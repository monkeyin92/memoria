FROM ghcr.io/astral-sh/uv:0.11.2 AS uv

FROM python:3.12-slim

ARG MEMORIA_RELEASE_COMMIT
ARG MEMORIA_RELEASE_TAG
ARG MEMORIA_IMAGE_ROLE=agent
LABEL org.opencontainers.image.revision="${MEMORIA_RELEASE_COMMIT}" \
      org.opencontainers.image.version="${MEMORIA_RELEASE_TAG}" \
      com.memoria.release.role="${MEMORIA_IMAGE_ROLE}"

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_COMPILE_BYTECODE=1 \
    HOME=/tmp \
    XDG_CACHE_HOME=/tmp/.cache

WORKDIR /app

COPY --from=uv /uv /uvx /bin/
COPY pyproject.toml uv.lock ./
ARG UV_DEFAULT_INDEX=https://pypi.org/simple
RUN uv export --frozen --no-dev --extra kws --no-emit-project --no-header --no-annotate \
        --output-file /tmp/requirements.production.txt --quiet \
    && uv venv --python /usr/local/bin/python --no-python-downloads \
    && uv pip install --python /app/.venv/bin/python \
        --requirements /tmp/requirements.production.txt \
        --require-hashes \
        --default-index "$UV_DEFAULT_INDEX" \
    && rm /tmp/requirements.production.txt

COPY README.md ./
COPY services ./services
COPY packages ./packages
COPY scripts/verify_env.py scripts/livekit_smoke_test.py scripts/provider_smoke_test.py \
     scripts/run_media_bridge.py scripts/run_media_slo_reporter.py \
     scripts/media_runtime_smoke.py ./scripts/
# Explicit mode: the runtime user (65532) must be able to read the gate, and
# the source file's mode is not something a build may depend on.
COPY --chmod=0644 scripts/verify_agent_release_artifact.py ./scripts/verify_agent_release_artifact.py
# Reviewed runtime voice maps (no secrets).
COPY infra/kws/keywords.txt ./infra/kws/keywords.txt

# COPY preserves the build host's file modes, and a checkout made under a
# restrictive umask ships 0600 sources the runtime user (65532) cannot read —
# including the gate script itself. Normalise every copied tree so the shipped
# artifact does not depend on who built it.
RUN chmod -R u=rwX,go=rX /app/services /app/packages /app/scripts /app/infra

# Release gate: this exact venv and source tree must still carry the pinned
# LiveKit group, the telemetry privacy defaults (fresh-process bootstrap, a
# real-exporter canary and its negative control) and the 1.8.x turn-handling
# contract. It runs offline. It is invoked as a module because the project
# itself is not installed into the venv, so `-m` is what keeps /app on
# sys.path; leaving the file in the image lets the release rehearsal re-run the
# same gate against the deployed candidate.
RUN /app/.venv/bin/python -m scripts.verify_agent_release_artifact

USER 65532:65532
ENTRYPOINT ["/app/.venv/bin/python", "-m", "services.agent.src.main"]
CMD ["start"]
