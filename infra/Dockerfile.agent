FROM ghcr.io/astral-sh/uv:0.11.2 AS uv

FROM python:3.12-slim

ARG MEMORIA_RELEASE_COMMIT
ARG MEMORIA_RELEASE_TAG
ARG MEMORIA_IMAGE_ROLE=agent
LABEL org.opencontainers.image.revision="${MEMORIA_RELEASE_COMMIT}" \
      org.opencontainers.image.version="${MEMORIA_RELEASE_TAG}" \
      com.memoria.release.role="${MEMORIA_IMAGE_ROLE}"

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_COMPILE_BYTECODE=1 \
    HOME=/tmp \
    XDG_CACHE_HOME=/tmp/.cache

WORKDIR /app

COPY --from=uv /uv /uvx /bin/
COPY pyproject.toml uv.lock ./
ARG UV_DEFAULT_INDEX=https://pypi.org/simple
RUN uv export --frozen --no-dev --no-emit-project --no-header --no-annotate \
        --output-file /tmp/requirements.production.txt --quiet \
    && uv venv --python /usr/local/bin/python --no-python-downloads \
    && uv pip install --python /app/.venv/bin/python \
        --requirements /tmp/requirements.production.txt \
        --require-hashes \
        --default-index "$UV_DEFAULT_INDEX" \
    && rm /tmp/requirements.production.txt

COPY README.md ./
COPY services/agent ./services/agent
COPY services/common ./services/common
COPY services/speaker ./services/speaker
COPY packages ./packages
COPY services/__init__.py ./services/__init__.py
COPY scripts/verify_env.py scripts/livekit_smoke_test.py scripts/provider_smoke_test.py ./scripts/
# Reviewed runtime voice maps (no secrets).
COPY infra/voices/designed_voice_ids.json ./infra/voices/designed_voice_ids.json
COPY infra/voices/doubao_voice_ids.json ./infra/voices/doubao_voice_ids.json

USER 65532:65532
ENTRYPOINT ["/app/.venv/bin/python", "-m", "services.agent.src.main"]
CMD ["start"]
