# Fill a private operator copy, then split it with scripts/split_production_env.py.
# Docker reads /etc/memoria-control-api.env and /etc/memoria-agent.env (mode 0600).
# Never commit or copy a filled version back into the repository.

ENVIRONMENT=production
DEPLOYMENT_PROFILE=cn_self_hosted
LOG_LEVEL=INFO
LLM_PROVIDER=bailian_deepseek
TTS_PROVIDER=doubao
PUBLIC_BASE_URL=https://122.51.108.140:8443/memoria-api
ALLOWED_ORIGINS=https://122.51.108.140:8443
OFFLINE_MOCK=false

# Self-hosted LiveKit
LIVEKIT_URL=wss://122.51.108.140:8443
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_AGENT_NAME=duplex-zh-agent
LIVEKIT_TURN_DETECTOR_VERSION=v1-mini
# Independent coturn (REST API HMAC credentials; never expose this secret).
COTURN_URLS=turn:turn.example.com:3478,turns:turn.example.com:5349
COTURN_REALM=memoria
COTURN_SHARED_SECRET=
COTURN_CREDENTIAL_TTL_S=300
MEDIA_EDGE_JWT_SECRET=
MEDIA_EDGE_JWT_ISSUER=voice-agent
MEDIA_EDGE_JWT_AUDIENCE=memoria-media
MEDIA_EDGE_VOICE_CORE_ADDR=voice-core-media-bridge:7001
MEDIA_EDGE_VOICE_CORE_REQUIRED=true
MEDIA_EDGE_VOICE_CORE_CA_FILE=/etc/memoria-media-runtime/media-edge-ca.crt
MEDIA_EDGE_VOICE_CORE_CLIENT_CERT_FILE=/etc/memoria-media-runtime/media-edge-client.crt
MEDIA_EDGE_VOICE_CORE_CLIENT_KEY_FILE=/etc/memoria-media-runtime/media-edge-client.key
MEDIA_EDGE_VOICE_CORE_SERVER_NAME=voice-core-media-bridge
MEDIA_EDGE_VOICE_CORE_ALLOW_INSECURE_DEVELOPMENT=false
MEDIA_EDGE_VOICE_CORE_CONNECT_TIMEOUT_MS=5000
# Fail-closed readiness seam for the real media terminator. Keep false until a
# reviewed WHIP/WebRTC/RTP downlink sender is installed in the edge process and
# verified; sessions still require every Voice Core bridge to carry a sender.
MEDIA_EDGE_EXTERNAL_DOWNLINK_SENDER_READY=false
STREAMCORE_SLO_GATE_ENABLED=false
MEDIA_EDGE_CONTROL_URL=http://media-edge:8080
MEDIA_EDGE_CONTROL_TIMEOUT_S=2
MEDIA_SLO_SNAPSHOT_TTL_S=120
MEDIA_SLO_REPORT_TOKEN=
MEDIA_SLO_REPORT_ENABLED=false
MEDIA_SLO_REPORT_URL=http://control-api:8000/v1/internal/media-runtime/slo
MEDIA_SLO_METRICS_URL=http://agent:9090/
MEDIA_SLO_REPORT_INTERVAL_S=30
MEDIA_SLO_REPORT_TIMEOUT_S=2
REDIS_URL=redis://redis:6379/1
DEVICE_CHALLENGE_TTL_MS=120000
MEDIA_BRIDGE_GRPC_ENABLED=false
MEDIA_BRIDGE_PROVIDER_FACTORY=services.agent.src.voice_core.provider_adapter:build_production_provider_factory
# Required only when enabling the opt-in media-runtime profile. This must
# build the established full Agent response pipeline; a raw vendor LLM is not
# an acceptable substitute.
MEDIA_BRIDGE_ORCHESTRATED_LLM_FACTORY=
MEDIA_BRIDGE_GRPC_ADDR=0.0.0.0:7001
MEDIA_BRIDGE_MTLS=true
MEDIA_BRIDGE_TLS_CERT_FILE=/etc/memoria-media-runtime/voice-core-server.crt
MEDIA_BRIDGE_TLS_KEY_FILE=/etc/memoria-media-runtime/voice-core-server.key
MEDIA_BRIDGE_CLIENT_CA_FILE=/etc/memoria-media-runtime/media-edge-ca.crt
MEDIA_BRIDGE_MAX_PENDING_AUDIO_FRAMES=100
MEDIA_BRIDGE_MAX_PENDING_MESSAGES=128
MEDIA_EDGE_ID=media-edge-1
VOICE_CORE_ID=voice-core-1
# Native WeChat Mini Program media adapter. The public WSS URL is only
# consumed by Control API; the gateway gets a least-privilege separate env.
MINIPROGRAM_MEDIA_GATEWAY_URL=wss://aigcnice.com:8443/memoria-mini-media/v1/mini-program/media
MINIPROGRAM_GATEWAY_TICKET_TTL_S=90
MINIPROGRAM_POST_PLAYOUT_GUARD_MS=150
MEMORIA_MINIPROGRAM_GATEWAY_TICKET_SECRET=
MINIPROGRAM_GATEWAY_TICKET_MAX_TTL_S=300
MINIPROGRAM_GATEWAY_LIVEKIT_TOKEN_TTL_S=300
# Mini Program-only WebRTC APM. Keep off for normal half-duplex traffic;
# use alternating only during an explicit real-device A/B window.
MINIPROGRAM_GATEWAY_AEC_ENABLED=false
MINIPROGRAM_GATEWAY_AEC_MODE=off
MINIPROGRAM_GATEWAY_AEC_STREAM_DELAY_MS=120
MINIPROGRAM_GATEWAY_AEC_ACTIVE_WINDOW_MS=750
# Diagnostics are disabled unless one exact session ID is configured.
MINIPROGRAM_GATEWAY_AEC_CAPTURE_SESSION_ID=
MINIPROGRAM_GATEWAY_AEC_CAPTURE_DIR=/tmp/memoria-aec-diagnostics
MINIPROGRAM_GATEWAY_AEC_CAPTURE_MAX_MS=5000
MINIPROGRAM_GATEWAY_GENERATION_QUARANTINE_MS=400
MINIPROGRAM_GATEWAY_AUDIO_QUEUE_FRAMES=20
# P1-5: adaptive interruption with Turn Detector (set false to force pure VAD).
LIVEKIT_ADAPTIVE_INTERRUPTION=true
# Alibaba Model Studio / DashScope
DASHSCOPE_API_KEY=
DASHSCOPE_WORKSPACE_ID=
# P1-8: fixed Memoria persona (DashScope preset). Optional clone id overrides.
QWEN_OMNI_VOICE=Liora Mira
# QWEN_OMNI_VOICE_CLONE_ID=
QWEN_OMNI_PERSONA_LABEL=Memoria 人设声
QWEN_OMNI_SDP_TIMEOUT_S=10
DASHSCOPE_REGION=cn-beijing
DASHSCOPE_WS_URL=wss://dashscope.aliyuncs.com/api-ws/v1/inference
DASHSCOPE_COMPATIBLE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_FAST_MODEL=qwen-turbo
QWEN_DEEP_MODEL=qwen-plus
# The default LLM and its bounded background tasks use DeepSeek-v4-flash via
# the DashScope-compatible endpoint and DASHSCOPE_API_KEY above.
INTERRUPT_SEMANTIC_ENABLED=true
INTERRUPT_SEMANTIC_MODEL=deepseek-v4-flash
INTERRUPT_SEMANTIC_TIMEOUT_S=1.2
# Optional post-AEC short-command KWS for trusted Mini Program sessions only.
# Model files are operator-provided under the Agent /data bind.
MINIPROGRAM_KWS_ENABLED=false
MINIPROGRAM_KWS_MODEL_DIR=/data/models/vosk-model-small-cn-0.22
MINIPROGRAM_KWS_KEYWORDS_FILE=/app/infra/kws/keywords.txt
MINIPROGRAM_KWS_MIN_CONFIDENCE=0.65
DASHSCOPE_SUMMARY_MODEL=deepseek-v4-flash
DASHSCOPE_SUMMARY_TIMEOUT_S=30
MEMORIA_MEMORY_EXTRACTION_MODEL=deepseek-v4-flash
MEMORIA_MEMORY_EXTRACTION_TIMEOUT_S=20
QWEN_EMOTION_ENABLED=true

# Short listener backchannels ("嗯/我在听") on main TTS track (no dual-track).
LISTENER_CUES_ENABLED=true
LISTENER_CUE_PLAYBACK=main_track
LISTENER_CUE_AEC_VALIDATED=false
LISTENER_CUE_PAUSE_MS=250
LISTENER_CUE_MIN_SPEECH_MS=1800
LISTENER_CUE_COOLDOWN_MS=5000
LISTENER_CUE_MAX_PER_TURN=2
LISTENER_CUE_VOLUME=0.65

# Omni semantic_vad knobs (Flash).
QWEN_OMNI_VAD_THRESHOLD=0.5
QWEN_OMNI_PREFIX_PADDING_MS=500
QWEN_OMNI_SILENCE_DURATION_MS=800

# Legacy spectral guard is not identity authority; formal three-state service below.
SPEAKER_VERIFY_ENABLED=false
SPEAKER_ENROLL_SPEECH_MS=3500
SPEAKER_ENROLL_TIMEOUT_MS=15000
SPEAKER_ACCEPT_THRESHOLD=0.62
SPEAKER_MIN_VERIFY_SPEECH_MS=450
MEMORIA_SPEAKER_AUTHORITY_ENABLED=true
MEMORIA_SPEAKER_AUTHORITY_URL=http://control-api:8000/v1/speakers/classify
MEMORIA_SPEAKER_AUTHORITY_TIMEOUT_S=0.4
MEMORIA_SPEAKER_DB_PATH=/data/speakers.sqlite3
# Empty means reuse MEMORIA_ARCHIVE_DATABASE_URL; set only for a separate database.
MEMORIA_SPEAKER_DATABASE_URL=
MEMORIA_SPEAKER_INTERNAL_TOKEN=
MEMORIA_SPEAKER_TEMPLATE_KEY=
MEMORIA_SPEAKER_EMBEDDING_URL=http://speaker-model:8001/v1/embeddings/speaker
MEMORIA_SPEAKER_EMBEDDING_TOKEN=
MEMORIA_SPEAKER_EMBEDDING_MODEL=campplus-cn-common@v1.0.0+ckpt.3388cf5f+onnx.7a39d2e5e566+fbank.v1
MEMORIA_SPEAKER_EMBEDDING_TIMEOUT_S=1.0
MEMORIA_SPEAKER_OWNER_THRESHOLD=0.78
MEMORIA_SPEAKER_GUEST_THRESHOLD=0.40

# Legacy CosyVoice clone enrollment/storage only; not the runtime playback chain.
# Keep historical assets for viewing, evaluation and revocation. Active legacy
# profiles fall back to the selected robot's approved Doubao default at runtime.
# Voice samples require their own Fernet key, signed URL secret and S3/OSS bucket.
MEMORIA_VOICE_SAMPLE_STORE_PATH=/data/voice-samples
MEMORIA_VOICE_SAMPLE_ENCRYPTION_KEY=
MEMORIA_VOICE_SAMPLE_KEY_VERSION=voice-sample-v1
# JSON object: retired version -> Fernet key; control-api only during rotation.
MEMORIA_VOICE_SAMPLE_READ_KEYS=
MEMORIA_VOICE_OBJECT_BUCKET=
MEMORIA_VOICE_OBJECT_ENDPOINT=
MEMORIA_VOICE_OBJECT_ACCESS_KEY=
MEMORIA_VOICE_OBJECT_SECRET_KEY=
MEMORIA_VOICE_OBJECT_REGION=cn-beijing
MEMORIA_VOICE_OBJECT_PREFIX=voice-clone
MEMORIA_VOICE_SAMPLE_URL_SECRET=
MEMORIA_VOICE_SAMPLE_URL_TTL_S=300
MEMORIA_VOICE_PROVIDER_REGION=cn-beijing
# Default keeps legacy enrollment. To enable Doubao Voice Clone 2.0, set
# provider=volcengine_doubao, target=seed-icl-2.0, an independent Control API
# key, and a real-smoke-verified synth-ready ID mode.
MEMORIA_VOICE_CLONE_PROVIDER=alibaba_model_studio
MEMORIA_VOICE_ENROLLMENT_URL=https://dashscope.aliyuncs.com/api/v1/services/audio/tts/customization
MEMORIA_VOICE_ENROLLMENT_TIMEOUT_S=120
MEMORIA_VOICE_TARGET_MODEL=cosyvoice-v3.5-flash
MEMORIA_DOUBAO_VOICE_API_KEY=
MEMORIA_DOUBAO_VOICE_CLONE_URL=https://openspeech.bytedance.com/api/v3/tts/voice_clone
MEMORIA_DOUBAO_VOICE_QUERY_URL=https://openspeech.bytedance.com/api/v3/tts/get_voice
MEMORIA_DOUBAO_VOICE_CLONE_POLL_INTERVAL_S=1
MEMORIA_DOUBAO_VOICE_SYNTH_READY_ID_MODE=unverified
MEMORIA_DOUBAO_VOICE_SYNTH_READY_ID_FIELD=
MEMORIA_DOUBAO_VOICE_EXPIRES_AT_FIELD=
MEMORIA_DOUBAO_VOICE_EXPIRES_AT_FORMAT=epoch_ms

# FunASR
FUNASR_MODEL=fun-asr-realtime
FUNASR_CONTEXT_ENABLED=false
FUNASR_SAMPLE_RATE=16000
FUNASR_LANGUAGE=zh
FUNASR_CHUNK_MS=80
FUNASR_MAX_SENTENCE_SILENCE_MS=550
FUNASR_SEMANTIC_PUNCTUATION=false
FUNASR_HEARTBEAT=true
FUNASR_RECONNECT_AUDIO_MS=400
FUNASR_CONNECT_TIMEOUT_S=5
FUNASR_RESULT_TIMEOUT_S=8
# Optional after vocabulary creation and recorded-device calibration.
# FUNASR_VOCABULARY_ID=
# FUNASR_SPEECH_NOISE_THRESHOLD=-0.1

# DeepSeek
# The default LLM_PROVIDER=bailian_deepseek reuses DASHSCOPE_API_KEY and the
# DashScope-compatible endpoint. Set LLM_PROVIDER=deepseek only for a direct
# DeepSeek account and provide its separate key below.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_FAST_MODEL=deepseek-v4-flash
DEEPSEEK_DEEP_MODEL=deepseek-v4-flash
DEEPSEEK_SUMMARY_MODEL=deepseek-v4-flash
DEEPSEEK_SUMMARY_TIMEOUT_S=30
DEEPSEEK_FAST_FIRST_TOKEN_TIMEOUT_S=3.0
DEEPSEEK_FAST_TOTAL_TIMEOUT_S=12.0
DEEPSEEK_FAST_MAX_TOKENS=240
DEEPSEEK_FAST_TEMPERATURE=0.45
DEEPSEEK_DEEP_TOTAL_TIMEOUT_S=90

# Doubao TTS 2.0 bidirectional streaming. Configure one authentication form:
# a non-empty API Key, or both APP ID and Access Token.
DOUBAO_TTS_API_KEY=
DOUBAO_TTS_APP_ID=
DOUBAO_TTS_ACCESS_TOKEN=
# DOUBAO_TTS_SECRET_KEY is not used by this WebSocket API and must not be deployed.
DOUBAO_TTS_WS_URL=wss://openspeech.bytedance.com/api/v3/tts/bidirection
DOUBAO_TTS_RESOURCE_ID=seed-tts-2.0
DOUBAO_TTS_VOICE_PROFILE=warm_companion
# Optional approved speaker override; normally resolve the profile from the registry.
# DOUBAO_TTS_SPEAKER=zh_male_yangguangqingnian_uranus_bigtts
DOUBAO_TTS_VOICE_REGISTRY=infra/voices/doubao_voice_ids.json
# Fixed output contract: PCM s16le, 24 kHz, mono, with word timestamps.
DOUBAO_TTS_SAMPLE_RATE=24000
DOUBAO_TTS_SPEECH_RATE=0
DOUBAO_TTS_LOUDNESS_RATE=0
DOUBAO_TTS_PITCH=0
# Opt-in only after the real provider smoke reports style_context=on with raw
# alignment_status=ok. Seed-TTS 2.0 preset voices only; personal clones ignore it.
DOUBAO_TTS_STYLE_CONTROL_ENABLED=false
DOUBAO_TTS_POOL_SIZE=4
DOUBAO_TTS_CONNECT_TIMEOUT_S=5
DOUBAO_TTS_FIRST_AUDIO_TIMEOUT_S=1.5
DOUBAO_TTS_TOTAL_TIMEOUT_S=20

# Turn handling
VAD_MIN_SPEECH_DURATION_S=0.05
VAD_MIN_SILENCE_DURATION_S=0.30
VAD_PREFIX_PADDING_DURATION_S=0.30
ENDPOINTING_MODE=dynamic
ENDPOINTING_MIN_DELAY_S=1.50
ENDPOINTING_MAX_DELAY_S=2.20
ENDPOINTING_ALPHA=0.85
INTERRUPTION_MIN_DURATION_S=0.45
FALSE_INTERRUPTION_TIMEOUT_S=1.70
BACKCHANNEL_BOUNDARY_START_S=0.50
BACKCHANNEL_BOUNDARY_END_S=1.80
PREEMPTIVE_GENERATION=false
PREEMPTIVE_TTS=false

# Persistence and security
MEMORIA_DB_PATH=/data/memoria.sqlite3
MEMORIA_TIMEZONE=Asia/Shanghai
MEMORIA_AUTH_SECRET=
MEMORIA_AUTH_TOKEN_TTL_S=900
MEMORIA_AUTH_REFRESH_TTL_S=2592000
MEMORIA_REFRESH_COOKIE_NAME=memoria_refresh
WECHAT_MINIPROGRAM_APPID=wx20a3a044b52fcbb7
WECHAT_MINIPROGRAM_APPSECRET=
MEMORIA_WECHAT_IDENTITY_SECRET=
WECHAT_JSCODE2SESSION_ENDPOINT=https://api.weixin.qq.com/sns/jscode2session
WECHAT_ACCESS_TOKEN_ENDPOINT=https://api.weixin.qq.com/cgi-bin/token
WECHAT_PHONE_NUMBER_ENDPOINT=https://api.weixin.qq.com/wxa/business/getuserphonenumber
WECHAT_AUTH_TIMEOUT_S=8
WECHAT_AVATAR_MAX_BYTES=2097152
WECHAT_AVATAR_PUBLIC_BASE_URL=https://aigcnice.com:8443/memoria-api
# Temporary runtime-first migration window; absolute UTC only. Blank disables legacy auth.
MEMORIA_LEGACY_AUTH_COMPAT_UNTIL=
MEMORIA_MESSAGE_IDEMPOTENCY_SECRET=
MEMORIA_ARCHIVE_DATABASE_URL=
MEMORIA_ARCHIVE_COMPILER_DATABASE_URL=
MEMORIA_ARCHIVE_COMPILER_ROLE=
# Independent capabilities; never reuse one token across these routes.
MEMORIA_ARCHIVE_WRITE_TOKEN=
MEMORIA_AGENT_HEARTBEAT_TOKEN=
MEMORIA_MEMORY_READ_TOKEN=
MEMORIA_PERSONA_READ_TOKEN=
MEMORIA_VOICE_RESOLUTION_TOKEN=
MEMORIA_VOICE_CLEANUP_TOKEN=
MEMORIA_INTERACTION_POLICY_TOKEN=
MEMORIA_RESPONSE_PLAN_TOKEN=
# Archive objects use a key and bucket independent from voice samples and speaker templates.
MEMORIA_ARCHIVE_OBJECT_STORE_PATH=/data/archive-objects
MEMORIA_ARCHIVE_OBJECT_ENCRYPTION_KEY=
MEMORIA_ARCHIVE_OBJECT_KEY_VERSION=archive-object-v1
# JSON object: retired version -> Fernet key; control-api only during rotation.
MEMORIA_ARCHIVE_OBJECT_READ_KEYS=
MEMORIA_ARCHIVE_OBJECT_BUCKET=
MEMORIA_ARCHIVE_OBJECT_ENDPOINT=
MEMORIA_ARCHIVE_OBJECT_ACCESS_KEY=
MEMORIA_ARCHIVE_OBJECT_SECRET_KEY=
MEMORIA_ARCHIVE_OBJECT_REGION=cn-beijing
MEMORIA_ARCHIVE_OBJECT_PREFIX=archive
MEMORIA_ARCHIVE_COMPILE_INTERVAL_S=1.0
MEMORIA_ARCHIVE_COMPILE_BATCH_SIZE=100
MEMORIA_MEMORY_EMBEDDING_URL=
MEMORIA_MEMORY_EMBEDDING_API_KEY=
MEMORIA_MEMORY_EMBEDDING_MODEL=text-embedding-v4
MEMORIA_MEMORY_EMBEDDING_DIMENSIONS=1024
MEMORIA_MEMORY_EMBEDDING_TIMEOUT_S=5
MEMORIA_ARCHIVE_SINK_ENABLED=true
MEMORIA_ARCHIVE_SESSION_EVENTS_URL=http://control-api:8000/v1/archive/session-events
MEMORIA_ARCHIVE_SPOOL_KEY=
MEMORIA_ARCHIVE_SPOOL_PATH=/data/archive-events.spool
MEMORIA_ARCHIVE_SPOOL_MAX_BYTES=8388608
# Enable only after Persona consent/API migrations are ready.
MEMORIA_PERSONA_ENABLED=false
MEMORIA_PERSONA_CAPSULE_URL=http://control-api:8000/v1/persona/session-capsule
MEMORIA_PERSONA_TIMEOUT_S=0.3
MEMORIA_PERSONA_CACHE_TTL_S=60
# Enable after confirmed memory projections are populated.
MEMORIA_MEMORY_CONTEXT_ENABLED=false
MEMORIA_MEMORY_CONTEXT_URL=http://control-api:8000/v1/archive/session-context
MEMORIA_MEMORY_CONTEXT_TIMEOUT_S=0.3
MEMORIA_MEMORY_CONTEXT_CACHE_TTL_S=60
MEMORIA_MEMORY_CONTEXT_LIMIT=8
# Required for per-robot Doubao voice resolution. Historical clone profiles are
# isolated by the Agent and fall back to the selected robot's approved voice.
MEMORIA_VOICE_PROFILE_ENABLED=true
MEMORIA_VOICE_PROFILE_URL=http://control-api:8000/v1/voices/session-resolution
MEMORIA_VOICE_PROFILE_TIMEOUT_S=0.3
READINESS_GATE_TTL_S=86400
SESSION_TOKEN_TTL_S=300
JWT_ISSUER=voice-agent
AUDIO_RETENTION_ENABLED=false
AUDIO_RETENTION_DAYS=0
PII_REDACTION_ENABLED=true

# Optional observability
OTEL_EXPORTER_OTLP_ENDPOINT=
PROMETHEUS_PORT=9090
SENTRY_DSN=
