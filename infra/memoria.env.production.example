# Fill a private operator copy, then split it with scripts/split_production_env.py.
# Docker reads /etc/memoria-control-api.env and /etc/memoria-agent.env (mode 0600).
# Never commit or copy a filled version back into the repository.

ENVIRONMENT=production
DEPLOYMENT_PROFILE=cn_self_hosted
LOG_LEVEL=INFO
LLM_PROVIDER=deepseek
# Set TTS_PROVIDER=stepfun_primary and STEPFUN_TTS_ENABLED=true to opt in.
TTS_PROVIDER=doubao
PUBLIC_BASE_URL=https://aginice.cn:8443/memoria-api
ALLOWED_ORIGINS=https://aginice.cn:8443
OFFLINE_MOCK=false

# Media: devices speak Direct Device WSS to the Go media-edge, which talks
# media-v1 gRPC to the Voice Core media bridge. LiveKit, its Agent worker and
# the Python mini-program/device gateways are retired.
# Preferred: Control API holds an Ed25519 private key and Media Edge receives
# only the matching public key/JWKS. HS256 fields remain a migration fallback
# and, when used, must contain the same independent secret.
STREAMCORE_TOKEN_PRIVATE_KEY_FILE=
STREAMCORE_TOKEN_PRIVATE_KEY_PEM=
STREAMCORE_TOKEN_KEY_ID=streamcore-1
# STREAMCORE_TOKEN_TTL_S=120
MEDIA_EDGE_JWT_PUBLIC_KEY_FILE=
MEDIA_EDGE_JWT_PUBLIC_KEY_PEM=
MEDIA_EDGE_JWT_KEY_ID=streamcore-1
MEDIA_EDGE_JWT_MAX_TTL_S=300
MEDIA_EDGE_JWT_CLOCK_SKEW_S=30
# STREAMCORE_TOKEN_SECRET must use the same secret as MEDIA_EDGE_JWT_SECRET.
STREAMCORE_TOKEN_SECRET=
MEDIA_EDGE_JWT_SECRET=
MEDIA_EDGE_JWT_ISSUER=voice-agent
MEDIA_EDGE_JWT_AUDIENCE=memoria-media
# Only python_authoritative is supported; go_shadow/go_authoritative fail startup.
MEDIA_EDGE_INTERACTION_AUTHORITY=python_authoritative
MEDIA_EDGE_VOICE_CORE_ADDR=voice-core-media-bridge:7001
MEDIA_EDGE_VOICE_CORE_REQUIRED=true
MEDIA_EDGE_VOICE_CORE_CA_FILE=/etc/memoria-media-runtime/media-edge-ca.crt
MEDIA_EDGE_VOICE_CORE_CLIENT_CERT_FILE=/etc/memoria-media-runtime/media-edge-client.crt
MEDIA_EDGE_VOICE_CORE_CLIENT_KEY_FILE=/etc/memoria-media-runtime/media-edge-client.key
MEDIA_EDGE_VOICE_CORE_SERVER_NAME=voice-core-media-bridge
MEDIA_EDGE_VOICE_CORE_ALLOW_INSECURE_DEVELOPMENT=false
MEDIA_EDGE_VOICE_CORE_CONNECT_TIMEOUT_MS=5000
MEDIA_EDGE_CONTROL_URL=http://media-edge:8080
MEDIA_EDGE_CONTROL_TIMEOUT_S=2
# Route this URL through the production internal HTTPS/mTLS boundary. The
# upgrade-env helper generates the shared request token if left absent.
MEDIA_EDGE_INTERNAL_CONTROL_URL=
MEDIA_EDGE_INTERNAL_CONTROL_TOKEN=
MEDIA_EDGE_INTERNAL_CONTROL_CA_FILE=/etc/memoria-media-runtime/control-edge-ca.crt
MEDIA_EDGE_INTERNAL_CONTROL_CLIENT_CERT_FILE=/etc/memoria-media-runtime/control-edge-client.crt
MEDIA_EDGE_INTERNAL_CONTROL_CLIENT_KEY_FILE=/etc/memoria-media-runtime/control-edge-client.key
MEDIA_EDGE_DEVICE_CLOSE_REPORT_TOKEN=
MEDIA_EDGE_HTTP_ADDR=:8080
MEDIA_EDGE_INTERNAL_HTTP_ADDR=:8081

# Direct ESP32 media is the only device media path; device onboarding and
# binding hand out DEVICE_DIRECT_MEDIA_WSS_URL. The internal URL above must
# terminate mTLS.
DEVICE_DIRECT_MEDIA_WSS_URL=
DEVICE_RUNTIME_PROFILE_TTL_S=3600
# 经 onboarding 用自身密钥激活、且绑定到当前 binding 的设备，在没有硬件 attestation 时
# 也按「已绑定链路」（trusted）对待，只放行长期记忆类能力（memory_capture、
# memory_recall_private、guardian_summary_view）；其余敏感能力仍要 verified。
# 默认关闭：关闭时所有未 attest 的设备都是 untrusted。开关只是 control-api 的环境变量，
# 改后重建 control-api 即可，不需要 schema 步骤；已签发的 profile 最长再有效
# DEVICE_RUNTIME_PROFILE_TTL_S 秒。
MEMORIA_BOUND_DEVICE_TRUST_ENABLED=false
# Direct Device WSS is the Media Edge's only media path: a production edge
# refuses to start unless it is true. docker-compose.production.yml pins it to
# true for the media-runtime profile; this file's value is overridden there.
MEDIA_EDGE_DEVICE_WSS_ENABLED=false
MEDIA_EDGE_DEVICE_REQUIRED=false
MEDIA_EDGE_DEVICE_ACOUSTIC_REGISTRY_FILE=
MEDIA_EDGE_DEVICE_JWT_ISSUER=
MEDIA_EDGE_DEVICE_JWT_AUDIENCE=
MEDIA_EDGE_DEVICE_ALLOW_HS256_DEVELOPMENT=false
# Required for Direct Device WSS. Use a shared production Redis authority;
# direct Device WSS never falls back to process-local replay or lease state.
# Must be a rediss:// URL in production.
MEDIA_EDGE_DEVICE_STATE_REDIS_URL=
MEDIA_EDGE_DEVICE_STATE_REDIS_CA_FILE=/etc/memoria-media-runtime/device-state-redis-ca.crt
MEDIA_EDGE_DEVICE_STATE_REDIS_CLIENT_CERT_FILE=/etc/memoria-media-runtime/device-state-redis-client.crt
MEDIA_EDGE_DEVICE_STATE_REDIS_CLIENT_KEY_FILE=/etc/memoria-media-runtime/device-state-redis-client.key
MEDIA_EDGE_DEVICE_STATE_REDIS_SERVER_NAME=device-state-redis
MEDIA_EDGE_DEVICE_STATE_KEY_PREFIX=memoria:device-media:v2
MEDIA_EDGE_DEVICE_STATE_TIMEOUT_MS=500
MEDIA_EDGE_DEVICE_LEASE_TTL_MS=30000
MEDIA_EDGE_DEVICE_LEASE_CHECK_INTERVAL_MS=5000
MEDIA_EDGE_INSTANCE_ID=
# Required for Direct Device WSS. Edge's private
# listener terminates mTLS; the healthcheck identity is independent from the
# Control client identity. The upgrade helper sets URL/listen defaults.
MEDIA_EDGE_INTERNAL_TLS_CERT_FILE=/etc/memoria-media-runtime/edge-internal-server.crt
MEDIA_EDGE_INTERNAL_TLS_KEY_FILE=/etc/memoria-media-runtime/edge-internal-server.key
MEDIA_EDGE_INTERNAL_TLS_CLIENT_CA_FILE=/etc/memoria-media-runtime/control-edge-ca.crt
MEDIA_EDGE_HEALTHCHECK_CA_FILE=/etc/memoria-media-runtime/control-edge-ca.crt
MEDIA_EDGE_HEALTHCHECK_CLIENT_CERT_FILE=/etc/memoria-media-runtime/edge-healthcheck-client.crt
MEDIA_EDGE_HEALTHCHECK_CLIENT_KEY_FILE=/etc/memoria-media-runtime/edge-healthcheck-client.key
MEDIA_EDGE_DEVICE_CLOSE_REPORT_URL=
MEDIA_EDGE_DEVICE_CLOSE_REPORT_TIMEOUT_MS=2000
MEDIA_SLO_SNAPSHOT_TTL_S=120
MEDIA_SLO_REPORT_TOKEN=
MEDIA_SLO_REPORT_ENABLED=false
MEDIA_SLO_REPORT_URL=http://control-api:8000/v1/internal/media-runtime/slo
MEDIA_SLO_METRICS_URL=http://voice-core-media-bridge:9090/
MEDIA_SLO_REPORT_INTERVAL_S=30
MEDIA_SLO_REPORT_TIMEOUT_S=2
# Agent -> Control reply-delivery receipts. Off by default; when enabled the
# production reporter requires MEDIA_REPLY_DELIVERY_TOKEN on both services.
# Commented lines show the built-in default; uncomment only to override.
# MEDIA_REPLY_DELIVERY_ENABLED=false
# MEDIA_REPLY_DELIVERY_URL=http://control-api:8000/v1/internal/media-runtime/reply-delivery
# MEDIA_REPLY_DELIVERY_TOKEN=
# MEDIA_REPLY_DELIVERY_SPOOL_KEY=
# MEDIA_REPLY_DELIVERY_SPOOL_PATH=data/media-reply-delivery.spool
# MEDIA_REPLY_DELIVERY_SPOOL_MAX_BYTES=8388608
# MEDIA_STREAM_EPOCH_ENABLED=true
# Agent -> Control interaction calls (built-in defaults).
# MEMORIA_INTERACTION_POLICY_URL=http://control-api:8000/v1/interaction/session-policy
# MEMORIA_INTERACTION_POLICY_TIMEOUT_S=0.4
# MEMORIA_RESPONSE_PLAN_URL=http://control-api:8000/v1/interaction/response-plan
# MEMORIA_RESPONSE_PLAN_TIMEOUT_S=0.8
# MEMORIA_TRANSACTIONAL_EFFECT_COMMIT_URL=http://control-api:8000/v1/interaction/tool-effect/commit
# MEMORIA_TRANSACTIONAL_EFFECT_RECONCILE_URL=http://control-api:8000/v1/interaction/tool-effect/reconcile
REDIS_URL=redis://redis:6379/1
DEVICE_CHALLENGE_TTL_MS=120000
MEDIA_BRIDGE_GRPC_ENABLED=false
# Required by the opt-in media-runtime profile. This in-repo factory builds
# Runtime and providers from the same Agent policy/context authority.
MEDIA_BRIDGE_SESSION_FACTORY=services.agent.src.media_agent_factory:build_production_media_session_factory
MEDIA_BRIDGE_GRPC_ADDR=0.0.0.0:7001
MEDIA_BRIDGE_MTLS=true
MEDIA_BRIDGE_TLS_CERT_FILE=/etc/memoria-media-runtime/voice-core-server.crt
MEDIA_BRIDGE_TLS_KEY_FILE=/etc/memoria-media-runtime/voice-core-server.key
MEDIA_BRIDGE_CLIENT_CA_FILE=/etc/memoria-media-runtime/media-edge-ca.crt
MEDIA_BRIDGE_MAX_PENDING_AUDIO_FRAMES=100
MEDIA_BRIDGE_MAX_PENDING_MESSAGES=128
MEDIA_OUTPUT_GENERATION_TIMEOUT_S=45
MEDIA_OWNER_SILENCE_TIMEOUT_S=30
MEDIA_MAX_USER_SPEECH_DURATION_S=60
MEDIA_EDGE_ID=media-edge-1
VOICE_CORE_ID=voice-core-1
MEMORIA_DEVICE_ONBOARDING_DATABASE_URL=postgresql://memoria_device_onboarding_api:replace@memoria-postgres:5432/memoria
MEMORIA_DEVICE_ACTIVATION_SIGNING_SEED_B64=
# Alibaba Model Studio / DashScope
# DASHSCOPE_API_KEY stays. Agent FunASR reads it. Deleting it does not turn
# the two switches below off, and turning them off must not delete the key.
DASHSCOPE_API_KEY=
# Default false. After deploy, Qwen realtime search does not run until this is true.
LIVE_SEARCH_QWEN_ENABLED=false
# Default false. After deploy, Qwen Omni sessions are refused until this is true.
QWEN_OMNI_SESSION_ENABLED=false
# control-api only. none does not 503 for a missing DashScope key. funasr does.
# The agent process still requires the key for FunASR either way.
ASR_PROVIDER=none
DASHSCOPE_WORKSPACE_ID=
# P1-8: fixed Memoria persona (DashScope preset).
QWEN_OMNI_VOICE=Liora Mira
QWEN_OMNI_PERSONA_LABEL=Memoria 人设声
QWEN_OMNI_SDP_TIMEOUT_S=10
DASHSCOPE_REGION=cn-beijing
DASHSCOPE_WS_URL=wss://dashscope.aliyuncs.com/api-ws/v1/inference
DASHSCOPE_COMPATIBLE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_FAST_MODEL=qwen3.7-flash
QWEN_DEEP_MODEL=qwen-plus
# The Qwen values are the LLM_PROVIDER=qwen rollback: the conversation LLM
# qwen3.7-flash on DashScope Beijing, classifiers on cheaper qwen-flash.
# QWEN_DEEP_MODEL (qwen-plus) serves realtime search under every provider.
# The classifier timeouts hold DeepSeek's tail (p50 ~0.5 s, p90 ~0.8 s).
# Weather lookup: off plus LIVE_SEARCH_QWEN_ENABLED=false answers with the
# fixed weather-fallback-v1 sentence and sends nothing. domestic asks QWeather
# (和风天气) for allowlisted Chinese cities only, and stays off until both the
# key and the per-account *.qweatherapi.com host are set. Live search on, with
# no domestic source, sends unanswered weather to Qwen realtime search.
# See docs/compliance (天气查询) for the fields sent.
WEATHER_LOOKUP_PROVIDER=off
# QWEATHER_API_KEY=
# QWEATHER_API_HOST=
LIVE_LOOKUP_SEMANTIC_ENABLED=true
LIVE_LOOKUP_SEMANTIC_MODEL=qwen-flash
LIVE_LOOKUP_SEMANTIC_TIMEOUT_S=1.2
CONVERSATION_CLOSE_SEMANTIC_ENABLED=true
CONVERSATION_CLOSE_SEMANTIC_MODEL=qwen-flash
CONVERSATION_CLOSE_SEMANTIC_TIMEOUT_S=1.2
CRISIS_SEMANTIC_ENABLED=true
CRISIS_SEMANTIC_MODEL=qwen-flash
CRISIS_SEMANTIC_TIMEOUT_S=1.2
DASHSCOPE_SUMMARY_MODEL=qwen-flash
DASHSCOPE_SUMMARY_TIMEOUT_S=30
MEMORIA_MEMORY_EXTRACTION_MODEL=qwen-flash
MEMORIA_MEMORY_EXTRACTION_TIMEOUT_S=20
# MEMORIA_PERSONA_STRUCTURING_MODEL=qwen-flash
# MEMORIA_PERSONA_STRUCTURING_TIMEOUT_S=8
MEMORIA_CORPUS_RETENTION_INTERVAL_S=300
MEMORIA_MEMORY_VECTOR_BACKFILL_INTERVAL_S=3600
MEMORIA_MEMORY_VECTOR_BACKFILL_BATCH=200

# Omni semantic_vad knobs (Flash).
QWEN_OMNI_VAD_THRESHOLD=0.5
QWEN_OMNI_PREFIX_PADDING_MS=500
QWEN_OMNI_SILENCE_DURATION_MS=800

# Legacy spectral guard is not identity authority; formal three-state service below.
SPEAKER_VERIFY_ENABLED=false
SPEAKER_ENROLL_SPEECH_MS=3500
SPEAKER_ENROLL_TIMEOUT_MS=15000
SPEAKER_ACCEPT_THRESHOLD=0.62
SPEAKER_MIN_VERIFY_SPEECH_MS=450
# Voiceprint is off: each device serves the one person it is bound to, and
# that binding (signed Runtime Profile), not a voice match, carries owner data
# authority. The CAM++ service stays deployable for a later, calibrated return.
MEMORIA_SPEAKER_AUTHORITY_ENABLED=false
MEMORIA_SPEAKER_AUTHORITY_URL=http://control-api:8000/v1/speakers/classify
MEMORIA_SPEAKER_AUTHORITY_TIMEOUT_S=0.4
MEMORIA_SPEAKER_DB_PATH=/data/speakers.sqlite3
# Empty means reuse MEMORIA_ARCHIVE_DATABASE_URL; set only for a separate database.
MEMORIA_SPEAKER_DATABASE_URL=
MEMORIA_SPEAKER_INTERNAL_TOKEN=
MEMORIA_SPEAKER_TEMPLATE_KEY=
MEMORIA_SPEAKER_EMBEDDING_URL=http://speaker-model:8001/v1/embeddings/speaker
MEMORIA_SPEAKER_EMBEDDING_TOKEN=
MEMORIA_SPEAKER_EMBEDDING_MODEL=campplus-cn-common@v1.0.0+ckpt.3388cf5f+onnx.7a39d2e5e566+fbank.v1
MEMORIA_SPEAKER_EMBEDDING_TIMEOUT_S=1.0
MEMORIA_SPEAKER_OWNER_THRESHOLD=0.78
MEMORIA_SPEAKER_GUEST_THRESHOLD=0.40

# Historical voice-sample objects stay for revocation. Playback uses the
# approved Doubao preset. Samples need their own Fernet key, signed URL secret
# and S3/OSS bucket.
MEMORIA_VOICE_SAMPLE_STORE_PATH=/data/voice-samples
MEMORIA_VOICE_SAMPLE_ENCRYPTION_KEY=
MEMORIA_VOICE_SAMPLE_KEY_VERSION=voice-sample-v1
# JSON object: retired version -> Fernet key; control-api only during rotation.
MEMORIA_VOICE_SAMPLE_READ_KEYS=
MEMORIA_VOICE_OBJECT_BUCKET=
MEMORIA_VOICE_OBJECT_ENDPOINT=
MEMORIA_VOICE_OBJECT_ACCESS_KEY=
MEMORIA_VOICE_OBJECT_SECRET_KEY=
MEMORIA_VOICE_OBJECT_REGION=cn-beijing
MEMORIA_VOICE_OBJECT_PREFIX=voice-clone
MEMORIA_VOICE_SAMPLE_URL_SECRET=
MEMORIA_VOICE_SAMPLE_URL_TTL_S=300
MEMORIA_VOICE_PROVIDER_REGION=cn-beijing

# FunASR
FUNASR_MODEL=fun-asr-realtime
# Only sent to qwen-audio-3.1-asr-* models: near_meeting_16k | far_field_meeting_16k
FUNASR_VAD_MODEL=
FUNASR_CONTEXT_ENABLED=false
FUNASR_SAMPLE_RATE=16000
FUNASR_LANGUAGE=zh
FUNASR_CHUNK_MS=80
FUNASR_MAX_SENTENCE_SILENCE_MS=550
FUNASR_SEMANTIC_PUNCTUATION=false
FUNASR_HEARTBEAT=true
FUNASR_RECONNECT_AUDIO_MS=400
FUNASR_CONNECT_TIMEOUT_S=5
FUNASR_RESULT_TIMEOUT_S=8
# Optional after vocabulary creation and recorded-device calibration.
# FUNASR_VOCABULARY_ID=
# FUNASR_SPEECH_NOISE_THRESHOLD=-0.1

# SenseVoice offline rescue: when a FunASR VAD segment ends with zero usable
# finals but real speech energy, the whole segment PCM is POSTed to this
# endpoint (raw 16-bit mono PCM, response JSON {"text": "..."}) and the
# transcript is re-emitted as a normal provider final. Empty URL disables.
# SENSEVOICE_URL=http://sensevoice:8000/asr
# SENSEVOICE_TIMEOUT_S=2.5
# SENSEVOICE_MIN_RMS=100
# SENSEVOICE_MAX_AUDIO_S=12
# SENSEVOICE_MIN_TEXT_CHARS=2

# Optional ASR failover (phase 1). Off by default: the media bridge keeps using
# DashScope fun-asr-realtime exactly as before. When enabled, Volc is primary,
# the SenseVoice sidecar re-recognises the whole failed VAD segment, and
# DashScope fun-asr-realtime is the third attempt.
# ASR_FAILOVER_ENABLED=false
# ASR_PRIMARY=volc
# ASR_BACKUP=sensevoice
# ASR_TERTIARY=dashscope_funasr
# ASR_FAILOVER_FIRST_RESULT_TIMEOUT_MS=1500
# ASR_FAILOVER_CONNECT_TIMEOUT_MS=2000
# ASR_BREAKER_FAILURES=3
# ASR_BREAKER_OPEN_S=30
# ASR_BACKUP_TIMEOUT_S=5
# ASR_BACKUP_MAX_AUDIO_S=12
# Volc credentials are read only from the process environment, never from this
# file or any other plaintext config.
# VOLC_ASR_APP_ID=
# VOLC_ASR_ACCESS_TOKEN=
# VOLC_ASR_RESOURCE_ID=volc.seedasr.sauc.duration
# VOLC_ASR_WS_URL=wss://openspeech.bytedance.com/api/v3/sauc/bigmodel_async
# VOLC_ASR_END_WINDOW_MS=550
# VOLC_ASR_BOOSTING_TABLE_ID=

# DeepSeek (official API)
# LLM_PROVIDER=deepseek moves every text-model call to this account and key:
# the reply model and the per-turn classifiers (agent), crisis evidence,
# memory/persona extraction and persona structuring (control-api), all on
# DEEPSEEK_FAST_MODEL, and the guardian recap / daily summary on
# DEEPSEEK_SUMMARY_MODEL. Realtime search stays on Qwen (DeepSeek has no web
# search); ASR, TTS and embeddings are not LLM calls and stay on DashScope.
# deepseek-flash serves DeepSeek-V4.1-Flash. Production runs LLM_PROVIDER=deepseek
# since 20261001-deepseek-flash-v1; LLM_PROVIDER=qwen is the rollback.
DEEPSEEK_API_KEY=
DEEPSEEK_API_URL=https://api.deepseek.com
# Legacy name, read only when DEEPSEEK_API_URL is unset. Migrate to DEEPSEEK_API_URL.
# DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_FAST_MODEL=deepseek-flash
DEEPSEEK_DEEP_MODEL=deepseek-flash
DEEPSEEK_SUMMARY_MODEL=deepseek-flash
DEEPSEEK_SUMMARY_TIMEOUT_S=30
DEEPSEEK_FAST_FIRST_TOKEN_TIMEOUT_S=3.0
DEEPSEEK_FAST_TOTAL_TIMEOUT_S=12.0
DEEPSEEK_FAST_MAX_TOKENS=240
DEEPSEEK_FAST_TEMPERATURE=0.45
DEEPSEEK_DEEP_TOTAL_TIMEOUT_S=90
# Primary→Beijing DashScope backup. Keep off until the enable checklist is done.
LLM_FAILOVER_ENABLED=false
LLM_FIRST_TOKEN_TIMEOUT_S=5.0
LLM_INTER_TOKEN_TIMEOUT_S=4.0
LLM_BACKUP_MODEL=qwen3.8-flash

# Doubao TTS 2.0 bidirectional streaming. Configure one authentication form:
# a non-empty API Key, or both APP ID and Access Token.
DOUBAO_TTS_API_KEY=
DOUBAO_TTS_APP_ID=
DOUBAO_TTS_ACCESS_TOKEN=
# DOUBAO_TTS_SECRET_KEY is not used by this WebSocket API and must not be deployed.
DOUBAO_TTS_WS_URL=wss://openspeech.bytedance.com/api/v3/tts/bidirection
DOUBAO_TTS_RESOURCE_ID=seed-tts-2.0
DOUBAO_TTS_VOICE_PROFILE=warm_companion
# Optional approved speaker override; normally resolve the profile from the registry.
# DOUBAO_TTS_SPEAKER=zh_female_kailangjiejie_uranus_bigtts
# Voice used when StepFun fails over to Doubao in main/backup mode
# (TTS_PROVIDER=stepfun_primary and STEPFUN_TTS_ENABLED=true). Product chose
# 开朗姐姐 2.0 on 2026-10-20 19:09; override here if the approved voice changes.
# It never falls back to the warm_companion speaker above, and clone/ICL
# voices are rejected on this path.
DOUBAO_TTS_FALLBACK_SPEAKER=zh_female_kailangjiejie_uranus_bigtts
DOUBAO_TTS_VOICE_REGISTRY=infra/voices/doubao_voice_ids.json
# Fixed output contract: PCM s16le, 24 kHz, mono, with word timestamps.
DOUBAO_TTS_SAMPLE_RATE=24000
DOUBAO_TTS_SPEECH_RATE=0
DOUBAO_TTS_LOUDNESS_RATE=0
DOUBAO_TTS_PITCH=0
# Opt-in only after the real provider smoke reports style_context=on with raw
# alignment_status=ok. Seed-TTS 2.0 preset voices only.
DOUBAO_TTS_STYLE_CONTROL_ENABLED=false
DOUBAO_TTS_POOL_SIZE=4
DOUBAO_TTS_CONNECT_TIMEOUT_S=5
DOUBAO_TTS_FIRST_AUDIO_TIMEOUT_S=1.5
DOUBAO_TTS_TOTAL_TIMEOUT_S=20
# Absolute cap for one generation attempt; the effective cap is
# max(DOUBAO_TTS_TOTAL_TIMEOUT_S * 5, this value). Progress renews the
# stall budget above, so only runaway generation hits this cap.
DOUBAO_TTS_HARD_DEADLINE_S=180

# StepFun StepAudio 3 TTS (optional primary; Doubao stays the default).
# Opt in with TTS_PROVIDER=stepfun_primary and STEPFUN_TTS_ENABLED=true.
STEPFUN_TTS_ENABLED=false
STEPFUN_API_KEY=
STEPFUN_TTS_WS_URL=wss://api.stepfun.com/v1/realtime/audio
STEPFUN_TTS_MODEL=stepaudio-3-tts
STEPFUN_TTS_VOICE=yuanqishaonv
# Delivery guard (deployment wording, not a child-facing line). Empty disables it.
STEPFUN_TTS_INSTRUCTION=请用温柔、自然、亲切的语气朗读。不要笑，不要结巴，不要重复字词，不要添加“嗯”“呃”“啊”“哦”等语气词，也不要模仿或插入笑声。
STEPFUN_TTS_SAMPLE_RATE=24000
STEPFUN_TTS_POOL_SIZE=2
STEPFUN_TTS_CONNECT_TIMEOUT_S=5
STEPFUN_TTS_FIRST_AUDIO_TIMEOUT_S=1.5
STEPFUN_TTS_TOTAL_TIMEOUT_S=20
STEPFUN_TTS_HARD_DEADLINE_S=180
STEPFUN_TTS_BREAKER_FAILURES=3
STEPFUN_TTS_BREAKER_OPEN_S=30
STEPFUN_TTS_AUTH_BREAKER_OPEN_S=3600

# AIGC labels (GB 45438-2025). One round = point-screen wake to session end
# (3-minute silence close, child stop, anti-addiction refusal/limit). Each round
# opens and ends with a configurable AI notice; the default is the compliance-
# approved short-long / short-short pure-tone rhythm generated from these
# parameters. No prompt text is written or synthesized here. Live stream audio
# carries no watermark; shipped clips carry the Appendix-E OpusTags instead.
AIGC_NOTICE_ENABLED=true
# tone | speech | none. speech plays only AIGC_NOTICE_SPEECH_RESOURCE and
# nothing when it is unset (no synthesized stand-in).
AIGC_NOTICE_MODE=tone
AIGC_NOTICE_OPENING_ENABLED=true
AIGC_NOTICE_CLOSING_ENABLED=true
# S=short, L=long; whitespace separates groups. SL SS = short-long, short-short.
AIGC_NOTICE_TONE_PATTERN=SL SS
AIGC_NOTICE_TONE_FREQUENCY_HZ=880
AIGC_NOTICE_TONE_SHORT_MS=120
AIGC_NOTICE_TONE_LONG_MS=300
AIGC_NOTICE_TONE_GAP_MS=90
AIGC_NOTICE_TONE_GROUP_GAP_MS=260
# 0..1 of full scale; 0.20 is roughly normal speaking loudness.
AIGC_NOTICE_TONE_VOLUME=0.20
# Pause between the opening notice and the following 「我在呢」 wake acknowledgement.
AIGC_NOTICE_LEAD_INTERVAL_MS=400
# Upper bound on waiting for one notice to finish (a stalled downlink must not
# hold a round open).
AIGC_NOTICE_MARKER_DURATION_MS=3000
# External, product-approved clip id or path (24 kHz mono s16 le .wav/.s16le),
# played at its native normal speed. Ship the approved text in the clip.
AIGC_NOTICE_SPEECH_RESOURCE=
AIGC_NOTICE_SPEECH_ROOT=
AIGC_NOTICE_SPEECH_SAMPLE_RATE_HZ=24000
# Internal per-round record: time, provider/engine, voice, content id, close
# reason. Never child speech or reply text. Empty path = log line only.
AIGC_GENERATION_LOG_ENABLED=true
AIGC_GENERATION_LOG_PATH=
# Offline/render tooling only (scripts/render_*.py, retag_offline_aigc_metadata.py):
# party identifiers written as CONTENT_PRODUCER / CONTENT_PROPAGATOR, plus
# LABEL=1, on newly rendered clips. The agent runtime does not read these.
AIGC_CONTENT_PRODUCER=Memoria
AIGC_CONTENT_PROPAGATOR=Memoria

# Turn handling
VAD_MIN_SPEECH_DURATION_S=0.05
VAD_PREFIX_PADDING_DURATION_S=0.30
ENDPOINTING_MODE=dynamic
ENDPOINTING_MIN_DELAY_S=1.50
ENDPOINTING_MAX_DELAY_S=2.20
ENDPOINTING_ALPHA=0.85
INTERRUPTION_MIN_DURATION_S=0.45
FALSE_INTERRUPTION_TIMEOUT_S=1.70
BACKCHANNEL_BOUNDARY_START_S=0.50
BACKCHANNEL_BOUNDARY_END_S=1.80

# Persistence and security
MEMORIA_DB_PATH=/data/memoria.sqlite3
MEMORIA_TIMEZONE=Asia/Shanghai
MEMORIA_AUTH_SECRET=
MEMORIA_AUTH_TOKEN_TTL_S=900
# MEMORIA_AUTH_ISSUER=memoria-control-api
# MEMORIA_AUTH_AUDIENCE=memoria-h5
MEMORIA_AUTH_REFRESH_TTL_S=2592000
MEMORIA_REFRESH_COOKIE_NAME=memoria_refresh
WECHAT_MINIPROGRAM_APPID=wx20a3a044b52fcbb7
WECHAT_MINIPROGRAM_APPSECRET=
MEMORIA_WECHAT_IDENTITY_SECRET=
WECHAT_JSCODE2SESSION_ENDPOINT=https://api.weixin.qq.com/sns/jscode2session
WECHAT_ACCESS_TOKEN_ENDPOINT=https://api.weixin.qq.com/cgi-bin/token
WECHAT_PHONE_NUMBER_ENDPOINT=https://api.weixin.qq.com/wxa/business/getuserphonenumber
WECHAT_AUTH_TIMEOUT_S=8
WECHAT_AVATAR_MAX_BYTES=2097152
WECHAT_AVATAR_PUBLIC_BASE_URL=https://aginice.cn:8443/memoria-api
# 监护人危机提醒（小程序一次性订阅消息）。默认关闭：关闭时提醒只排队并显示在监护页。
# 开启：在小程序后台「订阅消息」选用模板 → 填模板 ID 与关键词映射 → 置 true。
# 关键词映射为 slot=keyword（slot 取 title/child/time/tip），必须与所选模板字段一致。
MEMORIA_GUARDIAN_PUSH_ENABLED=false
MEMORIA_WECHAT_SUBSCRIBE_CRISIS_TEMPLATE_ID=
MEMORIA_WECHAT_SUBSCRIBE_CRISIS_FIELDS=title=thing1,child=name2,time=time3,tip=thing4
MEMORIA_WECHAT_SUBSCRIBE_CRISIS_PAGE=pages/guardian/index
WECHAT_SUBSCRIBE_SEND_ENDPOINT=https://api.weixin.qq.com/cgi-bin/message/subscribe/send
# formal=正式版，trial=体验版，developer=开发版（点消息打开的小程序版本）。
WECHAT_MINIPROGRAM_STATE=formal
MEMORIA_GUARDIAN_PUSH_INTERVAL_S=10
MEMORIA_GUARDIAN_PUSH_MAX_ATTEMPTS=5
# Temporary runtime-first migration window; absolute UTC only. Blank disables legacy auth.
MEMORIA_LEGACY_AUTH_COMPAT_UNTIL=
MEMORIA_MESSAGE_IDEMPOTENCY_SECRET=

# PostgreSQL bootstrap credentials belong only in root:root 0600
# /etc/memoria-postgres.env. Keep these assignments commented in this merged
# operator template so split_production_env.py can never route them into the
# long-lived Control API or Agent env files. Generate them with
# scripts/bootstrap_production_data_env.py and preserve existing values during
# forward-only upgrades.
# POSTGRES_PASSWORD=
# MEMORIA_DB_APP_PASSWORD=
# MEMORIA_DB_COMPILER_PASSWORD=
# MEMORIA_DB_EVOLUTION_PASSWORD=
# MEMORIA_DB_GUARDIAN_PASSWORD=
# MEMORIA_DB_GUARDIAN_MAINTENANCE_PASSWORD=
# MEMORIA_DB_GUARDIAN_WORKER_PASSWORD=
# MEMORIA_DB_IDENTITY_PASSWORD=
# MEMORIA_DB_IDENTITY_REGISTRATION_PASSWORD=
# MEMORIA_DB_CONSENT_PASSWORD=
# MEMORIA_DB_DEVICE_ONBOARDING_API_PASSWORD=
# MEMORIA_DB_DEVICE_ONBOARDING_MAINTENANCE_PASSWORD=
# MEMORIA_DB_SESSION_API_PASSWORD=
# MEMORIA_DB_ACTION_EXECUTOR_PASSWORD=
# MEMORIA_DB_SESSION_PROJECTOR_PASSWORD=
# MEMORIA_DB_SESSION_WORKER_PASSWORD=
# MEMORIA_DB_SESSION_MAINTENANCE_PASSWORD=
# MEMORIA_DB_MEMORY_API_PASSWORD=
# MEMORIA_DB_MEMORY_WORKER_PASSWORD=
# MEMORIA_DB_MEMORY_MAINTENANCE_PASSWORD=
# MEMORIA_DB_CONTROL_PASSWORD=

# Long-lived Control API DSNs use independent LOGIN/NOBYPASSRLS roles. The
# release env generator derives these from /etc/memoria-postgres.env. Never add
# MEMORIA_SESSION_RUNTIME_BOOTSTRAP_DATABASE_URL,
# MEMORIA_MEMORY_BOOTSTRAP_DATABASE_URL, or a memoria_admin DSN here;
# administrator credentials are permitted only in a bounded upgrade window.
MEMORIA_ARCHIVE_DATABASE_URL=
MEMORIA_ARCHIVE_COMPILER_DATABASE_URL=
MEMORIA_ARCHIVE_COMPILER_ROLE=memoria_compiler
MEMORIA_EVOLUTION_DATABASE_URL=
MEMORIA_GUARDIAN_DATABASE_URL=
MEMORIA_GUARDIAN_MAINTENANCE_DATABASE_URL=
MEMORIA_GUARDIAN_WORKER_DATABASE_URL=
MEMORIA_IDENTITY_DATABASE_URL=
MEMORIA_IDENTITY_REGISTRATION_DATABASE_URL=
MEMORIA_CONSENT_DATABASE_URL=
# Accounts, auth sessions, devices and voice sessions. Leave empty to keep the
# SQLite file (MEMORIA_DB_PATH); set it only in the authorized cutover, right
# after scripts/migrate_control_sqlite_to_postgres.py --apply, to
# postgresql://memoria_control:...@memoria-postgres:5432/memoria
MEMORIA_CONTROL_DATABASE_URL=
MEMORIA_SESSION_RUNTIME_DATABASE_URL=
MEMORIA_ACTION_EXECUTOR_DATABASE_URL=
MEMORIA_SESSION_RUNTIME_PROJECTOR_DATABASE_URL=
MEMORIA_SESSION_RUNTIME_WORKER_DATABASE_URL=
MEMORIA_SESSION_RUNTIME_MAINTENANCE_DATABASE_URL=
MEMORIA_SESSION_RUNTIME_SCHEMA_MANAGED_EXTERNALLY=true
MEMORIA_MEMORY_API_DATABASE_URL=
MEMORIA_MEMORY_WORKER_DATABASE_URL=
# Erasing one bound subject's memory records (memory_subject_erase only).
MEMORIA_MEMORY_MAINTENANCE_DATABASE_URL=
MEMORIA_MEMORY_SCHEMA_MANAGED_EXTERNALLY=true
# HMAC producer/verifier aliases. Set both to the same generated secret;
# split_production_env routes only the signing alias to Control and only the
# verify alias to Agent.
MEMORIA_RUNTIME_PROFILE_SIGNING_SECRET=
MEMORIA_RUNTIME_PROFILE_VERIFY_KEY=
MEMORIA_DEVICE_BINDING_TOKEN_SECRET=
MEMORIA_TRANSFER_EVIDENCE_SECRET=
# Exact `digest` field from this release's verified canonical manifest.
MEMORIA_EVOLUTION_TRUSTED_ROOT_SHA256=
MEMORIA_EVOLUTION_MIN_NEW_SIGNALS=10
MEMORIA_EVOLUTION_MIN_FAILURE_SUPPORT=2
MEMORIA_EVOLUTION_STALE_AFTER_DAYS=30
MEMORIA_EVOLUTION_CANARY_PERCENT=0
# Exact low-risk prompt task-family allowlist; protected control families are rejected.
MEMORIA_EVOLUTION_RUNTIME_PROMPT_FAMILIES=weather
MEMORIA_EVOLUTION_SLEEP_INTERVAL_S=3600
# Independent capabilities; never reuse one token across these routes.
MEMORIA_ARCHIVE_WRITE_TOKEN=
MEMORIA_AGENT_HEARTBEAT_TOKEN=
MEMORIA_VOICE_RESOLUTION_TOKEN=
MEMORIA_VOICE_CLEANUP_TOKEN=
MEMORIA_INTERACTION_POLICY_TOKEN=
MEMORIA_RESPONSE_PLAN_TOKEN=
MEMORIA_EVOLUTION_CONTROL_TOKEN=
# Archive objects use a key and bucket independent from voice samples and speaker templates.
MEMORIA_ARCHIVE_OBJECT_STORE_PATH=/data/archive-objects
MEMORIA_ARCHIVE_OBJECT_ENCRYPTION_KEY=
MEMORIA_ARCHIVE_OBJECT_KEY_VERSION=archive-object-v1
# JSON object: retired version -> Fernet key; control-api only during rotation.
MEMORIA_ARCHIVE_OBJECT_READ_KEYS=
MEMORIA_ARCHIVE_OBJECT_BUCKET=
MEMORIA_ARCHIVE_OBJECT_ENDPOINT=
MEMORIA_ARCHIVE_OBJECT_ACCESS_KEY=
MEMORIA_ARCHIVE_OBJECT_SECRET_KEY=
MEMORIA_ARCHIVE_OBJECT_REGION=cn-beijing
MEMORIA_ARCHIVE_OBJECT_PREFIX=archive
MEMORIA_ARCHIVE_COMPILE_INTERVAL_S=1.0
MEMORIA_ARCHIVE_COMPILE_BATCH_SIZE=100
MEMORIA_ARCHIVE_COMPILE_LEASE_S=300
MEMORIA_ARCHIVE_COMPILE_MAX_ATTEMPTS=8
MEMORIA_ARCHIVE_COMPILE_RETRY_BASE_S=2
MEMORIA_ARCHIVE_COMPILE_RETRY_MAX_S=300
MEMORIA_MEMORY_EMBEDDING_URL=
MEMORIA_MEMORY_EMBEDDING_API_KEY=
MEMORIA_MEMORY_EMBEDDING_MODEL=text-embedding-v4
MEMORIA_MEMORY_EMBEDDING_DIMENSIONS=1024
MEMORIA_MEMORY_EMBEDDING_TIMEOUT_S=5
MEMORIA_ARCHIVE_SINK_ENABLED=true
MEMORIA_ARCHIVE_SESSION_EVENTS_URL=http://control-api:8000/v1/archive/session-events
MEMORIA_SESSION_RECAP_ENABLED=true
MEMORIA_SESSION_RECAP_URL=http://control-api:8000/v1/internal/child-memory/session-recap
MEMORIA_ARCHIVE_SPOOL_KEY=
MEMORIA_ARCHIVE_SPOOL_PATH=/data/archive-events.spool
MEMORIA_ARCHIVE_SPOOL_MAX_BYTES=8388608
# Required for per-robot Doubao voice resolution. Historical clone profiles are
# isolated by the Agent and fall back to the selected robot's approved voice.
MEMORIA_VOICE_PROFILE_ENABLED=true
MEMORIA_VOICE_PROFILE_URL=http://control-api:8000/v1/voices/session-resolution
MEMORIA_VOICE_PROFILE_TIMEOUT_S=0.3
READINESS_GATE_TTL_S=86400
JWT_ISSUER=voice-agent
AUDIO_RETENTION_ENABLED=false
AUDIO_RETENTION_DAYS=0

# Optional observability
OTEL_EXPORTER_OTLP_ENDPOINT=
PROMETHEUS_PORT=9090
SENTRY_DSN=
