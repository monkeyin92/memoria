# Install as /etc/memoria-offsite-backup.env with mode 0600.
# The endpoint must be hosted outside the Memoria production machine.
MEMORIA_OFFSITE_S3_ENDPOINT=https://s3.example-region.invalid
MEMORIA_OFFSITE_S3_ACCESS_KEY=
MEMORIA_OFFSITE_S3_SECRET_KEY=
MEMORIA_OFFSITE_S3_BUCKET=memoria-offsite-backup
MEMORIA_BASE_BACKUP_INTERVAL_S=86400
MEMORIA_BASE_BACKUP_LOCAL_RETENTION_DAYS=3
MEMORIA_OFFSITE_SYNC_INTERVAL_S=60
MEMORIA_WAL_LOCAL_RETENTION_DAYS=7
