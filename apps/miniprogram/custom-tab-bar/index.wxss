/* Parent v4 tab bar: frosted surface, indigo active, safe-area. */
.mem-tabbar {
  display: flex;
  justify-content: space-around;
  box-sizing: border-box;
  min-height: 176rpx;
  padding: 16rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
  background: var(--mp-tabbar-bg, rgba(250, 250, 252, 0.86));
  border-top: 1rpx solid var(--mp-line, #ececf1);
  backdrop-filter: blur(24px);
  -webkit-backdrop-filter: blur(24px);
}
.mem-tab {
  display: flex;
  flex: 1;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  min-width: 112rpx;
  padding-top: 8rpx;
  color: var(--mp-ink-3, #7a7e92);
}
.mem-tab-icon {
  display: block;
  width: 48rpx;
  height: 48rpx;
}
.mem-tab-text {
  font-size: var(--mp-type-tab, 20rpx);
  font-weight: 500;
  line-height: 1.3;
}
.mem-tab-on {
  color: var(--mp-accent, #4a52c9);
  font-weight: 600;
}
.mem-tabbar-hidden {
  display: none;
}
