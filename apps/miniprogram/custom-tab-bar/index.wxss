/* Parent v4 tab bar: frosted surface, indigo active, safe-area. */
.mem-tabbar {
  display: flex;
  justify-content: space-around;
  box-sizing: border-box;
  height: calc(108rpx + env(safe-area-inset-bottom));
  padding: 16rpx 32rpx env(safe-area-inset-bottom);
  background: var(--mp-tabbar-bg, rgba(250, 250, 252, 0.86));
  box-shadow: inset 0 2rpx 0 var(--mp-hairline, rgba(22, 24, 43, 0.06));
  backdrop-filter: blur(24px);
  -webkit-backdrop-filter: blur(24px);
}
.mem-tab {
  display: flex;
  flex: 1;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  min-width: 112rpx;
  color: var(--mp-tab-ink, #8e91a3);
}
.mem-tab-icon {
  display: block;
  width: 48rpx;
  height: 48rpx;
}
.mem-tab-text {
  font-size: var(--mp-type-tab, 20rpx);
  font-weight: 500;
  line-height: 1.2;
}
.mem-tab-on {
  color: var(--mp-accent, #4a52c9);
}
.mem-tabbar-hidden {
  display: none;
}
