.mem-tabbar {
  display: flex;
  justify-content: space-around;
  box-sizing: border-box;
  height: calc(54px + env(safe-area-inset-bottom));
  padding: 8px 16px env(safe-area-inset-bottom);
  background: var(--mp-tabbar-bg, rgba(250, 250, 252, 0.86));
  box-shadow: inset 0 1px 0 var(--mp-hairline, rgba(22, 24, 43, 0.06));
  backdrop-filter: blur(24px);
  -webkit-backdrop-filter: blur(24px);
}
.mem-tab {
  display: flex;
  flex: 1;
  flex-direction: column;
  align-items: center;
  gap: 4px;
  min-width: 56px;
  color: var(--mp-tab-ink, #8e91a3);
}
.mem-tab-icon {
  display: block;
  width: 24px;
  height: 24px;
}
.mem-tab-text {
  font-size: var(--mp-type-tab, 10px);
  font-weight: 500;
  line-height: normal;
}
.mem-tab-on {
  color: var(--mp-accent, #4a52c9);
}
.mem-tabbar-hidden {
  display: none;
}
