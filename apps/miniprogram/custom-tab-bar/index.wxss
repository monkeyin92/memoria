/* Parent v3 tab bar: surface, accent active, no glass. */
.mem-tabbar {
  display: flex;
  box-sizing: border-box;
  padding: 8rpx 12rpx calc(12rpx + env(safe-area-inset-bottom));
  background: var(--mp-surface, #fffdf9);
  border-top: 1rpx solid var(--mp-line, #efe6da);
  box-shadow: none;
}
.mem-tab {
  position: relative;
  display: flex;
  flex: 1;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  min-width: 128rpx;
  padding: 10rpx 0 6rpx;
  color: var(--mp-ink-3, #a39789);
}
.mem-tab-indicator {
  position: absolute;
  top: 0;
  width: 36rpx;
  height: 8rpx;
  border-radius: 999rpx;
  background: var(--mp-accent, #e2702a);
  box-shadow: none;
}
.mem-tab-icon { width: 48rpx; height: 48rpx; }
.mem-tab-icon rich-text { width: 100%; height: 100%; display: block; }
.mem-tab-text { font-size: 22rpx; line-height: 1.3; }
.mem-tab-on { color: var(--mp-accent, #e2702a); font-weight: 600; }
.mem-tabbar-hidden { display: none; }
