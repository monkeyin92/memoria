/* Parent v4 tab bar: frosted surface, indigo active, safe-area. */
.mem-tabbar {
  display: flex;
  box-sizing: border-box;
  height: auto;
  min-height: 176rpx;
  padding: 16rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
  background: rgba(250, 250, 252, 0.86);
  border-top: 1rpx solid rgba(22, 24, 43, 0.06);
  box-shadow: none;
  backdrop-filter: blur(24px);
  -webkit-backdrop-filter: blur(24px);
}
.mem-tab {
  position: relative;
  display: flex;
  flex: 1;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
  gap: 8rpx;
  min-width: 128rpx;
  padding: 8rpx 0 0;
  color: #8e91a3;
}
.mem-tab-indicator {
  display: none;
}
.mem-tab-icon {
  width: 48rpx;
  height: 48rpx;
  color: inherit;
}
.mem-tab-icon rich-text {
  width: 100%;
  height: 100%;
  display: block;
}
.mem-tab-text {
  font-size: var(--mp-type-tab, 20rpx);
  font-weight: 500;
  line-height: 1.3;
}
.mem-tab-on {
  color: var(--mp-accent, #4a52c9);
  font-weight: 600;
}
.mem-tabbar-hidden {
  display: none;
}
