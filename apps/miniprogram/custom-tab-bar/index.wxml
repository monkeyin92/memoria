<view class="mem-tabbar mem-tabbar-{{selected}} {{selected === 3 || selected === 4 ? 'mem-tabbar-dark' : ''}}">
  <view
    class="mem-tab {{index === selected ? 'mem-tab-on' : ''}}"
    wx:for="{{tabs}}"
    wx:key="pagePath"
    wx:for-index="index"
    data-index="{{index}}"
    bindtap="onTapTab"
  >
    <view class="mem-tab-indicator" wx:if="{{index === selected}}"></view>
    <view class="mem-tab-icon"><rich-text nodes="{{item.icon}}"></rich-text></view>
    <text class="mem-tab-text">{{item.text}}</text>
  </view>
</view>
