<view class="mem-tabbar {{hidden ? 'mem-tabbar-hidden' : ''}}">
  <view
    class="mem-tab {{index === selected ? 'mem-tab-on' : ''}}"
    wx:for="{{tabs}}"
    wx:key="pagePath"
    wx:for-index="index"
    data-index="{{index}}"
    bindtap="onTapTab"
  >
    <image class="mem-tab-icon" src="{{index === selected ? item.iconOn : item.icon}}" mode="aspectFit"></image>
    <text class="mem-tab-text">{{item.text}}</text>
  </view>
</view>
