/* ============================================================
   Memoria parent UI v4 tokens (docs/design/app-v4).
   One indigo accent, light grey bg, white cards, 8pt grid, layered shadows.
   Lengths are the design's px, not rpx, so the 390 pt frame renders 1:1 like an iOS
   layout instead of scaling with screen width. Page styles use these tokens only.
   ============================================================ */
page {
  --mp-bg: #f4f4f7;
  --mp-surface: #ffffff;
  --mp-accent: #4a52c9;
  --mp-accent-soft: #eeeffc;
  --mp-on-accent: #ffffff;
  --mp-rust: #9a4732;
  --mp-rust-bg: #fbeee9;
  --mp-rust-ink: #8a5848;
  --mp-rust-tile: #f5dcd3;
  --mp-sage: #23805f;
  --mp-sage-bg: #e7f4ee;
  --mp-sun: #7f5a00;
  --mp-sun-bg: #fbf1d6;
  --mp-ink: #16182b;
  --mp-ink-2: #5b5f73;
  --mp-ink-3: #7a7e92;
  --mp-ink-4: #b4b6c4;
  --mp-line: #ececf1;
  --mp-fill: #f4f4f8;
  --mp-track: #ececf2;
  --mp-scrim: rgba(22, 24, 43, 0.42);
  --mp-tabbar-bg: rgba(250, 250, 252, 0.86);
  --mp-tab-ink: #8e91a3;
  --mp-hairline: rgba(22, 24, 43, 0.06);
  --mp-radius-card: 24px;
  --mp-radius-card-xl: 32px;
  --mp-radius-inset: 16px;
  --mp-radius-icon: 12px;
  --mp-radius-sheet: 32px;
  --mp-radius-pill: 499.5px;
  --mp-pad-page: 24px;
  --mp-gap-card: 16px;
  --mp-pad-card: 16px;
  --mp-pad-card-lg: 24px;
  --mp-tap: 56px;
  --mp-icon: 40px;
  --mp-tab-clearance: calc(88px + 24px + env(safe-area-inset-bottom));
  --mp-page-foot: calc(32px + env(safe-area-inset-bottom));
  --mp-shadow-card: 0 1px 2px rgba(22, 24, 43, 0.04),
    0 8px 24px -8px rgba(22, 24, 43, 0.08),
    0 24px 48px -24px rgba(22, 24, 43, 0.1);
  --mp-shadow-float: 0 2px 8px rgba(22, 24, 43, 0.08);
  --mp-shadow-selected: 0 0 0 2px var(--mp-accent), 0 8px 24px -8px rgba(74, 82, 201, 0.25);
  --mp-type-num-xl: 40px;
  --mp-type-display: 32px;
  --mp-type-headline: 24px;
  --mp-type-title: 20px;
  --mp-type-button: 17px;
  --mp-type-lead: 18px;
  --mp-type-card: 16px;
  --mp-type-body: 15px;
  --mp-type-caption: 13px;
  --mp-type-meta: 12px;
  --mp-type-tab: 10px;
  --mp-lh-display: 40px;
  --mp-lh-card: 24px;
  --mp-lh-body: 24px;
  --mp-lh-caption: 20px;
  --mp-dur: 200ms;
  min-height: 100%;
  color: var(--mp-ink);
  background: var(--mp-bg);
  /* Inter and Noto Sans CJK SC are the design's stand-ins for SF and PingFang; phones with PingFang or HarmonyOS Sans never reach them. */
  font-family: "PingFang SC", "HarmonyOS Sans SC", "Inter", "Noto Sans CJK SC", "Source Han Sans SC", "Noto Sans SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
  font-size: var(--mp-type-body);
  line-height: 1.6;
  font-feature-settings: "tnum";
}

button::after { border: none; }
button { font-family: inherit; }

/* ---------- 页面骨架 ---------- */
.page-shell {
  position: relative;
  box-sizing: border-box;
  min-height: 100vh;
  padding: 12px var(--mp-pad-page) var(--mp-page-foot);
  background: var(--mp-bg);
  color: var(--mp-ink);
}
.page-shell.tab-page {
  padding-top: calc(var(--mp-status-bar, 20px) + 16px);
  padding-bottom: var(--mp-tab-clearance);
}
.eyebrow {
  display: block;
  color: var(--mp-ink-3);
  font-size: var(--mp-type-caption);
  font-weight: 600;
  letter-spacing: 0.2px;
}
.page-title {
  display: block;
  margin: 4px 0 0;
  color: var(--mp-ink);
  font-size: var(--mp-type-display);
  font-weight: 800;
  letter-spacing: -0.6px;
  line-height: var(--mp-lh-display);
}
.page-lede,
.page-subtitle {
  display: block;
  margin: 8px 0 0;
  color: var(--mp-ink-2);
  font-size: var(--mp-type-body);
  line-height: var(--mp-lh-body);
}
.caption {
  display: block;
  margin-top: 12px;
  color: var(--mp-ink-3);
  font-size: var(--mp-type-meta);
  line-height: var(--mp-lh-caption);
}
.nav-back {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 40px;
  height: 40px;
  margin: 4px 0 8px;
  border-radius: 50%;
  background: var(--mp-surface);
  box-shadow: var(--mp-shadow-float);
  color: var(--mp-ink);
  font-size: var(--mp-type-title);
}
.nav-back-icon {
  width: 24px;
  height: 24px;
}
/* The capsule spans status bar +4px to +36px, so a 40px back button starting at the status bar edge shares its centre line. */
.page-shell.sub-page,
.trial-page.sub-page {
  padding-top: var(--mp-status-bar, 20px);
}
.sub-page > .nav-back {
  margin: 0 0 8px;
}

/* ---------- 卡片 ---------- */
.l2-card,
.card,
.list,
.timeline-card,
.choice-card {
  box-sizing: border-box;
  background: var(--mp-surface);
  border: none;
  border-radius: var(--mp-radius-card);
  box-shadow: var(--mp-shadow-card);
}
.l2-card,
.card {
  margin-top: var(--mp-gap-card);
  padding: var(--mp-pad-card);
}
.card-xl { border-radius: var(--mp-radius-card-xl); padding: var(--mp-pad-card-lg); }
.l2-card-title {
  display: block;
  color: var(--mp-ink);
  font-size: var(--mp-type-card);
  font-weight: 600;
  line-height: var(--mp-lh-card);
}
.l2-card-sub {
  display: block;
  margin-top: 4px;
  color: var(--mp-ink-2);
  font-size: var(--mp-type-caption);
  line-height: var(--mp-lh-caption);
}
.card-lead {
  display: flex;
  align-items: center;
  gap: 12px;
  margin-bottom: 8px;
}
.card-lead .l2-card-title { flex: 1; min-width: 0; }

/* ---------- 角色卡（角色页与绑定页共用） ---------- */
.role-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--mp-gap-card);
  margin-top: 24px;
}
.role-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  box-sizing: border-box;
  min-width: 0;
  padding: 8px 8px 16px;
  border-radius: var(--mp-radius-card);
  background: var(--mp-surface);
  box-shadow: var(--mp-shadow-card);
  text-align: center;
  transition: box-shadow var(--mp-dur);
}
.role-card-on { box-shadow: var(--mp-shadow-selected); }
.role-art {
  display: flex;
  justify-content: center;
  width: 100%;
  height: 96px;
  overflow: hidden;
  border-radius: var(--mp-radius-inset);
  background: var(--mp-fill);
}
.role-card-on .role-art { background: var(--mp-accent-soft); }
.role-fig { margin-top: 8px; }
.role-name {
  display: block;
  margin-top: 8px;
  color: var(--mp-ink);
  font-size: var(--mp-type-body);
  font-weight: 600;
  line-height: var(--mp-lh-body);
}
.role-tagline {
  display: block;
  margin-top: 4px;
  padding: 0 4px;
  color: var(--mp-ink-2);
  font-size: var(--mp-type-meta);
  line-height: 16px;
}
.role-chip { margin-top: 8px; }
.role-play { flex-shrink: 0; min-height: 32px; }

/* ---------- 按钮 ---------- */
.primary-button,
.secondary-button,
.danger-button {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  width: 100%;
  min-height: var(--mp-tap);
  margin: 0;
  padding: 8px 16px;
  border-radius: var(--mp-radius-inset);
  font-size: var(--mp-type-button);
  font-weight: 600;
  line-height: 1.4;
  text-align: center;
  transition: transform var(--mp-dur), opacity var(--mp-dur);
}
.primary-button {
  color: var(--mp-on-accent);
  background: var(--mp-ink);
}
.primary-button:active,
.secondary-button:active { transform: scale(0.98); opacity: 0.9; }
.secondary-button {
  color: var(--mp-ink);
  background: var(--mp-surface);
  box-shadow: var(--mp-shadow-card);
}
.l2-card .secondary-button,
.card .secondary-button {
  background: var(--mp-fill);
  box-shadow: none;
}
.danger-button {
  color: var(--mp-rust);
  background: var(--mp-surface);
  border: 1px solid var(--mp-line);
}
button[disabled] {
  color: var(--mp-ink-3) !important;
  background: var(--mp-fill) !important;
  box-shadow: none !important;
}
.text-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 44px;
  margin: 0;
  padding: 6px 0;
  color: var(--mp-accent);
  font-size: var(--mp-type-body);
  font-weight: 600;
  background: transparent;
}
.btn-sm {
  width: auto;
  min-height: 36px;
  padding: 4px 16px;
  font-size: var(--mp-type-caption);
  border-radius: var(--mp-radius-pill);
}
.button-row { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 16px; }
.button-row button { flex: 1 1 120px; min-width: 0; }

/* ---------- inset-grouped 列表 ---------- */
.list {
  margin-top: var(--mp-gap-card);
  padding: 0 var(--mp-pad-card);
  overflow: hidden;
}
.list-row {
  display: flex;
  align-items: center;
  gap: 16px;
  box-sizing: border-box;
  min-height: 64px;
  padding: 16px 0;
  border-bottom: 1px solid var(--mp-line);
}
.list > .list-row {
  margin: 0 calc(-1 * var(--mp-pad-card));
  padding-left: var(--mp-pad-card);
  padding-right: var(--mp-pad-card);
}
.list-row:last-child { border-bottom: none; }
.row-copy { flex: 1; min-width: 0; }
.row-title,
.row-copy .row-title {
  display: block;
  color: var(--mp-ink);
  font-size: var(--mp-type-body);
  font-weight: 600;
  line-height: var(--mp-lh-body);
}
.row-meta {
  display: block;
  margin-top: 2px;
  color: var(--mp-ink-2);
  font-size: var(--mp-type-caption);
  line-height: var(--mp-lh-caption);
}
.row-chev { flex-shrink: 0; width: 18px; height: 18px; }
.row-chev-fold { transition: transform var(--mp-dur); }
.row-chev-open { transform: rotate(90deg); }
.row-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: var(--mp-icon);
  height: var(--mp-icon);
  border-radius: var(--mp-radius-icon);
  background: var(--mp-fill);
  color: var(--mp-ink-2);
}
.group-label {
  display: block;
  margin: 24px 4px 8px;
  color: var(--mp-ink-3);
  font-size: var(--mp-type-caption);
  font-weight: 600;
}

/* ---------- 胶囊标签 ---------- */
.pill {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  min-height: 24px;
  padding: 0 12px;
  border-radius: var(--mp-radius-pill);
  background: var(--mp-sage-bg);
  color: var(--mp-sage);
  font-size: var(--mp-type-meta);
  font-weight: 600;
  line-height: 1.4;
  white-space: nowrap;
}
.pill-online::before {
  content: "";
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: currentColor;
}
.pill-neutral { background: var(--mp-fill); color: var(--mp-ink-2); }
.pill-amber,
.pill-draft { background: var(--mp-sun-bg); color: var(--mp-sun); }
.pill-teal { background: var(--mp-accent-soft); color: var(--mp-accent); }

/* ---------- 提示条 / 空状态 ---------- */
.notice {
  display: flex;
  flex-direction: column;
  gap: 4px;
  margin-top: var(--mp-gap-card);
  padding: var(--mp-pad-card);
  border-radius: var(--mp-radius-card);
  background: var(--mp-accent-soft);
  color: var(--mp-accent);
  font-size: var(--mp-type-caption);
  line-height: var(--mp-lh-caption);
}
.notice-warn { background: var(--mp-rust-bg); color: var(--mp-rust); }
.notice-title { display: block; font-size: var(--mp-type-card); font-weight: 600; }
.notice-copy { display: block; font-size: var(--mp-type-caption); line-height: var(--mp-lh-caption); }
.empty-block { padding: 32px 16px; text-align: center; }
.empty-title {
  display: block;
  color: var(--mp-ink);
  font-size: var(--mp-type-title);
  font-weight: 700;
  line-height: 1.4;
}
.empty-copy,
.loading-text {
  display: block;
  margin: 8px auto 0;
  max-width: 280px;
  color: var(--mp-ink-2);
  font-size: var(--mp-type-caption);
  line-height: var(--mp-lh-caption);
}
.empty-button { margin-top: 16px; }
.error-text {
  display: block;
  margin: 8px 0 0;
  color: var(--mp-rust);
  font-size: var(--mp-type-caption);
  line-height: var(--mp-lh-caption);
}

/* ---------- 表单 ---------- */
.field-label {
  display: block;
  margin: 16px 0 8px;
  color: var(--mp-ink);
  font-size: var(--mp-type-caption);
  font-weight: 600;
}
.field-input,
.field-textarea {
  box-sizing: border-box;
  width: 100%;
  min-height: 48px;
  padding: 12px 14px;
  border: 1px solid var(--mp-line);
  border-radius: var(--mp-radius-inset);
  background: var(--mp-fill);
  color: var(--mp-ink);
  font-size: var(--mp-type-body);
}
.field-placeholder { color: var(--mp-ink-3); }
.picker-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  box-sizing: border-box;
  min-height: 48px;
  padding: 0 14px;
  border: 1px solid var(--mp-line);
  border-radius: var(--mp-radius-inset);
  background: var(--mp-fill);
}
.picker-label { flex: 1; min-width: 0; color: var(--mp-ink); font-size: var(--mp-type-body); }
.picker-value { flex: 1; min-width: 0; color: var(--mp-ink); font-size: var(--mp-type-body); }
.picker-label + .picker-value { flex: none; max-width: 60%; color: var(--mp-accent); text-align: right; }
.setting-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  min-height: var(--mp-tap);
  padding: 8px 0;
}
.setting-name { display: block; font-size: var(--mp-type-body); font-weight: 600; }
.setting-desc {
  display: block;
  margin-top: 2px;
  color: var(--mp-ink-2);
  font-size: var(--mp-type-caption);
  line-height: var(--mp-lh-caption);
}
.choice-card {
  display: flex;
  align-items: center;
  gap: 12px;
  min-height: 64px;
  margin-top: 8px;
  padding: 12px 16px;
}
.choice-card-on { box-shadow: var(--mp-shadow-selected) !important; }
.choice-radio {
  flex-shrink: 0;
  box-sizing: border-box;
  width: 20px;
  height: 20px;
  border: 2px solid var(--mp-line);
  border-radius: 50%;
}
.choice-card-on .choice-radio {
  border-color: var(--mp-accent);
  background: var(--mp-accent);
  box-shadow: inset 0 0 0 4px var(--mp-surface);
}

/* ---------- 区块 ---------- */
.foot-link { margin-top: 12px; color: var(--mp-ink-2); font-size: var(--mp-type-caption); background: transparent; }
.privacy-note {
  display: block;
  margin: 24px auto 0;
  max-width: 300px;
  color: var(--mp-ink-3);
  font-size: var(--mp-type-meta);
  line-height: var(--mp-lh-caption);
  text-align: center;
}
.section-head { display: flex; align-items: center; justify-content: space-between; gap: 8px; margin: 32px 2px 12px; }
.section-head-title { color: var(--mp-ink); font-size: var(--mp-type-title); font-weight: 700; letter-spacing: -0.3px; }
.section-title { display: block; margin: 32px 0 16px; color: var(--mp-ink); font-size: var(--mp-type-title); font-weight: 700; letter-spacing: -0.3px; line-height: 28px; }
.section-link { padding: 6px 0; color: var(--mp-accent); font-size: var(--mp-type-caption); font-weight: 600; }
.summary-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 12px;
  padding: 10px 0;
  border-bottom: 0.5px solid var(--mp-line);
}
.summary-key { flex: 0 0 auto; color: var(--mp-ink-2); font-size: var(--mp-type-caption); }
.summary-value {
  min-width: 0;
  color: var(--mp-ink);
  font-size: var(--mp-type-caption);
  font-weight: 600;
  text-align: right;
  word-break: break-all;
}
.fold { margin-top: 16px; padding-top: 4px; border-top: 0.5px solid var(--mp-line); }
.fold-summary { display: block; padding: 12px 0; color: var(--mp-ink-2); font-size: var(--mp-type-caption); }
.diagnostic { padding-bottom: 12px; color: var(--mp-ink-2); font-size: var(--mp-type-meta); line-height: var(--mp-lh-caption); }

/* ---------- 分段器 ---------- */
.seg {
  display: flex;
  padding: 4px;
  border-radius: var(--mp-radius-inset);
  background: var(--mp-surface);
  box-shadow: var(--mp-shadow-card);
}
.seg-item {
  flex: 1;
  padding: 8px 0;
  border-radius: var(--mp-radius-icon);
  color: var(--mp-ink-2);
  font-size: var(--mp-type-caption);
  font-weight: 500;
  text-align: center;
}
.seg-item-on { color: var(--mp-on-accent); font-weight: 600; background: var(--mp-accent); }

/* ---------- 时间线 ---------- */
.timeline-card {
  display: flex;
  gap: 12px;
  margin-top: var(--mp-gap-card);
  padding: var(--mp-pad-card) var(--mp-pad-card-lg);
}
.timeline-dot { flex-shrink: 0; width: 6px; height: 6px; margin-top: 9px; border-radius: 50%; background: var(--mp-accent); }
.timeline-time { display: block; color: var(--mp-ink-3); font-size: var(--mp-type-meta); }

/* ---------- 进度条 ---------- */
.progress-track { height: 8px; border-radius: var(--mp-radius-pill); background: var(--mp-track); overflow: hidden; }
.progress-fill { height: 100%; border-radius: var(--mp-radius-pill); background: var(--mp-accent); }

/* ---------- 底部抽屉 / 弹窗 ---------- */
.sheet-mask,
.mp-sheet-mask {
  position: fixed;
  left: 0; right: 0; top: 0; bottom: 0;
  z-index: 100;
  background: var(--mp-scrim);
}
.sheet,
.mp-sheet {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  z-index: 101;
  box-sizing: border-box;
  max-height: 86vh;
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
  padding: 8px 20px calc(20px + env(safe-area-inset-bottom));
  border-radius: var(--mp-radius-sheet) var(--mp-radius-sheet) 0 0;
  background: var(--mp-surface);
  box-shadow: var(--mp-shadow-card);
}
.sheet-grab,
.mp-sheet-grab { width: 36px; height: 4px; margin: 4px auto 14px; border-radius: var(--mp-radius-pill); background: var(--mp-line); }
.sheet-title,
.mp-sheet-title {
  display: block;
  margin-bottom: 8px;
  color: var(--mp-ink);
  font-size: var(--mp-type-title);
  font-weight: 700;
  line-height: 1.3;
}
.sheet-sub { display: block; margin: 0 0 12px; color: var(--mp-ink-2); font-size: var(--mp-type-caption); line-height: var(--mp-lh-caption); }
.modal-wrap {
  position: fixed;
  left: 0; right: 0; top: 0; bottom: 0;
  z-index: 102;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 var(--mp-pad-page);
  background: var(--mp-scrim);
}
.modal-card {
  box-sizing: border-box;
  width: 100%;
  max-height: 86vh;
  overflow-y: auto;
  padding: var(--mp-pad-card-lg) var(--mp-pad-card-lg) var(--mp-pad-card);
  border-radius: var(--mp-radius-card-xl);
  background: var(--mp-surface);
  box-shadow: var(--mp-shadow-card);
}
.modal-title { display: block; font-size: var(--mp-type-title); font-weight: 700; text-align: center; }
.modal-desc { display: block; margin-top: 8px; color: var(--mp-ink-2); font-size: var(--mp-type-body); line-height: var(--mp-lh-body); text-align: center; }

/* ---------- 步骤点 ---------- */
.dots { display: flex; align-items: center; justify-content: center; gap: 6px; margin: 12px 0; }
.dot { width: 8px; height: 8px; border-radius: 50%; background: var(--mp-line); }
.dot-done { background: var(--mp-accent-soft); }
.dot-now { width: 20px; border-radius: var(--mp-radius-pill); background: var(--mp-accent); }

/* ---------- 图标 ---------- */
.inline-icon { display: inline-flex; align-items: center; justify-content: center; width: 24px; height: 24px; }
/* WXML 不渲染内联 <svg>：勾和折叠箭头用边框绘制，颜色跟随 currentColor */
.icon-check { display: block; box-sizing: border-box; width: 7px; height: 12px; border-right: 2px solid currentColor; border-bottom: 2px solid currentColor; border-radius: 0.5px; transform: translateY(-1.5px) rotate(45deg); }
.icon-chevron { display: block; box-sizing: border-box; width: 8px; height: 8px; border-right: 1.5px solid currentColor; border-bottom: 1.5px solid currentColor; border-radius: 0.5px; transform: translateY(-2px) rotate(45deg); }
.danger-link { padding: 6px 0; color: var(--mp-rust); font-size: var(--mp-type-caption); background: transparent; }
button.danger-link { width: auto; margin: 0; padding: 6px 12px; line-height: 1.6; }
