page {
  min-height: 100%;
  color: #19223d;
  background:
    radial-gradient(circle at 88% 2%, rgba(150, 185, 255, 0.22), transparent 32%),
    linear-gradient(180deg, #f9fbff 0%, #f3f6ff 100%);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
}

button::after {
  border: none;
}

.page-shell {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 32rpx 28rpx 48rpx;
}

.eyebrow {
  margin: 0 0 10rpx;
  color: #647299;
  font-size: 24rpx;
  letter-spacing: 1rpx;
}

.page-title {
  margin: 0;
  color: #17213c;
  font-size: 48rpx;
  font-weight: 700;
  line-height: 1.2;
}

.page-subtitle {
  margin: 14rpx 0 0;
  color: #71809d;
  font-size: 28rpx;
  line-height: 1.6;
}

.card {
  box-sizing: border-box;
  margin-top: 24rpx;
  padding: 28rpx;
  border: 1rpx solid rgba(158, 176, 221, 0.32);
  border-radius: 30rpx;
  background: rgba(255, 255, 255, 0.9);
  box-shadow: 0 16rpx 42rpx rgba(67, 87, 142, 0.08);
}

.primary-button,
.secondary-button,
.danger-button {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 86rpx;
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: 600;
}

.primary-button {
  color: #fff;
  background: linear-gradient(135deg, #506de1 0%, #7d63d7 100%);
  box-shadow: 0 14rpx 26rpx rgba(77, 98, 211, 0.26);
}

.secondary-button {
  color: #4c61bb;
  background: #edf1ff;
}

.danger-button {
  color: #be4456;
  background: #fff0f2;
}

.button-row {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}

.button-row button {
  flex: 1;
}

.empty-state {
  padding: 52rpx 20rpx;
  color: #7c88a1;
  text-align: center;
  font-size: 28rpx;
  line-height: 1.7;
}

.error-text {
  margin: 18rpx 0 0;
  color: #ba4255;
  font-size: 26rpx;
  line-height: 1.5;
}
