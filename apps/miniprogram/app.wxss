/* ============================================================
   Memoria parent UI v4 tokens (docs/design/app-v4).
   One indigo accent, light grey bg, white cards, 8pt grid, layered shadows.
   px in design notes → rpx ×2. Page styles use these tokens only.
   ============================================================ */
page {
  --mp-bg: #f4f4f7;
  --mp-surface: #ffffff;
  --mp-accent: #4a52c9;
  --mp-accent-soft: #eeeffc;
  --mp-on-accent: #ffffff;
  --mp-rust: #9a4732;
  --mp-rust-bg: #fbeee9;
  --mp-rust-ink: #8a5848;
  --mp-rust-tile: #f5dcd3;
  --mp-sage: #23805f;
  --mp-sage-bg: #e7f4ee;
  --mp-sun: #7f5a00;
  --mp-sun-bg: #fbf1d6;
  --mp-ink: #16182b;
  --mp-ink-2: #5b5f73;
  --mp-ink-3: #7a7e92;
  --mp-ink-4: #b4b6c4;
  --mp-line: #ececf1;
  --mp-fill: #f4f4f8;
  --mp-track: #ececf2;
  --mp-scrim: rgba(22, 24, 43, 0.42);
  --mp-tabbar-bg: rgba(250, 250, 252, 0.86);
  --mp-radius-card: 48rpx;
  --mp-radius-card-xl: 64rpx;
  --mp-radius-inset: 32rpx;
  --mp-radius-icon: 24rpx;
  --mp-radius-sheet: 64rpx;
  --mp-radius-pill: 999rpx;
  --mp-pad-page: 48rpx;
  --mp-gap-card: 32rpx;
  --mp-pad-card: 32rpx;
  --mp-pad-card-lg: 48rpx;
  --mp-tap: 112rpx;
  --mp-icon: 80rpx;
  --mp-tab-clearance: calc(176rpx + 48rpx + env(safe-area-inset-bottom));
  --mp-page-foot: calc(64rpx + env(safe-area-inset-bottom));
  --mp-shadow-card: 0 2rpx 4rpx rgba(22, 24, 43, 0.04),
    0 16rpx 48rpx -16rpx rgba(22, 24, 43, 0.08),
    0 48rpx 96rpx -48rpx rgba(22, 24, 43, 0.1);
  --mp-shadow-float: 0 4rpx 16rpx rgba(22, 24, 43, 0.08);
  --mp-shadow-selected: 0 0 0 4rpx var(--mp-accent), 0 16rpx 48rpx -16rpx rgba(74, 82, 201, 0.25);
  --mp-type-num-xl: 80rpx;
  --mp-type-display: 64rpx;
  --mp-type-headline: 48rpx;
  --mp-type-title: 40rpx;
  --mp-type-button: 34rpx;
  --mp-type-card: 32rpx;
  --mp-type-body: 30rpx;
  --mp-type-caption: 26rpx;
  --mp-type-meta: 24rpx;
  --mp-type-tab: 20rpx;
  --mp-lh-display: 80rpx;
  --mp-lh-card: 48rpx;
  --mp-lh-body: 48rpx;
  --mp-lh-caption: 40rpx;
  --mp-dur: 200ms;
  min-height: 100%;
  color: var(--mp-ink);
  background: var(--mp-bg);
  font-family: "PingFang SC", "HarmonyOS Sans SC", "Source Han Sans SC", "Noto Sans SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
  font-size: var(--mp-type-body);
  line-height: 1.6;
  font-feature-settings: "tnum";
}

button::after { border: none; }
button { font-family: inherit; }

/* ---------- 页面骨架 ---------- */
.page-shell {
  position: relative;
  box-sizing: border-box;
  min-height: 100vh;
  padding: 24rpx var(--mp-pad-page) var(--mp-page-foot);
  background: var(--mp-bg);
  color: var(--mp-ink);
}
.page-shell.tab-page { padding-bottom: var(--mp-tab-clearance); }
.eyebrow {
  display: block;
  margin-top: 16rpx;
  color: var(--mp-ink-3);
  font-size: var(--mp-type-caption);
  font-weight: 600;
  letter-spacing: 0.4rpx;
}
.page-title {
  display: block;
  margin: 8rpx 0 0;
  color: var(--mp-ink);
  font-size: var(--mp-type-display);
  font-weight: 800;
  letter-spacing: -1.2rpx;
  line-height: var(--mp-lh-display);
}
.page-lede,
.page-subtitle {
  display: block;
  margin: 16rpx 0 0;
  color: var(--mp-ink-2);
  font-size: var(--mp-type-body);
  line-height: var(--mp-lh-body);
}
.caption {
  display: block;
  margin-top: 24rpx;
  color: var(--mp-ink-3);
  font-size: var(--mp-type-meta);
  line-height: var(--mp-lh-caption);
}
.nav-back {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 80rpx;
  height: 80rpx;
  margin: 8rpx 0 16rpx;
  border-radius: 50%;
  background: var(--mp-surface);
  box-shadow: var(--mp-shadow-float);
  color: var(--mp-ink);
  font-size: var(--mp-type-title);
}

/* ---------- 卡片 ---------- */
.l2-card,
.card,
.list,
.timeline-card,
.choice-card {
  box-sizing: border-box;
  background: var(--mp-surface);
  border: none;
  border-radius: var(--mp-radius-card);
  box-shadow: var(--mp-shadow-card);
}
.l2-card,
.card {
  margin-top: var(--mp-gap-card);
  padding: var(--mp-pad-card);
}
.card-xl { border-radius: var(--mp-radius-card-xl); padding: var(--mp-pad-card-lg); }
.l2-card-title {
  display: block;
  color: var(--mp-ink);
  font-size: var(--mp-type-card);
  font-weight: 600;
  line-height: var(--mp-lh-card);
}
.l2-card-sub {
  display: block;
  margin-top: 8rpx;
  color: var(--mp-ink-2);
  font-size: var(--mp-type-caption);
  line-height: var(--mp-lh-caption);
}
.card-lead {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-bottom: 16rpx;
}
.card-lead .l2-card-title { flex: 1; min-width: 0; }

/* 品牌 hero：认证与守护入口用的深色卡，色值全部来自 token */
.mem-hero {
  position: relative;
  box-sizing: border-box;
  overflow: hidden;
  padding: var(--mp-pad-card-lg);
  border-radius: var(--mp-radius-card-xl);
  background: var(--mp-ink);
  color: var(--mp-on-accent);
  box-shadow: var(--mp-shadow-card);
}
.mem-hero-eyebrow {
  display: block;
  color: var(--mp-ink-4);
  font-size: var(--mp-type-meta);
  font-weight: 600;
}
.mem-hero-title {
  display: block;
  margin-top: 16rpx;
  font-size: var(--mp-type-headline);
  font-weight: 800;
  letter-spacing: -0.8rpx;
  line-height: 1.3;
}
.mem-hero-sub {
  display: block;
  margin-top: 16rpx;
  color: var(--mp-ink-4);
  font-size: var(--mp-type-caption);
  line-height: var(--mp-lh-caption);
}
.mem-hero-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  margin-top: 8rpx;
}
.mem-hero .pill { background: var(--mp-sage-bg); color: var(--mp-sage); }
.mem-hero .pill-amber { background: var(--mp-sun-bg); color: var(--mp-sun); }

.role-tint-card {
  box-sizing: border-box;
  padding: var(--mp-pad-card-lg);
  border-radius: var(--mp-radius-card-xl);
  background: var(--mp-accent-soft);
  box-shadow: none;
}

/* ---------- 按钮 ---------- */
.primary-button,
.secondary-button,
.danger-button {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  width: 100%;
  min-height: var(--mp-tap);
  margin: 0;
  padding: 16rpx 32rpx;
  border-radius: var(--mp-radius-inset);
  font-size: var(--mp-type-button);
  font-weight: 600;
  line-height: 1.4;
  text-align: center;
  transition: transform var(--mp-dur), opacity var(--mp-dur);
}
.primary-button {
  color: var(--mp-on-accent);
  background: var(--mp-ink);
}
.primary-button:active,
.secondary-button:active { transform: scale(0.98); opacity: 0.9; }
.secondary-button {
  color: var(--mp-ink);
  background: var(--mp-surface);
  box-shadow: var(--mp-shadow-card);
}
.danger-button {
  color: var(--mp-rust);
  background: var(--mp-surface);
  border: 2rpx solid var(--mp-line);
}
button[disabled] {
  color: var(--mp-ink-3) !important;
  background: var(--mp-fill) !important;
  box-shadow: none !important;
}
.text-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  margin: 0;
  padding: 12rpx 0;
  color: var(--mp-accent);
  font-size: var(--mp-type-body);
  font-weight: 600;
  background: transparent;
}
.btn-sm {
  width: auto;
  min-height: 72rpx;
  padding: 8rpx 32rpx;
  font-size: var(--mp-type-caption);
  border-radius: var(--mp-radius-pill);
}
.button-row { display: flex; flex-wrap: wrap; gap: 24rpx; margin-top: 32rpx; }
.button-row button { flex: 1 1 240rpx; min-width: 0; }

/* ---------- inset-grouped 列表 ---------- */
.list {
  margin-top: var(--mp-gap-card);
  padding: 0 var(--mp-pad-card);
  overflow: hidden;
}
.list-row {
  display: flex;
  align-items: center;
  gap: 32rpx;
  min-height: 128rpx;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--mp-line);
}
.list-row:last-child { border-bottom: none; }
.row-copy { flex: 1; min-width: 0; }
.row-title,
.row-copy .row-title {
  display: block;
  color: var(--mp-ink);
  font-size: var(--mp-type-body);
  font-weight: 600;
  line-height: var(--mp-lh-body);
}
.row-meta {
  display: block;
  margin-top: 4rpx;
  color: var(--mp-ink-2);
  font-size: var(--mp-type-caption);
  line-height: var(--mp-lh-caption);
}
.row-chevron { flex-shrink: 0; color: var(--mp-ink-4); font-size: var(--mp-type-title); line-height: 1; }
.row-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: var(--mp-icon);
  height: var(--mp-icon);
  border-radius: var(--mp-radius-icon);
  background: var(--mp-fill);
  color: var(--mp-ink-2);
}
.group-label {
  display: block;
  margin: 48rpx 8rpx 16rpx;
  color: var(--mp-ink-3);
  font-size: var(--mp-type-caption);
  font-weight: 600;
}

/* ---------- 胶囊标签 ---------- */
.pill {
  display: inline-flex;
  align-items: center;
  gap: 12rpx;
  min-height: 48rpx;
  padding: 0 24rpx;
  border-radius: var(--mp-radius-pill);
  background: var(--mp-sage-bg);
  color: var(--mp-sage);
  font-size: var(--mp-type-meta);
  font-weight: 600;
  line-height: 1.4;
  white-space: nowrap;
}
.pill-online::before {
  content: "";
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: currentColor;
}
.pill-neutral { background: var(--mp-fill); color: var(--mp-ink-2); }
.pill-amber { background: var(--mp-sun-bg); color: var(--mp-sun); }
.pill-teal { background: var(--mp-accent-soft); color: var(--mp-accent); }

/* ---------- 提示条 / 空状态 ---------- */
.notice {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  margin-top: var(--mp-gap-card);
  padding: var(--mp-pad-card);
  border-radius: var(--mp-radius-card);
  background: var(--mp-accent-soft);
  color: var(--mp-accent);
  font-size: var(--mp-type-caption);
  line-height: var(--mp-lh-caption);
}
.notice-warn { background: var(--mp-rust-bg); color: var(--mp-rust); }
.notice-title { display: block; font-size: var(--mp-type-card); font-weight: 600; }
.empty-block { padding: 64rpx 32rpx; text-align: center; }
.empty-title {
  display: block;
  color: var(--mp-ink);
  font-size: var(--mp-type-title);
  font-weight: 700;
  line-height: 1.4;
}
.empty-copy,
.loading-text {
  display: block;
  margin: 16rpx auto 0;
  max-width: 560rpx;
  color: var(--mp-ink-2);
  font-size: var(--mp-type-caption);
  line-height: var(--mp-lh-caption);
}
.empty-button { margin-top: 32rpx; }
.error-text {
  display: block;
  margin: 16rpx 0 0;
  color: var(--mp-rust);
  font-size: var(--mp-type-caption);
  line-height: var(--mp-lh-caption);
}

/* ---------- 表单 ---------- */
.field-label {
  display: block;
  margin: 32rpx 0 16rpx;
  color: var(--mp-ink);
  font-size: var(--mp-type-caption);
  font-weight: 600;
}
.field-input,
.field-textarea {
  box-sizing: border-box;
  width: 100%;
  min-height: 96rpx;
  padding: 24rpx 28rpx;
  border: 2rpx solid var(--mp-line);
  border-radius: var(--mp-radius-inset);
  background: var(--mp-fill);
  color: var(--mp-ink);
  font-size: var(--mp-type-body);
}
.field-placeholder { color: var(--mp-ink-3); }
.setting-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  min-height: var(--mp-tap);
  padding: 16rpx 0;
}
.setting-name { display: block; font-size: var(--mp-type-body); font-weight: 600; }
.setting-desc {
  display: block;
  margin-top: 4rpx;
  color: var(--mp-ink-2);
  font-size: var(--mp-type-caption);
  line-height: var(--mp-lh-caption);
}
.choice-card {
  display: flex;
  align-items: center;
  gap: 24rpx;
  min-height: 128rpx;
  margin-top: 16rpx;
  padding: 24rpx 32rpx;
}
.choice-card-on { box-shadow: var(--mp-shadow-selected) !important; }
.choice-radio {
  flex-shrink: 0;
  box-sizing: border-box;
  width: 40rpx;
  height: 40rpx;
  border: 4rpx solid var(--mp-line);
  border-radius: 50%;
}
.choice-card-on .choice-radio {
  border-color: var(--mp-accent);
  background: var(--mp-accent);
  box-shadow: inset 0 0 0 8rpx var(--mp-surface);
}

/* ---------- 区块 ---------- */
.foot-link { margin-top: 24rpx; color: var(--mp-ink-2); font-size: var(--mp-type-caption); background: transparent; }
.privacy-note {
  display: block;
  margin: 48rpx auto 0;
  max-width: 600rpx;
  color: var(--mp-ink-3);
  font-size: var(--mp-type-meta);
  line-height: var(--mp-lh-caption);
  text-align: center;
}
.section-head { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; margin: 64rpx 4rpx 24rpx; }
.section-head-title { color: var(--mp-ink); font-size: var(--mp-type-title); font-weight: 700; letter-spacing: -0.6rpx; }
.section-link { padding: 12rpx 0; color: var(--mp-accent); font-size: var(--mp-type-caption); font-weight: 600; }
.summary-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 24rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--mp-line);
}
.summary-key { flex: 0 0 auto; color: var(--mp-ink-2); font-size: var(--mp-type-caption); }
.summary-value {
  min-width: 0;
  color: var(--mp-ink);
  font-size: var(--mp-type-caption);
  font-weight: 600;
  text-align: right;
  word-break: break-all;
}
.fold { margin-top: 32rpx; padding-top: 8rpx; border-top: 1rpx solid var(--mp-line); }
.fold-summary { display: block; padding: 24rpx 0; color: var(--mp-ink-2); font-size: var(--mp-type-caption); }
.diagnostic { padding-bottom: 24rpx; color: var(--mp-ink-2); font-size: var(--mp-type-meta); line-height: var(--mp-lh-caption); }

/* ---------- 分段器 ---------- */
.seg {
  display: flex;
  padding: 8rpx;
  border-radius: var(--mp-radius-inset);
  background: var(--mp-surface);
  box-shadow: var(--mp-shadow-card);
}
.seg-item {
  flex: 1;
  padding: 16rpx 0;
  border-radius: var(--mp-radius-icon);
  color: var(--mp-ink-2);
  font-size: var(--mp-type-caption);
  font-weight: 500;
  text-align: center;
}
.seg-item-on { color: var(--mp-on-accent); font-weight: 600; background: var(--mp-accent); }

/* ---------- 时间线 ---------- */
.timeline-card {
  display: flex;
  gap: 24rpx;
  margin-top: var(--mp-gap-card);
  padding: var(--mp-pad-card) var(--mp-pad-card-lg);
}
.timeline-dot { flex-shrink: 0; width: 12rpx; height: 12rpx; margin-top: 18rpx; border-radius: 50%; background: var(--mp-accent); }
.timeline-time { display: block; color: var(--mp-ink-3); font-size: var(--mp-type-meta); }

/* ---------- 进度条 ---------- */
.progress-track { height: 16rpx; border-radius: var(--mp-radius-pill); background: var(--mp-track); overflow: hidden; }
.progress-fill { height: 100%; border-radius: var(--mp-radius-pill); background: var(--mp-accent); }

/* ---------- 底部抽屉 / 弹窗 ---------- */
.sheet-mask,
.mp-sheet-mask {
  position: fixed;
  left: 0; right: 0; top: 0; bottom: 0;
  z-index: 100;
  background: var(--mp-scrim);
}
.sheet,
.mp-sheet {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  z-index: 101;
  box-sizing: border-box;
  max-height: 86vh;
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
  padding: 16rpx 40rpx calc(40rpx + env(safe-area-inset-bottom));
  border-radius: var(--mp-radius-sheet) var(--mp-radius-sheet) 0 0;
  background: var(--mp-surface);
  box-shadow: var(--mp-shadow-card);
}
.sheet-grab,
.mp-sheet-grab { width: 72rpx; height: 8rpx; margin: 8rpx auto 28rpx; border-radius: var(--mp-radius-pill); background: var(--mp-line); }
.sheet-title,
.mp-sheet-title {
  display: block;
  margin-bottom: 16rpx;
  color: var(--mp-ink);
  font-size: var(--mp-type-title);
  font-weight: 700;
  line-height: 1.3;
}
.sheet-sub { display: block; margin: 0 0 24rpx; color: var(--mp-ink-2); font-size: var(--mp-type-caption); line-height: var(--mp-lh-caption); }
.modal-wrap {
  position: fixed;
  left: 0; right: 0; top: 0; bottom: 0;
  z-index: 102;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 var(--mp-pad-page);
  background: var(--mp-scrim);
}
.modal-card {
  box-sizing: border-box;
  width: 100%;
  max-height: 86vh;
  overflow-y: auto;
  padding: var(--mp-pad-card-lg) var(--mp-pad-card-lg) var(--mp-pad-card);
  border-radius: var(--mp-radius-card-xl);
  background: var(--mp-surface);
  box-shadow: var(--mp-shadow-card);
}
.modal-title { display: block; font-size: var(--mp-type-title); font-weight: 700; text-align: center; }
.modal-desc { display: block; margin-top: 16rpx; color: var(--mp-ink-2); font-size: var(--mp-type-body); line-height: var(--mp-lh-body); text-align: center; }

/* ---------- 步骤点 ---------- */
.dots { display: flex; align-items: center; justify-content: center; gap: 12rpx; margin: 24rpx 0; }
.dot { width: 16rpx; height: 16rpx; border-radius: 50%; background: var(--mp-line); }
.dot-done { background: var(--mp-accent-soft); }
.dot-now { width: 40rpx; border-radius: var(--mp-radius-pill); background: var(--mp-accent); }

/* ---------- 图标 ---------- */
.inline-icon { display: inline-flex; align-items: center; justify-content: center; width: 48rpx; height: 48rpx; }
/* WXML 不渲染内联 <svg>：勾和折叠箭头用边框绘制，颜色跟随 currentColor */
.icon-check { display: block; box-sizing: border-box; width: 14rpx; height: 24rpx; border-right: 4rpx solid currentColor; border-bottom: 4rpx solid currentColor; border-radius: 1rpx; transform: translateY(-3rpx) rotate(45deg); }
.icon-chevron { display: block; box-sizing: border-box; width: 16rpx; height: 16rpx; border-right: 3rpx solid currentColor; border-bottom: 3rpx solid currentColor; border-radius: 1rpx; transform: translateY(-4rpx) rotate(45deg); }
.danger-link { padding: 12rpx 0; color: var(--mp-rust); font-size: var(--mp-type-caption); background: transparent; }
button.danger-link { width: auto; margin: 0; padding: 12rpx 24rpx; line-height: 1.6; }
