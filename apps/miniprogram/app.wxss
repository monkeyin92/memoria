/* ============================================================
   Memoria 设计系统 v1.2（Airbnb Soft Warm × Editorial 点缀）
   令牌来源：design-tokens.md v1.2 §9 · px 按 375 屏宽 1:2 换算为 rpx
   L1 情感层 / L2 功能层 / L3 信息层 三层节奏为全案骨架
   ============================================================ */
page {
  --brand-deep: #172f43;
  --brand-deep-hover: #1f3d55;
  --brand-teal: #326e70;
  --brand-teal-soft: #e3edec;
  --bg-porcelain: #f4f6f8;
  --surface-white: #ffffff;
  --gray-100: #e9eef2;
  --gray-150: #eaf0f3;
  --border-default: #dfe6ea;
  --text-primary: #1d2b36;
  --text-secondary: #5c6b76;
  --text-tertiary: #93a1ab;
  --text-inverse: #ffffff;
  --text-on-brand-soft: #c9d6dd;
  --success: #346856;
  --success-bg: #e8f1ee;
  --warning: #855524;
  --warning-bg: #f5eddf;
  --danger: #a43a43;
  --danger-bg: #f6e6e7;
  --radius-l1: 52rpx;
  --radius-card: 44rpx;
  --radius-sm: 32rpx;
  --radius-button: 28rpx;
  --radius-input: 20rpx;
  --shadow-sm: 0 1px 3px rgba(23, 47, 67, 0.06);
  --shadow-md: 0 4px 16px rgba(23, 47, 67, 0.08);
  --shadow-lg: 0 8px 28px rgba(23, 47, 67, 0.12);
  --dur-fast: 150ms;
  --dur-base: 250ms;
  --dur-slow: 400ms;
  min-height: 100%;
  color: #1d2b36;
  color: var(--text-primary);
  background: #f4f6f8;
  background: var(--bg-porcelain);
  font-family: "PingFang SC", "HarmonyOS Sans SC", "Source Han Sans SC", "Noto Sans SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
  line-height: 1.6;
}

/* 角色主题变量组：换角色 = 换 data-role 一个属性，结构零改动 */
[data-role="starlight"] { --role-primary: #3d5a80; --role-soft: #e6ecf5; --role-accent: #f2c14e; --role-ink: #22344d; }
[data-role="taoxi"] { --role-primary: #ef8fa8; --role-soft: #fdeef2; --role-accent: #ffb84d; --role-ink: #8c3a52; }
[data-role="mianmian"] { --role-primary: #e8b4c4; --role-soft: #faf0f4; --role-accent: #c9a6e0; --role-ink: #7d5468; }
[data-role="axu"] { --role-primary: #8a9bae; --role-soft: #eef1f5; --role-accent: #5f7f95; --role-ink: #4a5a68; }
[data-role="xuanmo"] { --role-primary: #2b2f36; --role-soft: #e8eaef; --role-accent: #5b8def; --role-ink: #1c1f24; }

button::after { border: none; }
button { font-family: inherit; }

/* ---------- 页面骨架 ---------- */
.page-shell {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 24rpx 32rpx 64rpx;
  background: #f4f6f8;
  background: var(--bg-porcelain);
}
.page-title {
  display: block;
  margin: 0;
  color: #1d2b36;
  color: var(--text-primary);
  font-size: 56rpx;
  font-weight: 600;
  line-height: 1.3;
}
.page-lede,
.page-subtitle {
  display: block;
  margin: 8rpx 0 32rpx;
  color: #5c6b76;
  color: var(--text-secondary);
  font-size: 26rpx;
  line-height: 1.7;
}
.caption {
  display: block;
  margin-top: 24rpx;
  color: #5c6b76;
  color: var(--text-secondary);
  font-size: 24rpx;
  line-height: 1.7;
}
.nav-back {
  display: inline-flex;
  align-items: center;
  margin-bottom: 12rpx;
  padding: 12rpx 0;
  color: #5c6b76;
  color: var(--text-secondary);
  font-size: 28rpx;
}

/* ---------- L1 情感层：hero ---------- */
.mem-hero {
  box-sizing: border-box;
  padding: 36rpx 32rpx;
  border-radius: 52rpx;
  border-radius: var(--radius-l1);
  background: linear-gradient(160deg, #172f43 0%, #1f4258 55%, #2a5a5c 100%);
  color: #ffffff;
  color: var(--text-inverse);
  box-shadow: 0 4px 16px rgba(23, 47, 67, 0.08);
  box-shadow: var(--shadow-md);
}
.mem-hero-eyebrow {
  display: block;
  color: #c9d6dd;
  color: var(--text-on-brand-soft);
  font-size: 22rpx;
  letter-spacing: 4rpx;
}
.mem-hero-title {
  display: block;
  margin-top: 12rpx;
  font-family: "Songti SC", "Noto Serif SC", "STSong", serif;
  font-size: 48rpx;
  font-weight: 600;
  line-height: 1.35;
}
.mem-hero-sub {
  display: block;
  margin-top: 10rpx;
  color: #c9d6dd;
  color: var(--text-on-brand-soft);
  font-size: 26rpx;
  line-height: 1.6;
}
.mem-hero-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  margin-top: 8rpx;
}
.mem-hero-link {
  display: inline-block;
  margin-top: 16rpx;
  padding: 8rpx 0;
  color: #c9d6dd;
  color: var(--text-on-brand-soft);
  font-size: 24rpx;
  text-decoration: underline;
}

/* ---------- L1 情感层：角色渐变卡 ---------- */
.role-tint-card {
  box-sizing: border-box;
  padding: 36rpx 32rpx;
  border-radius: 52rpx;
  border-radius: var(--radius-l1);
  background: #e6ecf5;
  background: linear-gradient(150deg, var(--role-soft) 0%, #ffffff 100%);
  box-shadow: 0 4px 16px rgba(23, 47, 67, 0.08);
  box-shadow: var(--shadow-md);
}

/* ---------- L2 功能层：白卡 ---------- */
.l2-card,
.card {
  box-sizing: border-box;
  margin-top: 28rpx;
  padding: 32rpx;
  border-radius: 44rpx;
  border-radius: var(--radius-card);
  background: #ffffff;
  background: var(--surface-white);
  box-shadow: 0 1px 3px rgba(23, 47, 67, 0.06);
  box-shadow: var(--shadow-sm);
}
.l2-card-title {
  display: block;
  color: #1d2b36;
  color: var(--text-primary);
  font-size: 32rpx;
  font-weight: 600;
  line-height: 1.4;
}
.l2-card-sub {
  display: block;
  margin-top: 6rpx;
  color: #5c6b76;
  color: var(--text-secondary);
  font-size: 24rpx;
  line-height: 1.6;
}

/* ---------- 按钮 ---------- */
.primary-button,
.secondary-button,
.danger-button {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  width: 100%;
  min-height: 88rpx;
  padding: 20rpx 32rpx;
  border-radius: 28rpx;
  border-radius: var(--radius-button);
  font-size: 30rpx;
  font-weight: 500;
  line-height: 1.5;
  text-align: center;
  transition: transform 150ms, opacity 150ms;
}
.primary-button { color: #fff; background: #172f43; background: var(--brand-deep); }
.primary-button:active { background: #1f3d55; transform: scale(0.97); }
.secondary-button { color: #326e70; color: var(--brand-teal); background: #e3edec; background: var(--brand-teal-soft); }
.secondary-button:active { transform: scale(0.97); opacity: 0.9; }
.secondary-button-ghost {
  color: #1d2b36;
  background: #fff;
  border: 1rpx solid #dfe6ea;
  border: 1rpx solid var(--border-default);
}
.danger-button { color: #a43a43; color: var(--danger); background: #f6e6e7; background: var(--danger-bg); }
.button-disabled,
button[disabled] { color: #93a1ab !important; color: var(--text-tertiary) !important; background: #e9eef2 !important; background: var(--gray-100) !important; }
.text-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  padding: 12rpx 0;
  color: #326e70;
  color: var(--brand-teal);
  font-size: 28rpx;
  font-weight: 500;
  background: transparent;
}
.btn-sm { width: auto; min-height: 68rpx; padding: 12rpx 28rpx; font-size: 26rpx; }
.button-row { display: flex; gap: 20rpx; margin-top: 24rpx; }
.button-row button { flex: 1; }
.stack { display: flex; flex-direction: column; gap: 24rpx; }

/* ---------- 列表 / 设置行（L3 信息层） ---------- */
.list {
  margin-top: 8rpx;
  padding: 0 32rpx;
  border-radius: 40rpx;
  background: #ffffff;
  background: var(--surface-white);
  box-shadow: 0 1px 3px rgba(23, 47, 67, 0.06);
  box-shadow: var(--shadow-sm);
}
.list-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  min-height: 132rpx;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #dfe6ea;
  border-bottom: 1rpx solid var(--border-default);
}
.list-row:last-child { border-bottom: none; }
.row-copy { flex: 1; min-width: 0; }
.row-title,
.row-copy .row-title {
  display: block;
  color: #1d2b36;
  color: var(--text-primary);
  font-size: 28rpx;
  font-weight: 500;
  line-height: 1.5;
}
.row-meta {
  display: block;
  margin-top: 6rpx;
  color: #5c6b76;
  color: var(--text-secondary);
  font-size: 24rpx;
  line-height: 1.65;
}
.row-chevron { color: #93a1ab; color: var(--text-tertiary); font-size: 32rpx; line-height: 1; }
.row-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #e3edec;
  background: var(--brand-teal-soft);
}
.group-label {
  display: block;
  margin: 40rpx 8rpx 16rpx;
  color: #5c6b76;
  color: var(--text-secondary);
  font-size: 24rpx;
}

/* ---------- 胶囊标签 ---------- */
.pill {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  background: #e8f1ee;
  background: var(--success-bg);
  color: #346856;
  color: var(--success);
  font-size: 22rpx;
  font-weight: 500;
  line-height: 1.5;
  white-space: nowrap;
}
.pill-dot { width: 12rpx; height: 12rpx; border-radius: 50%; background: currentColor; }
.pill-neutral { background: #e9eef2; background: var(--gray-100); color: #5c6b76; color: var(--text-secondary); }
.pill-amber { background: #f5eddf; background: var(--warning-bg); color: #855524; color: var(--warning); }
.pill-teal { background: #e3edec; background: var(--brand-teal-soft); color: #326e70; color: var(--brand-teal); }
.pill-pink { background: #fdeef2; color: #8c3a52; }
.pill-role { background: #e6ecf5; background: var(--role-soft); color: #22344d; color: var(--role-ink); }
.count-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 40rpx;
  height: 40rpx;
  padding: 0 10rpx;
  border-radius: 999rpx;
  background: #a43a43;
  background: var(--danger);
  color: #fff;
  font-size: 22rpx;
  font-weight: 600;
}

/* ---------- 提示条 / 空状态 ---------- */
.notice {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  margin-top: 28rpx;
  padding: 28rpx 30rpx;
  border-radius: 32rpx;
  border-radius: var(--radius-sm);
  background: #e3edec;
  background: var(--brand-teal-soft);
  color: #326e70;
  color: var(--brand-teal);
  font-size: 26rpx;
  line-height: 1.7;
}
.notice-warn { background: #f5eddf; background: var(--warning-bg); color: #855524; color: var(--warning); }
.notice-title { display: block; font-size: 28rpx; font-weight: 600; }
.empty-block { padding: 56rpx 26rpx; text-align: center; }
.empty-title { display: block; color: #1d2b36; color: var(--text-primary); font-size: 42rpx; font-weight: 600; }
.empty-copy,
.loading-text {
  display: block;
  margin: 18rpx auto 0;
  max-width: 560rpx;
  color: #5c6b76;
  color: var(--text-secondary);
  font-size: 26rpx;
  line-height: 1.7;
}
.empty-button { margin-top: 32rpx; }
.error-text { display: block; margin: 18rpx 0 0; color: #a43a43; color: var(--danger); font-size: 26rpx; line-height: 1.5; }

/* ---------- 表单 ---------- */
.field-label { display: block; margin: 28rpx 0 12rpx; color: #1d2b36; color: var(--text-primary); font-size: 26rpx; font-weight: 500; }
.field-input,
.field-textarea {
  box-sizing: border-box;
  width: 100%;
  min-height: 88rpx;
  padding: 20rpx 24rpx;
  border: 1rpx solid #dfe6ea;
  border: 1rpx solid var(--border-default);
  border-radius: 20rpx;
  border-radius: var(--radius-input);
  background: #ffffff;
  background: var(--surface-white);
  color: #1d2b36;
  color: var(--text-primary);
  font-size: 28rpx;
}
.field-placeholder { color: #93a1ab; color: var(--text-tertiary); }
.setting-row { display: flex; align-items: center; justify-content: space-between; gap: 24rpx; min-height: 120rpx; padding: 18rpx 0; }
.setting-name { display: block; font-size: 28rpx; font-weight: 500; }
.setting-desc { display: block; margin-top: 6rpx; color: #5c6b76; color: var(--text-secondary); font-size: 24rpx; line-height: 1.65; }
.choice-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
  min-height: 128rpx;
  margin-top: 16rpx;
  padding: 24rpx 26rpx;
  border: 2rpx solid #dfe6ea;
  border: 2rpx solid var(--border-default);
  border-radius: 28rpx;
  border-radius: var(--radius-button);
  background: #fff;
}
.choice-card-on { border-color: #326e70; border-color: var(--brand-teal); background: #e3edec; background: var(--brand-teal-soft); }
.choice-radio { width: 36rpx; height: 36rpx; border: 4rpx solid #c8d4dc; border-radius: 50%; flex-shrink: 0; box-sizing: border-box; }
.choice-card-on .choice-radio { border-color: #172f43; background: #172f43; box-shadow: inset 0 0 0 8rpx #fff; }

/* ---------- 数据 / 区块 ---------- */
.two-stats { display: flex; margin-top: 28rpx; padding: 30rpx 0; border-radius: 34rpx; background: #e9eef2; background: var(--gray-100); }
.two-stats-cell { flex: 1; padding: 0 20rpx; text-align: center; }
.two-stats-cell + .two-stats-cell { border-left: 1rpx solid #cad7df; }
.two-stats-value { display: block; font-size: 28rpx; font-weight: 500; }
.two-stats-label { display: block; margin-top: 6rpx; color: #5c6b76; color: var(--text-secondary); font-size: 22rpx; }
.foot-link { margin-top: 24rpx; color: #5c6b76; color: var(--text-secondary); font-size: 26rpx; background: transparent; }
.privacy-note { display: block; margin: 42rpx auto 0; max-width: 600rpx; color: #5c6b76; color: var(--text-secondary); font-size: 22rpx; line-height: 1.7; text-align: center; }
.section-head { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; margin: 48rpx 0 20rpx; }
.section-head-title,
.settings-title { color: #1d2b36; color: var(--text-primary); font-size: 36rpx; font-weight: 600; }
.section-link { color: #326e70; color: var(--brand-teal); font-size: 26rpx; font-weight: 500; padding: 12rpx 0; }
.eyebrow { display: block; margin-bottom: 8rpx; color: #326e70; color: var(--brand-teal); font-size: 22rpx; letter-spacing: 2rpx; }
.summary-row { display: flex; align-items: baseline; justify-content: space-between; gap: 24rpx; padding: 18rpx 0; border-bottom: 1rpx solid #dfe6ea; border-bottom: 1rpx solid var(--border-default); }
.summary-key { flex: 0 0 auto; color: #5c6b76; color: var(--text-secondary); font-size: 24rpx; }
.summary-value { min-width: 0; color: #1d2b36; color: var(--text-primary); font-size: 24rpx; font-weight: 600; text-align: right; word-break: break-all; }
.fold { margin-top: 32rpx; padding-top: 8rpx; border-top: 1rpx solid #dfe6ea; border-top: 1rpx solid var(--border-default); }
.fold-summary { display: block; padding: 24rpx 0; color: #5c6b76; color: var(--text-secondary); font-size: 26rpx; }
.diagnostic { padding-bottom: 24rpx; color: #5c6b76; color: var(--text-secondary); font-size: 24rpx; line-height: 1.7; }

/* ---------- FaceBadge 表情脸（角色视觉唯一载体） ---------- */
.face-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  border-radius: 26%;
  background: #e6ecf5;
  background: var(--role-soft);
  overflow: hidden;
}
.face-badge svg { width: 76%; height: 76%; display: block; }
.fb-xs { width: 48rpx; height: 48rpx; }
.fb-sm { width: 80rpx; height: 80rpx; }
.fb-md { width: 144rpx; height: 144rpx; }
.fb-lg { width: 192rpx; height: 192rpx; }
.fb-xl { width: 240rpx; height: 240rpx; }
.face-on-light {
  background: #ffffff;
  box-shadow: 0 4px 20px rgba(61, 90, 128, 0.18);
}
.fb-breathe { animation: fbFloat 3s ease-in-out infinite; }
@keyframes fbFloat { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-8rpx); } }

/* ---------- 角色卡 ---------- */
.role-card {
  box-sizing: border-box;
  flex-shrink: 0;
  width: 560rpx;
  padding: 36rpx 32rpx;
  border-radius: 52rpx;
  border-radius: var(--radius-l1);
  background: #e6ecf5;
  background: linear-gradient(150deg, var(--role-soft) 0%, #ffffff 100%);
  box-shadow: 0 4px 16px rgba(23, 47, 67, 0.08);
  box-shadow: var(--shadow-md);
  border: 2rpx solid transparent;
}
.role-card-selected { border-color: #3d5a80; border-color: var(--role-primary); }
.role-card-name { display: block; font-size: 36rpx; font-weight: 600; color: #22344d; color: var(--role-ink); }
.role-card-tagline { display: block; margin-top: 8rpx; font-size: 26rpx; color: #5c6b76; color: var(--text-secondary); line-height: 1.6; }
.role-flow { display: flex; gap: 24rpx; margin: 8rpx -32rpx 0; padding: 8rpx 32rpx 16rpx; overflow-x: auto; }

/* ---------- Segment 分段器 ---------- */
.seg {
  display: flex;
  position: relative;
  padding: 8rpx;
  border-radius: 999rpx;
  background: #e9eef2;
  background: var(--gray-100);
}
.seg-item { flex: 1; padding: 16rpx 0; font-size: 26rpx; color: #5c6b76; color: var(--text-secondary); text-align: center; border-radius: 999rpx; z-index: 1; }
.seg-item-on { color: #172f43; color: var(--brand-deep); font-weight: 600; background: #fff; box-shadow: 0 1px 3px rgba(23, 47, 67, 0.06); box-shadow: var(--shadow-sm); }

/* ---------- 时间线 ---------- */
.timeline-card {
  display: flex;
  gap: 20rpx;
  margin-top: 20rpx;
  padding: 28rpx;
  border-radius: 32rpx;
  border-radius: var(--radius-sm);
  background: #ffffff;
  background: var(--surface-white);
  box-shadow: 0 1px 3px rgba(23, 47, 67, 0.06);
  box-shadow: var(--shadow-sm);
}
.timeline-dot { flex-shrink: 0; width: 16rpx; height: 16rpx; margin-top: 12rpx; border-radius: 50%; background: #326e70; background: var(--brand-teal); }
.timeline-time { display: block; font-size: 22rpx; color: #93a1ab; color: var(--text-tertiary); }
.timeline-text { display: block; margin-top: 6rpx; font-size: 26rpx; line-height: 1.65; }

/* ---------- 进度条 ---------- */
.progress-track { height: 12rpx; border-radius: 999rpx; background: #e9eef2; background: var(--gray-100); overflow: hidden; }
.progress-fill { height: 100%; border-radius: 999rpx; background: #326e70; background: var(--brand-teal); }

/* ---------- 底部抽屉 / 弹窗 ---------- */
.sheet-mask {
  position: fixed;
  left: 0; right: 0; top: 0; bottom: 0;
  background: rgba(23, 47, 67, 0.45);
  z-index: 90;
}
.sheet {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  box-sizing: border-box;
  padding: 20rpx 32rpx 48rpx;
  border-radius: 48rpx 48rpx 0 0;
  background: #fff;
  box-shadow: 0 8px 28px rgba(23, 47, 67, 0.12);
  box-shadow: var(--shadow-lg);
  z-index: 91;
}
.sheet-grab { width: 80rpx; height: 8rpx; margin: 8rpx auto 20rpx; border-radius: 999rpx; background: #dfe6ea; background: var(--border-default); }
.sheet-title { display: block; font-size: 36rpx; font-weight: 600; text-align: center; }
.sheet-sub { display: block; margin: 8rpx 0 20rpx; font-size: 24rpx; color: #5c6b76; color: var(--text-secondary); text-align: center; }
.modal-wrap { position: fixed; left: 0; right: 0; top: 0; bottom: 0; display: flex; align-items: center; justify-content: center; z-index: 95; padding: 0 80rpx; }
.modal-card { box-sizing: border-box; width: 100%; padding: 44rpx 40rpx 32rpx; border-radius: 44rpx; background: #fff; box-shadow: 0 8px 28px rgba(23, 47, 67, 0.12); box-shadow: var(--shadow-lg); }
.modal-title { display: block; font-size: 36rpx; font-weight: 600; text-align: center; }
.modal-desc { display: block; margin-top: 12rpx; font-size: 28rpx; color: #5c6b76; color: var(--text-secondary); line-height: 1.7; text-align: center; }

/* ---------- 步骤点 / stepper ---------- */
.dots { display: flex; align-items: center; justify-content: center; gap: 12rpx; margin: 24rpx 0; }
.dot { width: 16rpx; height: 16rpx; border-radius: 50%; background: #dfe6ea; background: var(--border-default); }
.dot-done { background: #326e70; background: var(--brand-teal); }
.dot-now { background: #172f43; background: var(--brand-deep); transform: scale(1.3); }

/* ---------- 图标 ---------- */
.inline-icon { display: inline-flex; width: 44rpx; height: 44rpx; }
.inline-icon svg { width: 100%; height: 100%; }
.row-icon svg { width: 40rpx; height: 40rpx; }
.danger-link { color: #a43a43; color: var(--danger); font-size: 26rpx; padding: 12rpx 0; }
