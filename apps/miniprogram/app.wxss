page {
  min-height: 100%;
  color: #dfe7ff;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
}

button::after {
  border: none;
}

/* 页面背景层：本地图片不能用于 WXSS background-image（微信官方限制），
   且渲染层 page 默认白底会盖住负 z-index 内容。
   因此各页采用「双顶层节点」结构：
   <view class="page-bg"><image class="page-bg-img"/></view> 为 z-index:0 的
   固定底色+背景图层（自带 #070b1a，杜绝白底穿透），
   .page-shell 以 z-index:1 叠于其上；shell 本身不得再设背景色。 */
.page-bg {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 0;
  background: #070b1a;
}

.page-bg-img {
  width: 100%;
}

.page-shell {
  position: relative;
  z-index: 1;
  min-height: 100vh;
  box-sizing: border-box;
  padding: 36rpx 32rpx 56rpx;
}

/* ——— 赛博霓虹潮玩 · 全局令牌 ——— */
.eyebrow {
  display: inline-flex;
  align-items: center;
  margin: 0 0 16rpx;
  padding: 8rpx 24rpx;
  border: 1rpx solid rgba(94, 234, 255, 0.32);
  border-radius: 999rpx;
  background: rgba(34, 229, 255, 0.08);
  color: #7ceaff;
  font-size: 22rpx;
  letter-spacing: 5rpx;
  text-shadow: 0 0 16rpx rgba(34, 229, 255, 0.45);
}

.page-title {
  display: block;
  margin: 0;
  color: #f2f5ff;
  font-size: 52rpx;
  font-weight: 800;
  line-height: 1.22;
  letter-spacing: 1rpx;
}

.page-subtitle {
  display: block;
  margin: 16rpx 0 0;
  color: #8d99c4;
  font-size: 27rpx;
  line-height: 1.65;
}

.card {
  box-sizing: border-box;
  margin-top: 28rpx;
  padding: 32rpx;
  border: 1rpx solid rgba(94, 234, 255, 0.14);
  border-radius: 36rpx;
  background: rgba(16, 23, 52, 0.72);
  box-shadow:
    0 18rpx 48rpx rgba(0, 0, 0, 0.38),
    inset 0 0 40rpx rgba(34, 229, 255, 0.03);
  backdrop-filter: blur(24rpx);
}

.primary-button,
.secondary-button,
.danger-button {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  min-height: 92rpx;
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.primary-button {
  color: #fff;
  background: linear-gradient(120deg, #19b8d8 0%, #7b5cff 55%, #c44de0 100%);
  box-shadow:
    0 12rpx 36rpx rgba(123, 92, 255, 0.42),
    0 0 28rpx rgba(34, 229, 255, 0.22);
}

.secondary-button {
  border: 1rpx solid rgba(94, 234, 255, 0.38);
  color: #7ceaff;
  background: rgba(34, 229, 255, 0.08);
}

.danger-button {
  border: 1rpx solid rgba(255, 110, 140, 0.42);
  color: #ff8ba3;
  background: rgba(255, 77, 109, 0.1);
}

.button-row {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}

.button-row button {
  flex: 1;
}

.empty-state {
  padding: 56rpx 24rpx;
  color: #6b7699;
  text-align: center;
  font-size: 27rpx;
  line-height: 1.7;
}

.empty-spark {
  display: block;
  margin-bottom: 12rpx;
  color: rgba(140, 240, 255, 0.6);
  font-size: 44rpx;
  text-shadow: 0 0 18rpx rgba(34, 229, 255, 0.55);
}

.empty-copy {
  display: block;
}

.error-text {
  display: block;
  margin: 18rpx 0 0;
  color: #ff8ba3;
  font-size: 26rpx;
  line-height: 1.5;
}
