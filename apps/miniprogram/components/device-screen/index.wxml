<view class="ds {{online ? 'ds-on' : 'ds-off'}}" style="width: {{(size) / 2}}px; height: {{(size * 0.94) / 2}}px; border-radius: {{(size * 0.3) / 2}}px;" aria-hidden="true">
  <view class="ds-screen" style="border-radius: {{(size * 0.26) / 2}}px;">
    <view class="ds-cam"></view>
    <view class="ds-face">
      <view class="ds-eye"></view>
      <view class="ds-eye"></view>
    </view>
    <view class="ds-smile"></view>
    <view class="ds-glare"></view>
  </view>
</view>
