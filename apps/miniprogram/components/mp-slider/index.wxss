/* The 18px pads give a 44px touch band; the margins put the track 24px below the head and 8px above the range. */
.mps {
  margin: 6px 0 -10px;
  padding: 18px 0;
}

.mps-off {
  opacity: 0.55;
}

.mps-track {
  position: relative;
  height: 8px;
  border-radius: 8px;
  background: var(--mp-track);
}

.mps-fill {
  position: absolute;
  top: 0;
  bottom: 0;
  left: 0;
  border-radius: 8px;
  background: var(--mp-accent);
}

.mps-thumb {
  position: absolute;
  top: -12px;
  width: 32px;
  height: 32px;
  border-radius: 50%;
  background: var(--mp-surface);
  box-shadow: var(--mp-shadow-thumb);
}
