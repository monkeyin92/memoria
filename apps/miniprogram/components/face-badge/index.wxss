/* 组件样式隔离：app.wxss 的 class 不进组件，样式都放在这里。 */
.face-badge {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-sizing: border-box;
  padding: 8%;
  border-radius: 30%;
  background: #dde6f5;
  border: 0.5px solid rgba(255, 255, 255, 0.8);
  box-shadow: 0 6px 14px rgba(34, 52, 84, 0.14), inset 0 1px 0 rgba(255, 255, 255, 0.9);
  overflow: hidden;
}

.fb-role-starlight { background: #dde6f5; }
.fb-role-taoxi { background: #fbe3e8; }
.fb-role-mianmian { background: #e4f0e6; }
.fb-role-axu { background: #f1e5d6; }
.fb-role-xuanmo { background: #e2e6da; }

.fb-img {
  position: relative;
  display: block;
  width: 100%;
  height: 100%;
}

.fb-xs { width: 24px; height: 24px; }
.fb-sm { width: 40px; height: 40px; }
.fb-tile { width: 52px; height: 52px; }
.fb-md { width: 72px; height: 72px; }
.fb-lg { width: 96px; height: 96px; }
.fb-xl { width: 120px; height: 120px; }
.fb-empty { width: 148px; height: 148px; }
.fb-hero { width: 130px; height: 130px; }

.face-on-light {
  background: #ffffff;
  box-shadow: 0 4px 20px rgba(61, 90, 128, 0.18);
}

/* plain：大尺寸形象不要底板，只留落地阴影 */
.fb-plain {
  padding: 0;
  border: none;
  border-radius: 0;
  background: transparent;
  box-shadow: none;
  overflow: visible;
}

.fb-shadow {
  position: absolute;
  left: 22%;
  right: 22%;
  bottom: -2%;
  height: 7%;
  border-radius: 50%;
  background: radial-gradient(ellipse at center, rgba(4, 10, 24, 0.32) 0%, rgba(4, 10, 24, 0) 70%);
}

/* 调暗整个容器，不碰 .fb-img 的 opacity，否则会盖过表情帧的显隐 */
.fb-dim {
  filter: grayscale(0.85) brightness(0.8);
  opacity: 0.7;
}

.fb-breathe .fb-img { animation: fbFloat 3s ease-in-out infinite; }

/* ---------- animated：表情帧叠放，切换时交叉淡入，身体动作跟着表情走 ---------- */
.fb-stage {
  position: relative;
  width: 100%;
  height: 100%;
  transform-origin: 50% 92%;
}

.fb-frame {
  position: absolute;
  left: 0;
  top: 0;
  opacity: 0;
  transition: opacity 0.18s ease-out;
}

.fb-frame-on { opacity: 1; }

.fb-mood-default { animation: fbFloat 3s ease-in-out infinite; }
.fb-mood-happy { animation: fbHop 0.8s ease-out 2; }
.fb-mood-surprised { animation: fbStartle 0.5s cubic-bezier(0.3, 1.6, 0.5, 1) 1; }
.fb-mood-thinking { animation: fbTilt 3.2s ease-in-out 1 forwards; }
.fb-mood-dizzy { animation: fbWobble 0.9s ease-in-out infinite; }
.fb-mood-sleepy { animation: fbSnooze 3.6s ease-in-out infinite; }

@keyframes fbHop {
  0%, 100% { transform: translateY(0) scale(1, 1); }
  15% { transform: translateY(0) scale(1.05, 0.94); }
  45% { transform: translateY(-11px) scale(0.97, 1.04); }
  75% { transform: translateY(0) scale(1.03, 0.97); }
}

@keyframes fbStartle {
  0% { transform: scale(0.94); }
  60% { transform: translateY(-5px) scale(1.06); }
  100% { transform: translateY(0) scale(1); }
}

@keyframes fbTilt {
  0% { transform: rotate(0deg); }
  25%, 80% { transform: rotate(-5deg) translateY(-2px); }
  100% { transform: rotate(0deg); }
}

@keyframes fbWobble {
  0%, 100% { transform: rotate(0deg); }
  25% { transform: rotate(-6deg) translateX(-2px); }
  75% { transform: rotate(6deg) translateX(2px); }
}

@keyframes fbSnooze {
  0%, 100% { transform: scale(1, 1); }
  50% { transform: scale(1.02, 0.97); }
}

@keyframes fbFloat {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-4px); }
}
