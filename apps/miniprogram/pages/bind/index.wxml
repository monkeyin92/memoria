<view class="page-shell bind-trial sub-page" style="{{statusBarStyle}}">
  <view class="nav-back" bindtap="goBack" aria-label="返回"><image class="nav-back-icon" src="/assets/ui/v4/back-strong.svg" /></view>
  <block wx:if="{{step === 'mode'}}"><text class="eyebrow">第 1 步 · 选择绑定方式</text></block>
  <block wx:elif="{{step === 'form'}}"><text class="eyebrow">第 2 步 · 填写使用者信息</text></block>
  <block wx:elif="{{step === 'review'}}"><text class="eyebrow">第 3、4 步 · 确认授权并提交</text></block>
  <block wx:elif="{{step === 'done'}}"><text class="eyebrow">第 5 步 · 完成</text></block>
  <block wx:else><text class="eyebrow">正在准备绑定</text></block>
  <text class="page-title">绑定设备</text>
  <view class="dots">
    <view class="dot {{step === 'mode' ? 'dot-now' : (step === 'form' || step === 'review' || step === 'done' ? 'dot-done' : '')}}"></view>
    <view class="dot {{step === 'form' ? 'dot-now' : (step === 'review' || step === 'done' ? 'dot-done' : '')}}"></view>
    <view class="dot {{step === 'review' || step === 'done' ? 'dot-done' : ''}}"></view>
    <view class="dot {{step === 'review' ? 'dot-now' : (step === 'done' ? 'dot-done' : '')}}"></view>
    <view class="dot {{step === 'done' ? 'dot-done' : ''}}"></view>
  </view>

  <block wx:if="{{step === 'loading'}}">
    <view class="l2-card">
      <text class="l2-card-title">正在准备</text>
      <text class="l2-card-sub">马上就好，请稍等。</text>
      <text class="loading-text">正在读取机器人的启用信息…</text>
    </view>
  </block>

  <block wx:if="{{step === 'error'}}">
    <view class="l2-card">
      <text class="l2-card-title">无法继续绑定</text>
      <text class="l2-card-sub">{{error}}</text>
      <button wx:if="{{needsRescan}}" class="secondary-button empty-button" bindtap="rescanDevice">轻点机器人屏幕换码后，重新扫码</button>
      <button class="secondary-button empty-button" bindtap="openDevicePage">返回设备管理</button>
    </view>
  </block>

  <!-- 步骤 1：绑定方式二选一 -->
  <block wx:if="{{step === 'mode'}}">
    <view class="bind-mode-list">
      <view wx:for="{{modeCards}}" wx:key="id" class="choice-card" data-mode="{{item.id}}" bindtap="chooseMode">
        <view class="choice-radio"></view>
        <view class="choice-copy">
          <text class="choice-title">{{item.title}}</text>
          <text class="choice-desc">{{item.tagline}}</text>
        </view>
      </view>
    </view>
    <text class="mode-footnote">不同的使用方式会建立不同的档案和记忆空间；之后都可以在“设备与成员”里修改。</text>
  </block>

  <!-- 步骤 2：机器人尾号只读 + 使用者备注 -->
  <block wx:if="{{step === 'form'}}">
    <view class="l2-card">
      <text class="l2-card-title">{{modeMeta.title}} · 基本信息</text>
      <view wx:if="{{deviceTail}}" class="field">
        <text class="field-label">机器人</text>
        <view class="readonly-chip"><text class="readonly-code">尾号 {{deviceTail}}</text><text class="readonly-hint">扫码自动获取，无需填写</text></view>
      </view>

      <!-- A. 给孩子使用 -->
      <block wx:if="{{declaredMode === 'parent_for_child'}}">
        <picker range="{{subjectSourceOptions}}" range-key="label" value="{{form.subjectSource === 'existing' ? 1 : 0}}" bindchange="onSubjectSourceChange">
          <view class="picker-row"><text class="picker-label">孩子档案</text><text class="picker-value">{{form.subjectSource === 'existing' ? '使用已有档案' : '新建档案'}}</text></view>
        </picker>
        <picker wx:if="{{form.subjectSource === 'existing' && existingSubjectOptions.length > 0}}" range="{{existingSubjectOptions}}" range-key="label" value="{{form.existingSubjectIndex}}" bindchange="onExistingSubjectChange">
          <view class="picker-row"><text class="picker-label">选择孩子</text><text class="picker-value">{{existingSubjectOptions[form.existingSubjectIndex].label}}</text></view>
        </picker>
        <text wx:if="{{form.subjectSource === 'new' && existingSubjectOptions.length > 0}}" class="caption">之前建过「{{existingSubjectOptions[0].label}}」{{existingSubjectOptions.length > 1 ? '等 ' + existingSubjectOptions.length + ' 位' : ''}}的档案，重新绑定时选「使用已有档案」就能沿用，不用重新建。</text>
        <text wx:if="{{form.subjectSource === 'new'}}" class="field-label">使用者备注 *</text>
        <input wx:if="{{form.subjectSource === 'new'}}" class="field-input" value="{{form.childNickname}}" placeholder="例如：亲爱的儿子、小乐" placeholder-class="field-placeholder" maxlength="{{maxSubjectLabel}}" data-key="childNickname" bindinput="onFieldInput" />
        <text wx:if="{{form.subjectSource === 'existing'}}" class="field-label">使用者备注</text>
        <input wx:if="{{form.subjectSource === 'existing'}}" class="field-input" value="{{form.subjectAlias}}" placeholder="例如：亲爱的儿子" placeholder-class="field-placeholder" maxlength="{{maxSubjectLabel}}" data-key="subjectAlias" bindinput="onFieldInput" />
        <picker range="{{ageBands}}" range-key="label" value="{{ageBandIndex}}" bindchange="onAgeBandChange">
          <view class="picker-row"><text class="picker-label">年龄段</text><text class="picker-value">{{ageBands[ageBandIndex].label}}</text></view>
        </picker>
        <view class="setting-row">
          <view><text class="setting-name">学习指导</text><text class="setting-desc">先引导步骤，不直接代做作业</text></view>
          <switch checked="{{form.tutorEnabled}}" data-key="tutorEnabled" bindchange="onSwitch" color="#4A52C9" />
        </view>
        <view class="setting-row">
          <view><text class="setting-name">英语口语陪练</text><text class="setting-desc">开口练习与即时反馈</text></view>
          <switch checked="{{form.englishPracticeEnabled}}" data-key="englishPracticeEnabled" bindchange="onSwitch" color="#4A52C9" />
        </view>
        <picker range="{{sessionMinuteOptions}}" value="{{sessionMinuteIndex}}" bindchange="onSessionMinutesChange">
          <view class="picker-row"><text class="picker-label">单次使用时长</text><text class="picker-value">{{sessionMinuteOptions[sessionMinuteIndex]}} 分钟</text></view>
        </picker>
        <view class="quiet-hours-block">
          <text class="quiet-hours-label">{{quietHoursLabel}}</text>
          <text class="l2-card-sub bind-night-caption">点下方的开始、结束时间可以修改</text>
          <view class="quiet-hours-row">
            <picker mode="time" value="{{form.quietHoursStart}}" bindchange="onQuietStartChange">
              <view class="picker-row"><text class="picker-label">开始</text><text class="picker-value">{{form.quietHoursStart}}</text></view>
            </picker>
            <picker mode="time" value="{{form.quietHoursEnd}}" bindchange="onQuietEndChange">
              <view class="picker-row"><text class="picker-label">结束</text><text class="picker-value">{{form.quietHoursEnd}}</text></view>
            </picker>
          </view>
        </view>
        <text class="form-note">孩子的年龄和监护关系由系统核实；学习时长、夜间模式和成长记录，都按儿童保护规则执行，AI 角色改不了。</text>
      </block>

      <!-- B. 给自己使用 -->
      <block wx:if="{{declaredMode === 'self_use'}}">
        <text class="field-label">使用者备注 *</text>
        <input class="field-input" value="{{form.selfNickname}}" placeholder="例如：我自己、阿宁" placeholder-class="field-placeholder" maxlength="{{maxSubjectLabel}}" data-key="selfNickname" bindinput="onFieldInput" />
        <picker range="{{memoryLevelOptions}}" range-key="label" value="{{form.memoryLevelIndex}}" data-key="memoryLevelIndex" bindchange="onPickerChange">
          <view class="picker-row"><text class="picker-label">记忆深度</text><text class="picker-value">{{memoryLevelOptions[form.memoryLevelIndex].label}}</text></view>
        </picker>
        <picker range="{{interviewFrequencyOptions}}" range-key="label" value="{{form.interviewFrequencyIndex}}" data-key="interviewFrequencyIndex" bindchange="onPickerChange">
          <view class="picker-row"><text class="picker-label">主动采访</text><text class="picker-value">{{interviewFrequencyOptions[form.interviewFrequencyIndex].label}}</text></view>
        </picker>
        <text class="form-note">首页的当前使用者会显示这条备注，不是微信昵称。年龄以系统核实的为准；数字自我与传承等能力默认关闭，需要单独开启。</text>
      </block>

      <!-- C. 给父母使用 -->
      <block wx:if="{{declaredMode === 'child_for_parent'}}">
        <view class="setting-row">
          <view><text class="setting-name">我是购买者 / 设备管理员</text><text class="setting-desc">管理网络、固件与绑定，不代表可以读取父母私人内容</text></view>
          <switch checked="{{form.adminIsBuyer}}" data-key="adminIsBuyer" bindchange="onSwitch" color="#4A52C9" />
        </view>
        <text class="field-label">使用者备注 *</text>
        <input class="field-input" value="{{form.parentNickname}}" placeholder="例如：老爸、妈妈" placeholder-class="field-placeholder" maxlength="{{maxSubjectLabel}}" data-key="parentNickname" bindinput="onFieldInput" />
        <picker range="{{speechSpeedOptions}}" range-key="label" value="{{form.speechSpeedIndex}}" data-key="speechSpeedIndex" bindchange="onPickerChange">
          <view class="picker-row"><text class="picker-label">语速偏好</text><text class="picker-value">{{speechSpeedOptions[form.speechSpeedIndex].label}}</text></view>
        </picker>
        <picker range="{{adminVisibilityOptions}}" range-key="label" value="{{form.adminVisibilityIndex}}" data-key="adminVisibilityIndex" bindchange="onPickerChange">
          <view class="picker-row"><text class="picker-label">子女可见范围</text><text class="picker-value">{{adminVisibilityOptions[form.adminVisibilityIndex].label}}</text></view>
        </picker>
        <view class="notice notice-warn">
          <text class="notice-title">长期记忆由你代父母决定</text>
          <text class="notice-copy">下一步如果勾选「我代父母同意」，就是你代父母同意角色记住 TA 聊过的事；不勾选只保留当次对话。你可以随时在小程序里撤回。子女协助管理设备，不等于可以读取父母的聊天和人生故事。</text>
        </view>
      </block>

      <!-- D. 家庭共同使用 -->
      <block wx:if="{{declaredMode === 'family_shared'}}">
        <text class="field-label">使用者备注 *</text>
        <input class="field-input" value="{{form.subjectAlias}}" placeholder="例如：老爸、亲爱的儿子" placeholder-class="field-placeholder" maxlength="{{maxSubjectLabel}}" data-key="subjectAlias" bindinput="onFieldInput" />
        <text class="caption">家庭名称与其他成员可以稍后添加。</text>
        <view class="setting-row">
          <view><text class="setting-name">共用同一位 AI 角色</text><text class="setting-desc">成员档案仍然各自独立</text></view>
          <switch checked="{{form.sharedPersonaEnabled}}" data-key="sharedPersonaEnabled" bindchange="onSwitch" color="#4A52C9" />
        </view>
        <text class="form-note">每位成员都有自己独立的档案；私人记忆、家庭共享记忆与待确认的共同记忆分开管理，家庭管理员不能读取成员的私人记忆。成员邀请与确认由系统完成。</text>
      </block>

    </view>

    <text class="section-title">AI 角色</text>
    <view class="role-grid bind-roles">
      <view
        wx:for="{{personaOptions}}"
        wx:key="id"
        class="role-card {{index === personaIndex ? 'role-card-on' : ''}}"
        data-index="{{index}}"
        bindtap="onPersonaTap"
      >
        <view class="role-art">
          <view class="role-fig"><face-badge role="{{item.id}}" size="lg" plain="{{true}}"></face-badge></view>
        </view>
        <text class="role-name">{{item.name}}</text>
        <text class="role-tagline">{{item.tagline}}</text>
        <view wx:if="{{index === personaIndex}}" class="pill pill-online role-chip">已选择</view>
        <view wx:else class="pill pill-neutral role-chip">选这个</view>
      </view>
    </view>
    <view class="card bind-voice">
      <text class="bind-role-desc">{{personaOptions[personaIndex].description}}</text>
      <view class="setting-row">
        <mp-icon name="volume"></mp-icon>
        <view class="row-copy">
          <text class="row-title">声音 · {{personaOptions[personaIndex].voiceName}}</text>
          <text class="row-meta">{{personaOptions[personaIndex].tone}}</text>
        </view>
        <view class="pill pill-teal role-play" data-index="{{personaIndex}}" catchtap="togglePreview">{{previewingId === personaOptions[personaIndex].id ? '停止' : '试听'}}</view>
      </view>
    </view>

    <view class="button-row bind-nav">
      <button class="secondary-button" bindtap="backToMode">上一步</button>
      <button class="primary-button" bindtap="goToReview">下一步</button>
    </view>
    <text wx:if="{{error}}" class="error-text">{{error}}</text>
  </block>

  <!-- 步骤 3/4：协议勾选与汇总确认 -->
  <block wx:if="{{step === 'review'}}">
    <view class="l2-card">
      <text class="l2-card-title">确认一下</text>
      <text class="l2-card-sub">核对下面的信息，勾选需要的授权后提交</text>
      <view class="summary-row"><text class="summary-key">设备用途</text><text class="summary-value">{{modeMeta.title}}</text></view>
      <view class="summary-row"><text class="summary-key">使用者</text><text class="summary-value">{{reviewSubjectLabel}}</text></view>
      <view class="summary-row"><text class="summary-key">AI 角色</text><text class="summary-value">{{personaOptions[personaIndex].name}}</text></view>

      <text class="field-label">需要你确认的授权</text>
      <view wx:for="{{offers}}" wx:key="id" class="offer-row {{item.requiresParentSelfAcceptance ? 'offer-disabled' : ''}}" data-id="{{item.id}}" bindtap="{{item.requiresParentSelfAcceptance ? '' : 'toggleOffer'}}">
        <view class="offer-check {{item.checked ? 'offer-check-on' : ''}}">
          <text wx:if="{{item.checked}}">✓</text>
        </view>
        <view class="offer-copy">
          <text class="offer-label">{{item.label}}</text>
          <text class="offer-desc">{{item.description}}</text>
          <text wx:if="{{item.requiresParentSelfAcceptance}}" class="offer-note">需父母本人确认，绑定后在设备上完成</text>
          <text wx:if="{{item.proxyConsent}}" class="offer-note">由你代父母同意，可随时在小程序里撤回</text>
          <text wx:if="{{item.requiredForSubmit}}" class="offer-note">完成绑定前必须勾选</text>
        </view>
      </view>
      <text class="form-note">敏感能力（长期记忆、数字自我、传承、原始音频等）只有明确勾选才会申请；孩子和父母的长期记忆默认不勾选，不勾选也能完成绑定。</text>
      <view wx:if="{{subscriptionPushEnabled && crisisSubscribeRequired}}" class="notice notice-warn">
        <text class="l2-card-title">安全提醒是完成绑定的前提</text>
        <text class="l2-card-sub">{{crisisPush.enabled ? crisisPush.explanation : '安全提醒尚未开通，暂时不能完成这类绑定。'}}</text>
      </view>

      <view class="button-row bind-nav">
        <button class="secondary-button" bindtap="backToForm">上一步</button>
        <button class="primary-button bind-submit" loading="{{submitting}}" bindtap="submitBinding">{{submitLabel}}</button>
      </view>
      <text wx:if="{{error}}" class="error-text">{{error}}</text>
      <button wx:if="{{needsRescan}}" class="secondary-button bind-rescan" bindtap="rescanDevice">轻点机器人屏幕换码后，重新扫码</button>
    </view>
  </block>

  <!-- 步骤 5：完成徽章 -->
  <block wx:if="{{step === 'done'}}">
    <view class="l2-card done-card">
      <view class="done-device">
        <face-badge role="{{personaOptions[personaIndex].id}}" size="xl" plain="{{true}}" animated="{{true}}"></face-badge>
      </view>
      <text class="done-badge">设置已提交</text>
      <text class="done-title">机器人已建立「{{manifest.declared_mode === 'parent_for_child' ? '给孩子使用' : manifest.declared_mode === 'self_use' ? '给自己使用' : manifest.declared_mode === 'child_for_parent' ? '给父母使用' : '家庭共同使用'}}」绑定</text>
      <view class="summary-row"><text class="summary-key">使用者</text><text class="summary-value">{{reviewSubjectLabel}}</text></view>
      <view class="summary-row"><text class="summary-key">AI 角色</text><text class="summary-value">{{personaOptions[personaIndex].name}}</text></view>
      <view wx:if="{{deviceTail}}" class="summary-row"><text class="summary-key">机器人</text><text class="summary-value">尾号 {{deviceTail}}</text></view>
      <text wx:if="{{subscriptionPushEnabled && crisisSubscribeAccepted}}" class="done-note">已完成安全提醒设置。家长打开小程序时首页会置顶显示。</text>
      <text class="done-note">设置已经提交，机器人收到后就能用了，一般一分钟内。等它准备好，唤醒它就能开始聊天；手机不会录音。</text>
      <view class="button-row">
        <button class="primary-button" bindtap="continueActivation">继续等待激活</button>
      </view>
      <button class="secondary-button empty-button" bindtap="openDevicePage">返回设备管理</button>
      <text class="form-note">使用人由这次绑定确定，不通过声音识别身份；之后可在「设备」页管理使用人或解除绑定。</text>
    </view>
  </block>
</view>
