.back-row {
  padding: 8rpx 0 4rpx;
}

.back-link {
  display: inline-flex;
  align-items: center;
  min-height: 88rpx;
  color: #285c5e;
  color: var(--brand-teal);
  font-size: 28rpx;
  font-weight: 500;
}

.page-head {
  padding: 12rpx 0 4rpx;
}

.bind-mode-list {
  display: flex;
  flex-direction: column;
  margin-top: 28rpx;
}

.bind-mode-list .choice-card {
  align-items: flex-start;
}

.choice-copy {
  flex: 1;
  min-width: 0;
}

.choice-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
}

.choice-desc {
  display: block;
  margin-top: 8rpx;
  color: #474e54;
  color: var(--text-secondary);
  font-size: 24rpx;
  line-height: 1.6;
}

.mode-footnote,
.form-note {
  display: block;
  margin-top: 24rpx;
  color: #474e54;
  color: var(--text-secondary);
  font-size: 22rpx;
  line-height: 1.65;
}

.field {
  margin-bottom: 12rpx;
}

.readonly-chip {
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-height: 88rpx;
  padding: 16rpx 24rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.55);
  border: 1rpx solid rgba(255, 255, 255, 0.8);
}

.readonly-code {
  color: #192f41;
  font-size: 28rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}

.readonly-hint {
  color: #474e54;
  color: var(--text-secondary);
  font-size: 24rpx;
}

.picker-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 84rpx;
  border-bottom: 1rpx solid rgba(30, 45, 70, 0.08);
}

.picker-label {
  color: #192f41;
  font-size: 28rpx;
}

.picker-value {
  color: #285c5e;
  color: var(--brand-teal);
  font-size: 26rpx;
}

.quiet-hours-row {
  display: flex;
  gap: 24rpx;
}

.quiet-hours-row .picker-row {
  flex: 1;
}

.bind-nav {
  margin-top: 32rpx;
}

.offer-row {
  display: flex;
  align-items: flex-start;
  gap: 22rpx;
  padding: 22rpx 0;
  border-bottom: 1rpx solid rgba(30, 45, 70, 0.08);
}

.offer-check {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 40rpx;
  width: 40rpx;
  height: 40rpx;
  margin-top: 2rpx;
  box-sizing: border-box;
  border: 2rpx solid rgba(30, 45, 70, 0.22);
  border-radius: 50%;
  color: #fff;
  font-size: 24rpx;
  font-weight: 700;
}

.offer-check-on {
  background: #172f43;
  border-color: #172f43;
}

.offer-copy {
  flex: 1;
  min-width: 0;
}

.offer-label {
  display: block;
  font-size: 27rpx;
  font-weight: 600;
}

.offer-desc {
  display: block;
  margin-top: 6rpx;
  color: #474e54;
  color: var(--text-secondary);
  font-size: 24rpx;
  line-height: 1.55;
}

.offer-note {
  display: block;
  margin-top: 6rpx;
  color: #855524;
  font-size: 22rpx;
}

.offer-disabled {
  opacity: 0.62;
}

.notice-copy {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.65;
}

.done-card {
  text-align: center;
}

.done-device {
  display: flex;
  justify-content: center;
  margin: 8rpx 0 0;
}

.done-badge {
  display: inline-flex;
  margin-top: 20rpx;
  padding: 8rpx 24rpx;
  border-radius: 999rpx;
  background: #e8f1ee;
  color: #346856;
  font-size: 22rpx;
}

.done-title {
  display: block;
  margin-top: 20rpx;
  font-size: 34rpx;
  font-weight: 600;
  line-height: 1.45;
}

.done-note {
  display: block;
  margin-top: 22rpx;
  color: #474e54;
  color: var(--text-secondary);
  font-size: 23rpx;
  line-height: 1.65;
  text-align: left;
}

.done-card .form-note {
  text-align: left;
}

/* 陪伴伙伴：左右滑动的卡片，两侧露出并压暗，当前卡片放大 */
.persona-hint {
  margin-top: 0;
}

.persona-swiper {
  height: 720rpx;
  margin: 8rpx -32rpx 0;
}

.persona-slide {
  display: flex;
  align-items: center;
  justify-content: center;
}

.persona-card {
  position: relative;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 100%;
  height: 680rpx;
  margin: 0 -18rpx;
  padding: 36rpx 32rpx 28rpx;
  border-radius: var(--radius-card);
  background: linear-gradient(180deg, var(--role-soft) 0%, rgba(255, 255, 255, 0.92) 62%);
  border: 1rpx solid rgba(255, 255, 255, 0.8);
  box-shadow: var(--shadow-sm);
  transform: scale(0.86);
  opacity: 0.62;
  transition: transform var(--dur-base) ease, opacity var(--dur-base) ease, box-shadow var(--dur-base) ease;
}

.persona-card-current {
  z-index: 2;
  transform: scale(1);
  opacity: 1;
  border-color: var(--role-primary);
  box-shadow: var(--shadow-md);
}

.persona-picked {
  position: absolute;
  top: 24rpx;
  right: 24rpx;
}

.persona-face {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 280rpx;
}

.persona-name {
  margin-top: 12rpx;
  color: var(--role-ink);
  font-size: 44rpx;
  font-weight: 700;
}

.persona-tagline {
  margin-top: 6rpx;
  color: var(--role-ink);
  font-size: 27rpx;
}

.persona-desc {
  margin-top: 14rpx;
  color: var(--text-secondary);
  font-size: 25rpx;
  line-height: 1.6;
  text-align: center;
}

.persona-voice {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  margin-top: auto;
  padding-top: 18rpx;
  border-top: 1rpx solid var(--border-default);
}

.persona-voice-name {
  flex: 1;
  color: var(--text-secondary);
  font-size: 24rpx;
}

.persona-play {
  margin: 0;
  padding: 0 28rpx;
  height: 60rpx;
  line-height: 60rpx;
  border-radius: 999rpx;
  background: var(--role-primary);
  color: #ffffff;
  font-size: 25rpx;
}

.persona-play-on {
  background: var(--role-ink);
}

.persona-dots {
  display: flex;
  justify-content: center;
  gap: 12rpx;
  margin: 8rpx 0 24rpx;
}

.persona-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: rgba(30, 45, 70, 0.18);
  transition: width var(--dur-base) ease;
}

.persona-dot-on {
  width: 32rpx;
  border-radius: 999rpx;
  background: var(--brand-deep);
}
