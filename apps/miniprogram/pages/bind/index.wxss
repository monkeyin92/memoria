.mode-card {
  padding-top: 36rpx;
}

.mode-card-head {
  display: flex;
  align-items: baseline;
  flex-wrap: wrap;
  gap: 16rpx;
}

.mode-card-title {
  font-size: 36rpx;
  font-weight: 600;
}

.mode-card-tagline {
  color: #326e70;
  font-size: 24rpx;
}

.mode-card-desc {
  display: block;
  margin-top: 14rpx;
  color: #596a78;
  font-size: 26rpx;
  line-height: 1.7;
}

.mode-footnote,
.form-note {
  display: block;
  margin-top: 24rpx;
  color: #596a78;
  font-size: 22rpx;
  line-height: 1.65;
}

.picker-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 84rpx;
  border-bottom: 1rpx solid #dfe6ea;
}

.picker-label {
  color: #192f41;
  font-size: 28rpx;
}

.picker-value {
  color: #326e70;
  font-size: 26rpx;
}

.quiet-hours-row {
  display: flex;
  gap: 24rpx;
}

.quiet-hours-row .picker-row {
  flex: 1;
}

.notice-card {
  box-sizing: border-box;
  margin-top: 28rpx;
  padding: 26rpx 28rpx;
  border-radius: 26rpx;
  background: #f3ede2;
}

.notice-title {
  display: block;
  color: #855524;
  font-size: 27rpx;
  font-weight: 600;
}

.notice-copy {
  display: block;
  margin-top: 10rpx;
  color: #855524;
  font-size: 24rpx;
  line-height: 1.65;
}

.form-back-button {
  flex: 0 0 220rpx;
  margin-top: 28rpx;
}

.form-next-button {
  flex: 1;
  margin-top: 28rpx;
}

.offer-row {
  display: flex;
  align-items: flex-start;
  gap: 22rpx;
  padding: 22rpx 0;
  border-bottom: 1rpx solid #dfe6ea;
}

.offer-check {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 40rpx;
  width: 40rpx;
  height: 40rpx;
  margin-top: 2rpx;
  box-sizing: border-box;
  border: 2rpx solid #c8d4dc;
  border-radius: 50%;
  color: #fff;
  font-size: 24rpx;
  font-weight: 700;
}

.offer-check-on {
  background: #172f43;
  border-color: #172f43;
}

.offer-label {
  display: block;
  font-size: 27rpx;
  font-weight: 600;
}

.offer-desc {
  display: block;
  margin-top: 6rpx;
  color: #596a78;
  font-size: 24rpx;
  line-height: 1.55;
}

.offer-note {
  display: block;
  margin-top: 6rpx;
  color: #855524;
  font-size: 22rpx;
}

.offer-disabled {
  opacity: 0.62;
}

.submit-button {
  margin-top: 32rpx;
}

.done-badge {
  display: inline-flex;
  padding: 8rpx 24rpx;
  border-radius: 999rpx;
  background: #e8f1ee;
  color: #346856;
  font-size: 22rpx;
}

.done-title {
  display: block;
  margin-top: 20rpx;
  font-size: 34rpx;
  font-weight: 600;
  line-height: 1.45;
}

.done-note {
  display: block;
  margin-top: 22rpx;
  color: #596a78;
  font-size: 23rpx;
  line-height: 1.65;
}
