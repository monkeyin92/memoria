@import "../../styles/trial-theme.wxss";

.bind-trial .picker-row {
  margin-top: 8px;
}

.bind-night-caption {
  margin: 0 0 8px;
}

.bind-submit {
  flex: 1;
}

.bind-mode-list {
  display: flex;
  flex-direction: column;
  margin-top: 16px;
}

.bind-mode-list .choice-card {
  align-items: flex-start;
}

.choice-copy {
  flex: 1;
  min-width: 0;
}

.choice-title {
  display: block;
  font-size: var(--mp-type-card);
  font-weight: 600;
}

.choice-desc {
  display: block;
  margin-top: 4px;
  color: var(--mp-ink-2);
  font-size: var(--mp-type-caption);
  line-height: var(--mp-lh-caption);
}

.mode-footnote,
.form-note {
  display: block;
  margin-top: 12px;
  color: var(--mp-ink-3);
  font-size: var(--mp-type-meta);
  line-height: var(--mp-lh-caption);
}

.field {
  margin-bottom: 8px;
}

.readonly-chip {
  display: flex;
  align-items: center;
  gap: 8px;
  box-sizing: border-box;
  min-height: 48px;
  padding: 8px 14px;
  border-radius: var(--mp-radius-inset);
  background: var(--mp-fill);
}

.readonly-code {
  color: var(--mp-ink);
  font-size: var(--mp-type-body);
  font-weight: 600;
  letter-spacing: 1px;
}

.readonly-hint {
  color: var(--mp-ink-3);
  font-size: var(--mp-type-meta);
}

.quiet-hours-block {
  margin-top: 16px;
}

.quiet-hours-label {
  display: block;
  margin-bottom: 4px;
  color: var(--mp-ink);
  font-size: var(--mp-type-body);
  font-weight: 600;
  line-height: var(--mp-lh-body);
}

.quiet-hours-row {
  display: flex;
  gap: 12px;
}

.quiet-hours-row picker {
  flex: 1;
  min-width: 0;
}

.bind-nav {
  margin-top: var(--mp-gap-card);
}

.bind-roles {
  margin-top: 0;
}

.bind-voice {
  padding-top: 16px;
  padding-bottom: 8px;
}

.bind-role-desc {
  display: block;
  color: var(--mp-ink-2);
  font-size: var(--mp-type-caption);
  line-height: var(--mp-lh-caption);
}

.bind-voice .setting-row {
  gap: 16px;
  margin-top: 8px;
  border-top: 1px solid var(--mp-line);
}

.offer-row {
  display: flex;
  align-items: flex-start;
  gap: 12px;
  padding: 12px 0;
  border-bottom: 1px solid var(--mp-line);
}

.offer-check {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 20px;
  width: 20px;
  height: 20px;
  margin-top: 2px;
  box-sizing: border-box;
  border: 1px solid var(--mp-ink-4);
  border-radius: 50%;
  color: var(--mp-on-accent);
  font-size: var(--mp-type-meta);
  font-weight: 700;
}

.offer-check-on {
  background: var(--mp-accent);
  border-color: var(--mp-accent);
}

.offer-copy {
  flex: 1;
  min-width: 0;
}

.offer-label {
  display: block;
  font-size: var(--mp-type-body);
  font-weight: 600;
}

.offer-desc {
  display: block;
  margin-top: 4px;
  color: var(--mp-ink-2);
  font-size: var(--mp-type-caption);
  line-height: var(--mp-lh-caption);
}

.offer-note {
  display: block;
  margin-top: 4px;
  color: var(--mp-sun);
  font-size: var(--mp-type-meta);
}

.offer-disabled {
  opacity: 0.6;
}

.bind-rescan {
  margin-top: 8px;
}

.done-card {
  text-align: center;
}

.done-device {
  display: flex;
  justify-content: center;
  margin-top: 4px;
}

.done-badge {
  display: inline-flex;
  margin-top: 12px;
  padding: 4px 12px;
  border-radius: var(--mp-radius-pill);
  background: var(--mp-sage-bg);
  color: var(--mp-sage);
  font-size: var(--mp-type-meta);
  font-weight: 600;
}

.done-title {
  display: block;
  margin-top: 12px;
  font-size: var(--mp-type-title);
  font-weight: 700;
  line-height: 1.4;
}

.done-note {
  display: block;
  margin-top: 12px;
  color: var(--mp-ink-2);
  font-size: var(--mp-type-caption);
  line-height: var(--mp-lh-caption);
  text-align: left;
}

.done-card .form-note {
  text-align: left;
}
