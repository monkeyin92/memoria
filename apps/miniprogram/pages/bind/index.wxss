.back-row {
  padding: 8rpx 0 4rpx;
}

.back-link {
  display: inline-flex;
  align-items: center;
  min-height: 88rpx;
  color: #285c5e;
  color: var(--brand-teal);
  font-size: 28rpx;
  font-weight: 500;
}

.page-head {
  padding: 12rpx 0 4rpx;
}

.bind-mode-list {
  display: flex;
  flex-direction: column;
  margin-top: 28rpx;
}

.bind-mode-list .choice-card {
  align-items: flex-start;
}

.choice-copy {
  flex: 1;
  min-width: 0;
}

.choice-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
}

.choice-desc {
  display: block;
  margin-top: 8rpx;
  color: #474e54;
  color: var(--text-secondary);
  font-size: 24rpx;
  line-height: 1.6;
}

.mode-footnote,
.form-note {
  display: block;
  margin-top: 24rpx;
  color: #474e54;
  color: var(--text-secondary);
  font-size: 22rpx;
  line-height: 1.65;
}

.field {
  margin-bottom: 12rpx;
}

.readonly-chip {
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-height: 88rpx;
  padding: 16rpx 24rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.55);
  border: 1rpx solid rgba(255, 255, 255, 0.8);
}

.readonly-code {
  color: #192f41;
  font-size: 28rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}

.readonly-hint {
  color: #474e54;
  color: var(--text-secondary);
  font-size: 24rpx;
}

.picker-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 84rpx;
  border-bottom: 1rpx solid rgba(30, 45, 70, 0.08);
}

.picker-label {
  color: #192f41;
  font-size: 28rpx;
}

.picker-value {
  color: #285c5e;
  color: var(--brand-teal);
  font-size: 26rpx;
}

.quiet-hours-row {
  display: flex;
  gap: 24rpx;
}

.quiet-hours-row .picker-row {
  flex: 1;
}

.bind-nav {
  margin-top: 32rpx;
}

.offer-row {
  display: flex;
  align-items: flex-start;
  gap: 22rpx;
  padding: 22rpx 0;
  border-bottom: 1rpx solid rgba(30, 45, 70, 0.08);
}

.offer-check {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 40rpx;
  width: 40rpx;
  height: 40rpx;
  margin-top: 2rpx;
  box-sizing: border-box;
  border: 2rpx solid rgba(30, 45, 70, 0.22);
  border-radius: 50%;
  color: #fff;
  font-size: 24rpx;
  font-weight: 700;
}

.offer-check-on {
  background: #172f43;
  border-color: #172f43;
}

.offer-copy {
  flex: 1;
  min-width: 0;
}

.offer-label {
  display: block;
  font-size: 27rpx;
  font-weight: 600;
}

.offer-desc {
  display: block;
  margin-top: 6rpx;
  color: #474e54;
  color: var(--text-secondary);
  font-size: 24rpx;
  line-height: 1.55;
}

.offer-note {
  display: block;
  margin-top: 6rpx;
  color: #855524;
  font-size: 22rpx;
}

.offer-disabled {
  opacity: 0.62;
}

.notice-copy {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.65;
}

.done-card {
  text-align: center;
}

.done-device {
  display: flex;
  justify-content: center;
  margin: 8rpx 0 0;
}

.done-badge {
  display: inline-flex;
  margin-top: 20rpx;
  padding: 8rpx 24rpx;
  border-radius: 999rpx;
  background: #e8f1ee;
  color: #346856;
  font-size: 22rpx;
}

.done-title {
  display: block;
  margin-top: 20rpx;
  font-size: 34rpx;
  font-weight: 600;
  line-height: 1.45;
}

.done-note {
  display: block;
  margin-top: 22rpx;
  color: #474e54;
  color: var(--text-secondary);
  font-size: 23rpx;
  line-height: 1.65;
  text-align: left;
}

.done-card .form-note {
  text-align: left;
}
