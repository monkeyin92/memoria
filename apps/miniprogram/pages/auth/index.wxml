<view class="page-shell auth-wrap">
  <page-backdrop theme="mist"></page-backdrop>
  <view class="mem-hero auth-hero" data-role="starlight">
    <view class="auth-copy">
      <text class="eyebrow auth-copy-line">家庭桌面陪伴终端</text>
      <text class="page-title auth-copy-line">先打个招呼，&#10;再慢慢认识。</text>
    </view>
    <view class="auth-device"><device-screen online="{{true}}" size="240"></device-screen></view>
  </view>

  <view class="auth-points">
    <view class="auth-point">
      <glass-icon name="shield" size="56"></glass-icon>
      <text class="auth-point-text">对话经云端安全处理，只为你服务</text>
    </view>
    <view class="auth-point">
      <glass-icon name="memory" size="56"></glass-icon>
      <text class="auth-point-text">记忆档案由你掌控，随时查看</text>
    </view>
    <view class="auth-point">
      <glass-icon name="export" size="56"></glass-icon>
      <text class="auth-point-text">支持导出与删除，删除可证明</text>
    </view>
  </view>

  <view class="l2-card auth-card">
    <text class="auth-intro">{{reasonHint}}</text>
    <view class="compliance-notice">
      <text class="compliance-line">连接设备、查看回顾、管理资料。对话在设备上完成，手机不录音。</text>
      <text class="compliance-line">设备回应由人工智能生成，会明确标识；模型训练默认关闭。</text>
      <text class="compliance-line">使用人由设备绑定确定，不通过声音识别身份；声音复刻需要单独授权。</text>
    </view>

    <view class="auth-user">
      <button
        class="avatar-button"
        open-type="chooseAvatar"
        bindchooseavatar="onChooseAvatar"
        disabled="{{loading}}"
        aria-label="选择微信头像"
      >
        <image wx:if="{{avatarPath}}" class="avatar-preview" src="{{avatarPath}}" mode="aspectFill" />
        <view wx:else class="avatar-placeholder">选择头像</view>
      </button>
      <view class="auth-user-copy">
        <text class="auth-user-name">微信用户</text>
        <text class="auth-user-sub">头像与昵称，登录后再完善</text>
      </view>
    </view>
    <text class="field-help">头像可选，登录成功后会安全保存到 Memoria。</text>

    <text class="field-label">怎么称呼你？{{needsSalutation ? ' *' : ''}}</text>
    <input
      class="field-input"
      type="nickname"
      value="{{nickname}}"
      maxlength="24"
      placeholder="例如：朋友、主人、小明"
      placeholder-class="field-placeholder"
      bindinput="onNicknameInput"
      disabled="{{loading}}"
    />
    <text class="field-help">首次注册后，我会在自然的对话里这样称呼你。</text>

    <checkbox-group class="consent-row" bindchange="onConsentChange">
      <label class="consent-label">
        <checkbox value="accepted" checked="{{consented}}" color="#326e70" />
        <text>我已阅读并同意</text>
      </label>
      <text class="privacy-link" bindtap="openPrivacy">《隐私保护指引》</text>
    </checkbox-group>

    <text wx:if="{{error}}" class="error-text auth-error">{{error}}</text>
    <button
      class="primary-button auth-submit"
      open-type="getPhoneNumber"
      bindgetphonenumber="onGetPhoneNumber"
      loading="{{loading}}"
      disabled="{{loading || !consented}}"
      aria-label="授权手机号并使用微信登录"
    >授权手机号并登录</button>
    <text class="login-note">已登录过的微信会自动恢复；首次登录需要手机号用于账号绑定，不会公开展示。</text>
    <text class="login-note">登录仅用于绑定家庭设备，不会同步任何对话内容</text>
  </view>
</view>
