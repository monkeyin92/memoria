<view class="page-shell auth-page">
  <view class="auth-copy">
    <text class="eyebrow auth-copy-line">家庭桌面档案终端</text>
    <text class="page-title auth-copy-line">微信登录 Memoria</text>
  </view>

  <view class="card auth-card">
    <text class="auth-intro">{{reasonHint}}</text>
    <view class="compliance-notice">
      <text class="compliance-line">连接设备、查看回顾、管理资料。对话在设备上完成，手机不录音。</text>
      <text class="compliance-line">设备回应由人工智能生成，会明确标识；模型训练默认关闭。</text>
      <text class="compliance-line">声纹属于敏感生物识别信息，只在设备端采集。</text>
    </view>

    <button
      class="avatar-button"
      open-type="chooseAvatar"
      bindchooseavatar="onChooseAvatar"
      disabled="{{loading}}"
      aria-label="选择微信头像"
    >
      <image wx:if="{{avatarPath}}" class="avatar-preview" src="{{avatarPath}}" mode="aspectFill" />
      <view wx:else class="avatar-placeholder">选择头像</view>
    </button>
    <text class="field-help">头像可选，登录成功后会安全保存到 Memoria。</text>

    <text class="field-label">怎么称呼你？{{needsSalutation ? ' *' : ''}}</text>
    <input
      class="field-input"
      type="nickname"
      value="{{nickname}}"
      maxlength="24"
      placeholder="例如：朋友、主人、小明"
      placeholder-class="field-placeholder"
      bindinput="onNicknameInput"
      disabled="{{loading}}"
    />
    <text class="field-help">首次注册后，我会在自然的对话里这样称呼你。</text>

    <checkbox-group class="consent-row" bindchange="onConsentChange">
      <label class="consent-label">
        <checkbox value="accepted" checked="{{consented}}" color="#326e70" />
        <text>我已阅读并同意</text>
      </label>
      <text class="privacy-link" bindtap="openPrivacy">《隐私保护指引》</text>
    </checkbox-group>

    <text wx:if="{{error}}" class="error-text auth-error">{{error}}</text>
    <button
      class="primary-button auth-submit"
      open-type="getPhoneNumber"
      bindgetphonenumber="onGetPhoneNumber"
      loading="{{loading}}"
      disabled="{{loading || !consented}}"
      aria-label="授权手机号并使用微信登录"
    >授权手机号并登录</button>
    <text class="login-note">已登录过的微信会自动恢复；首次登录需要手机号用于账号绑定，不会公开展示。</text>
  </view>
</view>
