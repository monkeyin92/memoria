<view class="page-shell auth-wrap sub-page" style="{{statusBarStyle}}">
  <view class="nav-back" bindtap="goBack" aria-label="返回"><image class="nav-back-icon" src="/assets/ui/v4/back-strong.svg" /></view>
  <text class="page-title">登录</text>
  <text class="page-lede">登录后可以绑定和管理你的设备。手机号只用于绑定账号，不会公开展示。</text>

  <view class="auth-consent" bindtap="toggleAccountConsent" aria-role="checkbox" aria-checked="{{accountAgreed}}">
    <view class="auth-check {{accountAgreed ? 'auth-check-on' : ''}}">
      <image wx:if="{{accountAgreed}}" class="auth-check-icon" src="/assets/ui/v4/check-white-bold.svg" />
    </view>
    <view class="auth-consent-copy">我已阅读并同意<text class="legal-link" catchtap="openUserAgreement">《用户服务协议》</text>和<text class="legal-link" catchtap="openPrivacyPolicy">《隐私政策》</text></view>
  </view>

  <text wx:if="{{error}}" class="error-text auth-error">{{error}}</text>
  <button
    wx:if="{{accountAgreed}}"
    class="trial-primary"
    open-type="getPhoneNumber"
    bindgetphonenumber="onGetPhoneNumber"
    loading="{{loading}}"
    disabled="{{loading}}"
    aria-label="登录"
  >登录</button>
  <button
    wx:else
    class="trial-primary"
    bindtap="onLoginWithoutConsent"
    disabled="{{loading}}"
    aria-label="登录"
  >登录</button>
  <text wx:if="{{reasonHint}}" class="login-note auth-reason">{{reasonHint}}</text>
</view>
