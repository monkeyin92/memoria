@import "../../styles/trial-theme.wxss";

.auth-wrap {
  padding-bottom: calc(12px + env(safe-area-inset-bottom));
}

.auth-consent {
  display: flex;
  align-items: flex-start;
  gap: 12px;
  margin: 8px 0 16px;
  color: var(--mp-ink-2);
  font-size: var(--mp-type-small);
  line-height: var(--mp-lh-body);
}

.auth-consent-copy {
  flex: 1;
  min-width: 0;
}

.auth-check {
  display: flex;
  flex: none;
  align-items: center;
  justify-content: center;
  width: 24px;
  height: 24px;
  border-radius: 8px;
  background: var(--mp-surface);
  box-shadow: inset 0 0 0 1.5px var(--mp-ink-4);
}

.auth-check-on {
  background: var(--mp-accent);
  box-shadow: none;
}

.auth-check-icon {
  width: 16px;
  height: 16px;
}

.legal-link {
  color: var(--mp-ink);
  font-weight: 600;
}

.auth-error {
  margin: -8px 0 8px;
  text-align: center;
}

.login-note {
  display: block;
  margin-top: 8px;
  color: var(--mp-ink-3);
  font-size: var(--mp-type-meta);
  line-height: 16px;
  text-align: center;
}
