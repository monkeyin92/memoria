.auth-page {
  display: flex;
  min-height: 100vh;
  box-sizing: border-box;
  flex-direction: column;
  justify-content: center;
}

.auth-copy {
  text-align: center;
}

.auth-copy-line {
  display: block;
}

.auth-copy .eyebrow {
  display: inline-flex;
}

.auth-copy .page-title {
  font-size: 46rpx;
  text-shadow: 0 0 32rpx rgba(34, 229, 255, 0.3);
}

.auth-card {
  margin-top: 32rpx;
}

.auth-intro,
.field-help,
.login-note {
  display: block;
  color: #8d99c4;
  font-size: 25rpx;
  line-height: 1.6;
}

.compliance-notice {
  margin: 24rpx 0;
  padding: 24rpx;
  border: 1rpx solid rgba(94, 234, 255, 0.18);
  border-radius: 24rpx;
  background: rgba(16, 23, 52, 0.55);
}

.compliance-line {
  display: block;
  color: #a8b4dc;
  font-size: 24rpx;
  line-height: 1.65;
}

.compliance-line + .compliance-line {
  margin-top: 12rpx;
}

.avatar-button {
  display: flex;
  width: 152rpx;
  height: 152rpx;
  min-height: 152rpx;
  margin: 28rpx auto 0;
  padding: 0;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  border: 2rpx solid rgba(94, 234, 255, 0.48);
  border-radius: 50%;
  color: #7ceaff;
  background: rgba(34, 229, 255, 0.08);
  font-size: 24rpx;
}

.avatar-preview {
  width: 100%;
  height: 100%;
}

.avatar-placeholder {
  padding: 24rpx;
  line-height: 1.35;
}

.field-help {
  margin-top: 14rpx;
  text-align: center;
}

.field-label {
  display: block;
  margin: 28rpx 0 12rpx;
  color: #9db4e8;
  font-size: 26rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}

.field-input {
  height: 88rpx;
  box-sizing: border-box;
  padding: 0 26rpx;
  border: 1rpx solid rgba(94, 234, 255, 0.26);
  border-radius: 999rpx;
  color: #f2f5ff;
  background: rgba(255, 255, 255, 0.05);
  font-size: 29rpx;
}

.field-placeholder {
  color: #5d688f;
}

.consent-row {
  display: flex;
  min-height: 88rpx;
  margin-top: 18rpx;
  align-items: center;
  justify-content: center;
  color: #9aa6cf;
  font-size: 25rpx;
}

.consent-label {
  display: flex;
  min-height: 88rpx;
  align-items: center;
}

.privacy-link {
  display: flex;
  min-height: 88rpx;
  margin-left: 8rpx;
  align-items: center;
  color: #7ceaff;
}

.auth-error {
  color: #ff8ba3;
}

.auth-submit {
  margin-top: 20rpx;
}

.auth-submit[disabled] {
  opacity: 0.55;
}

.login-note {
  margin-top: 20rpx;
  text-align: center;
}
