.auth-wrap {
  padding-top: 40rpx;
}

.auth-hero {
  margin-top: 24rpx;
}

.auth-copy-line {
  display: block;
}

.auth-hero .eyebrow {
  color: #9fc4c2;
  font-size: 22rpx;
  letter-spacing: 4rpx;
}

.auth-copy .page-title {
  margin-top: 12rpx;
  color: #ffffff;
  font-family: "Songti SC", "Noto Serif SC", "STSong", serif;
  font-size: 60rpx;
  font-weight: 600;
  line-height: 1.35;
  white-space: pre-line;
}

.auth-hero face-badge {
  display: flex;
  margin: 32rpx auto 4rpx;
}

.auth-points {
  margin: 28rpx 0 4rpx;
}

.auth-point {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 10rpx 0;
}

.auth-point .inline-icon {
  flex: none;
  color: #326e70;
}

.auth-point-text {
  color: #5c6b76;
  font-size: 26rpx;
  line-height: 1.6;
}

.auth-card {
  margin-top: 24rpx;
}

.auth-intro,
.field-help,
.login-note {
  display: block;
  color: #596a78;
  font-size: 25rpx;
  line-height: 1.6;
}

.compliance-notice {
  margin: 24rpx 0;
  padding: 24rpx;
  border-radius: 24rpx;
  background: #e8f0ef;
}

.compliance-line {
  display: block;
  color: #285b5c;
  font-size: 24rpx;
  line-height: 1.65;
}

.compliance-line + .compliance-line {
  margin-top: 12rpx;
}

.auth-user {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-bottom: 12rpx;
  padding: 24rpx;
  border-radius: 32rpx;
  background: #f4f6f8;
}

.avatar-button {
  display: flex;
  width: 120rpx;
  height: 120rpx;
  min-height: 120rpx;
  flex: none;
  margin: 0;
  padding: 0;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  border: 2rpx solid #c9d5dd;
  border-radius: 50%;
  color: #326e70;
  background: #ffffff;
  font-size: 24rpx;
}

.avatar-preview {
  width: 100%;
  height: 100%;
}

.avatar-placeholder {
  padding: 24rpx;
  line-height: 1.35;
}

.auth-user-copy {
  flex: 1;
  min-width: 0;
}

.auth-user-name {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
}

.auth-user-sub {
  display: block;
  margin-top: 6rpx;
  color: #93a1ab;
  font-size: 24rpx;
}

.consent-row {
  display: flex;
  min-height: 88rpx;
  margin-top: 18rpx;
  align-items: center;
  justify-content: center;
  color: #596a78;
  font-size: 25rpx;
}

.consent-label {
  display: flex;
  min-height: 88rpx;
  align-items: center;
}

.privacy-link {
  display: flex;
  min-height: 88rpx;
  margin-left: 8rpx;
  align-items: center;
  color: #326e70;
}

.auth-submit {
  margin-top: 20rpx;
}

.auth-submit[disabled] {
  opacity: 0.55;
}

.login-note {
  margin-top: 16rpx;
  text-align: center;
}
