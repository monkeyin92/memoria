.auth-wrap {
  padding-top: 48rpx;
}

.auth-copy-line {
  display: block;
}

.auth-title {
  margin-top: 32rpx;
}

.auth-title .page-title {
  margin-top: 0;
}

.auth-facts {
  margin-top: 48rpx;
  padding: 16rpx 0;
}

.auth-fact {
  display: flex;
  align-items: flex-start;
  gap: 32rpx;
  padding: 32rpx;
}

.auth-fact + .auth-fact {
  border-top: 2rpx solid var(--mp-line);
}

.auth-fact-copy {
  flex: 1;
  min-width: 0;
}

.auth-fact-title {
  display: block;
  color: var(--mp-ink);
  font-size: var(--mp-type-card);
  font-weight: 600;
  line-height: var(--mp-lh-card);
}

.auth-fact-sub {
  display: block;
  margin-top: 8rpx;
  color: var(--mp-ink-2);
  font-size: var(--mp-type-caption);
  line-height: var(--mp-lh-caption);
}

.auth-caption {
  margin: 24rpx 8rpx 0;
}

.auth-card {
  margin-top: var(--mp-gap-card);
}

.auth-intro,
.field-help,
.login-note {
  display: block;
  color: var(--mp-ink-2);
  font-size: var(--mp-type-meta);
  line-height: var(--mp-lh-caption);
}

.auth-intro {
  margin-bottom: 24rpx;
}

.field-help {
  margin-top: 16rpx;
}

.auth-user {
  display: flex;
  align-items: center;
  gap: 32rpx;
}

.avatar-button {
  display: flex;
  flex: none;
  align-items: center;
  justify-content: center;
  width: 112rpx;
  height: 112rpx;
  min-height: 112rpx;
  margin: 0;
  padding: 0;
  overflow: hidden;
  border: none;
  border-radius: 50%;
  background: var(--mp-accent-soft);
  color: var(--mp-accent);
  font-size: var(--mp-type-meta);
}

.avatar-preview {
  width: 100%;
  height: 100%;
}

.avatar-placeholder {
  padding: 16rpx;
  line-height: 1.35;
}

.auth-user-copy {
  flex: 1;
  min-width: 0;
}

.auth-user-name {
  display: block;
  color: var(--mp-ink);
  font-size: var(--mp-type-card);
  font-weight: 600;
  line-height: var(--mp-lh-card);
}

.auth-user-sub {
  display: block;
  margin-top: 4rpx;
  color: var(--mp-ink-3);
  font-size: var(--mp-type-meta);
  line-height: var(--mp-lh-caption);
}

.consent-row {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  min-height: var(--mp-tap);
  margin-top: 32rpx;
  color: var(--mp-ink-2);
  font-size: var(--mp-type-caption);
}

.consent-label {
  display: flex;
  align-items: center;
  gap: 8rpx;
  min-height: 88rpx;
}

.privacy-link {
  display: flex;
  align-items: center;
  min-height: 88rpx;
  color: var(--mp-ink);
  font-weight: 600;
}

.auth-submit {
  margin-top: 16rpx;
}

.login-note {
  margin-top: 16rpx;
  text-align: center;
}
