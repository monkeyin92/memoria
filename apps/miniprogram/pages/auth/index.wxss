.auth-page {
  display: flex;
  min-height: 100vh;
  box-sizing: border-box;
  flex-direction: column;
  justify-content: center;
}

.auth-copy {
  text-align: center;
}

.auth-copy-line {
  display: block;
}

.auth-copy .page-title {
  font-size: 46rpx;
}

.auth-card {
  margin-top: 32rpx;
}

.auth-intro,
.field-help,
.login-note {
  display: block;
  color: #596a78;
  font-size: 25rpx;
  line-height: 1.6;
}

.compliance-notice {
  margin: 24rpx 0;
  padding: 24rpx;
  border-radius: 24rpx;
  background: #e8f0ef;
}

.compliance-line {
  display: block;
  color: #285b5c;
  font-size: 24rpx;
  line-height: 1.65;
}

.compliance-line + .compliance-line {
  margin-top: 12rpx;
}

.avatar-button {
  display: flex;
  width: 152rpx;
  height: 152rpx;
  min-height: 152rpx;
  margin: 28rpx auto 0;
  padding: 0;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  border: 2rpx solid #c9d5dd;
  border-radius: 50%;
  color: #326e70;
  background: #f4f6f8;
  font-size: 24rpx;
}

.avatar-preview {
  width: 100%;
  height: 100%;
}

.avatar-placeholder {
  padding: 24rpx;
  line-height: 1.35;
}

.field-help {
  margin-top: 14rpx;
  text-align: center;
}

.consent-row {
  display: flex;
  min-height: 88rpx;
  margin-top: 18rpx;
  align-items: center;
  justify-content: center;
  color: #596a78;
  font-size: 25rpx;
}

.consent-label {
  display: flex;
  min-height: 88rpx;
  align-items: center;
}

.privacy-link {
  display: flex;
  min-height: 88rpx;
  margin-left: 8rpx;
  align-items: center;
  color: #326e70;
}

.auth-submit {
  margin-top: 20rpx;
}

.auth-submit[disabled] {
  opacity: 0.55;
}

.login-note {
  margin-top: 20rpx;
  text-align: center;
}
