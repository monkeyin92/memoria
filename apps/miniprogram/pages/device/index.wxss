@import "../../styles/trial-theme.wxss";

.device-trial-head {
  min-height: 0;
  margin: 0;
  padding: 0;
  background: transparent;
}

.device-setting-copy {
  flex: 1;
  min-width: 0;
}

.device-setting-copy .trial-caption {
  margin-top: 4px;
}

.device-usage-card {
  display: flex;
  align-items: center;
  gap: 24px;
  margin-top: 24px;
  padding: 16px 24px;
}

.device-ring {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 112px;
  height: 112px;
  border-radius: 50%;
  background: var(--mp-track);
}

.device-ring-inner {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 88px;
  height: 88px;
  border-radius: 50%;
  background: var(--mp-surface);
}

.device-ring-num {
  color: var(--mp-ink);
  font-size: var(--mp-type-display);
  font-weight: 700;
  line-height: 32px;
  letter-spacing: -1px;
  font-variant-numeric: tabular-nums;
}

.device-ring-num.is-unset {
  font-size: var(--mp-type-title);
}

.device-ring-cap {
  margin-top: 4px;
  color: var(--mp-ink-3);
  font-size: var(--mp-type-micro);
}

.device-usage-copy {
  flex: 1;
  min-width: 0;
}

.device-usage-title {
  display: block;
  margin-bottom: 8px;
  color: var(--mp-ink);
  font-size: var(--mp-type-button);
  font-weight: 600;
  line-height: var(--mp-lh-card);
}

.device-usage-remaining {
  white-space: nowrap;
}

.device-limit-card {
  margin-top: var(--mp-gap-card);
  padding: 24px;
}

.device-limit-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.device-limit-label {
  color: var(--mp-ink);
  font-size: var(--mp-type-card);
  font-weight: 600;
}

.device-limit-num {
  color: var(--mp-ink);
  font-size: var(--mp-type-display);
  font-weight: 700;
  letter-spacing: -1px;
  font-variant-numeric: tabular-nums;
}

.device-limit-unit {
  color: var(--mp-ink-2);
  font-size: var(--mp-type-small);
}

.device-limit-range {
  display: flex;
  justify-content: space-between;
  color: var(--mp-ink-3);
  font-size: var(--mp-type-meta);
}

.device-limit-divider {
  height: 1px;
  margin: 16px 0;
  background: var(--mp-line);
}

.device-quiet-card {
  display: flex;
  align-items: center;
  gap: 16px;
  margin-top: var(--mp-gap-card);
  padding: 16px;
}

.device-quiet-title {
  color: var(--mp-ink);
  font-size: var(--mp-type-card);
  font-weight: 600;
}

.device-quiet-card .trial-caption {
  line-height: normal;
}

.device-quiet-chip {
  flex-shrink: 0;
  height: 24px;
  padding: 0 12px;
  border-radius: var(--mp-radius-pill);
  background: var(--mp-accent-soft);
  color: var(--mp-accent);
  font-size: var(--mp-type-meta);
  font-weight: 600;
  line-height: 24px;
  white-space: nowrap;
}

.device-privacy-block {
  margin-top: var(--mp-gap-card);
}

.device-privacy-block .trial-inset-label {
  flex: 1;
}

.device-header {
  padding: 4px 0 6px;
}

.device-header .page-title {
  margin-bottom: 6px;
}

/* L2 音量卡：复用全局 l2-card / slider，只补数字与刻度 */
.volume-num {
  flex-shrink: 0;
  color: var(--mp-ink);
  font-size: var(--mp-type-title);
  font-weight: 600;
}

.slider-scale {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 4px;
  color: var(--mp-ink-3);
  font-size: var(--mp-type-meta);
}

/* L3 行内数值：唤醒词、网络、备注的当前值 */
.row-value {
  flex: 0 1 auto;
  min-width: 0;
  max-width: 50%;
  overflow: visible;
  color: var(--mp-ink-2);
  font-size: var(--mp-type-caption);
  line-height: var(--mp-lh-caption);
  text-align: right;
  white-space: normal;
  word-break: break-word;
}

.row-value-warn {
  color: var(--mp-sun);
}

.list-row-hover {
  opacity: 0.6;
}

.row-title-danger,
.row-copy .row-title-danger {
  color: var(--mp-rust);
}

/* 年龄申报：三个选项各占一格，间距分开 */
.option-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin-top: 12px;
}

.option-chip {
  box-sizing: border-box;
  flex: 1 1 90px;
  min-height: 42px;
  padding: 9px 10px;
  border: 1px solid var(--mp-line);
  border-radius: var(--mp-radius-icon);
  background: var(--mp-surface);
  color: var(--mp-ink);
  font-size: var(--mp-type-caption);
  line-height: 1.4;
  text-align: center;
}

.option-chip-on {
  border-color: var(--mp-accent);
  background: var(--mp-accent-soft);
  color: var(--mp-accent);
  font-weight: 600;
}

.card-action {
  margin-top: 14px;
}

.style-labels {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
  margin-top: 10px;
}

.alert-row {
  margin-top: 8px;
}

.summary-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 12px;
  padding: 6px 0;
}

.summary-key {
  color: var(--mp-ink-2);
}

.summary-value {
  flex: 1;
  text-align: right;
  overflow-wrap: anywhere;
}

/* 底部抽屉：高度封顶，选项区单独滚动，按钮始终露在底部 */
.device-sheet {
  display: flex;
  flex-direction: column;
  max-height: 86vh;
}

.sheet-scroll {
  flex: 1;
  min-height: 0;
  max-height: 56vh;
}

.sheet-custom {
  padding: 2px 2px 6px;
}

.sheet-action {
  flex-shrink: 0;
  margin-top: 12px;
}

.sheet-cancel {
  flex-shrink: 0;
  width: 100%;
  margin-top: 4px;
}

/* 底部抽屉选项：复用全局 .sheet / .sheet-grab / .sheet-title / .sheet-sub */
.sheet-opt {
  display: flex;
  align-items: center;
  flex-shrink: 0;
  gap: 10px;
  min-height: 56px;
  margin-top: 8px;
  padding: 10px 12px;
  border: 1px solid var(--mp-line);
  border-radius: var(--mp-radius-inset);
  background: var(--mp-surface);
}

.sheet-opt.on {
  border-color: var(--mp-accent);
  background: var(--mp-accent-soft);
}

.sheet-opt .opt-check {
  display: none;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 18px;
  height: 18px;
  color: var(--mp-accent);
}

.sheet-opt.on .opt-check {
  display: flex;
}

.sheet-opt.on .choice-radio { border-color: var(--mp-accent); background: var(--mp-accent); box-shadow: inset 0 0 0 4px var(--mp-surface); }

/* 解绑结果：每行独立节点，长句在窄屏自动折行 */
.unbind-result-card {
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  max-width: 100%;
}

.unbind-result-lines {
  margin-top: 12px;
}

.unbind-result-line {
  display: block;
  color: var(--mp-ink-2);
  font-size: var(--mp-type-body);
  line-height: var(--mp-lh-body);
  text-align: center;
  white-space: normal;
  word-break: break-word;
}

.unbind-result-line + .unbind-result-line {
  margin-top: 6px;
}

.unbind-result-action {
  margin-top: 20px;
}

/* 使用时段：卡片标题行的「修改」与抽屉里的选择行 */
.limits-edit { margin: 0; padding: 0 0 0 12px; }
.limits-quiet-label {
  display: block;
  margin: 4px 0 0;
  color: var(--mp-ink);
  font-size: var(--mp-type-body);
  font-weight: 600;
  line-height: 1.45;
}
.limits-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 48px;
  border-bottom: 1px solid var(--mp-line);
}

/* 唤醒方式：两个开关（唤醒词 / 点击屏幕）与说明 */
.wake-mode-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
}
.wake-mode-row {
  display: flex;
  align-items: center;
  gap: 12px;
  min-height: 60px;
  padding: 8px 0;
  border-bottom: 0.5px solid var(--mp-line);
}
.wake-mode-note { margin-top: 8px; }
.wake-mode-note-warn { color: var(--mp-sun); }
.device-page-heading { display: flex; align-items: flex-end; justify-content: space-between; gap: 12px; margin-bottom: 20px; }
.device-add { display: flex; align-items: center; justify-content: center; flex-shrink: 0; width: 44px; height: 44px; margin: 36px 0 0; padding: 0; border-radius: 50%; background: var(--mp-paper); color: var(--mp-forest); font-size: var(--mp-type-display); line-height: 1; }
.device-hero { padding: 20px; border-radius: 24px; background: var(--mp-screen); color: var(--mp-on-accent); }
.device-hero-heading { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 12px; }
.device-hero-name { display: block; flex: 1; min-width: 120px; font-size: var(--mp-type-lead); font-weight: 600; line-height: 1.5; overflow-wrap: anywhere; }
.device-hero-hint { display: block; margin-top: 14px; font-size: var(--mp-type-meta); color: var(--mp-on-accent); }
.device-hero .trial-status-pill { background: var(--mp-cyan); color: var(--mp-screen); }
.device-hero .trial-status-pill.is-off { background: var(--mp-fill); color: var(--mp-screen); }
.device-default-voice { display: flex; align-items: center; gap: 12px; margin-top: 18px; padding-top: 16px; border-top: 1px solid var(--mp-line); }
.device-voice-wave { display: flex; align-items: center; justify-content: center; gap: 3px; width: 36px; height: 36px; }
.device-voice-wave view { width: 3px; height: 12px; border-radius: 3px; background: var(--mp-accent); }
.device-voice-wave view:nth-child(2), .device-voice-wave view:nth-child(4) { height: 22px; }
.device-voice-wave view:nth-child(3) { height: 30px; }
.device-volume-label { display: flex; align-items: center; gap: 10px; }
.device-volume-card .setting-row { justify-content: space-between; margin-bottom: 4px; }
.device-controls { margin-top: 12px; }
.device-usage-card { margin-top: 10px; gap: 16px; padding: 16px; }
.device-ring { width: 80px; height: 80px; }
.device-ring-inner { width: 66px; height: 66px; }
.device-ring-num { font-size: var(--mp-type-headline); }
.device-ring-cap { margin-top: 0; font-size: var(--mp-type-micro); }
.device-usage-title { font-size: var(--mp-type-small); }
.device-limit-card { padding: 16px; }
.device-limit-num { font-size: var(--mp-type-heading); }
.device-quiet-card { background: var(--mp-paper); gap: 10px; }
.device-quiet-card .device-setting-copy { display: flex; align-items: center; flex-wrap: wrap; gap: 10px; }
.device-quiet-description { flex: 1; min-width: 110px; }
.device-quiet-chip { background: var(--mp-glass); font-size: var(--mp-type-meta); }
.device-quiet-title { font-size: var(--mp-type-small); }
.device-quiet-card .trial-caption { font-size: var(--mp-type-meta); line-height: 1.6; }
.device-member-entry { background: var(--mp-surface); }
.device-help { font-size: var(--mp-type-meta); text-align: center; }
.device-more-entry { margin-top: 16px; background: var(--mp-surface); }
