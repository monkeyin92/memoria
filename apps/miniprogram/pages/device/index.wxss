.loading-text {
  display: block;
  color: #8d99c4;
  font-size: 26rpx;
}

.empty-card {
  padding-top: 44rpx;
  padding-bottom: 44rpx;
}

.empty-badge {
  display: inline-flex;
  align-items: center;
  padding: 8rpx 24rpx;
  border: 1rpx solid rgba(94, 234, 255, 0.32);
  border-radius: 999rpx;
  background: rgba(34, 229, 255, 0.08);
  color: #7ceaff;
  font-size: 22rpx;
  letter-spacing: 4rpx;
}

.empty-copy {
  display: block;
  margin-top: 20rpx;
  color: #8d99c4;
  font-size: 26rpx;
  line-height: 1.7;
}

.empty-title {
  display: block;
  margin-top: 16rpx;
  color: #f2f5ff;
  font-size: 34rpx;
  font-weight: 750;
}

.empty-button {
  margin-top: 32rpx;
}

.empty-button + .empty-button {
  margin-top: 18rpx;
}

.sync-error-badge {
  border-color: rgba(255, 179, 92, 0.38);
  background: rgba(255, 155, 64, 0.1);
  color: #ffc285;
}

.sync-warning {
  display: block;
  box-sizing: border-box;
  margin-bottom: 24rpx;
  padding: 18rpx 22rpx;
  border: 1rpx solid rgba(255, 179, 92, 0.3);
  border-radius: 20rpx;
  background: rgba(46, 34, 18, 0.62);
  color: #ffc285;
  font-size: 23rpx;
  line-height: 1.55;
}

.binding-choice {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  box-sizing: border-box;
  min-height: 96rpx;
  margin-top: 18rpx;
  padding: 22rpx 26rpx;
  border: 1rpx solid rgba(94, 234, 255, 0.18);
  border-radius: 24rpx;
  background: rgba(8, 14, 36, 0.5);
}

.binding-choice-copy {
  flex: 1;
  min-width: 0;
}

.binding-choice-name,
.binding-choice-meta {
  display: block;
}

.binding-choice-name {
  color: #f2f5ff;
  font-size: 28rpx;
  font-weight: 650;
}

.binding-choice-meta {
  margin-top: 6rpx;
  color: #8d99c4;
  font-size: 22rpx;
}

.binding-choice-arrow {
  color: #7ceaff;
  font-size: 38rpx;
}

.device-status-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  margin-top: 22rpx;
}

.device-status-item {
  box-sizing: border-box;
  min-height: 112rpx;
  padding: 20rpx;
  border: 1rpx solid rgba(94, 234, 255, 0.12);
  border-radius: 22rpx;
  background: rgba(8, 14, 36, 0.48);
}

.device-status-label {
  display: block;
  color: #6b779f;
  font-size: 22rpx;
}

.device-status-value {
  display: block;
  margin-top: 10rpx;
  color: #dfe7ff;
  font-size: 24rpx;
  line-height: 1.4;
}

.device-action-row {
  margin-top: 24rpx;
}

.summary-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 24rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid rgba(94, 234, 255, 0.1);
}

.summary-row:last-child {
  border-bottom: none;
}

.summary-key {
  color: #8d99c4;
  font-size: 25rpx;
}

.summary-value {
  color: #f2f5ff;
  font-size: 26rpx;
  font-weight: 600;
  text-align: right;
}

.summary-mono {
  font-size: 22rpx;
  word-break: break-all;
}

.form-note {
  display: block;
  margin-top: 20rpx;
  color: #6b779f;
  font-size: 23rpx;
  line-height: 1.65;
}

.current-user-chip {
  display: inline-flex;
  align-items: center;
  gap: 18rpx;
  margin-top: 8rpx;
  padding: 18rpx 28rpx;
  border: 1rpx solid rgba(94, 234, 255, 0.32);
  border-radius: 999rpx;
  background: rgba(34, 229, 255, 0.08);
}

.current-user-name {
  color: #f2f5ff;
  font-size: 28rpx;
  font-weight: 700;
}

.current-user-state {
  color: #7ceaff;
  font-size: 22rpx;
}

.current-user-empty {
  margin-top: 16rpx;
}

.candidate-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  box-sizing: border-box;
  margin-top: 22rpx;
  padding: 24rpx 26rpx;
  border: 1rpx solid rgba(94, 234, 255, 0.14);
  border-radius: 24rpx;
  background: rgba(16, 23, 52, 0.5);
}

.candidate-selected {
  border-color: rgba(34, 229, 255, 0.55);
  box-shadow: 0 0 24rpx rgba(34, 229, 255, 0.16);
}

.candidate-copy {
  flex: 1;
  min-width: 0;
}

.candidate-name {
  display: block;
  color: #f2f5ff;
  font-size: 28rpx;
  font-weight: 600;
}

.candidate-relation {
  display: block;
  margin-top: 4rpx;
  color: #7ceaff;
  font-size: 22rpx;
}

.candidate-confidence {
  flex: 0 0 200rpx;
}

.confidence-track {
  height: 10rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.08);
}

.confidence-value {
  height: 100%;
  border-radius: inherit;
}

.confidence-high {
  background: linear-gradient(90deg, #22e5ff, #8b68ff);
}

.confidence-low {
  background: rgba(255, 179, 92, 0.75);
}

.confidence-label {
  display: block;
  margin-top: 8rpx;
  color: #7ceaff;
  font-size: 20rpx;
  text-align: right;
}

.confidence-low-text {
  color: #ffc285;
}

.confirm-button {
  margin-top: 28rpx;
}

.degradation-card {
  border-color: rgba(255, 179, 92, 0.28);
  background: rgba(46, 34, 18, 0.5);
}

.degradation-badge {
  display: inline-flex;
  align-items: center;
  padding: 8rpx 24rpx;
  border: 1rpx solid rgba(255, 179, 92, 0.4);
  border-radius: 999rpx;
  background: rgba(255, 155, 64, 0.1);
  color: #ffc285;
  font-size: 22rpx;
  letter-spacing: 4rpx;
}

.degradation-reason {
  display: block;
  margin-top: 16rpx;
  color: #f2d8b8;
  font-size: 26rpx;
  line-height: 1.6;
}

.degradation-columns {
  display: flex;
  gap: 22rpx;
  margin-top: 24rpx;
}

.degradation-column {
  flex: 1;
  min-width: 0;
}

.degradation-column-title {
  display: block;
  margin-bottom: 10rpx;
  color: #b8c6ed;
  font-size: 22rpx;
  font-weight: 700;
}

.degradation-forbidden-title {
  color: #ffb9c8;
}

.degradation-item {
  display: block;
  margin-top: 6rpx;
  color: #8d99c4;
  font-size: 20rpx;
  line-height: 1.5;
}

.degradation-forbidden {
  color: #ff8ba3;
}

.nav-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  box-sizing: border-box;
  margin-top: 20rpx;
  padding: 24rpx 26rpx;
  border: 1rpx solid rgba(94, 234, 255, 0.14);
  border-radius: 24rpx;
  background: rgba(16, 23, 52, 0.5);
}

.nav-arrow {
  flex: 0 0 auto;
}

.nav-arrow-icon {
  color: #7ceaff;
  font-size: 36rpx;
}

.device-error {
  display: block;
  margin-top: 24rpx;
}

.settings-title {
  display: block;
  color: #f2f5ff;
  font-size: 30rpx;
  font-weight: 700;
}

.setting-desc {
  display: block;
  margin-top: 10rpx;
  color: #8d99c4;
  font-size: 24rpx;
  line-height: 1.65;
}

.setting-control {
  margin-top: 22rpx;
  padding: 22rpx 24rpx;
  border: 1rpx solid rgba(94, 234, 255, 0.12);
  border-radius: 22rpx;
  background: rgba(8, 14, 36, 0.48);
}

.setting-control-label {
  display: block;
  margin-bottom: 12rpx;
  color: #b8c6ed;
  font-size: 24rpx;
  font-weight: 600;
}

.setting-control-note {
  display: block;
  margin-top: 14rpx;
  color: #6b779f;
  font-size: 23rpx;
  line-height: 1.6;
}

.picker-value {
  color: #dfe7ff;
  font-size: 25rpx;
}

.picker-disabled {
  opacity: 0.45;
}

.barge-in-option {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 14rpx;
}

.barge-in-label {
  color: #dfe7ff;
  font-size: 24rpx;
}

.acoustic-heading {
  margin-top: 20rpx;
  color: #7ceaff;
  font-size: 23rpx;
  font-weight: 700;
}
