.device-header {
  padding: 8rpx 0 12rpx;
}

.device-header .page-title {
  margin-bottom: 12rpx;
}

.portrait-pills {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.alias-edit {
  padding: 0 0 28rpx;
}

.alias-edit .field-input {
  margin-bottom: 16rpx;
}

.summary-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
  padding: 12rpx 0;
}

.summary-key {
  color: #596a78;
}

.summary-value {
  flex: 1;
  text-align: right;
  overflow-wrap: anywhere;
}
