page {
  background: #0E184F;
}

.device-header {
  padding: 8rpx 0 12rpx;
}

.device-header .page-title {
  margin-bottom: 12rpx;
}

/* L1 hero 胶囊行：复用全局 .pill，只补间距 */
.hero-pills {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 20rpx;
}

/* L2 音量卡：复用全局 l2-card / slider，只补数字与刻度 */
.volume-num {
  flex-shrink: 0;
  color: #ffffff;
  font-size: 40rpx;
  font-weight: 600;
}

.slider-scale {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 8rpx;
  color: rgba(236, 242, 250, 0.55);
  font-size: 22rpx;
}

/* L3 行内数值：唤醒词当前值 */
.row-value {
  flex-shrink: 0;
  color: rgba(236, 242, 250, 0.74);
  font-size: 26rpx;
}

.alias-edit {
  padding: 0 0 28rpx;
}

.alias-edit .field-input {
  margin-bottom: 16rpx;
}

.summary-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
  padding: 12rpx 0;
}

.summary-key {
  color: rgba(236, 242, 250, 0.6);
}

.summary-value {
  flex: 1;
  text-align: right;
  overflow-wrap: anywhere;
}

/* 唤醒词底部抽屉选项：复用全局 .sheet / .sheet-grab / .sheet-title / .sheet-sub */
.sheet-opt {
  display: flex;
  align-items: center;
  gap: 20rpx;
  min-height: 112rpx;
  margin-top: 16rpx;
  padding: 20rpx 24rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.12);
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.06);
}

.sheet-opt.on {
  border-color: #9fe3d8;
  background: rgba(143, 214, 203, 0.16);
}

.sheet-opt .opt-check {
  display: none;
  flex-shrink: 0;
  color: #9fe3d8;
}

.sheet-opt.on .opt-check {
  display: block;
}

.sheet-opt .choice-radio { border-color: rgba(255, 255, 255, 0.3); }
.sheet-opt.on .choice-radio { border-color: #9fe3d8; background: #9fe3d8; box-shadow: inset 0 0 0 8rpx #16202e; }

.hero-pills .pill-teal { color: #9fe3d8; }
