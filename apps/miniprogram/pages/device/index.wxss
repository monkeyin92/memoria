.device-header {
  padding: 8rpx 0 12rpx;
}

.device-header .page-title {
  margin-bottom: 12rpx;
}

/* L1 hero 胶囊行：复用全局 .pill，只补间距 */
.hero-pills {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 20rpx;
}

/* L2 音量卡：复用全局 l2-card / slider，只补数字与刻度 */
.volume-num {
  flex-shrink: 0;
  color: #16191c;
  color: var(--text-primary);
  font-size: 40rpx;
  font-weight: 600;
}

.slider-scale {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 8rpx;
  color: #5a6167;
  color: var(--text-tertiary);
  font-size: 22rpx;
}

/* L3 行内数值：唤醒词当前值 */
.row-value {
  flex-shrink: 0;
  color: #474e54;
  color: var(--text-secondary);
  font-size: 26rpx;
}

.alias-edit {
  padding: 0 0 28rpx;
}

.alias-edit .field-input {
  margin-bottom: 16rpx;
}

.summary-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
  padding: 12rpx 0;
}

.summary-key {
  color: #474e54;
  color: var(--text-secondary);
}

.summary-value {
  flex: 1;
  text-align: right;
  overflow-wrap: anywhere;
}

/* 唤醒词底部抽屉选项：复用全局 .sheet / .sheet-grab / .sheet-title / .sheet-sub */
.sheet-opt {
  display: flex;
  align-items: center;
  gap: 20rpx;
  min-height: 112rpx;
  margin-top: 16rpx;
  padding: 20rpx 24rpx;
  border: 2rpx solid rgba(30, 45, 70, 0.1);
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.62);
}

.sheet-opt.on {
  border-color: #326e70;
  background: rgba(227, 237, 236, 0.86);
}

.sheet-opt .opt-check {
  display: none;
  flex-shrink: 0;
  color: #285c5e;
  color: var(--brand-teal);
}

.sheet-opt.on .opt-check {
  display: block;
}

.sheet-opt.on .choice-radio { border-color: #172f43; background: #172f43; box-shadow: inset 0 0 0 8rpx #fff; }

/* hero 是深色品牌底，胶囊文字保持浅青 */
.hero-pills .pill-teal { color: #9fe3d8; }
