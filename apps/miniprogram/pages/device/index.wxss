@import "../../styles/trial-theme.wxss";

.device-trial-head {
  min-height: 0;
  margin: 0;
  padding: 0;
  background: transparent;
}

.device-setting-copy {
  flex: 1;
  min-width: 0;
}

.device-setting-copy .trial-caption {
  margin-top: 8rpx;
}

.device-usage-card {
  display: flex;
  align-items: center;
  gap: 48rpx;
  margin-top: 48rpx;
  padding: 32rpx 48rpx;
}

.device-ring {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 224rpx;
  height: 224rpx;
  border-radius: 50%;
  background: var(--mp-track);
}

.device-ring-inner {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 176rpx;
  height: 176rpx;
  border-radius: 50%;
  background: var(--mp-surface);
}

.device-ring-num {
  color: var(--mp-ink);
  font-size: var(--mp-type-display);
  font-weight: 700;
  line-height: 64rpx;
  letter-spacing: -2rpx;
  font-variant-numeric: tabular-nums;
}

.device-ring-cap {
  margin-top: 8rpx;
  color: var(--mp-ink-3);
  font-size: var(--mp-type-tab);
}

.device-usage-copy {
  flex: 1;
  min-width: 0;
}

.device-usage-title {
  display: block;
  margin-bottom: 24rpx;
  color: var(--mp-ink);
  font-size: var(--mp-type-button);
  font-weight: 600;
  line-height: var(--mp-lh-card);
}

.device-limit-card {
  margin-top: var(--mp-gap-card);
  padding: 48rpx;
}

.device-limit-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.device-limit-label {
  color: var(--mp-ink);
  font-size: var(--mp-type-card);
  font-weight: 600;
}

.device-limit-num {
  color: var(--mp-ink);
  font-size: var(--mp-type-display);
  font-weight: 700;
  letter-spacing: -2rpx;
  font-variant-numeric: tabular-nums;
}

.device-limit-unit {
  color: var(--mp-ink-2);
  font-size: var(--mp-type-caption);
}

.device-slider {
  margin: 32rpx 0 8rpx;
}

.device-limit-range {
  display: flex;
  justify-content: space-between;
  color: var(--mp-ink-3);
  font-size: var(--mp-type-meta);
}

.device-quiet-card {
  display: flex;
  align-items: center;
  gap: 32rpx;
  margin-top: var(--mp-gap-card);
  padding: 32rpx;
}

.device-quiet-card .trial-inset-label {
  font-weight: 600;
}

.device-privacy-block {
  margin-top: var(--mp-gap-card);
}

.device-header {
  padding: 8rpx 0 12rpx;
}

.device-header .page-title {
  margin-bottom: 12rpx;
}

/* L2 音量卡：复用全局 l2-card / slider，只补数字与刻度 */
.volume-num {
  flex-shrink: 0;
  color: var(--mp-ink);
  font-size: var(--mp-type-title);
  font-weight: 600;
}

.slider-scale {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 8rpx;
  color: var(--mp-ink-3);
  font-size: var(--mp-type-meta);
}

/* L3 行内数值：唤醒词、网络、备注的当前值 */
.row-value {
  flex: 0 1 auto;
  min-width: 0;
  max-width: 50%;
  overflow: visible;
  color: var(--mp-ink-2);
  font-size: var(--mp-type-caption);
  line-height: var(--mp-lh-caption);
  text-align: right;
  white-space: normal;
  word-break: break-word;
}

.row-value-warn {
  color: var(--mp-sun);
}

.list-row-hover {
  opacity: 0.6;
}

.row-title-danger,
.row-copy .row-title-danger {
  color: var(--mp-rust);
}

/* 年龄申报：三个选项各占一格，间距分开 */
.option-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 24rpx;
}

.option-chip {
  box-sizing: border-box;
  flex: 1 1 180rpx;
  min-height: 84rpx;
  padding: 18rpx 20rpx;
  border: 2rpx solid var(--mp-line);
  border-radius: var(--mp-radius-icon);
  background: var(--mp-surface);
  color: var(--mp-ink);
  font-size: var(--mp-type-caption);
  line-height: 1.4;
  text-align: center;
}

.option-chip-on {
  border-color: var(--mp-accent);
  background: var(--mp-accent-soft);
  color: var(--mp-accent);
  font-weight: 600;
}

.card-action {
  margin-top: 28rpx;
}

.style-labels {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 20rpx;
}

.alert-row {
  margin-top: 16rpx;
}

.summary-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
  padding: 12rpx 0;
}

.summary-key {
  color: var(--mp-ink-2);
}

.summary-value {
  flex: 1;
  text-align: right;
  overflow-wrap: anywhere;
}

/* 底部抽屉：高度封顶，选项区单独滚动，按钮始终露在底部 */
.device-sheet {
  display: flex;
  flex-direction: column;
  max-height: 86vh;
}

.sheet-scroll {
  flex: 1;
  min-height: 0;
  max-height: 56vh;
}

.sheet-custom {
  padding: 4rpx 4rpx 12rpx;
}

.sheet-action {
  flex-shrink: 0;
  margin-top: 24rpx;
}

.sheet-cancel {
  flex-shrink: 0;
  width: 100%;
  margin-top: 8rpx;
}

/* 底部抽屉选项：复用全局 .sheet / .sheet-grab / .sheet-title / .sheet-sub */
.sheet-opt {
  display: flex;
  align-items: center;
  gap: 20rpx;
  min-height: 112rpx;
  margin-top: 16rpx;
  padding: 20rpx 24rpx;
  border: 2rpx solid var(--mp-line);
  border-radius: var(--mp-radius-inset);
  background: var(--mp-surface);
}

.sheet-opt.on {
  border-color: var(--mp-accent);
  background: var(--mp-accent-soft);
}

.sheet-opt .opt-check {
  display: none;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 36rpx;
  height: 36rpx;
  color: var(--mp-accent);
}

.sheet-opt.on .opt-check {
  display: flex;
}

.sheet-opt.on .choice-radio { border-color: var(--mp-accent); background: var(--mp-accent); box-shadow: inset 0 0 0 8rpx var(--mp-surface); }

/* 使用时段：卡片标题行的「修改」与抽屉里的选择行 */
.limits-edit { margin: 0; padding: 0 0 0 24rpx; }
.limits-quiet-label {
  display: block;
  margin: 8rpx 0 0;
  color: var(--mp-ink);
  font-size: var(--mp-type-body);
  font-weight: 600;
  line-height: 1.45;
}
.limits-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 96rpx;
  border-bottom: 2rpx solid var(--mp-line);
}

/* 唤醒方式：两个开关（唤醒词 / 点击屏幕）与说明 */
.wake-mode-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
}
.wake-mode-row {
  display: flex;
  align-items: center;
  gap: 24rpx;
  min-height: 120rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--mp-line);
}
.wake-mode-note { margin-top: 16rpx; }
.wake-mode-note-warn { color: var(--mp-sun); }
