.device-portrait {
  padding: 8rpx 16rpx 34rpx;
  text-align: center;
}

.portrait-image {
  display: block;
  width: 374rpx;
  height: 346rpx;
  margin: 16rpx auto 0;
}

.portrait-name {
  display: block;
  margin: 8rpx 0 14rpx;
  font-size: 46rpx;
  font-weight: 600;
}

.portrait-pills {
  display: flex;
  justify-content: center;
  flex-wrap: wrap;
  gap: 8rpx;
}

.alias-edit {
  padding: 0 0 28rpx;
}

.alias-edit .field-input {
  margin-bottom: 16rpx;
}

.summary-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
  padding: 12rpx 0;
}

.summary-key {
  color: #596a78;
}

.summary-value {
  flex: 1;
  text-align: right;
  overflow-wrap: anywhere;
}
