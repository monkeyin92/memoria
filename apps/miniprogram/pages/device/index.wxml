<view class="page-bg"><image class="page-bg-img" src="/assets/bg/night-stars.png" mode="widthFix" /></view>

<view class="page-shell">
  <text class="eyebrow">设备与成员</text>
  <text class="page-title">谁在用，由谁决定</text>
  <text class="page-subtitle">小程序用于管理设备和回顾，对话请在机器人上完成。陪伴机器人随人移动，不按客厅、卧室这类房间来标记。首次绑定只决定默认用途；当前使用者与敏感能力由服务端 Runtime Profile 决定。</text>

  <view wx:if="{{loading}}" class="card">
    <text class="loading-text">{{syncingBindings ? '正在同步你的设备…' : '正在读取设备状态…'}}</text>
  </view>

  <view wx:elif="{{bindingSyncError && !hasBinding && !needsBindingChoice}}" class="card empty-card">
    <text class="empty-badge sync-error-badge">同步未完成</text>
    <text class="empty-title">暂时无法确认设备信息</text>
    <text class="empty-copy">{{bindingSyncError}}</text>
    <button class="primary-button empty-button" bindtap="retryBindingSync">重新同步</button>
  </view>

  <view wx:elif="{{needsBindingChoice}}" class="card empty-card">
    <text class="empty-badge">选择设备</text>
    <text class="empty-title">这次要管理哪一台？</text>
    <text class="empty-copy">你的账号绑定了多台设备，请选择一台作为当前设备。</text>
    <view wx:for="{{bindingChoices}}" wx:key="bindingId" class="binding-choice" data-binding-id="{{item.bindingId}}" bindtap="chooseDeviceBinding">
      <view class="binding-choice-copy">
        <text class="binding-choice-name">{{item.label}}</text>
        <text class="binding-choice-meta">{{item.modeLabel}}</text>
      </view>
      <text class="binding-choice-arrow">›</text>
    </view>
    <text wx:if="{{bindingSyncError}}" class="error-text">{{bindingSyncError}}</text>
  </view>

  <!-- 未绑定 -->
  <block wx:elif="{{!hasBinding}}">
    <view class="card empty-card">
      <text class="empty-badge">还没有绑定设备</text>
      <text class="empty-copy">把这里当作机器人管理入口：添加时扫码、近场配网、认领和首次初始化会在独立流程完成；绑定后小程序主要用于查看设备状态、管理设置和回顾信息。</text>
      <button class="primary-button empty-button" bindtap="openOnboarding">添加机器人</button>
      <button wx:if="{{hasPendingOnboarding}}" class="secondary-button empty-button" bindtap="resumeOnboarding">恢复未完成启用</button>
    </view>
  </block>

  <!-- 已绑定 -->
  <block wx:else>
    <text wx:if="{{bindingSyncError}}" class="sync-warning">{{bindingSyncError}}</text>
    <view class="card">
      <text class="settings-title">机器人状态</text>
      <view class="device-status-grid">
        <view class="device-status-item"><text class="device-status-label">在线状态</text><text class="device-status-value">{{onlineLabel}}</text></view>
        <view class="device-status-item"><text class="device-status-label">固件版本</text><text class="device-status-value">{{firmwareVersion}}</text></view>
        <view class="device-status-item"><text class="device-status-label">网络状态</text><text class="device-status-value">{{networkLabel}}</text></view>
        <view class="device-status-item"><text class="device-status-label">激活状态</text><text class="device-status-value">{{activationLabel}}</text></view>
      </view>
      <view class="button-row device-action-row">
        <button class="secondary-button" bindtap="openReprovision">重新配网</button>
        <button class="primary-button" bindtap="openOnboarding">添加另一个</button>
      </view>
      <text class="form-note">重新配网只更新 Wi‑Fi，不解除设备归属；设备状态与激活状态以服务端和机器人回执为准。</text>
    </view>

    <view class="card">
      <text class="settings-title">绑定信息</text>
      <view class="summary-row"><text class="summary-key">设备用途</text><text class="summary-value">{{bindingModeLabel}}</text></view>
      <view class="summary-row"><text class="summary-key">绑定编号</text><text class="summary-value summary-mono">{{binding.binding_id}}</text></view>
      <view wx:if="{{binding.binding_version}}" class="summary-row"><text class="summary-key">版本</text><text class="summary-value">v{{binding.binding_version}}</text></view>
      <view wx:if="{{bindingRoles.length > 0}}" class="summary-row">
        <text class="summary-key">角色</text>
        <text class="summary-value">{{bindingRoles}}</text>
      </view>
      <text class="form-note">更换主要使用者会产生新的绑定版本，旧版本保留用于审计；购买者不自动获得内容读取权限。</text>
    </view>

    <!-- 当前使用者 -->
    <view class="card">
      <text class="settings-title">当前使用者</text>
      <view wx:if="{{currentUserLabel}}" class="current-user-chip">
        <text class="current-user-name">{{currentUserLabel}}</text>
        <text class="current-user-state">已确认</text>
      </view>

      <block wx:if="{{candidates.length > 0 && !currentUserLabel}}">
        <text class="setting-desc">无法自动确认是谁在使用，请选择并确认：</text>
        <view wx:for="{{candidates}}" wx:key="person_id" class="candidate-row {{selectedCandidateId === item.person_id ? 'candidate-selected' : ''}}" data-person-id="{{item.person_id}}" bindtap="selectCandidate">
          <view class="candidate-copy">
            <text class="candidate-name">{{item.display_name}}</text>
            <text wx:if="{{item.relationship_label}}" class="candidate-relation">{{item.relationship_label}}</text>
          </view>
          <view class="candidate-confidence">
            <view class="confidence-track"><view class="confidence-value {{item.confidence >= 0.5 ? 'confidence-high' : 'confidence-low'}}" style="width: {{item.confidence * 100}}%;"></view></view>
            <text class="confidence-label {{item.confidence >= 0.5 ? '' : 'confidence-low-text'}}">{{item.confidence >= 0.5 ? '置信度 ' + Math.round(item.confidence * 100) + '%' : '置信度较低'}}</text>
          </view>
        </view>
        <button class="primary-button confirm-button" loading="{{switching}}" disabled="{{!canConfirmWithApp}}" bindtap="confirmSubject">确认是我</button>
        <text wx:if="{{!canConfirmWithApp}}" class="form-note">当前会话需要通过语音确认身份，应用内切换暂不可用。</text>
      </block>

      <view wx:if="{{candidates.length === 0 && !currentUserLabel}}" class="current-user-empty">
        <text class="empty-copy">暂时没有可确认的成员档案。</text>
      </view>
    </view>

    <!-- 可解释降级 -->

    <!-- 设备设置：版本化写入服务端 Runtime Profile，设备在下一安全点生效 -->
    <view class="card">
      <text class="settings-title">设备设置</text>
      <text class="setting-desc">设置以版本化方式写入服务端 Runtime Profile，设备在下一安全点生效；未保存成功不保留本地假状态。</text>
      <block wx:if="{{settings}}">
        <view class="setting-control">
          <text class="setting-control-label">音量</text>
          <slider min="0" max="100" step="1" value="{{settings.volume_limit}}" bindchange="changeVolume" disabled="{{settingsSaving}}" activeColor="#22e5ff" block-color="#7ceaff" />
        </view>
        <view class="setting-control">
          <text class="setting-control-label">屏幕亮度</text>
          <slider min="0" max="100" step="1" value="{{settings.screen_brightness}}" bindchange="changeBrightness" disabled="{{settingsSaving}}" activeColor="#22e5ff" block-color="#7ceaff" />
        </view>
        <view class="setting-control">
          <text class="setting-control-label">期望音频模式（{{currentAudioModeLabel}}）</text>
          <picker wx:if="{{audioModeOptions.length > 0}}" range="{{audioModeOptions}}" range-key="label" value="{{audioModeIndex}}" bindchange="selectAudioMode" disabled="{{settingsSaving}}">
            <view class="picker-value {{settingsSaving ? 'picker-disabled' : ''}}">{{audioModeOptions[audioModeIndex].label}}</view>
          </picker>
          <text wx:else class="setting-control-note">声学能力未知，音频模式暂不可修改（fail-closed）。</text>
        </view>
        <view class="setting-control">
          <text class="setting-control-label">唤醒方式</text>
          <picker range="{{wakeModeOptions}}" range-key="label" value="{{wakeModeIndex}}" bindchange="selectWakeMode" disabled="{{settingsSaving}}">
            <view class="picker-value {{settingsSaving ? 'picker-disabled' : ''}}">{{wakeModeLabel}}</view>
          </picker>
        </view>
        <view class="setting-control">
          <text class="setting-control-label">唤醒词</text>
          <picker wx:if="{{wakeWordOptions.length > 0}}" range="{{wakeWordOptions}}" range-key="label" value="{{wakeWordIndex}}" bindchange="selectWakeWord" disabled="{{settingsSaving}}">
            <view class="picker-value {{settingsSaving ? 'picker-disabled' : ''}}">{{wakeWordLabel}}</view>
          </picker>
          <text wx:if="{{wakeWordNote}}" class="setting-control-note">{{wakeWordNote}}</text>
          <text class="setting-control-note">保存后会在线同步到设备。设备应用新唤醒词后需要重启才会生效，请保持设备在线。</text>
        </view>
        <view class="setting-control custom-wake-word">
          <text class="setting-control-label">自定义唤醒词</text>
          <text class="setting-control-note">填写中文显示名与拼音（空格分音节，如 xiao hei）。保存后会在线同步到设备，设备重启后生效。</text>
          <input class="field-input wake-word-input" value="{{customWakeWordDisplay}}" maxlength="16" placeholder="显示名，例如：小黑" bindinput="onCustomWakeWordDisplayInput" disabled="{{settingsSaving}}" />
          <input class="field-input wake-word-input" value="{{customWakeWordPinyin}}" maxlength="64" placeholder="拼音，例如：xiao hei" bindinput="onCustomWakeWordPinyinInput" disabled="{{settingsSaving}}" />
          <button class="secondary-button wake-word-save" loading="{{settingsSaving}}" disabled="{{settingsSaving}}" bindtap="saveCustomWakeWord">保存自定义唤醒词</button>
          <view wx:for="{{customWakeWordWarnings}}" wx:key="*this">
            <text class="setting-control-note">{{item}}</text>
          </view>
        </view>
        <view class="setting-control">
          <text class="setting-control-label">允许的打断方式</text>
          <checkbox-group bindchange="toggleBargeIn">
            <label wx:for="{{bargeInOptions}}" wx:key="value" class="barge-in-option">
              <checkbox value="{{item.value}}" checked="{{bargeInChecked[item.value]}}" color="#22e5ff" disabled="{{settingsSaving}}" />
              <text class="barge-in-label">{{item.label}}</text>
            </label>
          </checkbox-group>
        </view>
        <text wx:if="{{settingsSaving}}" class="setting-control-note">正在保存…</text>
        <text wx:if="{{settingsError}}" class="error-text">{{settingsError}}</text>
      </block>
      <text wx:else class="setting-control-note">设备设置暂时无法读取，请下拉刷新；未取得权威设置前不开放修改。</text>
    </view>

    <!-- 诊断信息：只展示服务端权威字段（PR-18），客户端不拼接连接质量数据 -->
    <view class="card">
      <text class="settings-title">诊断信息</text>
      <block wx:if="{{diagnostics}}">
        <view wx:if="{{diagnostics.generated_at}}" class="summary-row"><text class="summary-key">最近诊断时间</text><text class="summary-value">{{diagnostics.generated_at}}</text></view>
        <view wx:if="{{diagnostics.binding}}" class="summary-row"><text class="summary-key">绑定版本 / 激活状态</text><text class="summary-value">v{{diagnostics.binding.binding_version}} · {{diagnostics.binding.activation_status}}</text></view>
        <view class="summary-row"><text class="summary-key">Runtime Profile 版本</text><text class="summary-value">v{{diagnostics.runtime_profile_version}}</text></view>
        <view class="summary-row"><text class="summary-key">实际音频模式</text><text class="summary-value">{{effectiveAudioModeLabel}}</text></view>
        <view class="summary-row"><text class="summary-key">实时链路</text><text class="summary-value">{{liveRuntimeStatusLabel}}</text></view>
        <view class="summary-row"><text class="summary-key">允许的音频模式</text><text class="summary-value">{{allowedAudioModesLabel}}</text></view>
        <block wx:if="{{acousticCapability}}">
          <text class="setting-desc acoustic-heading">声学能力登记（服务端权威）</text>
          <view class="summary-row"><text class="summary-key">板型</text><text class="summary-value">{{acousticCapability.board_profile}}</text></view>
          <view class="summary-row"><text class="summary-key">固件范围</text><text class="summary-value">{{acousticCapability.firmware_version_range}}</text></view>
          <view class="summary-row"><text class="summary-key">声学档案版本</text><text class="summary-value">v{{acousticCapability.acoustic_profile_version}}</text></view>
          <view class="summary-row"><text class="summary-key">AEC 验收</text><text class="summary-value">{{acousticCapability.aec_verified ? '已通过' : '未通过'}}</text></view>
          <view class="summary-row"><text class="summary-key">AEC 参考类型</text><text class="summary-value">{{acousticCapability.aec_reference_type}}</text></view>
          <view class="summary-row"><text class="summary-key">最大打断等级</text><text class="summary-value">{{acousticCapability.max_barge_in_level}}</text></view>
          <view class="summary-row"><text class="summary-key">测试音量范围</text><text class="summary-value">{{acousticCapability.tested_volume_range}}</text></view>
          <view wx:if="{{acousticCapability.tested_distance_m !== null}}" class="summary-row"><text class="summary-key">测试距离</text><text class="summary-value">{{acousticCapability.tested_distance_m}} m</text></view>
        </block>
        <text wx:else class="setting-control-note">尚未登记声学能力：只允许半双工安全模式，不开放全双工或语音打断。</text>
        <text class="form-note">诊断只展示服务端权威字段；连接质量（丢包/欠载/重连）等字段由服务端补齐后才会展示。</text>
      </block>
      <text wx:else class="setting-control-note">诊断信息暂时不可用（服务端未返回），不展示推断数据。</text>
    </view>
    <view wx:if="{{degradation}}" class="card degradation-card">
      <text class="degradation-badge">安全模式</text>
      <text wx:for="{{degradation.reasons}}" wx:key="*this" class="degradation-reason">{{item}}</text>
      <view class="degradation-columns">
        <view class="degradation-column">
          <text class="degradation-column-title">仍然可用</text>
          <text wx:for="{{degradation.allowed}}" wx:key="*this" class="degradation-item">{{item}}</text>
        </view>
        <view class="degradation-column">
          <text class="degradation-column-title">受限</text>
          <text wx:for="{{degradation.restricted}}" wx:key="*this" class="degradation-item">{{item}}</text>
        </view>
        <view class="degradation-column">
          <text class="degradation-column-title degradation-forbidden-title">保持关闭</text>
          <text wx:for="{{degradation.forbidden}}" wx:key="*this" class="degradation-item degradation-forbidden">{{item}}</text>
        </view>
      </view>
    </view>

    <!-- 敏感入口由服务端 capabilities 驱动 -->
    <view wx:if="{{sensitiveEntries.length > 0}}" class="card">
      <text class="settings-title">可用能力</text>
      <text class="setting-desc">以下入口由服务端按当前主体授权，而不是由本机推断年龄。</text>
      <view wx:for="{{sensitiveEntries}}" wx:key="key" class="nav-card" data-page="{{item.page}}" bindtap="openEntry">
        <view><text class="setting-name">{{item.title}}</text><text class="setting-desc">{{item.description}}</text></view>
        <view class="nav-arrow"><text class="nav-arrow-icon">›</text></view>
      </view>
    </view>

    <text wx:if="{{error}}" class="error-text device-error">{{error}}</text>
  </block>
</view>
