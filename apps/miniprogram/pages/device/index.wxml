<view class="page-shell">
  <view wx:if="{{!authenticated}}">
    <text class="page-title">设备</text>
    <text class="page-lede">跟随账号同步，无需在每个端重新绑定。</text>
    <view class="notice">登录后即可查看你的设备。</view>
    <button class="primary-button empty-button" bindtap="retryBindingSync">登录后查看设备</button>
  </view>

  <block wx:else>
    <view wx:if="{{loading}}" class="card">
      <text class="loading-text">{{syncingBindings ? '正在同步你的设备…' : '正在读取设备状态…'}}</text>
    </view>

    <view wx:elif="{{bindingSyncError && !hasBinding && !needsBindingChoice}}" class="card">
      <text class="empty-title">设备信息暂未同步</text>
      <text class="empty-copy">这不代表未绑定，无需重新配网。{{bindingSyncError}}</text>
      <button class="primary-button empty-button" bindtap="retryBindingSync">重新同步</button>
    </view>

    <view wx:elif="{{needsBindingChoice}}">
      <text class="page-title">设备</text>
      <text class="page-lede">设备信息已从账号找到。选择你要查看的设备。</text>
      <view
        wx:for="{{bindingChoices}}"
        wx:key="bindingId"
        class="choice-card"
        data-binding-id="{{item.bindingId}}"
        bindtap="chooseDeviceBinding"
      >
        <view class="row-copy">
          <text class="row-title">{{item.label}}</text>
          <text class="row-meta">{{item.modeLabel}}</text>
        </view>
        <text class="row-chevron">›</text>
      </view>
      <text class="caption">切换设备不会赋予查看其他成员私密内容的权限。</text>
      <text wx:if="{{bindingSyncError}}" class="error-text">{{bindingSyncError}}</text>
    </view>

    <view wx:elif="{{!hasBinding}}" class="empty-block">
      <text class="empty-title">还没有绑定设备</text>
      <text class="empty-copy">已确认当前账号下没有设备。接通电源后，即可开始添加。</text>
      <button class="primary-button empty-button" bindtap="{{hasPendingOnboarding ? 'resumeOnboarding' : 'openOnboarding'}}">{{hasPendingOnboarding ? '继续上次启用' : '添加设备'}}</button>
    </view>

    <block wx:else>
      <text wx:if="{{bindingSyncError}}" class="notice notice-warn">{{bindingSyncError}}</text>

      <!-- L1 情感层：设备状态卡 -->
      <view class="mem-hero">
        <text class="mem-hero-eyebrow">设备 · {{bindingModeLabel}}</text>
        <view class="mem-hero-row">
          <view class="row-copy">
            <text class="mem-hero-title">{{devicePlaceName}}</text>
            <text class="mem-hero-sub">{{onlineLabel}} · {{currentUserLabel}}正在使用</text>
          </view>
          <face-badge wx:if="{{profile && profile.persona && profile.persona.persona_id}}" role="{{profile.persona.persona_id}}" size="sm"></face-badge>
          <face-badge wx:else role="starlight" size="sm"></face-badge>
        </view>
        <view class="hero-pills">
          <view class="pill {{online ? '' : 'pill-amber'}}">
            <view class="pill-dot"></view>
            <text>{{online ? '在线' : '离线'}}</text>
          </view>
          <view class="pill pill-teal">{{bindingModeLabel}}</view>
        </view>
      </view>

      <view wx:if="{{!online}}" class="notice notice-warn">
        <text class="notice-title">设备暂时无法连接</text>
        <text>请检查电源和家庭 Wi-Fi。绑定关系仍在，无需重新认领。</text>
      </view>

      <!-- 双 stat 小卡 -->
      <view class="two-stats">
        <view class="two-stats-cell">
          <text class="two-stats-value">{{onlineLabel}}</text>
          <text class="two-stats-label">最近状态</text>
        </view>
        <view class="two-stats-cell">
          <text class="two-stats-value">{{currentUserLabel}}</text>
          <text class="two-stats-label">当前使用者</text>
        </view>
      </view>

      <!-- L2 功能层：音量 -->
      <view class="l2-card" wx:if="{{settings}}">
        <view class="setting-row">
          <view class="row-copy">
            <text class="l2-card-title">设备音量</text>
            <text class="l2-card-sub">在机器人上说话的声音大小</text>
          </view>
          <text class="volume-num">{{settings.volume_limit}}%</text>
        </view>
        <slider min="0" max="100" step="5" value="{{settings.volume_limit}}" bindchange="changeVolume" disabled="{{settingsSaving}}" activeColor="#326e70" block-color="#172f43" />
        <view class="slider-scale"><text>安静</text><text>响亮</text></view>
      </view>

      <!-- L3 信息层：角色与声音 / 唤醒词 / 网络 -->
      <view class="list">
        <view class="list-row" bindtap="openCompanion">
          <view class="row-icon">
            <svg viewBox="0 0 18 18" fill="none"><circle cx="9" cy="6" r="3" stroke="currentColor" stroke-width="1.5"/><path d="M3.5 15a5.5 5.5 0 0 1 11 0" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
          </view>
          <view class="row-copy">
            <text class="row-title">角色与声音</text>
            <text class="row-meta">{{personaName}} · {{personaVoice}}</text>
          </view>
          <text class="row-chevron">›</text>
        </view>
        <view class="list-row" bindtap="openWakeSheet">
          <view class="row-icon">
            <svg viewBox="0 0 18 18" fill="none"><path d="M3 7v4h3l4 3.5v-11L6 7H3z" fill="currentColor"/><path d="M12.5 5.5a4.5 4.5 0 0 1 0 7" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
          </view>
          <view class="row-copy">
            <text class="row-title">唤醒词</text>
            <text class="row-meta">叫它一声，它就应你</text>
          </view>
          <text class="row-value">{{wakeWordLabel}}</text>
          <text class="row-chevron">›</text>
        </view>
        <view class="list-row" bindtap="{{online ? '' : 'showConnectionHelp'}}">
          <view class="row-copy">
            <text class="row-title">网络连接</text>
            <text class="row-meta">{{online ? '家庭网络已连接' : '等待重新连接'}}</text>
          </view>
        </view>
      </view>

      <view class="section-head">
        <text class="section-head-title">使用者与设备</text>
      </view>
      <view class="list">
        <view class="list-row">
          <view class="row-copy">
            <text class="row-title">使用者备注</text>
            <text class="row-meta">首页显示这条备注，不是微信昵称。不按客厅、卧室这类房间来标记。</text>
          </view>
        </view>
        <view class="alias-edit">
          <input class="field-input" value="{{subjectAliasDraft}}" placeholder="例如：亲爱的儿子、老爸" placeholder-class="field-placeholder" maxlength="16" bindinput="onSubjectAliasInput" />
          <button class="secondary-button" bindtap="saveSubjectAlias">保存备注</button>
        </view>
        <view class="list-row" bindtap="openGuardian">
          <view class="row-copy">
            <text class="row-title">家庭成员</text>
            <text class="row-meta">邀请与权限分别管理</text>
          </view>
          <text class="row-chevron">›</text>
        </view>
        <block wx:if="{{personaRows.length > 0}}">
          <view
            wx:for="{{personaRows}}"
            wx:key="person_id"
            class="list-row"
            data-person-id="{{item.person_id}}"
            bindtap="openPersonaSheet"
          >
            <view class="row-copy">
              <text class="row-title">{{item.persona_name}}</text>
              <text class="row-meta">{{item.role_label}} · {{item.source_label}}</text>
            </view>
            <text class="row-chevron">›</text>
          </view>
          <text class="caption">人格按使用人分配；取消分配后跟随设备默认人格。分配会在下一次设备同步时生效。</text>
          <text wx:if="{{personaAssignmentError}}" class="error-text">{{personaAssignmentError}}</text>
        </block>
        <block wx:if="{{ageRows.length > 0}}">
          <view wx:for="{{ageRows}}" wx:key="person_id" class="list-row">
            <view class="row-copy">
              <text class="row-title">年龄资料申报</text>
              <text class="row-meta">{{item.declaredLabel}} · {{item.evidenceLabel}}。申报不是核验，不能申报已成年。</text>
              <view class="alias-edit">
                <button
                  wx:for="{{item.options}}"
                  wx:for-item="option"
                  wx:key="value"
                  class="secondary-button"
                  data-person-id="{{item.person_id}}"
                  data-age-band="{{option.value}}"
                  disabled="{{ageSaving}}"
                  bindtap="selectAgeBand"
                >{{item.selected === option.value ? '当前：' : ''}}{{option.label}}</button>
              </view>
              <button
                class="secondary-button"
                data-person-id="{{item.person_id}}"
                loading="{{ageSaving}}"
                disabled="{{ageSaving}}"
                bindtap="declareAge"
              >提交年龄申报</button>
            </view>
          </view>
          <text wx:if="{{ageError}}" class="error-text">{{ageError}}</text>
        </block>
        <view class="list-row" bindtap="openOnboarding">
          <view class="row-copy">
            <text class="row-title">添加其他设备</text>
          </view>
          <text class="row-chevron">›</text>
        </view>
        <view class="list-row" bindtap="openReprovision">
          <view class="row-copy">
            <text class="row-title">重新配网</text>
            <text class="row-meta">只更新 Wi-Fi，不解除绑定</text>
          </view>
          <text class="row-chevron">›</text>
        </view>
      </view>

      <block wx:if="{{candidates.length > 0 && !currentUserLabelConfirmed}}">
        <view class="card">
          <text class="setting-name">此刻是谁在用</text>
          <text class="setting-desc">请选择此刻在用的成员并确认。</text>
          <view wx:for="{{candidates}}" wx:key="person_id" class="choice-card {{selectedCandidateId === item.person_id ? 'choice-card-on' : ''}}" data-person-id="{{item.person_id}}" bindtap="selectCandidate">
            <view class="row-copy">
              <text class="row-title">{{item.display_name}}</text>
              <text wx:if="{{item.relationship_label}}" class="row-meta">{{item.relationship_label}}</text>
            </view>
          </view>
          <button class="primary-button empty-button" loading="{{switching}}" disabled="{{!canConfirmWithApp}}" bindtap="confirmSubject">确认是我</button>
          <text wx:if="{{!canConfirmWithApp}}" class="caption">当前会话暂不支持在应用内切换使用人。</text>
        </view>
      </block>

      <view wx:if="{{settings}}" class="card">
        <text class="setting-name">唤醒词</text>
        <text class="setting-desc">保存后会在线同步到设备。重启后生效，请保持设备在线。</text>
        <view class="list-row" bindtap="openWakeSheet">
          <view class="row-copy">
            <text class="row-title">当前唤醒词</text>
            <text class="row-meta">{{wakeWordLabel}}</text>
          </view>
          <text class="row-chevron">›</text>
        </view>
        <text wx:if="{{wakeWordNote}}" class="caption">{{wakeWordNote}}</text>
        <text class="field-label">自定义唤醒词</text>
        <input class="field-input" value="{{customWakeWordDisplay}}" maxlength="16" placeholder="显示名，例如：小黑" bindinput="onCustomWakeWordDisplayInput" disabled="{{settingsSaving}}" />
        <input class="field-input" value="{{customWakeWordPinyin}}" maxlength="64" placeholder="拼音，例如：xiao hei" bindinput="onCustomWakeWordPinyinInput" disabled="{{settingsSaving}}" />
        <button class="secondary-button empty-button" loading="{{settingsSaving}}" disabled="{{settingsSaving}}" bindtap="saveCustomWakeWord">保存自定义唤醒词</button>
        <text wx:for="{{customWakeWordWarnings}}" wx:key="*this" class="caption">{{item}}</text>
        <text wx:if="{{settingsSaving}}" class="caption">正在保存…</text>
        <text wx:if="{{settingsError}}" class="error-text">{{settingsError}}</text>
      </view>

      <!-- 唤醒词底部抽屉：选项单选 + 确认回写 -->
      <view wx:if="{{wakeSheetVisible}}" class="sheet-mask" bindtap="closeWakeSheet"></view>
      <view wx:if="{{wakeSheetVisible}}" class="sheet">
        <view class="sheet-grab"></view>
        <text class="sheet-title">唤醒词</text>
        <text class="sheet-sub">叫它一声，它就应你</text>
        <view
          wx:for="{{wakeWordOptions}}"
          wx:key="id"
          class="sheet-opt {{wakeSheetIndex === index ? 'on' : ''}}"
          data-index="{{index}}"
          bindtap="pickWakeSheetOption"
        >
          <view class="choice-radio"></view>
          <view class="row-copy">
            <text class="row-title">{{item.label}}</text>
            <text wx:if="{{item.note}}" class="row-meta">{{item.note}}</text>
          </view>
          <svg class="opt-check" width="18" height="18" viewBox="0 0 16 16" fill="none"><path d="M3.5 8.5l3 3 6-6.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </view>
        <button class="primary-button" style="margin-top: 16rpx;" loading="{{settingsSaving}}" bindtap="confirmWakeSheet">确认</button>
      </view>

      <!-- 人格分配底部抽屉：按使用人选择内置人格或恢复默认 -->
      <view wx:if="{{personaSheetVisible}}" class="sheet-mask" bindtap="closePersonaSheet"></view>
      <view wx:if="{{personaSheetVisible}}" class="sheet">
        <view class="sheet-grab"></view>
        <text class="sheet-title">选择人格</text>
        <text class="sheet-sub">{{personaSheetSubjectLabel}} · 分配后下一次设备同步生效</text>
        <view
          wx:for="{{personaOptions}}"
          wx:key="id"
          class="sheet-opt {{personaSheetSelection === item.id ? 'on' : ''}}"
          data-persona-id="{{item.id}}"
          bindtap="pickPersonaOption"
        >
          <view class="choice-radio"></view>
          <view class="row-copy">
            <text class="row-title">{{item.label}}</text>
            <text wx:if="{{item.note}}" class="row-meta">{{item.note}}</text>
          </view>
          <svg class="opt-check" width="18" height="18" viewBox="0 0 16 16" fill="none"><path d="M3.5 8.5l3 3 6-6.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </view>
        <button class="primary-button" style="margin-top: 16rpx;" loading="{{personaSaving}}" disabled="{{personaSaving}}" bindtap="confirmPersonaAssignment">确认分配</button>
        <button class="text-button" style="margin-top: 8rpx;" disabled="{{personaSaving}}" data-person-id="{{personaSheetSubjectId}}" bindtap="clearPersonaAssignment">恢复设备默认人格</button>
      </view>

      <!-- 设备信息诊断折叠面板 -->
      <view class="fold">
        <view class="list-row" bindtap="toggleDiag">
          <view class="row-icon">
            <svg viewBox="0 0 18 18" fill="none"><rect x="2.5" y="2.5" width="13" height="13" rx="3" stroke="currentColor" stroke-width="1.5"/><path d="M6 9h6M9 6v6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
          </view>
          <view class="row-copy">
            <text class="row-title">设备信息与诊断</text>
          </view>
          <text class="row-chevron">{{diagExpanded ? '﹀' : '›'}}</text>
        </view>
        <view wx:if="{{diagExpanded}}" class="diagnostic">
          <view class="summary-row"><text class="summary-key">设备用途</text><text class="summary-value">{{bindingModeLabel}}</text></view>
          <view class="summary-row"><text class="summary-key">绑定编号</text><text class="summary-value">{{binding.binding_id}}</text></view>
          <view wx:if="{{binding.binding_version}}" class="summary-row"><text class="summary-key">版本</text><text class="summary-value">v{{binding.binding_version}}</text></view>
          <view wx:if="{{firmwareVersion}}" class="summary-row"><text class="summary-key">固件</text><text class="summary-value">{{firmwareVersion}}</text></view>
          <view class="summary-row"><text class="summary-key">激活</text><text class="summary-value">{{activationLabel}}</text></view>
          <view class="summary-row"><text class="summary-key">交互方式</text><text class="summary-value">对话请在机器人上完成</text></view>
          <block wx:if="{{diagnostics}}">
            <view wx:if="{{diagnostics.generated_at}}" class="summary-row"><text class="summary-key">最近诊断</text><text class="summary-value">{{diagnostics.generated_at}}</text></view>
            <view class="summary-row"><text class="summary-key">配置版本</text><text class="summary-value">v{{diagnostics.runtime_profile_version}}</text></view>
            <view class="summary-row"><text class="summary-key">实际音频模式</text><text class="summary-value">{{effectiveAudioModeLabel}}</text></view>
          </block>
          <text class="caption">设备归属、在线状态、使用人和私密权限分别确认，不能互相替代。</text>
          <button class="text-button" bindtap="retryBindingSync">重新同步账号设备</button>
        </view>
      </view>

      <view wx:if="{{degradation}}" class="notice notice-warn">
        <text class="notice-title">安全模式</text>
        <text wx:for="{{degradation.reasons}}" wx:key="*this">{{item}}</text>
      </view>

      <view wx:if="{{sensitiveEntries.length > 0}}" class="list">
        <view wx:for="{{sensitiveEntries}}" wx:key="key" class="list-row" data-page="{{item.page}}" bindtap="openEntry">
          <view class="row-copy">
            <text class="row-title">{{item.title}}</text>
            <text class="row-meta">{{item.description}}</text>
          </view>
          <text class="row-chevron">›</text>
        </view>
      </view>

      <text wx:if="{{error}}" class="error-text">{{error}}</text>
    </block>
  </block>
</view>
