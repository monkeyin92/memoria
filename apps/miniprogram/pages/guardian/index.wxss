page {
  background: #FEF6E6;
}

.binding-result {
  margin-top: 22rpx;
  padding: 22rpx;
  border-radius: 28rpx;
  background: rgba(228, 242, 236, 0.86);
  border: 1rpx solid rgba(255, 255, 255, 0.7);
  text-align: center;
}

.binding-code {
  display: block;
  margin: 10rpx 0;
  color: #172f43;
  font-size: 54rpx;
  font-weight: 700;
  letter-spacing: 10rpx;
}

/* 成长小结卡头：标题 + 不含对话原文胶囊 */
.kept-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.bar-row {
  display: grid;
  grid-template-columns: 112rpx 1fr 44rpx;
  align-items: center;
  gap: 12rpx;
  margin-top: 12rpx;
  color: #596a78;
  font-size: 22rpx;
}

.bar-track {
  height: 12rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: rgba(30, 45, 70, 0.08);
}

.bar-fill {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #4f9b9c 0%, #326e70 100%);
}

.topic-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 14rpx;
}

.topic-tag {
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.62);
  border: 1rpx solid rgba(255, 255, 255, 0.8);
  color: #3f4c56;
  font-size: 22rpx;
}

.picker-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 84rpx;
}

.picker-label {
  color: #192f41;
}

.picker-value {
  color: #326e70;
}

/* 删除孩子数据：居中弹窗复用全局 .modal-wrap / .modal-card，只补输入框间距 */
.modal-card .field-input {
  margin-top: 24rpx;
}

.kept-head .l2-card-title {
  flex: 1;
  min-width: 0;
}
