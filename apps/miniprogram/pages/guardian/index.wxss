.binding-result {
  margin-top: 12px;
  padding: var(--mp-pad-card);
  border-radius: var(--mp-radius-inset);
  background: var(--mp-accent-soft);
  text-align: center;
}

.binding-code {
  display: block;
  margin: 4px 0;
  color: var(--mp-ink);
  font-size: var(--mp-type-num-xl);
  font-weight: 700;
  letter-spacing: 4px;
  line-height: 1.2;
}

.row-link {
  flex-shrink: 0;
  color: var(--mp-accent);
  font-size: var(--mp-type-caption);
  font-weight: 600;
}

/* 成长小结卡头：标题 + 不含对话原文胶囊 */
.kept-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
}

.kept-head .l2-card-title {
  flex: 1;
  min-width: 0;
}

.subject-actions button {
  padding: 8px;
  font-size: var(--mp-type-card);
}

.l2-card .group-label {
  margin: 16px 0 0;
}

.bar-row {
  display: grid;
  grid-template-columns: 56px 1fr 24px;
  align-items: center;
  gap: 8px;
  margin-top: 8px;
  color: var(--mp-ink-2);
  font-size: var(--mp-type-meta);
}

.bar-track {
  height: 8px;
  overflow: hidden;
  border-radius: var(--mp-radius-pill);
  background: var(--mp-track);
}

.bar-fill {
  height: 100%;
  border-radius: var(--mp-radius-pill);
  background: var(--mp-accent);
}

.topic-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin-top: 8px;
}

.topic-tag {
  padding: 4px 12px;
  border-radius: var(--mp-radius-pill);
  background: var(--mp-fill);
  color: var(--mp-ink-2);
  font-size: var(--mp-type-meta);
}

.picker-row {
  margin-top: 12px;
}

/* 删除孩子数据：居中弹窗复用全局 .modal-wrap / .modal-card，只补输入框间距 */
.modal-card .field-input {
  margin-top: 12px;
}
