.binding-result {
  margin-top: 22rpx;
  padding: 22rpx;
  border-radius: 22rpx;
  background: #e8f1ee;
  text-align: center;
}

.binding-code {
  display: block;
  margin: 10rpx 0;
  color: #172f43;
  font-size: 54rpx;
  font-weight: 700;
  letter-spacing: 10rpx;
}

.bar-row {
  display: grid;
  grid-template-columns: 112rpx 1fr 44rpx;
  align-items: center;
  gap: 12rpx;
  margin-top: 12rpx;
  color: #596a78;
  font-size: 22rpx;
}

.bar-track {
  height: 12rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: #dfe6ea;
}

.bar-fill {
  height: 100%;
  border-radius: 999rpx;
  background: #326e70;
}

.topic-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 14rpx;
}

.topic-tag {
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  background: #e8edf2;
  color: #526574;
  font-size: 22rpx;
}

.picker-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 84rpx;
}

.picker-label {
  color: #192f41;
}

.picker-value {
  color: #326e70;
}
