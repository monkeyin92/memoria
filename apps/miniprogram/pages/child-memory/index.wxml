<view class="cm-page trial-page">
  <text class="eyebrow">长期记住的事</text>
  <text class="trial-title">{{headerTitle}}</text>
  <text class="page-lede">{{headerCaption}}</text>

  <view class="seg cm-tabs">
    <view class="seg-item {{activeTab === 'recent' ? 'seg-item-on' : ''}}" bindtap="showRecent">近期摘要</view>
    <view class="seg-item {{activeTab === 'archive' ? 'seg-item-on' : ''}}" bindtap="showArchive">长期记忆</view>
  </view>

  <text wx:if="{{error}}" class="cm-error">{{error}}</text>
  <text wx:if="{{statusBanner}}" class="cm-banner">{{statusBanner}}</text>

  <view wx:if="{{!authenticated}}" class="trial-card cm-empty">
    <text class="cm-empty-title">请先登录</text>
    <text class="cm-empty-copy">登录后即可打开孩子的记忆档案。</text>
  </view>

  <view wx:elif="{{loadState === 'loading' || loading}}" class="trial-card">
    <text class="cm-loading">正在读取…</text>
  </view>

  <block wx:elif="{{activeTab === 'recent'}}">
    <view wx:if="{{!summaries.length}}" class="cm-empty-state">
      <face-badge role="{{companionId}}" size="empty" mood="thinking" plain></face-badge>
      <text class="cm-empty-title">{{emptyTitle}}</text>
      <text class="cm-empty-copy">{{emptyRecent}}</text>
    </view>

    <block wx:else>
      <view
        wx:for="{{summaries}}"
        wx:key="recordId"
        class="trial-card cm-row"
      >
        <view class="cm-row-body">
          <text class="cm-summary-text">{{item.text}}</text>
          <text class="cm-meta">{{item.dateLabel}}</text>
        </view>
        <view
          class="cm-delete"
          data-record-id="{{item.recordId}}"
          bindtap="askDeleteSummary"
          aria-label="删除"
        >
          <view class="cm-trash" aria-hidden="true">
            <view class="cm-trash-lid"></view>
            <view class="cm-trash-body"></view>
          </view>
        </view>
      </view>

      <view class="cm-footer">
        <text class="cm-muted-link" bindtap="askClearSummaries">清空全部</text>
      </view>
    </block>
  </block>

  <block wx:elif="{{activeTab === 'archive'}}">
    <block wx:if="{{!archiveConsent.active}}">
    </block>

    <view wx:elif="{{!archiveFlat.length}}" class="cm-empty-state">
      <face-badge role="{{companionId}}" size="empty" mood="thinking" plain></face-badge>
      <text class="cm-empty-title">暂无长期记忆</text>
      <text class="cm-empty-copy">{{emptyArchiveOn}}</text>
    </view>

    <block wx:else>
      <view class="trial-card trial-card-xl cm-archive">
        <view wx:for="{{archiveGroups}}" wx:key="field" class="cm-field">
          <mp-icon name="{{item.field === 'appellation' ? 'tag' : item.field === 'preference' ? 'heart' : 'paw'}}"></mp-icon>
          <view class="cm-field-body">
            <text class="cm-field-label">{{item.label}}</text>
            <view wx:for="{{item.items}}" wx:for-item="fact" wx:key="recordId" class="cm-fact">
              <view class="cm-fact-copy">
                <text class="cm-fact-text">{{fact.text}}</text>
                <text class="cm-meta">{{fact.dateLabel}}</text>
              </view>
              <view class="cm-delete" data-record-id="{{fact.recordId}}" bindtap="askDeleteArchive" aria-label="删除">
                <view class="cm-trash" aria-hidden="true">
                  <view class="cm-trash-lid"></view>
                  <view class="cm-trash-body"></view>
                </view>
              </view>
            </view>
          </view>
        </view>
      </view>

      <view class="trial-card cm-note">
        <view class="cm-note-art" aria-hidden="true"><image src="/assets/ui/v4/mascot-curious.jpg" mode="widthFix"></image></view>
        <text class="cm-note-text">长期记忆只记这三类：称呼、兴趣和小名。</text>
      </view>
    </block>

    <view class="trial-card cm-consent">
      <view class="cm-consent-row">
        <view class="cm-consent-copy">
          <text class="cm-consent-title">{{archiveConsent.label}}</text>
          <text class="cm-consent-desc">{{archiveConsent.description}}</text>
        </view>
        <switch
          checked="{{archiveConsent.active}}"
          color="#4A52C9"
          disabled="{{working}}"
          bindchange="onArchiveConsentChange"
          aria-label="长期记忆"
        />
      </view>
    </view>

    <view wx:if="{{archiveConsent.active && archiveFlat.length}}" class="cm-footer">
      <text class="cm-muted-link" bindtap="askClearArchive">清空全部</text>
    </view>
  </block>

  <text class="cm-privacy">{{privacyLine}}</text>

  <view wx:if="{{confirm}}" class="mp-sheet-mask" bindtap="closeConfirm" catchtouchmove="noop"></view>
  <view wx:if="{{confirm}}" class="mp-sheet" catchtap="noop">
    <view class="mp-sheet-grab"></view>
    <text class="mp-sheet-title">{{confirm.title}}</text>
    <view wx:if="{{confirm.quote}}" class="mp-sheet-quote">{{confirm.quote}}</view>
    <text wx:if="{{confirm.body}}" class="cm-sheet-body">{{confirm.body}}</text>
    <view class="mp-sheet-actions">
      <button class="trial-danger" bindtap="runConfirm" disabled="{{working}}">{{confirm.confirmLabel}}</button>
      <button class="trial-secondary" bindtap="closeConfirm" disabled="{{working}}">{{deleteKeepLabel}}</button>
    </view>
  </view>
</view>
