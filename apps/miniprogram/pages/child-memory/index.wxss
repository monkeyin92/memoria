/* Parent memory review. Off-white / light apricot + soft mint accent. */
.cm-page {
  --cm-bg: #faf6f0;
  --cm-card: #ffffff;
  --cm-ink: #2a2a28;
  --cm-muted: #8a8580;
  --cm-accent: #6f9e8e;
  --cm-accent-soft: rgba(111, 158, 142, 0.14);
  --cm-danger: #b56a64;
  --cm-shadow: 0 8rpx 28rpx rgba(60, 48, 36, 0.06);
  --cm-radius: 32rpx;
  min-height: 100vh;
  padding: 20rpx 32rpx 96rpx;
  background: var(--cm-bg);
  color: var(--cm-ink);
}

.cm-privacy {
  display: block;
  margin: 8rpx 4rpx 28rpx;
  color: var(--cm-muted);
  font-size: 22rpx;
  line-height: 1.6;
}

.cm-tabs {
  display: flex;
  gap: 8rpx;
  margin-bottom: 28rpx;
  padding: 6rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.72);
}

.cm-tab {
  flex: 1;
  padding: 18rpx 0;
  border-radius: 999rpx;
  color: var(--cm-muted);
  font-size: 28rpx;
  text-align: center;
}

.cm-tab-on {
  background: var(--cm-card);
  color: var(--cm-ink);
  font-weight: 600;
  box-shadow: var(--cm-shadow);
}

.cm-error {
  display: block;
  margin-bottom: 16rpx;
  color: var(--cm-danger);
  font-size: 24rpx;
}

.cm-banner {
  display: block;
  margin-bottom: 16rpx;
  padding: 16rpx 20rpx;
  border-radius: 20rpx;
  background: var(--cm-accent-soft);
  color: var(--cm-accent);
  font-size: 24rpx;
}

.cm-card {
  background: var(--cm-card);
  border-radius: var(--cm-radius);
  box-shadow: var(--cm-shadow);
}

.cm-loading {
  display: block;
  padding: 40rpx 28rpx;
  color: var(--cm-muted);
  font-size: 26rpx;
}

.cm-empty {
  padding: 56rpx 36rpx 48rpx;
  text-align: center;
}

.cm-empty-title {
  display: block;
  margin-bottom: 12rpx;
  color: var(--cm-ink);
  font-size: 30rpx;
  font-weight: 600;
}

.cm-empty-copy {
  display: block;
  color: var(--cm-muted);
  font-size: 26rpx;
  line-height: 1.7;
}

.cm-illus {
  position: relative;
  width: 120rpx;
  height: 88rpx;
  margin: 0 auto 28rpx;
}

.cm-illus-leaf {
  position: absolute;
  width: 52rpx;
  height: 52rpx;
  border-radius: 60% 0 60% 40%;
  background: var(--cm-accent-soft);
  transform: rotate(-28deg);
}

.cm-illus-leaf-a { left: 18rpx; top: 18rpx; }
.cm-illus-leaf-b {
  right: 18rpx;
  top: 8rpx;
  transform: rotate(18deg) scaleX(-1);
  opacity: 0.85;
}

.cm-illus-dot {
  position: absolute;
  left: 52rpx;
  bottom: 10rpx;
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: var(--cm-accent);
  opacity: 0.45;
}

.cm-swipe {
  position: relative;
  margin-bottom: 20rpx;
  overflow: hidden;
  border-radius: var(--cm-radius);
}

.cm-swipe-action {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  width: 144rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(181, 106, 100, 0.12);
  color: var(--cm-danger);
  font-size: 26rpx;
}

.cm-summary,
.cm-fact {
  position: relative;
  z-index: 1;
  display: flex;
  gap: 24rpx;
  align-items: flex-start;
  padding: 28rpx 28rpx;
  transition: transform 180ms ease;
}

.cm-swipe-open {
  transform: translateX(-144rpx);
}

.cm-date {
  flex: 0 0 140rpx;
  color: var(--cm-muted);
  font-size: 24rpx;
  line-height: 1.5;
}

.cm-summary-text {
  flex: 1;
  color: var(--cm-ink);
  font-size: 30rpx;
  line-height: 1.7;
}

.cm-fact {
  justify-content: space-between;
}

.cm-fact-text {
  flex: 1;
  color: var(--cm-ink);
  font-size: 30rpx;
  line-height: 1.6;
}

.cm-fact .cm-date {
  flex: 0 0 auto;
  margin-left: 16rpx;
  text-align: right;
}

.cm-consent {
  margin-bottom: 24rpx;
  padding: 28rpx;
}

.cm-consent-row {
  display: flex;
  gap: 20rpx;
  align-items: flex-start;
  justify-content: space-between;
}

.cm-consent-title {
  display: block;
  margin-bottom: 8rpx;
  font-size: 30rpx;
  font-weight: 600;
}

.cm-consent-desc {
  display: block;
  color: var(--cm-muted);
  font-size: 24rpx;
  line-height: 1.7;
}

.cm-group {
  margin-bottom: 12rpx;
}

.cm-group-title {
  display: block;
  margin: 8rpx 8rpx 16rpx;
  color: var(--cm-muted);
  font-size: 24rpx;
  letter-spacing: 0.5rpx;
}

.cm-footer {
  display: flex;
  justify-content: center;
  margin-top: 36rpx;
  padding-bottom: 24rpx;
}

.cm-danger-link {
  color: var(--cm-danger);
  font-size: 26rpx;
  padding: 12rpx 20rpx;
}

.cm-modal-wrap {
  position: fixed;
  inset: 0;
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 56rpx;
  background: rgba(42, 36, 30, 0.36);
}

.cm-modal {
  width: 100%;
  padding: 40rpx 36rpx 28rpx;
  border-radius: 36rpx;
  background: #fff;
  box-shadow: 0 24rpx 64rpx rgba(40, 30, 20, 0.16);
}

.cm-modal-title {
  display: block;
  margin-bottom: 12rpx;
  font-size: 32rpx;
  font-weight: 600;
}

.cm-modal-body {
  display: block;
  color: var(--cm-muted);
  font-size: 26rpx;
  line-height: 1.7;
}

.cm-modal-actions {
  display: flex;
  justify-content: flex-end;
  gap: 36rpx;
  margin-top: 36rpx;
}

.cm-modal-cancel {
  color: var(--cm-muted);
  font-size: 28rpx;
  padding: 8rpx 4rpx;
}

.cm-modal-ok {
  color: var(--cm-danger);
  font-size: 28rpx;
  font-weight: 600;
  padding: 8rpx 4rpx;
}
