@import "../../styles/trial-theme.wxss";

.cm-page {
  padding-top: 24px;
  padding-bottom: var(--mp-page-foot);
  background: var(--mp-bg);
  color: var(--mp-ink);
}

.cm-privacy {
  display: block;
  margin: 24px 16px 0;
  color: var(--mp-ink-3);
  font-size: var(--mp-type-caption);
  line-height: var(--mp-lh-caption);
  text-align: center;
}

.cm-first {
  margin-top: 24px;
}

.cm-error {
  display: block;
  margin-bottom: 8px;
  color: var(--mp-rust);
  font-size: var(--mp-type-meta);
  line-height: var(--mp-lh-caption);
}

.cm-banner {
  display: block;
  margin-bottom: var(--mp-gap-card);
  padding: 12px var(--mp-pad-card);
  border-radius: var(--mp-radius-inset);
  background: var(--mp-accent-soft);
  color: var(--mp-accent);
  font-size: var(--mp-type-meta);
  line-height: var(--mp-lh-caption);
}

.cm-loading {
  display: block;
  padding: 24px var(--mp-pad-card);
  color: var(--mp-ink-2);
  font-size: var(--mp-type-caption);
}

.cm-empty,
.cm-empty-state {
  padding: 32px var(--mp-pad-card-lg) 24px;
  text-align: center;
}

.cm-empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12px;
}

.cm-empty-title {
  display: block;
  margin-bottom: 4px;
  color: var(--mp-ink);
  font-size: var(--mp-type-card);
  font-weight: 700;
  line-height: var(--mp-lh-card);
}

.cm-empty-copy {
  display: block;
  color: var(--mp-ink-2);
  font-size: var(--mp-type-caption);
  line-height: var(--mp-lh-caption);
}

.cm-row {
  display: flex;
  align-items: flex-start;
  gap: 12px;
  margin-bottom: var(--mp-gap-card);
  padding: var(--mp-pad-card) var(--mp-pad-card) var(--mp-pad-card) var(--mp-pad-card-lg);
}

.cm-row-body {
  flex: 1;
  min-width: 0;
}

.cm-summary-text {
  display: -webkit-box;
  overflow: hidden;
  color: var(--mp-ink);
  font-size: var(--mp-type-body);
  line-height: var(--mp-lh-body);
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.cm-meta {
  display: block;
  margin-top: 4px;
  color: var(--mp-ink-3);
  font-size: var(--mp-type-meta);
  line-height: var(--mp-lh-caption);
}

.cm-archive {
  overflow: hidden;
}

.cm-field {
  display: flex;
  align-items: center;
  gap: 16px;
  padding: 24px;
}

.cm-field + .cm-field {
  box-shadow: inset 0 1px 0 var(--mp-line);
}

.cm-field-body {
  flex: 1;
  min-width: 0;
}

.cm-field-label {
  display: block;
  color: var(--mp-ink-3);
  font-size: var(--mp-type-caption);
}

.cm-fact {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-top: 4px;
}

.cm-fact + .cm-fact {
  margin-top: 12px;
}

.cm-fact-copy {
  flex: 1;
  min-width: 0;
}

.cm-fact-text {
  display: block;
  color: var(--mp-ink);
  font-size: var(--mp-type-lead);
  font-weight: 700;
  letter-spacing: -0.2px;
  word-break: break-all;
}

.cm-fact .cm-meta {
  line-height: normal;
}

/* Negative margins keep a 44px tap target without pushing the row taller than the design's. */
.cm-delete {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 44px;
  height: 44px;
  margin: -10px -14px -10px 0;
}

.cm-trash {
  position: relative;
  width: 14px;
  height: 16px;
}

.cm-trash-lid {
  position: absolute;
  top: 0;
  left: 1px;
  width: 12px;
  height: 3px;
  border-radius: 1px;
  background: var(--mp-ink-4);
}

.cm-trash-lid::before {
  content: "";
  position: absolute;
  top: -2px;
  left: 3px;
  width: 6px;
  height: 2px;
  border-radius: 1px;
  background: var(--mp-ink-4);
}

.cm-trash-body {
  position: absolute;
  top: 5px;
  left: 2px;
  width: 10px;
  height: 10px;
  border: 1.5px solid var(--mp-ink-4);
  border-top: 0;
  border-radius: 0 0 2px 2px;
  box-sizing: border-box;
}

.cm-note {
  display: flex;
  align-items: center;
  gap: 16px;
  margin-top: var(--mp-gap-card);
  padding: var(--mp-pad-card);
}

.cm-note-art {
  display: flex;
  justify-content: center;
  flex-shrink: 0;
  width: 56px;
  height: 56px;
  overflow: hidden;
  border-radius: 50%;
  background: var(--mp-accent-soft);
}

.cm-note-art image {
  flex-shrink: 0;
  width: 72px;
  margin-top: 8px;
  mix-blend-mode: multiply;
}

.cm-note-text {
  flex: 1;
  min-width: 0;
  color: var(--mp-ink-2);
  font-size: var(--mp-type-caption);
  line-height: var(--mp-lh-caption);
}

.cm-consent {
  margin-top: var(--mp-gap-card);
  padding: var(--mp-pad-card) var(--mp-pad-card-lg);
}
.cm-consent-row {
  display: flex;
  gap: 12px;
  align-items: center;
  justify-content: space-between;
}

.cm-consent-copy {
  flex: 1;
  min-width: 0;
}

.cm-consent-title {
  display: block;
  color: var(--mp-ink);
  font-size: var(--mp-type-card);
  font-weight: 700;
  line-height: var(--mp-lh-card);
}

.cm-consent-desc {
  display: block;
  margin-top: 4px;
  color: var(--mp-ink-2);
  font-size: var(--mp-type-meta);
  line-height: var(--mp-lh-caption);
}

.cm-footer {
  display: flex;
  justify-content: center;
  margin-top: 24px;
  padding-bottom: 12px;
}

.cm-muted-link {
  padding: 8px 12px;
  color: var(--mp-ink-3);
  font-size: var(--mp-type-caption);
}

.cm-sheet-body {
  display: block;
  margin-bottom: 24px;
  color: var(--mp-ink-2);
  font-size: var(--mp-type-caption);
  line-height: var(--mp-lh-caption);
}
