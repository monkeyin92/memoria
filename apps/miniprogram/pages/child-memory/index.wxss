@import "../../styles/trial-theme.wxss";

.cm-page {
  padding-top: 48rpx;
  padding-bottom: var(--mp-page-foot);
  background: var(--mp-bg);
  color: var(--mp-ink);
}

.cm-privacy {
  display: block;
  margin: 48rpx 32rpx 0;
  color: var(--mp-ink-3);
  font-size: var(--mp-type-caption);
  line-height: var(--mp-lh-caption);
  text-align: center;
}

.cm-tabs {
  margin: 48rpx 0 var(--mp-gap-card);
}

.cm-error {
  display: block;
  margin-bottom: 16rpx;
  color: var(--mp-rust);
  font-size: var(--mp-type-meta);
  line-height: var(--mp-lh-caption);
}

.cm-banner {
  display: block;
  margin-bottom: var(--mp-gap-card);
  padding: 24rpx var(--mp-pad-card);
  border-radius: var(--mp-radius-inset);
  background: var(--mp-accent-soft);
  color: var(--mp-accent);
  font-size: var(--mp-type-meta);
  line-height: var(--mp-lh-caption);
}

.cm-loading {
  display: block;
  padding: 48rpx var(--mp-pad-card);
  color: var(--mp-ink-2);
  font-size: var(--mp-type-caption);
}

.cm-empty,
.cm-empty-state {
  padding: 64rpx var(--mp-pad-card-lg) 48rpx;
  text-align: center;
}

.cm-empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24rpx;
}

.cm-empty-title {
  display: block;
  margin-bottom: 8rpx;
  color: var(--mp-ink);
  font-size: var(--mp-type-card);
  font-weight: 700;
  line-height: var(--mp-lh-card);
}

.cm-empty-copy {
  display: block;
  color: var(--mp-ink-2);
  font-size: var(--mp-type-caption);
  line-height: var(--mp-lh-caption);
}

.cm-row {
  display: flex;
  align-items: flex-start;
  gap: 24rpx;
  margin-bottom: var(--mp-gap-card);
  padding: var(--mp-pad-card) var(--mp-pad-card) var(--mp-pad-card) var(--mp-pad-card-lg);
}

.cm-row-body {
  flex: 1;
  min-width: 0;
}

.cm-summary-text {
  display: -webkit-box;
  overflow: hidden;
  color: var(--mp-ink);
  font-size: var(--mp-type-body);
  line-height: var(--mp-lh-body);
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.cm-meta {
  display: block;
  margin-top: 8rpx;
  color: var(--mp-ink-3);
  font-size: var(--mp-type-meta);
  line-height: var(--mp-lh-caption);
}

.cm-archive {
  overflow: hidden;
}

.cm-field {
  display: flex;
  align-items: center;
  gap: 32rpx;
  padding: 48rpx;
}

.cm-field + .cm-field {
  border-top: 2rpx solid var(--mp-line);
}

.cm-field-body {
  flex: 1;
  min-width: 0;
}

.cm-field-label {
  display: block;
  color: var(--mp-ink-3);
  font-size: var(--mp-type-caption);
  line-height: var(--mp-lh-caption);
}

.cm-fact {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 8rpx;
}

.cm-fact + .cm-fact {
  margin-top: 24rpx;
}

.cm-fact-copy {
  flex: 1;
  min-width: 0;
}

.cm-fact-text {
  display: block;
  color: var(--mp-ink);
  font-size: var(--mp-type-lead);
  font-weight: 700;
  letter-spacing: -0.4rpx;
  line-height: var(--mp-lh-card);
  word-break: break-all;
}

.cm-fact .cm-meta {
  margin-top: 4rpx;
}

.cm-delete {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 72rpx;
  height: 72rpx;
  border-radius: var(--mp-radius-icon);
  background: var(--mp-fill);
}

.cm-trash {
  position: relative;
  width: 28rpx;
  height: 32rpx;
}

.cm-trash-lid {
  position: absolute;
  top: 0;
  left: 2rpx;
  width: 24rpx;
  height: 6rpx;
  border-radius: 2rpx;
  background: var(--mp-ink-3);
}

.cm-trash-lid::before {
  content: "";
  position: absolute;
  top: -4rpx;
  left: 6rpx;
  width: 12rpx;
  height: 4rpx;
  border-radius: 2rpx;
  background: var(--mp-ink-3);
}

.cm-trash-body {
  position: absolute;
  top: 10rpx;
  left: 4rpx;
  width: 20rpx;
  height: 20rpx;
  border: 3rpx solid var(--mp-ink-3);
  border-top: 0;
  border-radius: 0 0 4rpx 4rpx;
  box-sizing: border-box;
}

.cm-note {
  display: flex;
  align-items: center;
  gap: 32rpx;
  margin-top: var(--mp-gap-card);
  padding: var(--mp-pad-card);
}

.cm-note-art {
  display: flex;
  justify-content: center;
  flex-shrink: 0;
  width: 112rpx;
  height: 112rpx;
  overflow: hidden;
  border-radius: 50%;
  background: var(--mp-accent-soft);
}

.cm-note-art image {
  flex-shrink: 0;
  width: 144rpx;
  margin-top: 16rpx;
}

.cm-note-text {
  flex: 1;
  min-width: 0;
  color: var(--mp-ink-2);
  font-size: var(--mp-type-caption);
  line-height: var(--mp-lh-caption);
}

.cm-consent {
  margin-top: var(--mp-gap-card);
  padding: var(--mp-pad-card) var(--mp-pad-card-lg);
}
.cm-consent-row {
  display: flex;
  gap: 24rpx;
  align-items: center;
  justify-content: space-between;
}

.cm-consent-copy {
  flex: 1;
  min-width: 0;
}

.cm-consent-title {
  display: block;
  color: var(--mp-ink);
  font-size: var(--mp-type-card);
  font-weight: 700;
  line-height: var(--mp-lh-card);
}

.cm-consent-desc {
  display: block;
  margin-top: 8rpx;
  color: var(--mp-ink-2);
  font-size: var(--mp-type-meta);
  line-height: var(--mp-lh-caption);
}

.cm-footer {
  display: flex;
  justify-content: center;
  margin-top: 48rpx;
  padding-bottom: 24rpx;
}

.cm-muted-link {
  padding: 16rpx 24rpx;
  color: var(--mp-ink-3);
  font-size: var(--mp-type-caption);
}

.cm-sheet-body {
  display: block;
  margin-bottom: 48rpx;
  color: var(--mp-ink-2);
  font-size: var(--mp-type-caption);
  line-height: var(--mp-lh-caption);
}
