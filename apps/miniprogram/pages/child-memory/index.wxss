@import "../../styles/trial-theme.wxss";

.cm-page {
  padding: 20rpx var(--mp-pad-page) 96rpx;
  background: var(--mp-bg);
  color: var(--mp-ink);
}

.cm-hero {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
  margin-bottom: 24rpx;
}

.cm-hero-copy {
  flex: 1;
  min-width: 0;
}

.cm-privacy {
  display: block;
  margin: 0 0 28rpx;
  color: var(--mp-ink-2);
  font-size: var(--mp-type-caption);
  line-height: var(--mp-lh-caption);
}

.cm-tabs {
  display: flex;
  gap: 8rpx;
  margin-bottom: 28rpx;
  padding: 6rpx;
  border-radius: var(--mp-radius-pill);
  background: var(--mp-fill);
}

.cm-tab {
  flex: 1;
  padding: 18rpx 0;
  border-radius: var(--mp-radius-pill);
  color: var(--mp-ink-2);
  font-size: 28rpx;
  text-align: center;
}

.cm-tab-on {
  background: var(--mp-surface);
  color: var(--mp-accent);
  font-weight: 600;
}

.cm-error {
  display: block;
  margin-bottom: 16rpx;
  color: var(--mp-rust);
  font-size: 24rpx;
}

.cm-banner {
  display: block;
  margin-bottom: 16rpx;
  padding: 16rpx 20rpx;
  border-radius: var(--mp-radius-card);
  background: var(--mp-accent-soft);
  color: var(--mp-accent);
  font-size: 24rpx;
}

.cm-loading {
  display: block;
  padding: 40rpx 28rpx;
  color: var(--mp-ink-2);
  font-size: 26rpx;
}

.cm-empty,
.cm-empty-state {
  padding: 56rpx 36rpx 48rpx;
  text-align: center;
}

.cm-empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
}

.cm-empty-title {
  display: block;
  margin-bottom: 12rpx;
  color: var(--mp-ink);
  font-size: 30rpx;
  font-weight: 600;
}

.cm-empty-copy {
  display: block;
  color: var(--mp-ink-2);
  font-size: 26rpx;
  line-height: 1.7;
}

.cm-row {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
  margin-bottom: 20rpx;
  padding: 32rpx 28rpx;
}

.cm-row-body {
  flex: 1;
  min-width: 0;
}

.cm-summary-text {
  display: -webkit-box;
  overflow: hidden;
  color: var(--mp-ink);
  font-size: var(--mp-type-body);
  line-height: var(--mp-lh-body);
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.cm-meta {
  display: block;
  margin-top: 12rpx;
  color: var(--mp-ink-3);
  font-size: var(--mp-type-meta);
}

.cm-delete {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
  border-radius: var(--mp-radius-icon);
  background: var(--mp-bg);
}

.cm-trash {
  position: relative;
  width: 28rpx;
  height: 32rpx;
}

.cm-trash-lid {
  position: absolute;
  top: 0;
  left: 2rpx;
  width: 24rpx;
  height: 6rpx;
  border-radius: 2rpx;
  background: var(--mp-ink-3);
}

.cm-trash-lid::before {
  content: "";
  position: absolute;
  top: -4rpx;
  left: 6rpx;
  width: 12rpx;
  height: 4rpx;
  border-radius: 2rpx;
  background: var(--mp-ink-3);
}

.cm-trash-body {
  position: absolute;
  top: 10rpx;
  left: 4rpx;
  width: 20rpx;
  height: 20rpx;
  border: 3rpx solid var(--mp-ink-3);
  border-top: 0;
  border-radius: 0 0 4rpx 4rpx;
  box-sizing: border-box;
}

.cm-consent {
  margin-bottom: 24rpx;
  padding: 28rpx;
}

.cm-consent-row {
  display: flex;
  gap: 20rpx;
  align-items: flex-start;
  justify-content: space-between;
}

.cm-consent-title {
  display: block;
  margin-bottom: 8rpx;
  font-size: 30rpx;
  font-weight: 600;
}

.cm-consent-desc {
  display: block;
  color: var(--mp-ink-2);
  font-size: 24rpx;
  line-height: 1.7;
}

.cm-group {
  margin-bottom: 12rpx;
}

.cm-group-title {
  display: inline-block;
  margin: 8rpx 8rpx 16rpx;
  color: var(--mp-ink-3);
  font-size: 22rpx;
  letter-spacing: 0.5rpx;
}

.cm-footer {
  display: flex;
  justify-content: center;
  margin-top: 36rpx;
  padding-bottom: 24rpx;
}

.cm-muted-link {
  color: var(--mp-ink-3);
  font-size: 26rpx;
  padding: 12rpx 20rpx;
}

.cm-sheet-body {
  display: block;
  margin-bottom: 36rpx;
  color: var(--mp-ink-2);
  font-size: 26rpx;
  line-height: 1.7;
}
