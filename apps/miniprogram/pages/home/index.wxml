<view class="page-shell trial-page home-trial">
  <view wx:if="{{!authenticated}}">
    <text class="trial-title">你好，欢迎来到 Memoria</text>
    <text class="trial-caption">把设备连好，再慢慢留下日常。</text>
    <view class="trial-card home-guest-card">
      <text class="home-guest-lead">记住哪些事，由你决定。</text>
      <text class="trial-caption">在设备上记录，在这里确认与整理。</text>
    </view>
    <view class="home-cta">
      <button class="trial-primary" bindtap="loginFromHome">微信登录，找回我的设备</button>
    </view>
    <text class="trial-caption home-foot">对话在设备上完成。手机用来连接、确认和整理，不录音。</text>
  </view>

  <block wx:else>
    <text class="trial-title">{{greeting}}</text>
    <text class="trial-caption">{{pageLede}}</text>

    <view wx:if="{{loading}}" class="trial-card home-pad">
      <text class="trial-caption">{{syncingBindings ? '正在同步你的设备…' : '正在读取状态…'}}</text>
    </view>

    <view wx:elif="{{bindingSyncError && !hasBinding && !needsBindingChoice}}" class="trial-card home-pad">
      <text class="home-empty-title">设备信息暂未同步</text>
      <text class="trial-caption">这不代表未绑定，无需重新配网。{{bindingSyncError}}</text>
      <button class="trial-primary home-cta-btn" bindtap="retryBindingSync">重新同步</button>
    </view>

    <view wx:elif="{{needsBindingChoice}}">
      <text class="trial-caption">设备信息已从账号找到。选择你要查看的设备。</text>
      <view
        wx:for="{{bindingChoices}}"
        wx:key="bindingId"
        class="trial-card home-choice"
        data-binding-id="{{item.bindingId}}"
        bindtap="chooseDeviceBinding"
      >
        <view class="home-choice-copy">
          <text class="home-choice-title">{{item.label}}</text>
          <text class="trial-caption">{{item.modeLabel}}</text>
        </view>
        <text class="trial-banner-chevron">›</text>
      </view>
      <text class="trial-caption">切换设备不会赋予查看其他成员私密内容的权限。</text>
      <text wx:if="{{bindingSyncError}}" class="home-error">{{bindingSyncError}}</text>
    </view>

    <view wx:elif="{{!hasBinding}}" class="trial-card home-pad">
      <text class="home-empty-title">还没有绑定设备</text>
      <text class="trial-caption">已完成账号同步。请接通设备电源，在手机旁完成首次启用。</text>
      <button class="trial-primary home-cta-btn" bindtap="openOnboarding">{{hasPendingOnboarding ? '继续上次启用' : '添加第一台设备'}}</button>
      <button class="home-text-btn" bindtap="showSyncHelp">其他手机上已经有设备？</button>
    </view>

    <block wx:else>
      <view
        wx:if="{{unreadSafetyAlert || pinnedCrisisAlerts.length}}"
        class="trial-banner"
        bindtap="openUnreadSafety"
      >
        <view class="trial-banner-dot"></view>
        <view class="trial-banner-copy">
          <text class="trial-banner-title">{{unreadSafetyCopy}}</text>
          <text class="trial-banner-meta">{{unreadSafetyMeta}}</text>
        </view>
        <text class="trial-banner-chevron">›</text>
      </view>

      <view class="trial-card home-device-card" bindtap="openDevice">
        <view class="mp-mascot-tile">
          <face-badge role="{{heroRoleId}}" size="tile" mood="default" plain></face-badge>
        </view>
        <view class="home-device-copy">
          <text class="home-device-name">{{devicePlaceName}}</text>
          <view class="trial-status-pill {{online ? '' : 'is-off'}}">
            <view class="trial-status-dot"></view>
            <text>{{statusLine}}</text>
          </view>
        </view>
      </view>

      <view wx:if="{{showChildMemory}}" class="trial-card home-memory-card">
        <view class="home-memory-head">
          <text class="home-card-title">{{childMemoryName}}的记忆</text>
          <text class="trial-link" bindtap="openChildMemory">查看全部</text>
        </view>
        <view wx:if="{{memoryPreviews.length}}" class="home-memory-list">
          <view
            wx:for="{{memoryPreviews}}"
            wx:key="recordId"
            class="home-memory-preview"
          >
            <text class="home-memory-text">{{item.text}}</text>
          </view>
        </view>
        <text wx:else class="trial-caption home-memory-empty">还没有摘要。聊过之后会出现在这里。</text>
      </view>

      <view wx:if="{{showSafetyNightCard}}" class="trial-card home-toggle-card">
        <view class="home-toggle-row">
          <view class="home-toggle-copy">
            <text class="home-card-title">安全提醒</text>
            <text class="trial-caption">{{safetySubscribeHelper}}</text>
          </view>
          <switch
            checked="{{safetySubscribeKnown && safetySubscribeOn}}"
            color="#E2702A"
            disabled="{{!safetySubscribeKnown || safetySubscribeBusy}}"
            bindchange="onSafetySubscribeChange"
          />
        </view>
        <view class="home-toggle-row" bindtap="openNightSettings">
          <view class="home-toggle-copy">
            <text class="home-card-title">夜间模式</text>
            <text class="trial-caption">{{quietHoursLabel}}</text>
          </view>
          <switch
            checked="{{nightModeOn}}"
            color="#E2702A"
            disabled="{{nightToggleBusy}}"
            catchchange="onNightModeChange"
          />
        </view>
      </view>
    </block>

    <text class="trial-caption home-foot">在设备上使用，手机不录音。对话由人工智能生成，会明确标识。</text>
  </block>
</view>
