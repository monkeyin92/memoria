<view class="page-shell trial-page tab-page home-v4" style="{{statusBarStyle}}">
  <view wx:if="{{!authenticated}}" class="home-guest">
    <text class="home-wordmark">Memoria</text>
    <text class="page-title">{{guestHome.productTitle}}</text>
    <text class="page-lede">{{guestHome.productBody}}</text>
    <view class="card guest-features">
      <view wx:for="{{guestHome.features}}" wx:key="id" class="guest-feature">
        <text class="home-card-title">{{item.title}}</text>
      </view>
    </view>
    <view class="home-note guest-agreements">
      <text
        wx:for="{{guestHome.agreements}}"
        wx:key="id"
        class="legal-link"
        data-id="{{item.id}}"
        catchtap="openGuestAgreement"
      >《{{item.title}}》</text>
    </view>
    <button class="trial-primary" bindtap="openAccountLogin">登录</button>
    <view class="list guest-actions">
      <view
        wx:for="{{loginGatedActions}}"
        wx:key="id"
        class="list-row"
        data-id="{{item.id}}"
        bindtap="onGuestGatedAction"
      >
        <text class="row-title row-copy">{{item.label}}</text>
      </view>
    </view>
  </view>

  <block wx:else>
    <view class="home-head">
      <view class="home-head-copy">
        <text class="home-wordmark">Memoria</text>
        <text class="trial-title">今天</text>
      </view>
      <text class="home-date">{{pageLede}}</text>
    </view>

    <view wx:if="{{loading}}" class="trial-card home-pad">
      <text class="trial-caption">{{syncingBindings ? '正在同步你的设备…' : '正在读取状态…'}}</text>
    </view>

    <view wx:elif="{{bindingSyncError && !hasBinding && !needsBindingChoice}}" class="trial-card home-pad">
      <text class="home-card-title">设备信息暂未同步</text>
      <text class="trial-caption">这不代表未绑定，无需重新配网。{{bindingSyncError}}</text>
      <button class="trial-primary home-cta-btn" bindtap="retryBindingSync">重新同步</button>
    </view>

    <view wx:elif="{{needsBindingChoice}}">
      <text class="trial-caption home-choice-lede">设备信息已从账号找到。选择你要查看的设备。</text>
      <view
        wx:for="{{bindingChoices}}"
        wx:key="bindingId"
        class="trial-card home-choice"
        data-binding-id="{{item.bindingId}}"
        bindtap="chooseDeviceBinding"
      >
        <view class="home-choice-copy">
          <text class="home-card-title">{{item.label}}</text>
          <text class="trial-caption">{{item.modeLabel}}</text>
        </view>
        <image class="home-chev" src="/assets/ui/v4/chev-faint.svg" />
      </view>
      <text class="trial-caption">切换设备不会赋予查看其他成员私密内容的权限。</text>
      <text wx:if="{{bindingSyncError}}" class="home-error">{{bindingSyncError}}</text>
    </view>

    <view wx:elif="{{!hasBinding}}" class="trial-card home-pad">
      <text class="home-card-title">还没有绑定设备</text>
      <text class="trial-caption">已完成账号同步。请接通设备电源，在手机旁完成首次启用。</text>
      <button class="trial-primary home-cta-btn" bindtap="openOnboarding">{{hasPendingOnboarding ? '继续上次启用' : '添加第一台设备'}}</button>
      <button class="home-text-btn" bindtap="showSyncHelp">其他手机上已经有设备？</button>
    </view>

    <block wx:else>
      <view
        wx:if="{{unreadSafetyAlert}}"
        class="trial-banner home-attention"
        bindtap="openUnreadSafety"
      >
        <view class="trial-banner-icon"><image src="/assets/ui/v4/heart-rust.svg" /></view>
        <view class="trial-banner-copy">
          <text class="trial-banner-title">{{unreadSafetyCopy}}</text>
          <text class="trial-banner-meta">{{unreadSafetyMeta}}</text>
        </view>
        <image class="home-chev" src="/assets/ui/v4/chev-rust.svg" />
      </view>

      <view class="home-status-card">
        <view class="home-status-top">
          <text class="home-status-label">当前设备</text>
          <view class="home-status-state"><view class="home-status-dot {{online ? '' : 'home-status-dot-off'}}"></view><text>{{online ? '设备在线' : '设备离线'}}</text></view>
        </view>
        <text class="home-status-title">{{devicePlaceName}}</text>
        <view class="home-status-bottom">
          <text class="home-status-caption">{{online ? '查看用量与设备设置。' : '检查电源与网络后重试。'}}</text>
          <button class="home-status-button" bindtap="openDevice">查看设备</button>
        </view>
      </view>

      <view class="home-daily-strip" bindtap="openDevice">
        <view class="home-daily-item"><text class="home-lbl">今日对话</text><text class="home-daily-value">{{todayCount}}<text class="home-daily-unit"> 次</text></text></view>
        <view class="home-daily-item"><text class="home-lbl">今日用量</text><text class="home-daily-value">{{usageKnown ? usageUsedMinutes : '待统计'}}<text wx:if="{{usageKnown}}" class="home-daily-unit"> 分钟</text></text></view>
        <view class="home-daily-more"><image class="home-chev" src="/assets/ui/v4/chev-faint.svg" /></view>
      </view>

      <view class="home-section-head"><text>近期回顾</text><button class="home-section-link" bindtap="openMemory">查看全部</button></view>
      <view class="trial-card trial-card-xl home-review-card" bindtap="openMemory">
        <view class="home-review-top">
          <view class="home-review-icon"><image src="/assets/ui/v4/note-ink.svg" aria-hidden="true"></image></view>
          <text class="home-lbl">{{memoryPreviews.length ? '最近聊到的事' : '对话留下的片段'}}</text>
        </view>
        <view class="home-review-body">
          <view class="home-review-copy">
            <text wx:if="{{memoryPreviews.length}}" class="home-review-lead">{{memoryPreviews[0].text}}</text>
            <text wx:elif="{{dailySummaryText}}" class="home-review-lead">{{dailySummaryText}}</text>
            <text wx:else class="home-review-empty">还没有摘要，聊过之后会出现在这里</text>
          </view>
        </view>
        <view class="home-review-meta">
          <text wx:if="{{showChildMemory}}" class="home-review-stat">近期摘要 {{summaryCount}} 条</text>
          <text class="home-review-open">打开回顾</text>
          <image class="home-chev" src="/assets/ui/v4/chev-faint.svg" />
        </view>
      </view>


      <view wx:if="{{showChildMemory}}" class="trial-card home-row-card home-memory-entry" bindtap="openChildMemory">
        <view class="mp-icon-tile"><image src="/assets/ui/v4/book-accent.svg" /></view>
        <view class="home-row-copy">
          <text class="home-card-title">{{childMemoryName}}的记忆</text>
          <text class="home-row-sub">查看长期记忆与近期摘要</text>
        </view>
        <image class="home-chev" src="/assets/ui/v4/chev-faint.svg" />
      </view>

      <view wx:if="{{showSafetyNightCard && subscriptionPushEnabled}}" class="trial-card home-toggle-card">
        <view class="home-toggle-row">
          <view class="home-toggle-copy">
            <text class="home-card-title">安全提醒</text>
            <text class="trial-caption">{{safetySubscribeHelper}}</text>
          </view>
          <switch
            checked="{{safetySubscribeKnown && safetySubscribeOn}}"
            color="#2455EF"
            disabled="{{!safetySubscribeKnown || safetySubscribeBusy}}"
            bindchange="onSafetySubscribeChange"
          />
        </view>
        <view class="home-toggle-row" bindtap="openNightSettings">
          <view class="mp-icon-tile home-moon"><image src="/assets/ui/v4/moon-ink.svg" /></view>
          <view class="home-toggle-copy">
            <text class="home-card-title">安静时段</text>
            <text class="trial-caption">{{nightModeOn ? quietHoursLabel : '未设置'}}</text>
          </view>
          <image class="home-chev" src="/assets/ui/v4/chev-faint.svg" />
        </view>
      </view>
    </block>

    <text class="home-note">在设备上和孩子对话，手机端不收声，回应由 AI 生成。</text>
  </block>
</view>
