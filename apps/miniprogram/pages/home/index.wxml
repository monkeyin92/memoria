<view class="page-shell tab-page home-v4" style="{{statusBarStyle}}">
  <view wx:if="{{!authenticated}}" class="home-guest">
    <text class="page-title">{{guestHome.productTitle}}</text>
    <text class="page-lede">{{guestHome.productBody}}</text>
    <view class="card guest-features">
      <view wx:for="{{guestHome.features}}" wx:key="id" class="guest-feature">
        <text class="home-card-title">{{item.title}}</text>
      </view>
    </view>
    <view class="home-note guest-agreements">
      <text
        wx:for="{{guestHome.agreements}}"
        wx:key="id"
        class="legal-link"
        data-id="{{item.id}}"
        catchtap="openGuestAgreement"
      >《{{item.title}}》</text>
    </view>
    <button class="primary-button" bindtap="openAccountLogin">登录</button>
    <view class="list guest-actions">
      <view
        wx:for="{{loginGatedActions}}"
        wx:key="id"
        class="list-row"
        data-id="{{item.id}}"
        bindtap="onGuestGatedAction"
      >
        <text class="row-title row-copy">{{item.label}}</text>
      </view>
    </view>
  </view>

  <block wx:else>
    <view class="home-head">
      <view class="home-head-copy">
        <text class="eyebrow">{{pageLede}}</text>
        <text class="page-title">今天</text>
      </view>
      <view class="home-avatar" bindtap="openProfile">{{avatarGlyph}}</view>
    </view>

    <view wx:if="{{loading}}" class="card home-pad">
      <text class="l2-card-sub">{{syncingBindings ? '正在同步你的设备…' : '正在读取状态…'}}</text>
    </view>

    <view wx:elif="{{bindingSyncError && !hasBinding && !needsBindingChoice}}" class="card home-pad">
      <text class="home-card-title">设备信息暂未同步</text>
      <text class="l2-card-sub">这不代表未绑定，无需重新配网。{{bindingSyncError}}</text>
      <button class="primary-button home-cta-btn" bindtap="retryBindingSync">重新同步</button>
    </view>

    <view wx:elif="{{needsBindingChoice}}">
      <text class="l2-card-sub home-choice-lede">设备信息已从账号找到。选择你要查看的设备。</text>
      <view
        wx:for="{{bindingChoices}}"
        wx:key="bindingId"
        class="card home-choice"
        data-binding-id="{{item.bindingId}}"
        bindtap="chooseDeviceBinding"
      >
        <view class="home-choice-copy">
          <text class="home-card-title">{{item.label}}</text>
          <text class="l2-card-sub">{{item.modeLabel}}</text>
        </view>
        <image class="home-chev" src="/assets/ui/v4/chev-faint.svg" />
      </view>
      <text class="l2-card-sub">切换设备不会赋予查看其他成员私密内容的权限。</text>
      <text wx:if="{{bindingSyncError}}" class="home-error">{{bindingSyncError}}</text>
    </view>

    <view wx:elif="{{!hasBinding}}" class="card home-pad">
      <text class="home-card-title">还没有绑定设备</text>
      <text class="l2-card-sub">已完成账号同步。请接通设备电源，在手机旁完成首次启用。</text>
      <button class="primary-button home-cta-btn" bindtap="openOnboarding">{{hasPendingOnboarding ? '继续上次启用' : '添加第一台设备'}}</button>
      <button class="home-text-btn" bindtap="showSyncHelp">其他手机上已经有设备？</button>
    </view>

    <block wx:else>
      <view
        wx:if="{{unreadSafetyAlert}}"
        class="alert-banner home-attention"
        bindtap="openUnreadSafety"
      >
        <view class="alert-banner-icon"><image src="/assets/ui/v4/heart-rust.svg" /></view>
        <view class="alert-banner-copy">
          <text class="alert-banner-title">{{unreadSafetyCopy}}</text>
          <text class="alert-banner-meta">{{unreadSafetyMeta}}</text>
        </view>
        <image class="home-chev" src="/assets/ui/v4/chev-rust.svg" />
      </view>

      <view class="card card-xl home-usage-card" bindtap="openDevice">
        <view class="home-ring" style="{{usageRingStyle}}">
          <view class="home-ring-inner">
            <text class="home-ring-num">{{usageCenterLabel}}</text>
            <text class="home-ring-cap">{{usageCapLabel}}</text>
          </view>
        </view>
        <view class="home-usage-copy">
          <text class="home-lbl">今天聊了</text>
          <view wx:if="{{usageKnown}}" class="home-usage-line">
            <text class="home-usage-num">{{usageUsedMinutes}}</text>
            <text class="home-usage-unit"> 分钟</text>
          </view>
          <text wx:else class="home-usage-pending">用量暂未统计</text>
          <view class="pill pill-online {{online ? '' : 'pill-neutral'}}">
            <text>{{personaName}}{{online ? '在线' : '离线'}}</text>
          </view>
        </view>
      </view>

      <view class="home-stat-grid">
        <view class="card home-stat" bindtap="openMemory">
          <view class="mp-icon-tile"><image src="/assets/ui/v4/book-accent.svg" /></view>
          <text class="home-lbl">今天对话</text>
          <view class="home-stat-line">
            <text class="home-stat-num">{{todayCount}}</text>
            <text class="home-stat-unit"> 次</text>
          </view>
        </view>
        <view class="card home-stat" bindtap="openMemory">
          <view class="mp-icon-tile"><image src="/assets/ui/v4/note-accent.svg" /></view>
          <text class="home-lbl">近期摘要</text>
          <view class="home-stat-line">
            <text class="home-stat-num">{{summaryCount}}</text>
            <text class="home-stat-unit"> 条</text>
          </view>
        </view>
      </view>

      <view wx:if="{{showChildMemory}}" class="card home-row-card" bindtap="openChildMemory">
        <mp-icon name="heart" size="96"></mp-icon>
        <view class="home-row-copy">
          <text class="home-card-title">{{childMemoryName}}的记忆</text>
          <text class="home-row-sub">{{memoryPreviews.length ? (todayTitle === '近期摘要' ? '近期摘要：' : '最近：') + memoryPreviews[0].text : '还没有摘要，聊过之后会出现在这里'}}</text>
        </view>
        <image class="home-chev" src="/assets/ui/v4/chev-faint.svg" />
      </view>

      <view wx:if="{{showSafetyNightCard && subscriptionPushEnabled}}" class="card home-toggle-card">
        <view class="home-toggle-row">
          <view class="home-toggle-copy">
            <text class="home-card-title">安全提醒</text>
            <text class="l2-card-sub">{{safetySubscribeHelper}}</text>
          </view>
          <switch
            checked="{{safetySubscribeKnown && safetySubscribeOn}}"
            color="#B9481F"
            disabled="{{!safetySubscribeKnown || safetySubscribeBusy}}"
            bindchange="onSafetySubscribeChange"
          />
        </view>
        <view class="home-toggle-row" bindtap="openNightSettings">
          <view class="mp-icon-tile home-moon"><image src="/assets/ui/v4/moon-ink.svg" /></view>
          <view class="home-toggle-copy">
            <text class="home-card-title">安静时段</text>
            <text class="l2-card-sub">{{nightModeOn ? quietHoursLabel : '未设置'}}</text>
          </view>
          <image class="home-chev" src="/assets/ui/v4/chev-faint.svg" />
        </view>
      </view>
    </block>

    <text class="home-note">在设备上和孩子对话，手机端不收声，回应由 AI 生成。</text>
  </block>
</view>
