.home-hero-main {
  align-items: center;
  margin-top: 20rpx;
}

.home-hero-copy {
  flex: 1;
  min-width: 0;
}

.home-hero-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  min-height: 102rpx;
  margin-top: 28rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.14);
  color: #c3d5e1;
  font-size: 24rpx;
}

.home-todo-head {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.home-todo-copy {
  flex: 1;
  min-width: 0;
}

.home-todo-copy .count-badge {
  margin-left: 12rpx;
  vertical-align: 2rpx;
}

.home-todo-chevron {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: rgba(233, 238, 242, 0.72);
  background: var(--gray-100);
  color: #474e54;
  color: var(--text-secondary);
  transition: transform 250ms;
}

.home-todo-chevron.is-open {
  transform: rotate(180deg);
}

.home-todo-body .caption {
  margin-top: 16rpx;
}

.home-recap-meta {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin-bottom: 18rpx;
}

.home-recap-time {
  flex: 1;
  color: #474e54;
  color: var(--text-secondary);
  font-size: 24rpx;
}
