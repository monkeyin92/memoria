.home-hero {
  position: relative;
  overflow: hidden;
  min-height: 572rpx;
  margin-top: 12rpx;
  padding: 46rpx 44rpx 0;
  border-radius: 52rpx;
  background: #172f43;
  color: #fff;
}

.home-hero-offline {
  background: #243848;
}

.hero-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  position: relative;
  z-index: 1;
}

.device-place {
  color: #d0dce5;
  font-size: 24rpx;
}

.home-hero .pill {
  background: #2d4a54;
  color: #c4e3d3;
}

.home-hero .pill-amber {
  background: #4a3d2d;
  color: #f0d7b0;
}

.hero-heading {
  display: block;
  position: relative;
  z-index: 1;
  max-width: 380rpx;
  margin: 22rpx 0 18rpx;
  font-size: 44rpx;
  font-weight: 500;
  line-height: 1.5;
}

.hero-caption {
  display: block;
  position: relative;
  z-index: 1;
  max-width: 310rpx;
  color: #c3d5e1;
  font-size: 24rpx;
  line-height: 1.75;
}

.hero-image {
  position: absolute;
  right: -26rpx;
  top: 98rpx;
  width: 376rpx;
  height: 388rpx;
}

.hero-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  position: relative;
  z-index: 1;
  min-height: 102rpx;
  margin-top: 70rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.14);
  color: #c3d5e1;
  font-size: 24rpx;
}

.hero-link {
  color: #edf8fc;
  font-size: 24rpx;
}

.choice-photo {
  width: 88rpx;
  height: 88rpx;
  flex-shrink: 0;
}

.next-action {
  display: flex;
  align-items: center;
  gap: 20rpx;
  min-height: 166rpx;
  margin-top: 28rpx;
  padding: 32rpx;
  border-radius: 34rpx;
  background: #e0ecec;
}

.next-action-copy {
  flex: 1;
}

.next-action-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
}

.next-action-meta {
  display: block;
  margin-top: 6rpx;
  color: #536b72;
  font-size: 24rpx;
}

.recap-preview {
  padding-bottom: 32rpx;
  border-bottom: 1rpx solid #dfe6ea;
}

.recap-meta {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin-bottom: 18rpx;
  color: #596a78;
  font-size: 24rpx;
}

.recap-title {
  display: block;
  font-size: 34rpx;
  font-weight: 600;
  line-height: 1.6;
}

.recap-body {
  display: block;
  margin: 16rpx 0;
  color: #596a78;
  font-size: 26rpx;
  line-height: 1.8;
}

.recap-read {
  display: block;
  color: #326e70;
  font-size: 24rpx;
}
