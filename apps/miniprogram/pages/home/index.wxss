@import "../../styles/trial-theme.wxss";

.home-trial {
  padding-bottom: 120rpx;
}

.home-guest-card,
.home-pad,
.home-device-card,
.home-choice {
  margin-top: 36rpx;
  padding: 40rpx 36rpx;
}

.home-guest-lead {
  display: block;
  color: var(--trial-ink);
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1.35;
}

.home-cta {
  margin-top: 40rpx;
}

.home-cta-btn {
  margin-top: 32rpx;
}

.home-foot {
  margin-top: 40rpx;
}

.home-empty-title {
  display: block;
  color: var(--trial-ink);
  font-size: 36rpx;
  font-weight: 700;
}

.home-choice {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.home-choice-title {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
}

.home-error {
  display: block;
  margin-top: 16rpx;
  color: #a3221b;
  font-size: 24rpx;
}

.home-text-btn {
  margin-top: 16rpx;
  padding: 0;
  background: transparent;
  color: var(--trial-muted);
  font-size: 26rpx;
  line-height: 1.6;
  text-align: left;
}

.home-device-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.home-device-name {
  flex: 1;
  min-width: 0;
  color: var(--trial-ink);
  font-size: 34rpx;
  font-weight: 650;
}

.home-usage-number {
  display: block;
  margin-top: 36rpx;
  color: var(--trial-ink);
  font-size: 112rpx;
  font-weight: 700;
  letter-spacing: -2rpx;
  line-height: 1;
}

.home-usage-label {
  display: block;
  margin-top: 12rpx;
  color: var(--trial-muted);
  font-size: 28rpx;
}

.home-quiet {
  margin-top: 28rpx;
}
