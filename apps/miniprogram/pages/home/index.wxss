.home-login-hero {
  position: relative;
  height: 400px;
  margin-top: 16px;
  border-radius: var(--mp-radius-card-xl);
  overflow: hidden;
  background: var(--mp-ink);
  box-shadow: var(--mp-shadow-hero);
}

.home-login-art {
  position: absolute;
  left: -120px;
  top: -24px;
  height: 448px;
}

.home-login-scrim {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: linear-gradient(180deg, var(--mp-hero-scrim), transparent 48%);
}

.home-login-brand {
  position: absolute;
  top: 40px;
  left: 0;
  right: 0;
  color: var(--mp-on-accent);
  text-align: center;
}

.home-login-title {
  display: block;
  font-size: var(--mp-type-num-xl);
  font-weight: 800;
  letter-spacing: -1px;
}

.home-login-tag {
  display: block;
  margin-top: 8px;
  font-size: var(--mp-type-body);
  opacity: 0.95;
}

.home-login-body {
  padding-top: 40px;
  text-align: center;
}

.home-login-wechat {
  margin-top: 32px;
}

.home-login-phone {
  margin-top: 16px;
}

.guest-features {
  margin-top: 16px;
  padding: 4px 0;
}

.guest-feature {
  padding: 12px 16px;
}

.guest-feature + .guest-feature {
  box-shadow: inset 0 1px 0 var(--mp-line);
}

.guest-agreements {
  display: flex;
  gap: 16px;
  margin-top: 16px;
}

.guest-actions {
  margin-top: 16px;
}

.legal-link {
  color: var(--mp-ink);
  font-weight: 600;
}

.home-login-hello {
  display: block;
  color: var(--mp-ink);
  font-size: var(--mp-type-headline);
  font-weight: 700;
  letter-spacing: -0.4px;
}

.home-btn-icon {
  width: 20px;
  height: 20px;
  margin-right: 8px;
}

.home-head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 12px;
}

.home-head-copy {
  min-width: 0;
}

.home-avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 40px;
  height: 40px;
  margin-top: calc(var(--mp-capsule-bottom) - var(--mp-status-bar) - var(--mp-tab-top) + 4px);
  border-radius: 50%;
  background: var(--mp-surface);
  box-shadow: var(--mp-shadow-float);
  color: var(--mp-accent);
  font-size: var(--mp-type-body);
  font-weight: 700;
}

.home-chev {
  flex-shrink: 0;
  width: 18px;
  height: 18px;
}

.home-usage-card {
  display: flex;
  align-items: center;
  gap: 24px;
  margin-top: var(--mp-gap-card);
  padding: var(--mp-pad-card-lg);
}

.home-ring {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 112px;
  height: 112px;
  border-radius: 50%;
  background: var(--mp-track);
}

.home-ring-inner {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 88px;
  height: 88px;
  border-radius: 50%;
  background: var(--mp-surface);
  text-align: center;
}

.home-ring-num {
  color: var(--mp-ink);
  font-size: var(--mp-type-headline);
  font-weight: 700;
  line-height: 32px;
  letter-spacing: -1px;
  font-variant-numeric: tabular-nums;
}

.home-ring-cap {
  color: var(--mp-ink-3);
  font-size: var(--mp-type-micro);
}

.home-usage-copy {
  flex: 1;
  min-width: 0;
}

.home-lbl {
  display: block;
  color: var(--mp-ink-2);
  font-size: var(--mp-type-caption);
  font-weight: 500;
}

.home-usage-line {
  margin: 4px 0 8px;
}

.home-usage-num {
  color: var(--mp-ink);
  font-size: var(--mp-type-num-xl);
  font-weight: 700;
  line-height: 48px;
  letter-spacing: -1px;
  font-variant-numeric: tabular-nums;
}

.home-usage-unit {
  color: var(--mp-ink-2);
  font-size: var(--mp-type-body);
  font-weight: 600;
}

.home-usage-pending {
  display: block;
  margin: 4px 0 8px;
  color: var(--mp-ink);
  font-size: var(--mp-type-card);
  font-weight: 600;
  line-height: 48px;
}

.home-usage-copy .pill {
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
}

.home-stat-grid {
  display: flex;
  gap: var(--mp-gap-card);
  margin-top: var(--mp-gap-card);
}

.home-stat {
  display: flex;
  margin-top: 0;
  flex: 1;
  flex-direction: column;
  box-sizing: border-box;
  min-width: 0;
  height: 152px;
  padding: var(--mp-pad-card);
}

.home-stat .home-lbl {
  margin-top: auto;
}

.home-stat-num {
  color: var(--mp-ink);
  font-size: var(--mp-type-display);
  font-weight: 700;
  line-height: 40px;
  letter-spacing: -1px;
  font-variant-numeric: tabular-nums;
}

.home-stat-unit {
  color: var(--mp-ink-2);
  font-size: var(--mp-type-small);
}

.home-pad,
.home-choice,
.home-toggle-card {
  margin-top: var(--mp-gap-card);
  padding: var(--mp-pad-card) var(--mp-pad-card-lg);
}

.home-card-title {
  display: block;
  color: var(--mp-ink);
  font-size: var(--mp-type-card);
  font-weight: 600;
  line-height: var(--mp-lh-card);
}

.home-row-card {
  display: flex;
  align-items: center;
  gap: 16px;
  margin-top: var(--mp-gap-card);
  padding: var(--mp-pad-card);
}

.home-row-copy {
  flex: 1;
  min-width: 0;
}

.home-row-copy .home-card-title {
  line-height: normal;
}

.home-row-sub {
  display: block;
  margin-top: 4px;
  overflow: hidden;
  color: var(--mp-ink-2);
  font-size: var(--mp-type-caption);
  white-space: nowrap;
  text-overflow: ellipsis;
}

.home-choice-lede {
  margin-top: 16px;
}

.home-choice {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
}

.home-choice-copy {
  min-width: 0;
}

.home-error {
  display: block;
  margin-top: 8px;
  color: var(--mp-rust);
  font-size: var(--mp-type-meta);
}

.home-cta-btn {
  margin-top: 16px;
}

.home-text-btn {
  margin: 8px 0 0;
  padding: 0;
  background: transparent;
  color: var(--mp-accent);
  font-size: var(--mp-type-caption);
  line-height: 1.6;
  text-align: left;
}

.home-toggle-row {
  display: flex;
  align-items: center;
  gap: 16px;
  min-height: var(--mp-tap);
}

.home-toggle-row + .home-toggle-row {
  margin-top: 4px;
  padding-top: 12px;
  border-top: 0.5px solid var(--mp-line);
}

.home-toggle-copy {
  flex: 1;
  min-width: 0;
}

.home-moon {
  background: var(--mp-fill);
}

.home-note {
  display: block;
  margin-top: 16px;
  color: var(--mp-ink-3);
  font-size: var(--mp-type-meta);
  line-height: 16px;
}

.home-guest .home-note {
  text-align: center;
}
