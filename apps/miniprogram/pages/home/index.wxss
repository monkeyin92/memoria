.home-page {
  padding-bottom: 80rpx;
}

.quick-setting-row,
.quick-setting-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
}

.quick-setting-row + .quick-setting-row,
.quick-setting-block {
  margin-top: 24rpx;
}

.learning-mode-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 14rpx;
}

.mode-chip {
  margin: 0;
  border: 1rpx solid rgba(128, 145, 195, 0.35);
  border-radius: 999rpx;
  color: #9ba9d4;
  background: rgba(20, 28, 62, 0.75);
}

.mode-chip.is-active {
  border-color: rgba(34, 229, 255, 0.72);
  color: #dfffff;
  background: rgba(34, 229, 255, 0.14);
}

.home-header {
  padding: 12rpx 4rpx 0;
}

.hero-greeting {
  display: block;
  color: #8d99c4;
  font-size: 26rpx;
  letter-spacing: 1rpx;
}

.hero-title {
  display: block;
  margin-top: 12rpx;
  color: #f2f5ff;
  font-size: 54rpx;
  font-weight: 800;
  line-height: 1.24;
  letter-spacing: 1rpx;
}

.hero-title-accent {
  background: linear-gradient(120deg, #22e5ff 0%, #7b5cff 55%, #ff4ddb 100%);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
}

.companion-chip {
  display: inline-flex;
  align-items: center;
  margin-top: 22rpx;
  padding: 8rpx 26rpx 8rpx 12rpx;
  border: 1rpx solid rgba(94, 234, 255, 0.28);
  border-radius: 999rpx;
  background: rgba(16, 23, 52, 0.66);
  box-shadow: 0 0 24rpx rgba(34, 229, 255, 0.12);
}

.companion-chip-img {
  width: 52rpx;
  height: 52rpx;
}

.companion-chip-text {
  margin-left: 14rpx;
  color: #9db4e8;
  font-size: 24rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}

/* ——— 吉祥物舞台：霓虹光环 + 机身与背景相融（静态陪伴展示） ——— */
.stage-wrap {
  position: relative;
  margin-top: 20rpx;
  height: 560rpx;
}

.stage-halo {
  position: absolute;
  left: 50%;
  top: 44%;
  width: 520rpx;
  height: 520rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(34, 229, 255, 0.16) 0%, rgba(123, 92, 255, 0.12) 44%, rgba(123, 92, 255, 0) 70%);
  transform: translate(-50%, -50%);
  animation: halo-breathe 4.2s ease-in-out infinite;
}

.stage-ring {
  position: absolute;
  left: 50%;
  top: 44%;
  width: 460rpx;
  height: 460rpx;
  box-sizing: border-box;
  border: 2rpx dashed rgba(94, 234, 255, 0.3);
  border-radius: 50%;
  transform: translate(-50%, -50%);
  animation: ring-spin 26s linear infinite;
}

.stage-ground {
  position: absolute;
  left: 50%;
  bottom: 90rpx;
  width: 340rpx;
  height: 72rpx;
  border-radius: 50%;
  background: radial-gradient(ellipse, rgba(34, 229, 255, 0.32) 0%, rgba(123, 92, 255, 0.16) 52%, rgba(123, 92, 255, 0) 76%);
  transform: translateX(-50%);
  animation: ground-pulse 3.4s ease-in-out infinite;
}

.spark {
  position: absolute;
  color: rgba(140, 240, 255, 0.85);
  text-shadow: 0 0 14rpx rgba(34, 229, 255, 0.8);
  animation: spark-float 3.6s ease-in-out infinite;
}

.spark-a {
  left: 96rpx;
  top: 96rpx;
  font-size: 34rpx;
}

.spark-b {
  right: 110rpx;
  top: 150rpx;
  color: rgba(255, 150, 235, 0.8);
  font-size: 28rpx;
  text-shadow: 0 0 14rpx rgba(255, 77, 219, 0.75);
  animation-delay: 0.9s;
}

.spark-c {
  right: 150rpx;
  bottom: 150rpx;
  font-size: 24rpx;
  animation-delay: 1.8s;
}

.mascot-body-shell {
  position: absolute;
  left: 50%;
  top: 44%;
  width: 450rpx;
  height: 450rpx;
  transform: translate(-50%, -50%);
  transform-origin: 50% 78%;
  animation: mascot-breathe 4.8s cubic-bezier(0.45, 0, 0.2, 1) infinite;
}

.mascot-body {
  display: block;
  width: 100%;
  height: 100%;
}

.mascot-idle .mascot-body-shell {
  animation-name: mascot-listen;
  animation-duration: 3.2s;
}

/* ——— 表情骨架（与 H5 内联 SVG 对齐，viewBox 240×140 → 脸屏百分比） ——— */
.mascot-face {
  position: absolute;
  pointer-events: none;
}

.mascot-face.tone-dark {
  filter: drop-shadow(0 0 6rpx rgba(140, 230, 255, 0.45));
}

.face-expression {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  opacity: 0;
}

.face-expression.is-visible {
  opacity: 1;
}

.eye {
  position: absolute;
  top: 24.3%;
  width: 18.33%;
  height: 41.43%;
  overflow: hidden;
  border-radius: 50%;
  background: var(--face-ink);
  animation: mascot-blink 5.6s ease-in-out infinite;
  transform-origin: center;
}

.eye-l {
  left: 20.84%;
}

.eye-r {
  left: 60.83%;
}

.iris {
  position: absolute;
  left: 6.8%;
  top: 3.5%;
  width: 86.4%;
  height: 89.7%;
  border-radius: 50%;
  background: linear-gradient(180deg, var(--eye-top) 0%, var(--eye-top) 52%, var(--eye-bottom) 100%);
}

.eye-glow {
  position: absolute;
  left: 22.7%;
  top: 69%;
  width: 54.5%;
  height: 17.2%;
  border-radius: 50%;
  background: var(--eye-glow);
}

.shine {
  position: absolute;
  border-radius: 50%;
  background: #fffaf0;
}

.shine-main {
  left: 22.7%;
  top: 22.4%;
  width: 22.7%;
  height: 17.2%;
}

.shine-sub {
  left: 60.5%;
  top: 47.6%;
  width: 10.9%;
  height: 8.3%;
  background: rgba(255, 255, 255, 0.72);
}

.brow {
  position: absolute;
  top: 15.7%;
  width: 15.5%;
  height: 5rpx;
  min-height: 4rpx;
  border-radius: 999rpx;
  background: var(--face-ink);
  opacity: 0.85;
}

.brow-l {
  left: 22.3%;
  transform: rotate(-6deg);
}

.brow-r {
  left: 62.2%;
  transform: rotate(6deg);
}

.mouth {
  position: absolute;
}

.mouth-smile {
  left: 45%;
  top: 72.5%;
  width: 10%;
  height: 7%;
  box-sizing: border-box;
  border-bottom: 5rpx solid var(--face-ink);
  border-radius: 0 0 999rpx 999rpx;
}

/* ——— 胸灯（星澜 / 玄墨） ——— */
.chest-pulse {
  position: absolute;
  left: 50%;
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  transform: translate(-50%, -50%);
  box-shadow: 0 0 19rpx 6rpx rgba(80, 181, 143, 0.2);
}

.mascot-idle .chest-pulse {
  animation: chest-listen 2.4s ease-in-out infinite;
}

/* ——— 状态胶囊 ——— */
.status-pill {
  position: absolute;
  left: 50%;
  bottom: 0;
  display: inline-flex;
  align-items: center;
  padding: 10rpx 30rpx;
  border: 1rpx solid rgba(94, 234, 255, 0.24);
  border-radius: 999rpx;
  color: #9db4e8;
  background: rgba(16, 23, 52, 0.72);
  box-shadow: 0 0 24rpx rgba(34, 229, 255, 0.1);
  font-size: 24rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  transform: translateX(-50%);
  white-space: nowrap;
}

.status-dot {
  width: 12rpx;
  height: 12rpx;
  margin-right: 12rpx;
  border-radius: 50%;
  background: #5d688f;
}

.status-online {
  color: #7ceaff;
  border-color: rgba(94, 234, 255, 0.45);
  box-shadow: 0 0 28rpx rgba(34, 229, 255, 0.22);
}

.status-online .status-dot {
  background: #22e5ff;
  box-shadow: 0 0 12rpx rgba(34, 229, 255, 0.9);
}

.status-offline {
  color: #ffcf8a;
  border-color: rgba(255, 190, 90, 0.4);
}

.status-offline .status-dot {
  background: #ffbe5a;
  box-shadow: 0 0 12rpx rgba(255, 190, 90, 0.9);
}

/* ——— Dashboard 卡片 ——— */
.section-heading {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  color: #e6ecff;
  font-size: 31rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.settings-title {
  display: block;
  color: #e6ecff;
  font-size: 31rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.setting-desc {
  display: block;
  margin-top: 14rpx;
  color: #8d99c4;
  font-size: 25rpx;
  line-height: 1.65;
}

.summary-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-top: 20rpx;
}

.summary-key {
  flex: none;
  color: #8d99c4;
  font-size: 25rpx;
}

.summary-value {
  margin-left: 24rpx;
  color: #dfe7ff;
  font-size: 26rpx;
  text-align: right;
}

.summary-overview-row {
  align-items: flex-start;
}

.summary-overview {
  color: #aeb9dd;
  line-height: 1.55;
}

.form-note {
  display: block;
  margin-top: 20rpx;
  color: #69759c;
  font-size: 22rpx;
  line-height: 1.55;
}

.device-status-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 24rpx 20rpx;
  margin-top: 24rpx;
}

.device-status-item {
  min-width: 0;
}

.device-status-label {
  display: block;
  color: #69759c;
  font-size: 22rpx;
}

.device-status-value {
  display: block;
  margin-top: 8rpx;
  color: #dfe7ff;
  font-size: 26rpx;
  font-weight: 600;
}

.offline-hint {
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid rgba(94, 234, 255, 0.12);
}

.notice-card {
  border-color: rgba(255, 190, 90, 0.34);
}

.notice-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.notice-count {
  flex: none;
  margin-left: 20rpx;
  color: #ffcf8a;
  font-size: 24rpx;
}

.empty-card {
  text-align: left;
}

.empty-badge {
  display: inline-block;
  padding: 8rpx 20rpx;
  border: 1rpx solid rgba(94, 234, 255, 0.32);
  border-radius: 999rpx;
  color: #7ceaff;
  background: rgba(34, 229, 255, 0.08);
  font-size: 22rpx;
  letter-spacing: 2rpx;
}

.empty-copy {
  display: block;
  margin-top: 16rpx;
  color: #8d99c4;
  font-size: 26rpx;
  line-height: 1.7;
}

.empty-button {
  margin-top: 24rpx;
}

/* ——— keyframes ——— */
@keyframes mascot-breathe {
  0%,
  100% {
    transform: translate(-50%, -50%) translateY(0) scale(1);
  }
  50% {
    transform: translate(-50%, -50%) translateY(-6rpx) scale(1.006);
  }
}

@keyframes mascot-listen {
  0%,
  100% {
    transform: translate(-50%, -50%) translateY(0) scale(1);
  }
  50% {
    transform: translate(-50%, -50%) translateY(-8rpx) scale(1.008);
  }
}

@keyframes mascot-blink {
  0%,
  43%,
  47%,
  100% {
    transform: scaleY(1);
  }
  45% {
    transform: scaleY(0.08);
  }
}

@keyframes chest-listen {
  0%,
  100% {
    opacity: 0.42;
  }
  50% {
    opacity: 0.74;
  }
}

@keyframes halo-breathe {
  0%,
  100% {
    opacity: 0.85;
    transform: translate(-50%, -50%) scale(1);
  }
  50% {
    opacity: 1;
    transform: translate(-50%, -50%) scale(1.06);
  }
}

@keyframes ring-spin {
  from {
    transform: translate(-50%, -50%) rotate(0deg);
  }
  to {
    transform: translate(-50%, -50%) rotate(360deg);
  }
}

@keyframes ground-pulse {
  0%,
  100% {
    opacity: 0.75;
    transform: translateX(-50%) scaleX(1);
  }
  50% {
    opacity: 1;
    transform: translateX(-50%) scaleX(1.08);
  }
}

@keyframes spark-float {
  0%,
  100% {
    opacity: 0.55;
    transform: translateY(0);
  }
  50% {
    opacity: 1;
    transform: translateY(-14rpx);
  }
}
