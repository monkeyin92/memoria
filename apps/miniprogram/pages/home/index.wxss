.greet {
  display: block;
  margin: 8rpx 0 12rpx;
  color: #7ceaff;
  font-size: 28rpx;
  letter-spacing: 1rpx;
}

.guest-home,
.empty-card {
  padding-top: 44rpx;
  padding-bottom: 44rpx;
}

.guest-title,
.empty-title,
.empty-badge,
.empty-copy,
.guest-copy,
.loading-text {
  display: block;
}

.guest-title,
.empty-title {
  margin-top: 16rpx;
  color: #f2f5ff;
  font-size: 34rpx;
  font-weight: 750;
}

.guest-copy,
.empty-copy {
  margin-top: 16rpx;
  color: #8d99c4;
  font-size: 26rpx;
  line-height: 1.7;
}

.guest-login-button,
.empty-button {
  margin-top: 32rpx;
}

.empty-badge {
  display: inline-flex;
  padding: 8rpx 24rpx;
  border: 1rpx solid rgba(94, 234, 255, 0.32);
  border-radius: 999rpx;
  background: rgba(34, 229, 255, 0.08);
  color: #7ceaff;
  font-size: 22rpx;
  letter-spacing: 4rpx;
}

.sync-error-badge {
  border-color: rgba(255, 179, 92, 0.38);
  background: rgba(255, 155, 64, 0.1);
  color: #ffc285;
}

.loading-text {
  color: #8d99c4;
  font-size: 26rpx;
}

.binding-choice {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  box-sizing: border-box;
  margin-top: 18rpx;
  padding: 24rpx 26rpx;
  border: 1rpx solid rgba(94, 234, 255, 0.18);
  border-radius: 24rpx;
  background: rgba(8, 14, 36, 0.5);
}

.binding-choice-copy {
  flex: 1;
  min-width: 0;
}

.binding-choice-name,
.binding-choice-meta {
  display: block;
}

.binding-choice-name {
  color: #f2f5ff;
  font-size: 28rpx;
  font-weight: 650;
}

.binding-choice-meta {
  margin-top: 6rpx;
  color: #8d99c4;
  font-size: 22rpx;
}

.binding-choice-arrow {
  color: #7ceaff;
  font-size: 38rpx;
}

.status-card {
  min-height: 88rpx;
}

.card-pressed {
  opacity: 0.86;
}

.kicker {
  display: block;
  color: #7ceaff;
  font-size: 22rpx;
  letter-spacing: 4rpx;
}

.card-heading {
  display: block;
  margin-top: 10rpx;
  color: #f2f5ff;
  font-size: 40rpx;
  font-weight: 800;
  line-height: 1.3;
}

.status-line {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 16rpx;
}

.status-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #ff8ba3;
}

.status-dot-on {
  background: #3ee0b0;
  box-shadow: 0 0 12rpx rgba(62, 224, 176, 0.7);
}

.status-dot-off {
  background: #ffb020;
}

.status-text {
  color: #dfe7ff;
  font-size: 26rpx;
}

.facts {
  display: flex;
  gap: 24rpx;
  margin-top: 24rpx;
}

.fact {
  flex: 1;
  min-width: 0;
}

.fact-label,
.persona-voice,
.today-meta {
  display: block;
  color: #6b779f;
  font-size: 22rpx;
}

.fact-value {
  display: block;
  margin-top: 6rpx;
  color: #f2f5ff;
  font-size: 28rpx;
  font-weight: 650;
}

.persona-voice {
  margin-top: 10rpx;
  color: #7ceaff;
  letter-spacing: 1rpx;
}

.persona-body {
  display: block;
  margin-top: 14rpx;
  color: #8d99c4;
  font-size: 25rpx;
  line-height: 1.65;
}

.today-meta {
  margin-top: 10rpx;
  color: #c7d0ef;
  font-size: 25rpx;
}

.go {
  display: block;
  margin-top: 22rpx;
  color: #7ceaff;
  font-size: 24rpx;
}

.error-text {
  display: block;
  margin-top: 24rpx;
  color: #ff8ba3;
  font-size: 24rpx;
}

.sync-warning {
  display: block;
  margin-top: 24rpx;
  color: #ffc285;
  font-size: 24rpx;
  line-height: 1.6;
}
