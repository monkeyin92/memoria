@import "../../styles/trial-theme.wxss";

.home-login-hero {
  position: relative;
  height: 800rpx;
  margin-top: 32rpx;
  border-radius: var(--mp-radius-card-xl);
  overflow: hidden;
  background: var(--mp-ink);
  box-shadow: var(--mp-shadow-card);
}

.home-login-art {
  position: absolute;
  left: -240rpx;
  top: -48rpx;
  height: 896rpx;
}

.home-login-scrim {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  height: 50%;
  background: linear-gradient(180deg, var(--mp-scrim), transparent);
}

.home-login-brand {
  position: absolute;
  top: 80rpx;
  left: 0;
  right: 0;
  color: var(--mp-on-accent);
  text-align: center;
}

.home-login-title {
  display: block;
  font-size: var(--mp-type-num-xl);
  font-weight: 800;
  line-height: 96rpx;
  letter-spacing: -2rpx;
}

.home-login-tag {
  display: block;
  margin-top: 16rpx;
  font-size: var(--mp-type-body);
  line-height: var(--mp-lh-body);
  opacity: 0.95;
}

.home-login-body {
  padding-top: 64rpx;
  text-align: center;
}

.home-login-hello {
  display: block;
  color: var(--mp-ink);
  font-size: var(--mp-type-headline);
  font-weight: 700;
  letter-spacing: -0.8rpx;
}

.home-btn-icon {
  width: 40rpx;
  height: 40rpx;
  margin-right: 16rpx;
}

.home-head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 24rpx;
}

.home-head-copy {
  min-width: 0;
}

.home-avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 80rpx;
  height: 80rpx;
  margin-bottom: 8rpx;
  border-radius: 50%;
  background: var(--mp-surface);
  box-shadow: var(--mp-shadow-float);
  color: var(--mp-accent);
  font-size: var(--mp-type-body);
  font-weight: 700;
}

.home-chev {
  flex-shrink: 0;
  width: 36rpx;
  height: 36rpx;
}

.home-usage-card {
  display: flex;
  align-items: center;
  gap: 48rpx;
  margin-top: var(--mp-gap-card);
  padding: var(--mp-pad-card-lg);
}

.home-ring {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 224rpx;
  height: 224rpx;
  border-radius: 50%;
}

.home-ring-inner {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 176rpx;
  height: 176rpx;
  border-radius: 50%;
  background: var(--mp-surface);
  text-align: center;
}

.home-ring-num {
  color: var(--mp-ink);
  font-size: var(--mp-type-headline);
  font-weight: 700;
  line-height: 64rpx;
  letter-spacing: -2rpx;
  font-variant-numeric: tabular-nums;
}

.home-ring-cap {
  color: var(--mp-ink-3);
  font-size: var(--mp-type-tab);
}

.home-usage-copy {
  flex: 1;
  min-width: 0;
}

.home-lbl {
  display: block;
  color: var(--mp-ink-2);
  font-size: var(--mp-type-caption);
  font-weight: 500;
}

.home-usage-line {
  margin: 8rpx 0 16rpx;
}

.home-usage-num {
  color: var(--mp-ink);
  font-size: var(--mp-type-num-xl);
  font-weight: 700;
  line-height: 96rpx;
  letter-spacing: -2rpx;
  font-variant-numeric: tabular-nums;
}

.home-usage-unit {
  color: var(--mp-ink-2);
  font-size: var(--mp-type-body);
  font-weight: 600;
}

.home-usage-pending {
  display: block;
  margin: 16rpx 0 24rpx;
  color: var(--mp-ink);
  font-size: var(--mp-type-card);
  font-weight: 600;
}

.home-usage-copy .trial-status-pill {
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
}

.home-stat-grid {
  display: flex;
  gap: var(--mp-gap-card);
  margin-top: var(--mp-gap-card);
}

.home-stat {
  display: flex;
  flex: 1;
  flex-direction: column;
  box-sizing: border-box;
  min-width: 0;
  height: 304rpx;
  padding: var(--mp-pad-card);
}

.home-stat .home-lbl {
  margin-top: auto;
}

.home-stat-num {
  color: var(--mp-ink);
  font-size: var(--mp-type-display);
  font-weight: 700;
  line-height: 80rpx;
  letter-spacing: -2rpx;
  font-variant-numeric: tabular-nums;
}

.home-stat-unit {
  color: var(--mp-ink-2);
  font-size: var(--mp-type-body);
}

.home-pad,
.home-choice,
.home-toggle-card {
  margin-top: var(--mp-gap-card);
  padding: var(--mp-pad-card) var(--mp-pad-card-lg);
}

.home-card-title {
  display: block;
  color: var(--mp-ink);
  font-size: var(--mp-type-card);
  font-weight: 600;
  line-height: var(--mp-lh-card);
}

.home-row-card {
  display: flex;
  align-items: center;
  gap: 32rpx;
  margin-top: var(--mp-gap-card);
  padding: var(--mp-pad-card);
}

.home-row-copy {
  flex: 1;
  min-width: 0;
}

.home-row-sub {
  display: block;
  margin-top: 8rpx;
  overflow: hidden;
  color: var(--mp-ink-2);
  font-size: var(--mp-type-caption);
  line-height: var(--mp-lh-caption);
  white-space: nowrap;
  text-overflow: ellipsis;
}

.home-choice-lede {
  margin-top: 32rpx;
}

.home-choice {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
}

.home-choice-copy {
  min-width: 0;
}

.home-error {
  display: block;
  margin-top: 16rpx;
  color: var(--mp-rust);
  font-size: var(--mp-type-meta);
}

.home-cta-btn {
  margin-top: 32rpx;
}

.home-text-btn {
  margin: 16rpx 0 0;
  padding: 0;
  background: transparent;
  color: var(--mp-accent);
  font-size: var(--mp-type-caption);
  line-height: 1.6;
  text-align: left;
}

.home-toggle-row {
  display: flex;
  align-items: center;
  gap: 32rpx;
  min-height: var(--mp-tap);
}

.home-toggle-row + .home-toggle-row {
  margin-top: 8rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid var(--mp-line);
}

.home-toggle-copy {
  flex: 1;
  min-width: 0;
}

.home-moon {
  background: var(--mp-fill);
}

.home-note {
  display: block;
  margin-top: 32rpx;
  color: var(--mp-ink-3);
  font-size: var(--mp-type-meta);
  line-height: var(--mp-lh-caption);
}

.home-guest .home-note {
  text-align: center;
}
