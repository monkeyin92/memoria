@import "../../styles/trial-theme.wxss";

.home-head { display: flex; align-items: flex-end; justify-content: space-between; gap: 12px; margin-bottom: 22px; }
.home-head-copy, .home-choice-copy { min-width: 0; }
.home-avatar {
  display: flex; align-items: center; justify-content: center; flex-shrink: 0;
  width: 44px; height: 44px;
  margin-top: calc(var(--mp-capsule-bottom) - var(--mp-status-bar) - var(--mp-tab-top) + 4px);
  border-radius: 50%; background: var(--mp-peach); color: var(--mp-forest); font-size: var(--mp-type-title); font-weight: 600;
}
.home-chev { flex-shrink: 0; width: 18px; height: 18px; }
.home-review-card {
  position: relative; margin-top: 16px; padding: 20px;
  overflow: hidden; background: var(--mp-forest); color: var(--mp-surface);
  box-shadow: var(--mp-shadow-forest);
}
.home-review-top { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
.home-review-card .home-lbl { color: var(--mp-on-forest); }
.home-review-open { color: var(--mp-on-forest); font-size: var(--mp-type-meta); margin-left: auto; }
.home-review-body { display: flex; align-items: center; gap: 6px; min-height: 148px; }
.home-review-copy { flex: 1; min-width: 0; padding: 12px 0; }
.home-review-lead { display: block; font-size: var(--mp-type-lead); font-weight: 500; line-height: 1.85; }
.home-review-empty { display: block; color: var(--mp-on-forest); font-size: var(--mp-type-card); line-height: 1.85; }
.home-review-art { flex-shrink: 0; width: 100px; height: 140px; transform: rotate(7deg); }
.home-review-meta { display: flex; flex-wrap: wrap; gap: 8px 16px; padding-top: 14px; border-top: 1px solid var(--mp-on-forest-line); }
.home-review-stat { color: var(--mp-on-forest); font-size: var(--mp-type-meta); }
.home-section-head { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 8px; margin: 26px 2px 12px; font-size: var(--mp-type-lead); font-weight: 600; }
.home-section-meta { color: var(--mp-ink-2); font-size: var(--mp-type-meta); font-weight: 400; }
.home-device-card { display: flex; align-items: center; gap: 14px; padding: 16px; }
.home-device-illustration { display: flex; align-items: center; justify-content: center; flex-shrink: 0; width: 68px; min-height: 82px; border-radius: 18px; background: var(--mp-paper); }
.home-device-copy { flex: 1; min-width: 0; }
.home-lbl { display: block; color: var(--mp-ink-2); font-size: var(--mp-type-meta); font-weight: 500; }
.home-device-copy .trial-status-pill { max-width: 100%; margin-bottom: 8px; padding: 0; background: transparent; font-size: var(--mp-type-meta); white-space: normal; }
.home-usage-compact { margin: 2px 0; }
.home-usage-compact-num { color: var(--mp-ink); font-size: var(--mp-type-display); font-weight: 600; font-variant-numeric: tabular-nums; }
.home-usage-compact-unit, .home-usage-cap-hint { color: var(--mp-ink-2); font-size: var(--mp-type-meta); }
.home-usage-cap-hint { display: block; }
.home-usage-pending { display: block; margin: 4px 0; font-size: var(--mp-type-card); font-weight: 500; }
.home-usage-track { margin-top: 8px; }
.home-pad, .home-choice, .home-toggle-card { margin-top: 12px; padding: 18px; }
.home-card-title { display: block; color: var(--mp-ink); font-size: var(--mp-type-card); font-weight: 600; line-height: 24px; }
.home-row-card { display: flex; align-items: center; gap: 14px; margin-top: 12px; padding: 16px; }
.home-memory-entry { background: var(--mp-lilac); }
.home-memory-entry .mp-icon-tile { background: var(--mp-glass); }
.home-row-copy { flex: 1; min-width: 0; }
.home-row-sub { display: block; margin-top: 3px; color: var(--mp-ink-2); font-size: var(--mp-type-meta); line-height: 1.6; }
.home-choice { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
.home-choice-lede { margin-top: 16px; }
.home-error { display: block; margin-top: 8px; color: var(--mp-rust); font-size: var(--mp-type-caption); }
.home-cta-btn { margin-top: 16px; }
.home-text-btn { min-height: 44px; margin: 8px 0 0; padding: 0; background: transparent; color: var(--mp-accent); font-size: var(--mp-type-caption); line-height: 1.6; text-align: left; }
.home-toggle-row { display: flex; align-items: center; gap: 14px; min-height: 48px; }
.home-toggle-row + .home-toggle-row { margin-top: 10px; padding-top: 12px; border-top: 1px solid var(--mp-line); }
.home-toggle-copy { flex: 1; min-width: 0; }
.home-moon { background: var(--mp-paper); }
.home-note { display: block; margin-top: 20px; color: var(--mp-ink-3); font-size: var(--mp-type-meta); line-height: 1.7; }
.home-guest { padding-top: 42px; }
.guest-brand-art { display: block; width: 110px; height: 146px; margin: 0 auto 24px; }
.home-guest .page-title, .home-guest .page-lede { text-align: center; }
.guest-features { margin: 24px 0 16px; padding: 4px 0; background: var(--mp-peach); }
.guest-feature { padding: 12px 16px; }
.guest-feature + .guest-feature { border-top: 1px solid var(--mp-soft-line); }
.guest-agreements { display: flex; justify-content: center; flex-wrap: wrap; gap: 12px; margin-bottom: 16px; }
.legal-link { color: var(--mp-accent); }
.guest-actions { margin-top: 16px; }
@media (max-width: 350px) {
  .home-review-art { width: 72px; height: 110px; }
  .home-review-card { padding: 16px; }
}
