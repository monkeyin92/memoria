@import "../../styles/trial-theme.wxss";

.home-head { display: flex; align-items: flex-end; justify-content: space-between; gap: 12px; margin-bottom: 20px; }
.home-head-copy, .home-choice-copy { min-width: 0; }
.home-wordmark { display: block; font-size: var(--mp-type-card); font-weight: 700; letter-spacing: -0.5px; }
.home-head .trial-title { margin-top: 14px; }
.home-date { color: var(--mp-ink-2); font-size: var(--mp-type-meta); padding-bottom: 4px; }
.home-chev { flex-shrink: 0; width: 18px; height: 18px; }
.home-status-card { box-sizing: border-box; margin-top: 16px; padding: 20px; border-radius: 24px; background: var(--mp-cobalt); color: var(--mp-on-accent); }
.home-status-top { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 8px; font-size: var(--mp-type-meta); }
.home-status-state { display: flex; align-items: center; gap: 6px; }
.home-status-dot { flex-shrink: 0; width: 6px; height: 6px; border-radius: 50%; background: var(--mp-cyan); }
.home-status-dot-off { background: var(--mp-on-accent); }
.home-status-title { display: block; margin-top: 16px; font-size: var(--mp-type-lead); line-height: 1.5; font-weight: 650; overflow-wrap: anywhere; }
.home-status-bottom { display: flex; align-items: center; flex-wrap: wrap; gap: 12px; margin-top: 12px; }
.home-status-caption { flex: 1; min-width: 120px; font-size: var(--mp-type-meta); line-height: 1.7; }
.home-status-button { flex-shrink: 0; width: auto; min-height: 44px; margin: 0; padding: 0 16px; border-radius: 14px; background: var(--mp-surface); color: var(--mp-accent); font-size: var(--mp-type-caption); font-weight: 600; line-height: 44px; }
.home-daily-strip { display: flex; align-items: center; gap: 20px; padding: 20px 4px; border-bottom: 1px solid var(--mp-line); }
.home-daily-item { flex: 1; min-width: 0; }
.home-daily-item + .home-daily-item { padding-left: 20px; border-left: 1px solid var(--mp-line); }
.home-daily-value { display: block; margin-top: 6px; font-size: var(--mp-type-title); font-weight: 650; }
.home-daily-unit { font-size: var(--mp-type-meta); font-weight: 400; }
.home-daily-more { flex-shrink: 0; }
.home-section-head { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 8px; margin: 12px 0 0; font-size: var(--mp-type-lead); font-weight: 650; }
.home-section-link { flex-shrink: 0; width: auto; min-height: 44px; margin: 0; padding: 0 2px; background: transparent; color: var(--mp-accent); font-size: var(--mp-type-meta); line-height: 44px; }
.home-review-card { margin-top: 0; padding: 20px; background: var(--mp-peach); box-shadow: none; }
.home-review-top { display: flex; align-items: center; gap: 8px; }
.home-review-icon { display: flex; align-items: center; justify-content: center; width: 30px; height: 30px; border-radius: 10px; background: var(--mp-glass); }
.home-review-icon image { width: 18px; height: 18px; }
.home-review-body { display: flex; min-height: 74px; padding: 14px 0; }
.home-review-copy { flex: 1; min-width: 0; }
.home-review-lead { display: block; font-size: var(--mp-type-lead); font-weight: 550; line-height: 1.85; }
.home-review-empty { display: block; color: var(--mp-ink-2); font-size: var(--mp-type-card); line-height: 1.85; }
.home-review-meta { display: flex; align-items: center; flex-wrap: wrap; gap: 8px 12px; padding-top: 12px; border-top: 1px solid var(--mp-soft-line); }
.home-review-stat, .home-review-open { color: var(--mp-ink-2); font-size: var(--mp-type-meta); }
.home-review-open { margin-left: auto; }
.home-lbl { display: block; color: var(--mp-ink-2); font-size: var(--mp-type-meta); font-weight: 500; }
.home-review-card .home-lbl, .home-review-stat, .home-review-open, .home-review-empty { color: var(--mp-ink); }
.home-pad, .home-choice, .home-toggle-card { margin-top: 12px; padding: 18px; }
.home-card-title { display: block; color: var(--mp-ink); font-size: var(--mp-type-card); font-weight: 600; line-height: 24px; }
.home-row-card { display: flex; align-items: center; gap: 14px; margin-top: 12px; padding: 16px; }
.home-memory-entry { background: var(--mp-surface); }
.home-memory-entry .mp-icon-tile { background: var(--mp-paper); }
.home-row-copy { flex: 1; min-width: 0; }
.home-row-sub { display: block; margin-top: 3px; color: var(--mp-ink-2); font-size: var(--mp-type-meta); line-height: 1.6; }
.home-choice { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
.home-choice-lede { margin-top: 16px; }
.home-error { display: block; margin-top: 8px; color: var(--mp-rust); font-size: var(--mp-type-caption); }
.home-cta-btn { margin-top: 16px; }
.home-text-btn { min-height: 44px; margin: 8px 0 0; padding: 0; background: transparent; color: var(--mp-accent); font-size: var(--mp-type-caption); line-height: 1.6; text-align: left; }
.home-toggle-row { display: flex; align-items: center; gap: 14px; min-height: 48px; }
.home-toggle-row + .home-toggle-row { margin-top: 10px; padding-top: 12px; border-top: 1px solid var(--mp-line); }
.home-toggle-copy { flex: 1; min-width: 0; }
.home-moon { background: var(--mp-paper); }
.home-note { display: block; margin-top: 20px; color: var(--mp-ink-3); font-size: var(--mp-type-meta); line-height: 1.7; }
.home-guest { padding-top: 32px; }
.home-guest .home-wordmark { margin-bottom: 24px; text-align: center; }
.home-guest .page-title, .home-guest .page-lede { text-align: center; }
.guest-features { margin: 24px 0 16px; padding: 4px 0; background: var(--mp-surface); }
.guest-feature { padding: 12px 16px; }
.guest-feature + .guest-feature { border-top: 1px solid var(--mp-soft-line); }
.guest-agreements { display: flex; justify-content: center; flex-wrap: wrap; gap: 12px; margin-bottom: 16px; }
.legal-link { color: var(--mp-accent); }
.guest-actions { margin-top: 16px; }
