.stepper {
  margin-top: 32rpx;
}

.step-item {
  display: flex;
  gap: 24rpx;
  position: relative;
  padding-bottom: 40rpx;
}

.step-item::before {
  content: '';
  position: absolute;
  left: 26rpx;
  top: 56rpx;
  bottom: 4rpx;
  width: 4rpx;
  border-radius: 2rpx;
  background: var(--mp-line);
}

.step-item:last-child {
  padding-bottom: 0;
}

.step-item:last-child::before {
  display: none;
}

.step-item.done::before {
  background: var(--mp-accent);
}

.step-node {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  width: 56rpx;
  height: 56rpx;
  box-sizing: border-box;
  border: 4rpx solid var(--mp-line);
  border-radius: 50%;
  background: var(--mp-surface);
  color: var(--mp-ink-3);
  font-size: var(--mp-type-meta);
  font-weight: 600;
  z-index: 1;
}

.step-item.done .step-node {
  border-color: var(--mp-accent);
  background: var(--mp-accent);
  color: var(--mp-on-accent);
}

.step-item.current .step-node {
  border-color: var(--mp-ink);
  background: var(--mp-ink);
  color: var(--mp-on-accent);
  box-shadow: 0 0 0 8rpx var(--mp-accent-soft);
}

.step-num {
  line-height: 1;
}

.step-check {
  width: 32rpx;
  height: 32rpx;
}

.step-main {
  flex: 1;
  min-width: 0;
  padding-top: 4rpx;
}

.step-title {
  display: block;
  color: var(--mp-ink);
  font-size: var(--mp-type-body);
  font-weight: 600;
  line-height: var(--mp-lh-body);
}

.step-item.todo .step-title {
  color: var(--mp-ink-3);
  font-weight: 500;
}

.step-desc {
  display: block;
  color: var(--mp-ink-2);
  font-size: var(--mp-type-meta);
  line-height: var(--mp-lh-caption);
}

.step-item.todo .step-desc {
  color: var(--mp-ink-3);
}

.step-title .pill {
  margin-left: 16rpx;
  vertical-align: 2rpx;
}

.onboarding-button {
  margin-top: 24rpx;
}

.flow-status-list {
  margin-top: 24rpx;
  padding: 16rpx 28rpx;
  border-radius: var(--mp-radius-inset);
  background: var(--mp-fill);
}

.flow-status {
  display: block;
  margin: 8rpx 0;
  color: var(--mp-ink-2);
  font-size: var(--mp-type-caption);
  line-height: var(--mp-lh-caption);
}

.wifi-hint {
  margin-top: 24rpx;
  padding: 16rpx 24rpx;
  border-radius: var(--mp-radius-icon);
  background: var(--mp-sage-bg);
  color: var(--mp-sage);
  font-size: var(--mp-type-caption);
}

.wifi-list {
  margin: 24rpx 0 16rpx;
  max-height: 360rpx;
  overflow-y: scroll;
  border-radius: var(--mp-radius-inset);
  background: var(--mp-fill);
}

.wifi-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  padding: 24rpx 28rpx;
  border-bottom: 2rpx solid var(--mp-line);
}

.wifi-row:last-child {
  border-bottom: none;
}

.wifi-selected {
  background: var(--mp-accent-soft);
}

.wifi-copy {
  min-width: 0;
}

.wifi-name {
  display: block;
  overflow: hidden;
  color: var(--mp-ink);
  font-size: var(--mp-type-body);
  text-overflow: ellipsis;
  white-space: nowrap;
}

.wifi-meta {
  display: block;
  margin-top: 4rpx;
  color: var(--mp-ink-3);
  font-size: var(--mp-type-meta);
}

.wifi-check {
  color: var(--mp-accent);
  font-size: var(--mp-type-title);
  font-weight: 700;
}

.password-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 16rpx;
}

.password-input {
  flex: 1;
}

.password-toggle {
  flex: 0 0 112rpx;
  width: 112rpx;
  min-height: 80rpx;
  margin: 0;
  padding: 0;
  border-radius: var(--mp-radius-pill);
  background: var(--mp-accent-soft);
  color: var(--mp-accent);
  font-size: var(--mp-type-caption);
  font-weight: 600;
  line-height: 80rpx;
}

.form-note {
  display: block;
  margin-top: 24rpx;
  color: var(--mp-ink-3);
  font-size: var(--mp-type-meta);
  line-height: var(--mp-lh-caption);
}

.progress-list {
  margin-top: 24rpx;
}

.progress-row {
  display: flex;
  align-items: center;
  min-height: 64rpx;
  color: var(--mp-ink-3);
  font-size: var(--mp-type-body);
}

.progress-dot {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 36rpx;
  width: 36rpx;
  height: 36rpx;
  margin-right: 16rpx;
  box-sizing: border-box;
  border: 2rpx solid var(--mp-ink-4);
  border-radius: 50%;
  color: var(--mp-on-accent);
  font-size: var(--mp-type-meta);
  font-weight: 700;
}

.progress-done,
.progress-active {
  color: var(--mp-ink);
}

.progress-done .progress-dot {
  border-color: var(--mp-accent);
  background: var(--mp-accent);
}

.progress-active .progress-dot {
  border-color: var(--mp-accent);
  animation: progress-pulse 1.2s ease-in-out infinite;
}

@keyframes progress-pulse {
  0%, 100% { box-shadow: 0 0 0 0 var(--mp-accent-soft); }
  50% { box-shadow: 0 0 0 10rpx var(--mp-accent-soft); }
}

.progress-failed {
  color: var(--mp-rust);
}

.progress-failed .progress-dot {
  border-color: var(--mp-rust);
  background: var(--mp-rust);
}

.network-state {
  display: block;
  margin-top: 24rpx;
  color: var(--mp-ink-2);
  font-size: var(--mp-type-caption);
  line-height: var(--mp-lh-caption);
}

.network-failure {
  margin-top: 24rpx;
}

.network-failure-text {
  display: block;
  padding: 24rpx 28rpx;
  border-radius: var(--mp-radius-inset);
  background: var(--mp-rust-bg);
  color: var(--mp-rust);
  font-size: var(--mp-type-caption);
  line-height: var(--mp-lh-caption);
}

.activation-badge,
.done-badge {
  display: inline-flex;
  margin-top: 24rpx;
  padding: 8rpx 24rpx;
  border-radius: var(--mp-radius-pill);
  background: var(--mp-sage-bg);
  color: var(--mp-sage);
  font-size: var(--mp-type-meta);
  font-weight: 600;
}

.done-card {
  text-align: center;
}

.done-device {
  display: flex;
  justify-content: center;
  margin-top: 8rpx;
}

.done-title {
  display: block;
  margin-top: 24rpx;
  color: var(--mp-ink);
  font-size: var(--mp-type-title);
  font-weight: 700;
  line-height: 1.4;
}

.done-note {
  display: block;
  margin-top: 24rpx;
  color: var(--mp-ink-2);
  font-size: var(--mp-type-caption);
  line-height: var(--mp-lh-caption);
  text-align: left;
}

.onboarding-error {
  margin-top: 24rpx;
}

.cancel-link {
  display: block;
  width: auto;
  margin: 24rpx auto 0;
  padding: 16rpx 32rpx;
  background: transparent;
  color: var(--mp-rust);
  font-size: var(--mp-type-caption);
  line-height: 1.6;
}
