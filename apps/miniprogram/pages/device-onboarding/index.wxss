.onboarding-page {
  padding-bottom: 100rpx;
}

.settings-title {
  display: block;
  color: #f2f5ff;
  font-size: 32rpx;
  font-weight: 800;
}

.setting-desc {
  display: block;
  margin-top: 16rpx;
  color: #8d99c4;
  font-size: 25rpx;
  line-height: 1.7;
}

.onboarding-button {
  width: 100%;
  margin-top: 24rpx;
}

.notice-card {
  box-sizing: border-box;
  margin-top: 24rpx;
  padding: 24rpx 26rpx;
  border: 1rpx solid rgba(255, 179, 92, 0.32);
  border-radius: 24rpx;
  background: rgba(255, 155, 64, 0.08);
}

.notice-title {
  display: block;
  color: #ffc285;
  font-size: 25rpx;
  font-weight: 700;
}

.notice-copy {
  display: block;
  margin-top: 8rpx;
  color: #b8a98c;
  font-size: 23rpx;
  line-height: 1.65;
}

.summary-list {
  margin-top: 18rpx;
}

.summary-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 24rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid rgba(94, 234, 255, 0.1);
}

.summary-key {
  flex: 0 0 auto;
  color: #8d99c4;
  font-size: 24rpx;
}

.summary-value {
  min-width: 0;
  color: #f2f5ff;
  font-size: 24rpx;
  font-weight: 600;
  text-align: right;
  word-break: break-all;
}

.flow-status-list {
  margin-top: 20rpx;
  padding: 20rpx 24rpx;
  border-radius: 24rpx;
  background: rgba(9, 16, 40, 0.55);
}

.flow-status {
  display: block;
  margin: 10rpx 0;
  color: #b8c6ed;
  font-size: 24rpx;
}

.flow-status::before {
  content: "•";
  margin-right: 12rpx;
  color: #22e5ff;
}

.wifi-hint {
  margin-top: 20rpx;
  padding: 16rpx 20rpx;
  border: 1rpx solid rgba(34, 229, 255, 0.2);
  border-radius: 18rpx;
  color: #7ceaff;
  font-size: 23rpx;
}

.wifi-list {
  margin-top: 18rpx;
  max-height: 360rpx;
  overflow: hidden;
  border: 1rpx solid rgba(94, 234, 255, 0.12);
  border-radius: 22rpx;
}

.wifi-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 22rpx 24rpx;
  border-bottom: 1rpx solid rgba(94, 234, 255, 0.08);
}

.wifi-row:last-child {
  border-bottom: none;
}

.wifi-selected {
  background: rgba(34, 229, 255, 0.1);
}

.wifi-copy {
  min-width: 0;
}

.wifi-name {
  display: block;
  overflow: hidden;
  color: #f2f5ff;
  font-size: 27rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.wifi-meta {
  display: block;
  margin-top: 6rpx;
  color: #6b779f;
  font-size: 21rpx;
}

.wifi-check {
  color: #7ceaff;
  font-size: 34rpx;
  font-weight: 800;
}

.field-input {
  box-sizing: border-box;
  width: 100%;
  min-height: 84rpx;
  margin-top: 20rpx;
  padding: 0 24rpx;
  border: 1rpx solid rgba(94, 234, 255, 0.16);
  border-radius: 20rpx;
  background: rgba(8, 14, 36, 0.6);
  color: #f2f5ff;
  font-size: 27rpx;
}

.field-placeholder {
  color: #5d688f;
}

.password-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.password-input {
  flex: 1;
}

.password-toggle {
  flex: 0 0 96rpx;
  min-height: 72rpx;
  padding: 0;
  border: 1rpx solid rgba(94, 234, 255, 0.28);
  border-radius: 999rpx;
  color: #7ceaff;
  background: rgba(34, 229, 255, 0.08);
  font-size: 22rpx;
}

.password-toggle::after {
  border: none;
}

.form-note {
  display: block;
  margin-top: 20rpx;
  color: #6b779f;
  font-size: 22rpx;
  line-height: 1.65;
}

.progress-list {
  margin-top: 20rpx;
}

.progress-row {
  display: flex;
  align-items: center;
  min-height: 64rpx;
  color: #5d688f;
}

.progress-dot {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 34rpx;
  width: 34rpx;
  height: 34rpx;
  margin-right: 16rpx;
  border: 2rpx solid rgba(94, 234, 255, 0.24);
  border-radius: 50%;
  color: #07101f;
  font-size: 22rpx;
  font-weight: 800;
}

.progress-label {
  font-size: 24rpx;
}

.progress-done,
.progress-active {
  color: #b8c6ed;
}

.progress-done .progress-dot,
.progress-active .progress-dot {
  border-color: #22e5ff;
}

.progress-done .progress-dot {
  background: #22e5ff;
}

.progress-active .progress-dot {
  box-shadow: 0 0 20rpx rgba(34, 229, 255, 0.5);
}

.network-state {
  display: block;
  margin-top: 22rpx;
  color: #7ceaff;
  font-size: 25rpx;
}

.activation-badge {
  display: inline-flex;
  margin-top: 22rpx;
  padding: 12rpx 22rpx;
  border: 1rpx solid rgba(94, 234, 255, 0.32);
  border-radius: 999rpx;
  background: rgba(34, 229, 255, 0.08);
  color: #7ceaff;
  font-size: 23rpx;
}

.done-card {
  padding-top: 44rpx;
  padding-bottom: 44rpx;
}

.done-badge {
  display: inline-flex;
  padding: 8rpx 24rpx;
  border: 1rpx solid rgba(94, 234, 255, 0.32);
  border-radius: 999rpx;
  background: rgba(34, 229, 255, 0.08);
  color: #7ceaff;
  font-size: 22rpx;
  letter-spacing: 4rpx;
}

.done-title {
  display: block;
  margin-top: 20rpx;
  color: #f2f5ff;
  font-size: 34rpx;
  font-weight: 800;
  line-height: 1.45;
}

.done-note {
  display: block;
  margin-top: 20rpx;
  color: #8d99c4;
  font-size: 24rpx;
  line-height: 1.7;
}

.onboarding-error {
  margin: 24rpx 8rpx 0;
}

.cancel-link {
  display: block;
  margin: 28rpx auto 0;
  padding: 10rpx 20rpx;
  border: none;
  color: #ff8ba3;
  background: transparent;
  font-size: 24rpx;
}

.cancel-link::after {
  border: none;
}
