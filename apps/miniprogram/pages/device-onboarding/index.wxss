.stepper {
  margin-top: 16px;
}

.step-item {
  display: flex;
  gap: 12px;
  position: relative;
  padding-bottom: 20px;
}

.step-item::before {
  content: '';
  position: absolute;
  left: 13px;
  top: 28px;
  bottom: 2px;
  width: 2px;
  border-radius: 1px;
  background: var(--mp-line);
}

.step-item:last-child {
  padding-bottom: 0;
}

.step-item:last-child::before {
  display: none;
}

.step-item.done::before {
  background: var(--mp-accent);
}

.step-node {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  width: 28px;
  height: 28px;
  box-sizing: border-box;
  border: 2px solid var(--mp-line);
  border-radius: 50%;
  background: var(--mp-surface);
  color: var(--mp-ink-3);
  font-size: var(--mp-type-meta);
  font-weight: 600;
  z-index: 1;
}

.step-item.done .step-node {
  border-color: var(--mp-accent);
  background: var(--mp-accent);
  color: var(--mp-on-accent);
}

.step-item.current .step-node {
  border-color: var(--mp-ink);
  background: var(--mp-ink);
  color: var(--mp-on-accent);
  box-shadow: 0 0 0 4px var(--mp-accent-soft);
}

.step-num {
  line-height: 1;
}

.step-check {
  width: 16px;
  height: 16px;
}

.step-main {
  flex: 1;
  min-width: 0;
  padding-top: 2px;
}

.step-title {
  display: block;
  color: var(--mp-ink);
  font-size: var(--mp-type-body);
  font-weight: 600;
  line-height: var(--mp-lh-body);
}

.step-item.todo .step-title {
  color: var(--mp-ink-3);
  font-weight: 500;
}

.step-desc {
  display: block;
  color: var(--mp-ink-2);
  font-size: var(--mp-type-meta);
  line-height: var(--mp-lh-caption);
}

.step-item.todo .step-desc {
  color: var(--mp-ink-3);
}

.step-title .pill {
  margin-left: 8px;
  vertical-align: 1px;
}

.onboarding-button {
  margin-top: 12px;
}

.flow-status-list {
  margin-top: 12px;
  padding: 8px 14px;
  border-radius: var(--mp-radius-inset);
  background: var(--mp-fill);
}

.flow-status {
  display: block;
  margin: 4px 0;
  color: var(--mp-ink-2);
  font-size: var(--mp-type-caption);
  line-height: var(--mp-lh-caption);
}

.wifi-hint {
  margin-top: 12px;
  padding: 8px 12px;
  border-radius: var(--mp-radius-icon);
  background: var(--mp-sage-bg);
  color: var(--mp-sage);
  font-size: var(--mp-type-caption);
}

.wifi-list {
  margin: 12px 0 8px;
  max-height: 180px;
  overflow-y: scroll;
  border-radius: var(--mp-radius-inset);
  background: var(--mp-fill);
}

.wifi-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  padding: 12px 14px;
  border-bottom: 1px solid var(--mp-line);
}

.wifi-row:last-child {
  border-bottom: none;
}

.wifi-selected {
  background: var(--mp-accent-soft);
}

.wifi-copy {
  min-width: 0;
}

.wifi-name {
  display: block;
  overflow: hidden;
  color: var(--mp-ink);
  font-size: var(--mp-type-body);
  text-overflow: ellipsis;
  white-space: nowrap;
}

.wifi-meta {
  display: block;
  margin-top: 2px;
  color: var(--mp-ink-3);
  font-size: var(--mp-type-meta);
}

.wifi-check {
  color: var(--mp-accent);
  font-size: var(--mp-type-title);
  font-weight: 700;
}

.password-row {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-top: 8px;
}

.password-input {
  flex: 1;
}

.password-toggle {
  flex: 0 0 56px;
  width: 56px;
  min-height: 40px;
  margin: 0;
  padding: 0;
  border-radius: var(--mp-radius-pill);
  background: var(--mp-accent-soft);
  color: var(--mp-accent);
  font-size: var(--mp-type-caption);
  font-weight: 600;
  line-height: 40px;
}

.form-note {
  display: block;
  margin-top: 12px;
  color: var(--mp-ink-3);
  font-size: var(--mp-type-meta);
  line-height: var(--mp-lh-caption);
}

.progress-list {
  margin-top: 12px;
}

.progress-row {
  display: flex;
  align-items: center;
  min-height: 32px;
  color: var(--mp-ink-3);
  font-size: var(--mp-type-body);
}

.progress-dot {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 18px;
  width: 18px;
  height: 18px;
  margin-right: 8px;
  box-sizing: border-box;
  border: 1px solid var(--mp-ink-4);
  border-radius: 50%;
  color: var(--mp-on-accent);
  font-size: var(--mp-type-meta);
  font-weight: 700;
}

.progress-done,
.progress-active {
  color: var(--mp-ink);
}

.progress-done .progress-dot {
  border-color: var(--mp-accent);
  background: var(--mp-accent);
}

.progress-active .progress-dot {
  border-color: var(--mp-accent);
  animation: progress-pulse 1.2s ease-in-out infinite;
}

@keyframes progress-pulse {
  0%, 100% { box-shadow: 0 0 0 0 var(--mp-accent-soft); }
  50% { box-shadow: 0 0 0 5px var(--mp-accent-soft); }
}

.progress-failed {
  color: var(--mp-rust);
}

.progress-failed .progress-dot {
  border-color: var(--mp-rust);
  background: var(--mp-rust);
}

.network-state {
  display: block;
  margin-top: 12px;
  color: var(--mp-ink-2);
  font-size: var(--mp-type-caption);
  line-height: var(--mp-lh-caption);
}

.network-failure {
  margin-top: 12px;
}

.network-failure-text {
  display: block;
  padding: 12px 14px;
  border-radius: var(--mp-radius-inset);
  background: var(--mp-rust-bg);
  color: var(--mp-rust);
  font-size: var(--mp-type-caption);
  line-height: var(--mp-lh-caption);
}

.activation-badge,
.done-badge {
  display: inline-flex;
  margin-top: 12px;
  padding: 4px 12px;
  border-radius: var(--mp-radius-pill);
  background: var(--mp-sage-bg);
  color: var(--mp-sage);
  font-size: var(--mp-type-meta);
  font-weight: 600;
}

.done-card {
  text-align: center;
}

.done-device {
  display: flex;
  justify-content: center;
  margin-top: 4px;
}

.done-title {
  display: block;
  margin-top: 12px;
  color: var(--mp-ink);
  font-size: var(--mp-type-title);
  font-weight: 700;
  line-height: 1.4;
}

.done-note {
  display: block;
  margin-top: 12px;
  color: var(--mp-ink-2);
  font-size: var(--mp-type-caption);
  line-height: var(--mp-lh-caption);
  text-align: left;
}

.onboarding-error {
  margin-top: 12px;
}

.cancel-link {
  display: block;
  width: auto;
  margin: 12px auto 0;
  padding: 8px 16px;
  background: transparent;
  color: var(--mp-rust);
  font-size: var(--mp-type-caption);
  line-height: 1.6;
}
