.onboarding-page {
  padding-bottom: 100rpx;
}

.back-row {
  padding: 8rpx 0 4rpx;
}

.back-link {
  display: inline-flex;
  align-items: center;
  min-height: 88rpx;
  color: #326e70;
  font-size: 28rpx;
  font-weight: 500;
}

.page-head {
  padding: 12rpx 0 4rpx;
}

.ob-steps-card {
  margin-top: 24rpx;
}

.stepper {
  margin-top: 28rpx;
}

.step-item {
  display: flex;
  gap: 24rpx;
  position: relative;
  padding-bottom: 44rpx;
}

.step-item::before {
  content: '';
  position: absolute;
  left: 26rpx;
  top: 56rpx;
  bottom: 4rpx;
  width: 4rpx;
  border-radius: 2rpx;
  background: #dfe6ea;
}

.step-item:last-child {
  padding-bottom: 0;
}

.step-item:last-child::before {
  display: none;
}

.step-item.done::before {
  background: #326e70;
}

.step-node {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  width: 56rpx;
  height: 56rpx;
  border: 4rpx solid #dfe6ea;
  border-radius: 50%;
  background: #ffffff;
  color: #93a1ab;
  font-size: 24rpx;
  font-weight: 600;
  z-index: 1;
  box-sizing: border-box;
}

.step-item.done .step-node {
  border-color: #326e70;
  background: #326e70;
  color: #ffffff;
}

.step-item.current .step-node {
  border-color: #172f43;
  background: #172f43;
  color: #ffffff;
  box-shadow: 0 0 0 10rpx #e3edec;
}

.step-num {
  line-height: 1;
}

.step-check {
  width: 28rpx;
  height: 28rpx;
}

.step-check svg {
  width: 100%;
  height: 100%;
}

.step-main {
  flex: 1;
  min-width: 0;
  padding-top: 4rpx;
}

.step-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
}

.step-item.todo .step-title {
  color: #93a1ab;
  font-weight: 500;
}

.step-desc {
  display: block;
  margin-top: 8rpx;
  color: #5c6b76;
  font-size: 24rpx;
  line-height: 1.6;
}

.step-item.todo .step-desc {
  color: #93a1ab;
}

.step-title .pill {
  margin-left: 12rpx;
  vertical-align: 2rpx;
}

.onboarding-button {
  width: 100%;
  margin-top: 24rpx;
}

.notice-copy {
  display: block;
  margin-top: 8rpx;
  font-size: 23rpx;
  line-height: 1.65;
}

.flow-status-list {
  margin-top: 20rpx;
  padding: 20rpx 24rpx;
  border-radius: 24rpx;
  background: #eaf0f3;
}

.flow-status {
  display: block;
  margin: 10rpx 0;
  color: #596a78;
  font-size: 24rpx;
}

.wifi-hint {
  margin-top: 20rpx;
  padding: 16rpx 20rpx;
  border-radius: 18rpx;
  background: #e8f1ee;
  color: #346856;
  font-size: 23rpx;
}

.wifi-list {
  margin-top: 18rpx;
  max-height: 360rpx;
  overflow-y: scroll;
  border: 1rpx solid #dfe6ea;
  border-radius: 22rpx;
}

.wifi-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 22rpx 24rpx;
  border-bottom: 1rpx solid #dfe6ea;
}

.wifi-row:last-child {
  border-bottom: none;
}

.wifi-selected {
  background: #e8f1ee;
}

.wifi-copy {
  min-width: 0;
}

.wifi-name {
  display: block;
  overflow: hidden;
  font-size: 27rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.wifi-meta {
  display: block;
  margin-top: 6rpx;
  color: #596a78;
  font-size: 21rpx;
}

.wifi-check {
  color: #326e70;
  font-size: 34rpx;
  font-weight: 700;
}

.password-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.password-input {
  flex: 1;
}

.password-toggle {
  flex: 0 0 96rpx;
  min-height: 72rpx;
  padding: 0;
  border-radius: 999rpx;
  color: #326e70;
  background: #e8f0ef;
  font-size: 22rpx;
}

.password-toggle::after {
  border: none;
}

.form-note {
  display: block;
  margin-top: 20rpx;
  color: #596a78;
  font-size: 22rpx;
  line-height: 1.65;
}

.progress-list {
  margin-top: 20rpx;
}

.progress-row {
  display: flex;
  align-items: center;
  min-height: 64rpx;
  color: #8a9aa4;
}

.progress-dot {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 34rpx;
  width: 34rpx;
  height: 34rpx;
  margin-right: 16rpx;
  border: 2rpx solid #dfe6ea;
  border-radius: 50%;
  color: #fff;
  font-size: 22rpx;
  font-weight: 700;
}

.progress-done,
.progress-active {
  color: #192f41;
}

.progress-done .progress-dot,
.progress-active .progress-dot {
  border-color: #172f43;
}

.progress-done .progress-dot {
  background: #172f43;
}

.network-state {
  display: block;
  margin-top: 22rpx;
  color: #326e70;
  font-size: 25rpx;
}

.activation-badge {
  display: inline-flex;
  margin-top: 22rpx;
  padding: 12rpx 22rpx;
  border-radius: 999rpx;
  background: #e8f1ee;
  color: #346856;
  font-size: 23rpx;
}

.done-badge {
  display: inline-flex;
  padding: 8rpx 24rpx;
  border-radius: 999rpx;
  background: #e8f1ee;
  color: #346856;
  font-size: 22rpx;
  letter-spacing: 4rpx;
}

.done-card {
  text-align: center;
}

.done-title {
  display: block;
  margin-top: 20rpx;
  font-size: 34rpx;
  font-weight: 600;
  line-height: 1.45;
}

.done-note {
  display: block;
  margin-top: 20rpx;
  color: #596a78;
  font-size: 24rpx;
  line-height: 1.7;
  text-align: left;
}

.onboarding-error {
  margin: 24rpx 8rpx 0;
}

.cancel-link {
  display: block;
  margin: 28rpx auto 0;
  padding: 10rpx 20rpx;
  border: none;
  color: #a43a43;
  background: transparent;
  font-size: 24rpx;
}

.cancel-link::after {
  border: none;
}
