.onboarding-page {
  padding-bottom: 100rpx;
}

.onboarding-button {
  width: 100%;
  margin-top: 24rpx;
}

.notice-card {
  box-sizing: border-box;
  margin-top: 24rpx;
  padding: 24rpx 26rpx;
  border-radius: 24rpx;
  background: #f3ede2;
}

.notice-title {
  display: block;
  color: #855524;
  font-size: 25rpx;
  font-weight: 600;
}

.notice-copy {
  display: block;
  margin-top: 8rpx;
  color: #855524;
  font-size: 23rpx;
  line-height: 1.65;
}

.flow-status-list {
  margin-top: 20rpx;
  padding: 20rpx 24rpx;
  border-radius: 24rpx;
  background: #eaf0f3;
}

.flow-status {
  display: block;
  margin: 10rpx 0;
  color: #596a78;
  font-size: 24rpx;
}

.wifi-hint {
  margin-top: 20rpx;
  padding: 16rpx 20rpx;
  border-radius: 18rpx;
  background: #e8f1ee;
  color: #346856;
  font-size: 23rpx;
}

.wifi-list {
  margin-top: 18rpx;
  max-height: 360rpx;
  overflow-y: scroll;
  border: 1rpx solid #dfe6ea;
  border-radius: 22rpx;
}

.wifi-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 22rpx 24rpx;
  border-bottom: 1rpx solid #dfe6ea;
}

.wifi-row:last-child {
  border-bottom: none;
}

.wifi-selected {
  background: #e8f0ef;
}

.wifi-copy {
  min-width: 0;
}

.wifi-name {
  display: block;
  overflow: hidden;
  font-size: 27rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.wifi-meta {
  display: block;
  margin-top: 6rpx;
  color: #596a78;
  font-size: 21rpx;
}

.wifi-check {
  color: #326e70;
  font-size: 34rpx;
  font-weight: 700;
}

.password-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.password-input {
  flex: 1;
}

.password-toggle {
  flex: 0 0 96rpx;
  min-height: 72rpx;
  padding: 0;
  border-radius: 999rpx;
  color: #326e70;
  background: #e8f0ef;
  font-size: 22rpx;
}

.password-toggle::after {
  border: none;
}

.form-note {
  display: block;
  margin-top: 20rpx;
  color: #596a78;
  font-size: 22rpx;
  line-height: 1.65;
}

.progress-list {
  margin-top: 20rpx;
}

.progress-row {
  display: flex;
  align-items: center;
  min-height: 64rpx;
  color: #8a9aa4;
}

.progress-dot {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 34rpx;
  width: 34rpx;
  height: 34rpx;
  margin-right: 16rpx;
  border: 2rpx solid #dfe6ea;
  border-radius: 50%;
  color: #fff;
  font-size: 22rpx;
  font-weight: 700;
}

.progress-done,
.progress-active {
  color: #192f41;
}

.progress-done .progress-dot,
.progress-active .progress-dot {
  border-color: #172f43;
}

.progress-done .progress-dot {
  background: #172f43;
}

.network-state {
  display: block;
  margin-top: 22rpx;
  color: #326e70;
  font-size: 25rpx;
}

.activation-badge {
  display: inline-flex;
  margin-top: 22rpx;
  padding: 12rpx 22rpx;
  border-radius: 999rpx;
  background: #e8f1ee;
  color: #346856;
  font-size: 23rpx;
}

.done-badge {
  display: inline-flex;
  padding: 8rpx 24rpx;
  border-radius: 999rpx;
  background: #e8f1ee;
  color: #346856;
  font-size: 22rpx;
  letter-spacing: 4rpx;
}

.done-title {
  display: block;
  margin-top: 20rpx;
  font-size: 34rpx;
  font-weight: 600;
  line-height: 1.45;
}

.done-note {
  display: block;
  margin-top: 20rpx;
  color: #596a78;
  font-size: 24rpx;
  line-height: 1.7;
}

.onboarding-error {
  margin: 24rpx 8rpx 0;
}

.cancel-link {
  display: block;
  margin: 28rpx auto 0;
  padding: 10rpx 20rpx;
  border: none;
  color: #a43a43;
  background: transparent;
  font-size: 24rpx;
}

.cancel-link::after {
  border: none;
}
