<view class="page-shell onboarding-page">
  <page-backdrop theme="mist"></page-backdrop>
  <view class="back-row"><navigator class="back-link" url="/pages/device/index" open-type="switchTab">‹ 设备</navigator></view>
  <view class="page-head">
    <text class="page-title">{{reprovision ? '重新配网' : '配网引导'}}</text>
    <text class="page-subtitle">跟着亮起的步骤走就好</text>
  </view>
  <text class="caption">{{reprovision ? '只更新网络，机器人的归属和绑定都不会变。' : '扫码、连上 Wi‑Fi、确认归属、等机器人就绪，几步就能完成；设置好后关掉小程序，机器人也能正常使用。'}}</text>

  <view class="l2-card ob-steps-card">
    <text class="l2-card-title">{{stateLabel}}</text>
    <view class="stepper">
      <view class="step-item {{(state === 'prepare' || state === 'scan') ? 'current' : 'done'}}">
        <view class="step-node">
          <view wx:if="{{state === 'prepare' || state === 'scan'}}" class="step-num">1</view>
          <view wx:else class="inline-icon step-check"><view class="icon-check"></view></view>
        </view>
        <view class="step-main"><text class="step-title">扫码确认身份</text><text class="step-desc">镜头对准设备底部的码</text></view>
      </view>
      <view class="step-item {{(state === 'device_verified' || state === 'ble') ? 'current' : ((state === 'prepare' || state === 'scan') ? 'todo' : 'done')}}">
        <view class="step-node">
          <view wx:if="{{state === 'device_verified' || state === 'ble'}}" class="step-num">2</view>
          <view wx:elif="{{state === 'prepare' || state === 'scan'}}" class="step-num">2</view>
          <view wx:else class="inline-icon step-check"><view class="icon-check"></view></view>
        </view>
        <view class="step-main"><text class="step-title">连上机器人</text><text class="step-desc">手机靠近机器人，自动连上</text></view>
      </view>
      <view class="step-item {{(state === 'wifi' || state === 'progress') ? 'current' : ((state === 'claim' || state === 'initialize' || state === 'activation' || state === 'complete') ? 'done' : 'todo')}}">
        <view class="step-node">
          <view wx:if="{{state === 'wifi' || state === 'progress'}}" class="step-num">3</view>
          <view wx:elif="{{state === 'claim' || state === 'initialize' || state === 'activation' || state === 'complete'}}" class="inline-icon step-check"><view class="icon-check"></view></view>
          <view wx:else class="step-num">3</view>
        </view>
        <view class="step-main"><text class="step-title">设置 Wi‑Fi <text wx:if="{{state === 'wifi' || state === 'progress'}}" class="pill pill-teal">进行中</text></text><text class="step-desc">把家里的 Wi‑Fi 告诉机器人，大约 30 秒</text></view>
      </view>
      <block wx:if="{{!reprovision}}">
      <view class="step-item {{(state === 'claim' || state === 'initialize') ? 'current' : ((state === 'activation' || state === 'complete') ? 'done' : 'todo')}}">
        <view class="step-node">
          <view wx:if="{{state === 'claim' || state === 'initialize'}}" class="step-num">4</view>
          <view wx:elif="{{state === 'activation' || state === 'complete'}}" class="inline-icon step-check"><view class="icon-check"></view></view>
          <view wx:else class="step-num">4</view>
        </view>
        <view class="step-main"><text class="step-title">确认归属</text><text class="step-desc">确认这台机器人是你的</text></view>
      </view>
      <view class="step-item {{state === 'activation' ? 'current' : (state === 'complete' ? 'done' : 'todo')}}">
        <view class="step-node">
          <view wx:if="{{state === 'complete'}}" class="inline-icon step-check"><view class="icon-check"></view></view>
          <view wx:else class="step-num">5</view>
        </view>
        <view class="step-main"><text class="step-title">激活完成</text><text class="step-desc">灯亮起来，就可以打招呼了</text></view>
      </view>
      </block>
      <view wx:else class="step-item {{state === 'complete' ? 'done' : 'todo'}}">
        <view class="step-node">
          <view wx:if="{{state === 'complete'}}" class="inline-icon step-check"><view class="icon-check"></view></view>
          <view wx:else class="step-num">4</view>
        </view>
        <view class="step-main"><text class="step-title">重新上线</text><text class="step-desc">用新网络连上 Memoria，绑定保持不变</text></view>
      </view>
    </view>
  </view>

  <view wx:if="{{state === 'prepare'}}" class="l2-card">
    <view class="card-lead">
      <glass-icon name="device" size="80"></glass-icon>
      <text class="l2-card-title">先准备好机器人</text>
    </view>
    <text wx:if="{{reprovision}}" class="l2-card-sub">机器人找不到已保存的 Wi‑Fi 时，屏幕会自动显示二维码。请用绑定它的账号扫码，本次只更新网络，不需要解除绑定；家庭网络需支持 2.4 GHz。</text>
    <text wx:else class="l2-card-sub">请接通电源，等机器人屏幕上出现二维码；手机需要打开蓝牙和 Wi‑Fi，家里的 Wi‑Fi 要是 2.4 GHz 的（多数路由器都支持）。</text>
    <view class="notice notice-warn">
      <text class="notice-title">小提醒</text>
      <text class="notice-copy">扫二维码只是开始设置，还不算绑定。Wi‑Fi 密码只用来给机器人联网，不会上传，也不会保存在手机上。</text>
    </view>
    <button class="primary-button onboarding-button" bindtap="startFlow">开始扫码</button>
    <button class="secondary-button onboarding-button" bindtap="openDevicePage">返回设备管理</button>
  </view>

  <view wx:if="{{state === 'scan'}}" class="l2-card">
    <view class="card-lead">
      <glass-icon name="qr" size="80"></glass-icon>
      <text class="l2-card-title">扫描机器人二维码</text>
    </view>
    <text class="l2-card-sub">请扫描机器人屏幕上的二维码，扫码结果不会保存在手机上。</text>
    <button class="primary-button onboarding-button" loading="{{scanning || busy}}" disabled="{{scanning || busy}}" bindtap="scanQr">扫描二维码</button>
    <text class="form-note">二维码过期了？轻点机器人屏幕换一张新的，再扫一次。</text>
  </view>

  <view wx:if="{{state === 'device_verified'}}" class="l2-card">
    <view class="card-lead">
      <glass-icon name="check" size="80"></glass-icon>
      <text class="l2-card-title">已确认这台设备</text>
    </view>
    <view wx:if="{{device}}" class="summary-list">
      <view class="summary-row"><text class="summary-key">设备型号</text><text class="summary-value">{{device.model}}</text></view>
      <view class="summary-row"><text class="summary-key">设备尾号</text><text class="summary-value">{{device.display_tail}}</text></view>
      <view class="summary-row"><text class="summary-key">固件版本</text><text class="summary-value">{{device.firmware_version}}</text></view>
      <view class="summary-row"><text class="summary-key">设备状态</text><text class="summary-value">{{device.claim_status === 'unclaimed' ? '待启用' : (device.claim_status === 'bound' ? '已绑定' : device.claim_status)}}</text></view>
    </view>
    <text wx:if="{{reprovision}}" class="form-note">这台机器人已绑定在你的账号上，本次只更新 Wi‑Fi；下一步让手机连上它。</text>
    <text wx:else class="form-note">下一步让手机连上这台机器人；只扫码不会绑定账号。</text>
    <button class="primary-button onboarding-button" loading="{{busy}}" disabled="{{busy}}" bindtap="connectBle">连接附近机器人</button>
    <button class="secondary-button onboarding-button" bindtap="startFlow">重新扫码</button>
  </view>

  <view wx:if="{{state === 'ble'}}" class="l2-card">
    <view class="card-lead">
      <glass-icon name="bluetooth" size="80"></glass-icon>
      <text class="l2-card-title">连接附近机器人</text>
    </view>
    <view class="flow-status-list">
      <text class="flow-status">正在打开蓝牙</text>
      <text class="flow-status">正在寻找屏幕上的机器人</text>
      <text class="flow-status">找到后会核对尾号，确认是同一台机器人</text>
      <text class="flow-status">确认安全之前，不会发送 Wi‑Fi 信息</text>
    </view>
    <button class="secondary-button onboarding-button" loading="{{busy}}" disabled="{{busy}}" bindtap="retryBle">重新连接</button>
  </view>

  <view wx:if="{{state === 'wifi'}}" class="l2-card">
    <view class="card-lead">
      <glass-icon name="wifi" size="80"></glass-icon>
      <text class="l2-card-title">选择家庭 Wi‑Fi</text>
    </view>
    <text class="l2-card-sub">下面是机器人附近能搜到的 2.4 GHz Wi‑Fi，请选择家里的网络，再输入密码。</text>
    <view wx:if="{{connectedWifi}}" class="wifi-hint">手机当前连接：{{connectedWifi}}</view>
    <view wx:if="{{wifiNetworks.length > 0}}" class="wifi-list">
      <view wx:for="{{wifiNetworks}}" wx:key="ssid" class="wifi-row {{selectedSsid === item.ssid ? 'wifi-selected' : ''}}" data-ssid="{{item.ssid}}" bindtap="onWifiNetworkTap">
        <view class="wifi-copy"><text class="wifi-name">{{item.ssid}}</text><text wx:if="{{item.meta}}" class="wifi-meta">{{item.meta}}</text></view>
        <text wx:if="{{selectedSsid === item.ssid}}" class="wifi-check">✓</text>
      </view>
    </view>
    <input class="field-input" value="{{selectedSsid}}" placeholder="也可以手动输入 Wi‑Fi 名称" placeholder-class="field-placeholder" bindinput="onSsidInput" />
    <view class="password-row">
      <input class="field-input password-input" password="{{!showPassword}}" value="{{wifiPassword}}" placeholder="Wi‑Fi 密码" placeholder-class="field-placeholder" bindinput="onWifiPasswordInput" />
      <button class="password-toggle" bindtap="togglePassword">{{showPassword ? '隐藏' : '显示'}}</button>
    </view>
    <text class="form-note">密码只用来给机器人联网，不会上传，也不会留在手机上；切到后台、离开页面或发送之后，都会立刻清除。</text>
    <button class="primary-button onboarding-button" loading="{{busy}}" disabled="{{busy}}" bindtap="submitWifi">安全发送给机器人</button>
  </view>

  <view wx:if="{{state === 'progress'}}" class="l2-card">
    <view class="card-lead">
      <glass-icon name="wifi" size="80"></glass-icon>
      <text class="l2-card-title">{{networkFailed ? '机器人没能联网' : (network.phase === 'online' ? '机器人已上线' : '机器人正在联网')}}</text>
    </view>
    <view class="progress-list">
      <view wx:for="{{networkRows}}" wx:key="key" class="progress-row {{item.done ? 'progress-done' : ''}} {{item.active ? 'progress-active' : ''}} {{item.failed ? 'progress-failed' : ''}}">
        <view class="progress-dot"><text wx:if="{{item.done}}">✓</text><text wx:elif="{{item.failed}}">!</text></view>
        <text class="progress-label">{{item.label}}</text>
      </view>
    </view>
    <text wx:if="{{network && !networkFailed && network.phase !== 'online'}}" class="network-state">已等待 {{network.elapsedS}} 秒，通常 30 秒内完成，请保持机器人通电、手机靠近。</text>
    <view wx:if="{{networkFailed}}" class="network-failure">
      <text class="network-failure-text">{{networkFailure}}</text>
      <button class="primary-button onboarding-button" bindtap="retryWifi">重新输入 Wi‑Fi 密码</button>
      <button wx:if="{{network.failure === 'cloud'}}" class="secondary-button onboarding-button" bindtap="retryProgress">再等一会儿</button>
      <button class="secondary-button onboarding-button" bindtap="startFlow">重新扫码</button>
    </view>
    <button wx:if="{{!network}}" class="secondary-button onboarding-button" loading="{{busy}}" disabled="{{busy}}" bindtap="retryProgress">查看机器人联网状态</button>
    <button wx:if="{{network.phase === 'online' && !reprovision}}" class="primary-button onboarding-button" loading="{{busy}}" disabled="{{busy}}" bindtap="reserveClaim">确认这是我的机器人</button>
  </view>

  <view wx:if="{{state === 'claim'}}" class="l2-card">
    <view class="card-lead">
      <glass-icon name="shield" size="80"></glass-icon>
      <text class="l2-card-title">确认这是你的机器人</text>
    </view>
    <text class="l2-card-sub">机器人已经联网。确认后，这台机器人就先留给你的账号，请接着完成设置；之后重新配 Wi‑Fi，它也不会换主人。</text>
    <view wx:if="{{device}}" class="summary-row"><text class="summary-key">设备尾号</text><text class="summary-value">{{device.display_tail}}</text></view>
    <view wx:if="{{claim && claimExpiryLabel}}" class="summary-row"><text class="summary-key">请在这之前完成</text><text class="summary-value">{{claimExpiryLabel}}</text></view>
    <text wx:if="{{claim}}" class="form-note">超时也没关系，会自动释放，回来重新确认一次就好。</text>
    <button wx:if="{{!claim}}" class="primary-button onboarding-button" loading="{{busy}}" disabled="{{busy}}" bindtap="reserveClaim">确认这是我的机器人</button>
    <button wx:if="{{claim}}" class="primary-button onboarding-button" bindtap="continueInitialize">下一步：设置使用方式</button>
  </view>

  <view wx:if="{{state === 'initialize'}}" class="l2-card">
    <view class="card-lead">
      <glass-icon name="sprout" size="80"></glass-icon>
      <text class="l2-card-title">设置使用方式</text>
    </view>
    <text class="l2-card-sub">接下来选择机器人给谁用、挑一位陪伴伙伴，不需要再扫码。</text>
    <button class="primary-button onboarding-button" bindtap="continueInitialize">去设置</button>
  </view>

  <view wx:if="{{state === 'activation'}}" class="l2-card">
    <view class="card-lead">
      <glass-icon name="bell" size="80"></glass-icon>
      <text class="l2-card-title">等待机器人激活</text>
    </view>
    <text class="l2-card-sub">机器人正在领取你刚刚设置好的内容，一般一分钟内就好。请保持机器人通电、连着 Wi‑Fi，这里会自动更新。</text>
    <view class="activation-badge">{{activationLabel}}</view>
    <text wx:if="{{activationSlow}}" class="form-note activation-slow">等得有点久？先看看机器人屏幕是否还亮着。如果一直没有变化，把机器人的电源拔掉再插上，重启后会自动接着完成，这里不用重新操作。</text>
    <button class="secondary-button onboarding-button" loading="{{busy}}" disabled="{{busy}}" bindtap="refreshActivation">刷新状态</button>
  </view>

  <view wx:if="{{state === 'complete'}}" class="l2-card done-card">
    <view class="done-device">
      <face-badge wx:if="{{companionId}}" role="{{companionId}}" size="xl" plain="{{true}}" animated="{{true}}"></face-badge>
      <device-screen wx:else online="{{true}}" size="220"></device-screen>
    </view>
    <text class="done-badge">{{reprovision ? 'ONLINE' : 'READY'}}</text>
    <text class="done-title">{{reprovision ? '网络已更新' : '机器人可以开始对话了'}}</text>
    <text wx:if="{{reprovision}}" class="done-note">机器人已经用新的 Wi‑Fi 连上 Memoria。绑定关系、使用人和记忆都没有变化，唤醒它就能继续聊天。</text>
    <text wx:else class="done-note">设备已就绪。唤醒机器人就可以开始聊天；它只服务这次绑定的使用人，使用人和设备管理都可以在「设备」页调整。</text>
    <button class="primary-button onboarding-button" bindtap="openDevicePage">进入设备管理</button>
  </view>

  <text wx:if="{{error}}" class="error-text onboarding-error">{{error}}</text>
  <text class="privacy-note">Wi‑Fi 密码只传给机器人，不会上传到服务器。</text>
  <button wx:if="{{state !== 'complete'}}" class="cancel-link" bindtap="cancelFlow">{{reprovision ? '取消重新配网' : '取消本次启用'}}</button>
</view>
