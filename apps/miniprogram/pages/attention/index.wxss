@import "../../styles/trial-theme.wxss";

.attention-card {
  margin-top: 9px;
  padding: 24px 24px 16px;
  border-radius: var(--mp-radius-card-xl);
  text-align: center;
}

.attention-mascot {
  width: 80px;
  height: 80px;
  margin: 0 auto;
  overflow: hidden;
  border-radius: 50%;
  background: var(--mp-rust-bg);
}

.attention-mascot-img {
  display: block;
  width: 96px;
  margin-top: 8px;
  mix-blend-mode: multiply;
}

.attention-title {
  display: block;
  margin-top: 16px;
  color: var(--mp-ink);
  font-size: var(--mp-type-heading);
  font-weight: 700;
  letter-spacing: -0.4px;
}

.attention-time {
  display: block;
  margin-top: 4px;
  color: var(--mp-ink-2);
  font-size: var(--mp-type-body);
  line-height: var(--mp-lh-body);
}

.attention-well {
  display: block;
  margin-top: 16px;
  padding: 16px;
  border-radius: var(--mp-radius-inset);
  background: var(--mp-rust-bg);
  color: var(--mp-rust-deep);
  font-size: var(--mp-type-small);
  line-height: var(--mp-lh-body);
  text-align: left;
}

.attention-category {
  display: block;
  margin-top: 12px;
  color: var(--mp-rust);
  font-size: var(--mp-type-small);
  font-weight: 600;
}

.attention-summary {
  display: block;
  font-size: var(--mp-type-body);
  line-height: var(--mp-lh-body);
}

.attention-steps {
  margin-top: 16px;
  padding: 0;
}

.attention-step {
  display: block;
  padding: 16px;
  color: var(--mp-ink);
  font-size: var(--mp-type-body);
  line-height: var(--mp-lh-body);
}

.attention-step + .attention-step {
  box-shadow: inset 0 1px 0 var(--mp-line);
}

.attention-error {
  margin-top: 16px;
  text-align: center;
}

.attention-done {
  margin-top: 16px;
}
