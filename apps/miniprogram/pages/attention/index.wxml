<view class="page-shell sub-page" style="{{statusBarStyle}}">
  <view class="nav-back" bindtap="goBack" aria-label="返回"><image class="nav-back-icon" src="/assets/ui/v4/back-strong.svg" /></view>

  <view wx:if="{{loading}}" class="card attention-card"><text class="attention-time">正在读取…</text></view>

  <block wx:elif="{{alert}}">
    <view class="card attention-card">
      <view class="attention-mascot"><image class="attention-mascot-img" src="/assets/ui/v4/mascot-calm.jpg" mode="widthFix" /></view>
      <text class="attention-title">{{alert.message}}</text>
      <text class="attention-time">{{alert.occurredLabel}}</text>
      <text wx:if="{{alert.categoryLabel}}" class="attention-category">{{alert.categoryLabel}}</text>
      <view wx:if="{{alert.summary}}" class="attention-well">
        <text class="attention-summary">{{alert.summary}}</text>
      </view>
    </view>

    <view wx:if="{{alert.robotSaid || alert.parentAction || alert.detail}}" class="card attention-steps">
      <text wx:if="{{alert.robotSaid}}" class="attention-step">{{alert.robotSaid}}</text>
      <text wx:if="{{alert.parentAction}}" class="attention-step">{{alert.parentAction}}</text>
      <text wx:if="{{alert.detail}}" class="attention-step">{{alert.detail}}</text>
    </view>
  </block>

  <view wx:else class="card attention-card">
    <text class="attention-title">现在没有需要关注的对话</text>
    <text class="attention-time">有新的提醒时，首页会置顶显示。</text>
  </view>

  <text wx:if="{{ackError}}" class="error-text attention-error">{{ackError}}</text>
  <button class="trial-primary attention-done" bindtap="acknowledge" disabled="{{acknowledging}}">我知道了</button>
</view>
