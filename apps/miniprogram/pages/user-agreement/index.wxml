<view class="page-shell sub-page" style="{{statusBarStyle}}">
  <view class="nav-back" bindtap="goBack" aria-label="返回"><image class="nav-back-icon" src="/assets/ui/v4/back-strong.svg" /></view>
  <text class="page-title">用户服务协议</text>
  <text wx:if="{{pending}}" class="page-lede agreement-pending">{{notice}}</text>
  <view wx:else class="agreement-copy">
    <text class="agreement-p" wx:for="{{paragraphs}}" wx:key="*this">{{item}}</text>
  </view>
</view>
