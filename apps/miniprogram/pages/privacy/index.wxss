.privacy-status,
.privacy-detail,
.privacy-note-title {
  display: block;
}

/* ——— 授权状态卡 ——— */
.consent-card {
  text-align: center;
}

.consent-shield {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 128rpx;
  height: 128rpx;
  margin: 8rpx auto 22rpx;
  border: 1rpx solid rgba(94, 234, 255, 0.3);
  border-radius: 50%;
  background: rgba(34, 229, 255, 0.07);
  box-shadow: 0 0 32rpx rgba(34, 229, 255, 0.12);
}

.consent-on .consent-shield {
  border-color: rgba(94, 234, 255, 0.7);
  background: linear-gradient(135deg, #19b8d8, #7b5cff);
  box-shadow: 0 0 44rpx rgba(34, 229, 255, 0.45);
}

.consent-shield-icon {
  color: #7ceaff;
  font-size: 52rpx;
}

.consent-on .consent-shield-icon {
  color: #fff;
}

.privacy-status {
  color: #f2f5ff;
  font-size: 33rpx;
  font-weight: 800;
  letter-spacing: 1rpx;
}

.privacy-detail {
  margin-top: 14rpx;
  color: #8d99c4;
  font-size: 26rpx;
  line-height: 1.7;
}

.privacy-button {
  margin-top: 30rpx;
}

/* ——— 边界说明 ——— */
.privacy-note {
  border-color: rgba(94, 234, 255, 0.22);
  background: linear-gradient(135deg, rgba(34, 229, 255, 0.07), rgba(123, 92, 255, 0.08));
}

.privacy-note .privacy-detail {
  text-align: left;
}

.privacy-note-title {
  color: #7ceaff;
  font-size: 29rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}
