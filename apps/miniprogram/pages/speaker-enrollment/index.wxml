<view class="page-bg"><image class="page-bg-img" src="/assets/bg/night-stars.png" mode="widthFix" /></view>

<view class="page-shell enrollment-page">
  <text class="eyebrow">OWNER VOICEPRINT</text>
  <text class="page-title">让伙伴更稳地认出你</text>
  <text class="page-subtitle">像录入多枚指纹一样，用四种常见说话状态各录一次。每段连续说 3 到 8 秒，环境安静即可。</text>

  <view class="progress-card">
    <view class="progress-copy">
      <text>录取进度</text>
      <text>{{completed}} / 4</text>
    </view>
    <view class="progress-track"><view class="progress-value progress-{{completed}}"></view></view>
  </view>

  <checkbox-group class="consent-card card" bindchange="onConsentChange">
    <label class="consent-label">
      <checkbox value="accepted" checked="{{consent}}" color="#22e5ff" />
      <view class="consent-copy">
        <text class="consent-title">同意采集主人声纹</text>
        <text class="consent-detail">声纹仅用于区分主人与明显旁人，不用于语音克隆。新声纹会先进入影子观察，达到质量门槛后才生效。</text>
      </view>
    </label>
  </checkbox-group>

  <view wx:for="{{recordings}}" wx:key="scene" class="card recording-card {{item.ready ? 'recording-ready' : ''}} {{recordingIndex === index ? 'recording-active' : ''}}">
    <view class="recording-heading">
      <view class="recording-step"><text>{{index + 1}}</text></view>
      <view class="recording-copy">
        <text class="recording-label">{{item.label}}</text>
        <text class="recording-hint">{{item.hint}}</text>
      </view>
      <text class="recording-state">{{recordingIndex === index ? elapsed + ' 秒' : (item.ready ? '已录取' : '待录取')}}</text>
    </view>
    <text class="recording-prompt">“{{item.prompt}}”</text>
    <button
      wx:if="{{recordingIndex !== index}}"
      class="secondary-button recording-button"
      data-index="{{index}}"
      bindtap="startRecording"
      disabled="{{!consent || busy || (!item.ready && index > completed) || recordingIndex >= 0}}"
    >{{item.ready ? '重新录制' : '开始录制'}}</button>
    <button wx:else class="danger-button recording-button" bindtap="stopRecording">停止并保存</button>
  </view>

  <text wx:if="{{error}}" class="error-text enrollment-error">{{error}}</text>
  <button
    class="primary-button submit-button"
    loading="{{busy}}"
    disabled="{{!consent || completed < 4 || recordingIndex >= 0 || busy}}"
    bindtap="submit"
  >完成主人声纹录取</button>
</view>
