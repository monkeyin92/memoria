.enrollment-page {
  padding-bottom: 88rpx;
}

.progress-card {
  box-sizing: border-box;
  margin-top: 32rpx;
  padding: 24rpx 28rpx;
  border: 1rpx solid rgba(94, 234, 255, 0.2);
  border-radius: 28rpx;
  background: rgba(16, 23, 52, 0.74);
}

.progress-copy {
  display: flex;
  justify-content: space-between;
  color: #b8c6ed;
  font-size: 25rpx;
}

.progress-track {
  height: 12rpx;
  margin-top: 18rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.08);
}

.progress-value {
  height: 100%;
  border-radius: inherit;
  background: linear-gradient(90deg, #22e5ff, #8b68ff);
  box-shadow: 0 0 20rpx rgba(34, 229, 255, 0.45);
  transition: width 180ms ease;
}

.progress-0 { width: 0; }
.progress-1 { width: 25%; }
.progress-2 { width: 50%; }
.progress-3 { width: 75%; }
.progress-4 { width: 100%; }

.consent-card {
  padding: 28rpx;
}

.consent-label,
.recording-heading {
  display: flex;
  align-items: flex-start;
}

.consent-label checkbox {
  flex: 0 0 auto;
  margin-top: 4rpx;
}

.consent-copy {
  flex: 1;
  min-width: 0;
  margin-left: 18rpx;
}

.consent-title,
.consent-detail,
.recording-label,
.recording-hint,
.recording-prompt {
  display: block;
}

.consent-title {
  color: #f2f5ff;
  font-size: 28rpx;
  font-weight: 700;
}

.consent-detail {
  margin-top: 10rpx;
  color: #8d99c4;
  font-size: 24rpx;
  line-height: 1.65;
}

.recording-card {
  border-color: rgba(94, 234, 255, 0.12);
  transition: border-color 180ms ease, box-shadow 180ms ease;
}

.recording-ready {
  border-color: rgba(94, 234, 255, 0.36);
}

.recording-active {
  border-color: rgba(255, 110, 140, 0.52);
  box-shadow: 0 0 34rpx rgba(255, 77, 109, 0.12);
}

.recording-step {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 56rpx;
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  color: #07101e;
  background: linear-gradient(135deg, #7ceaff, #9f8cff);
  font-size: 26rpx;
  font-weight: 800;
}

.recording-copy {
  flex: 1;
  min-width: 0;
  margin-left: 18rpx;
}

.recording-label {
  color: #f2f5ff;
  font-size: 29rpx;
  font-weight: 700;
}

.recording-hint {
  margin-top: 6rpx;
  color: #7d89b2;
  font-size: 23rpx;
  line-height: 1.5;
}

.recording-state {
  flex: 0 0 auto;
  margin-left: 12rpx;
  color: #7ceaff;
  font-size: 23rpx;
}

.recording-active .recording-state {
  color: #ff8ba3;
}

.recording-prompt {
  margin-top: 24rpx;
  padding: 22rpx 24rpx;
  border-radius: 22rpx;
  color: #cbd5f5;
  background: rgba(7, 11, 26, 0.48);
  font-size: 26rpx;
  line-height: 1.65;
}

.recording-button,
.submit-button {
  margin-top: 24rpx;
}

button[disabled] {
  opacity: 0.42;
}

.enrollment-error {
  margin-top: 28rpx;
  text-align: center;
}

.submit-button {
  width: 100%;
  margin-top: 34rpx;
}
