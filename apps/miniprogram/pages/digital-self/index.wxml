<view class="page-shell">
  <view class="back-row"><navigator class="back-link" url="/pages/profile/index" open-type="switchTab">‹ 我的</navigator></view>
  <view class="page-head">
    <text class="page-title">记忆档案</text>
    <text class="page-subtitle">被记住的，都是被允许的</text>
  </view>

  <view class="role-tint-card ds-hero" data-role="starlight">
    <face-badge role="starlight" size="lg"></face-badge>
    <view class="ds-copy">
      <text class="ds-num">{{dimensions.length}}</text>
      <text class="ds-sub">档案累计 · 版本 {{versions.length}}</text>
      <text class="ds-sub">{{persona && persona.enabled ? '已启用记忆档案' : '尚未启用，或还没有可展示的材料'}}</text>
    </view>
  </view>

  <text wx:if="{{error}}" class="error-text">{{error}}</text>

  <view class="l2-card">
    <text class="l2-card-title">已确认的内容</text>
    <text class="l2-card-sub">只保留你确认过的事</text>
    <block wx:if="{{loading}}">
      <text class="loading-text">正在读取记忆档案…</text>
    </block>
    <block wx:elif="{{dimensions.length}}">
      <view wx:for="{{dimensions}}" wx:key="key" class="dim-row">
        <view class="dim-head">
          <text class="dim-name">{{item.key}}</text>
          <text class="dim-meta">已采纳 {{item.adopted_sources.length}} 条来源</text>
        </view>
        <view class="progress-track"><view class="progress-fill" style="width: {{item.adopted_sources.length}}%"></view></view>
        <text class="row-meta">状态：{{item.status}} · {{item.version_readiness.status}}</text>
      </view>
    </block>
    <block wx:else>
      <view class="empty-block">
        <text class="empty-title">还没有可展示的内容</text>
        <text class="empty-copy">确认记住的事后，会显示在这里。</text>
      </view>
    </block>
  </view>

  <view class="l2-card">
    <view class="fold-head" bindtap="toggleEngineering">
      <text class="fold-title">技术状态与版本</text>
      <view class="inline-icon fold-chevron {{showEngineering ? 'fold-chevron-open' : ''}}"><svg viewBox="0 0 16 16" fill="none"><path d="M3 6l5 5 5-5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg></view>
    </view>
    <text class="fold-summary">{{showEngineering ? '收起技术状态' : '查看技术状态'}}</text>
    <block wx:if="{{showEngineering}}">
      <view class="summary-row"><text class="summary-key">存储位置</text><text class="summary-value">云端</text></view>
      <view class="summary-row"><text class="summary-key">加密</text><text class="summary-value">已开启</text></view>
      <view class="summary-row"><text class="summary-key">档案版本</text><text class="summary-value">{{versions.length ? versions[0].version_number : '—'}}</text></view>
      <block wx:if="{{versions.length}}">
        <view wx:for="{{versions}}" wx:key="version_id" class="summary-row">
          <text class="summary-key">版本 {{item.version_number || '—'}}</text>
          <text class="summary-value">{{item.status}} · {{item.manifest_sha256 ? '已绑定资料摘要' : '资料待整理'}}</text>
        </view>
      </block>
      <text wx:else class="caption">尚未构建数字分身版本。</text>
      <text class="caption">复杂的版本构建、评测、冻结、传承授权和密码确认仍由服务端高风险流程收口；小程序不会绕过这些保护。</text>
    </block>
  </view>
</view>
