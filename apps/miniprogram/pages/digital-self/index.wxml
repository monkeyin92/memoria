<view class="page-shell sub-page" style="{{statusBarStyle}}">
  <view class="nav-back" bindtap="goBack" aria-label="返回"><image class="nav-back-icon" src="/assets/ui/v4/back-strong.svg" /></view>
  <text class="eyebrow">只保留你确认过的事</text>
  <text class="page-title">记忆档案</text>
  <text class="page-lede">被记住的，都是被允许的。</text>

  <view class="card card-xl ds-hero">
    <view class="ds-copy">
      <text class="ds-num">{{view.sourceTotal}}</text>
      <text class="ds-unit">条已确认的来源</text>
      <text class="ds-sub">{{view.supportedCount}} / {{view.dimensionTotal}} 个方面已有依据</text>
    </view>
    <text class="pill {{view.enabled ? 'pill-online' : 'pill-neutral'}}">{{view.enabled ? '已启用' : '尚未启用'}}</text>
  </view>

  <text wx:if="{{error}}" class="error-text">{{error}}</text>

  <text class="group-label">各个方面</text>
  <view class="list">
    <block wx:if="{{loading}}">
      <view class="list-row"><text class="loading-text">正在读取记忆档案…</text></view>
    </block>
    <block wx:elif="{{view.dimensionRows.length}}">
      <view wx:for="{{view.dimensionRows}}" wx:key="key" class="list-row">
        <view class="row-copy">
          <text class="row-title">{{item.label}}</text>
          <text class="row-meta {{item.pending ? 'ds-pending' : ''}}">{{item.statusLabel}}{{item.readinessLabel ? ' · ' + item.readinessLabel : ''}}</text>
        </view>
        <text class="ds-count">{{item.sourceCount}} 条</text>
      </view>
    </block>
    <block wx:else>
      <view class="empty-block">
        <text class="empty-title">还没有可展示的内容</text>
        <text class="empty-copy">确认记住的事后，会显示在这里。</text>
      </view>
    </block>
  </view>

  <view class="list">
    <view class="list-row" bindtap="toggleEngineering">
      <view class="row-copy">
        <text class="row-title">版本记录</text>
        <text class="row-meta">{{showEngineering ? '收起版本记录' : '已生成 ' + view.versionRows.length + ' 个版本'}}</text>
      </view>
      <image class="row-chev row-chev-fold {{showEngineering ? 'row-chev-open' : ''}}" src="/assets/ui/v4/chev-faint.svg" />
    </view>
    <block wx:if="{{showEngineering}}">
      <view wx:for="{{view.versionRows}}" wx:key="versionId" class="list-row">
        <view class="row-copy">
          <text class="row-title">版本 {{item.number || '—'}}</text>
          <text class="row-meta">{{item.statusLabel}} · {{item.manifestLabel}}</text>
        </view>
      </view>
      <view wx:if="{{!view.versionRows.length}}" class="list-row"><text class="row-meta">尚未生成版本。</text></view>
    </block>
  </view>
  <text wx:if="{{showEngineering}}" class="caption">版本构建、评测、冻结、传承授权和密码确认都走服务端的高风险流程，小程序不会绕过这些保护。</text>
</view>
