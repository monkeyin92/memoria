.section-title,
.status-value,
.status-detail,
.dimension-name,
.dimension-detail,
.version-name,
.version-detail {
  display: block;
}

.section-title {
  color: #e6ecff;
  font-size: 31rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

/* ——— Persona 状态卡 ——— */
.persona-card {
  position: relative;
  overflow: hidden;
}

.persona-glow {
  position: absolute;
  top: -120rpx;
  right: -120rpx;
  width: 320rpx;
  height: 320rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(34, 229, 255, 0.16) 0%, rgba(34, 229, 255, 0) 68%);
}

.persona-status-row {
  display: flex;
  align-items: center;
  margin-top: 20rpx;
}

.persona-beacon {
  flex: none;
  width: 20rpx;
  height: 20rpx;
  margin-right: 16rpx;
  border-radius: 50%;
  background: #5d688f;
}

.persona-beacon-on {
  background: linear-gradient(135deg, #22e5ff, #7b5cff);
  box-shadow: 0 0 20rpx rgba(34, 229, 255, 0.75);
}

.status-value {
  color: #7ceaff;
  font-size: 31rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.status-detail {
  margin-top: 12rpx;
  color: #8d99c4;
  font-size: 25rpx;
  line-height: 1.65;
}

/* ——— 成长维度 ——— */
.dimension-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
  border-bottom: 1rpx solid rgba(94, 234, 255, 0.08);
}

.dimension-row:last-child {
  border-bottom: none;
}

.dimension-name {
  color: #c4cfef;
  font-size: 28rpx;
  font-weight: 650;
  letter-spacing: 1rpx;
}

.dimension-detail {
  margin-top: 5rpx;
  color: #6b7699;
  font-size: 23rpx;
}

.dimension-ready {
  flex: none;
  max-width: 200rpx;
  margin-left: 20rpx;
  padding: 8rpx 20rpx;
  border: 1rpx solid rgba(123, 92, 255, 0.35);
  border-radius: 999rpx;
  color: #cdb4ff;
  background: rgba(123, 92, 255, 0.12);
  font-size: 22rpx;
  text-align: center;
}

/* ——— 版本 ——— */
.version-row {
  display: flex;
  align-items: center;
  padding: 22rpx 0;
  border-bottom: 1rpx solid rgba(94, 234, 255, 0.08);
}

.version-row:last-child {
  border-bottom: none;
}

.version-badge {
  display: flex;
  flex: none;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
  border-radius: 24rpx;
  color: #fff;
  background: linear-gradient(135deg, #19b8d8, #7b5cff);
  box-shadow: 0 8rpx 24rpx rgba(123, 92, 255, 0.4);
  font-size: 24rpx;
  font-weight: 700;
}

.version-copy {
  flex: 1;
  margin-left: 20rpx;
}

.version-name {
  color: #c4cfef;
  font-size: 28rpx;
  font-weight: 650;
  letter-spacing: 1rpx;
}

.version-detail {
  margin-top: 5rpx;
  color: #6b7699;
  font-size: 23rpx;
}

/* ——— 边界说明 ——— */
.disclosure-card {
  border-color: rgba(123, 92, 255, 0.28);
  background: linear-gradient(135deg, rgba(123, 92, 255, 0.1), rgba(34, 229, 255, 0.06));
}
