.ds-hero {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
  padding: var(--mp-pad-card-lg);
}

.ds-copy {
  flex: 1;
  min-width: 0;
}

.ds-num {
  display: block;
  color: var(--mp-ink);
  font-size: var(--mp-type-num-xl);
  font-weight: 800;
  letter-spacing: -1.6rpx;
  line-height: 1;
}

.ds-unit {
  display: block;
  margin-top: 16rpx;
  color: var(--mp-ink);
  font-size: var(--mp-type-card);
  font-weight: 600;
}

.ds-sub {
  display: block;
  margin-top: 8rpx;
  color: var(--mp-ink-2);
  font-size: var(--mp-type-caption);
  line-height: var(--mp-lh-caption);
}

.ds-count {
  flex-shrink: 0;
  color: var(--mp-ink-2);
  font-size: var(--mp-type-caption);
  font-variant-numeric: tabular-nums;
}

.ds-pending {
  color: var(--mp-sun);
}
