<view class="page-shell">
  <page-backdrop theme="warm"></page-backdrop>
  <text class="page-title">回顾</text>
  <text class="page-lede">留下一些事，也可以选择不留。</text>

  <view wx:if="{{!authenticated}}">
    <view class="notice">登录后查看你的专属回顾。未登录时不会读取或展示任何对话整理内容。</view>
    <button class="primary-button empty-button" bindtap="loginForReview">微信登录后查看</button>
  </view>

  <block wx:else>
    <view class="seg">
      <view class="seg-item {{memoryTab === 'reviews' ? 'seg-item-on' : ''}}" bindtap="showReviews">日常回顾</view>
      <view class="seg-item {{memoryTab === 'memories' ? 'seg-item-on' : ''}}" bindtap="showMemories">记住的事{{pendingCount ? ' · ' + pendingCount : ''}}</view>
    </view>

    <text wx:if="{{error}}" class="error-text">{{error}}</text>
    <view wx:if="{{loading}}" class="card"><text class="loading-text">正在读取回顾…</text></view>

    <block wx:elif="{{memoryTab === 'reviews'}}">
      <button class="primary-button memory-summarize" loading="{{summarizing}}" bindtap="summarizeSelectedDay">生成 / 更新选中日期的回顾</button>
      <button class="secondary-button memory-share" open-type="share" data-date="{{selectedDate}}">分享选中日期的回顾</button>
      <view wx:if="{{!days.length}}" class="l2-card memory-empty">
        <glass-icon name="memory" size="176"></glass-icon>
        <text class="l2-card-title">还没有可回顾的内容</text>
        <text class="l2-card-sub">这里还空空的，没关系。需要时再来看看，一切由你决定。</text>
        <text class="caption">在设备上说几句后，再回来看看。AI 整理可能有偏差，打开回顾可以查看来源。</text>
        <view class="button-row">
          <button class="secondary-button btn-sm" bindtap="goCompanion">去和伙伴聊聊</button>
        </view>
      </view>
      <view wx:for="{{days}}" wx:key="date" class="memory-day">
        <text class="timeline-time">{{item.date}}</text>
        <view class="timeline-card {{selectedDate === item.date ? 'memory-day-selected' : ''}}" data-date="{{item.date}}" bindtap="chooseDay">
          <view class="timeline-dot"></view>
          <view class="memory-day-copy">
            <text class="pill pill-neutral">AI 整理</text>
            <text class="l2-card-title">{{item.title}}</text>
            <text class="l2-card-sub">{{item.overview}}</text>
            <view class="memory-tags">
              <text wx:for="{{item.highlights}}" wx:for-item="tag" wx:key="*this" class="pill pill-neutral memory-tag">{{tag}}</text>
            </view>
          </view>
        </view>
      </view>
      <view class="notice">AI 整理可能有偏差。未确认的内容不会自动变成长期记忆。</view>
      <view class="fold">
        <text class="fold-summary">实际听到的回复</text>
        <block wx:if="{{heardTurns.length}}">
          <view wx:for="{{heardTurns}}" wx:key="event_id" class="diagnostic">
            <text class="recap-body">{{item.text}}</text>
            <text class="caption">{{item.approximate ? '近似播放记录' : '精确播放记录'}}</text>
          </view>
        </block>
        <text wx:else class="caption">还没有可展示的听到记录。</text>
      </view>

      <view class="section-head conversation-section-head">
        <text class="section-head-title">最近对话</text>
        <text class="caption">仅显示当前主体可见内容</text>
      </view>
      <view wx:if="{{conversationSessions.length}}" class="conversation-list">
        <view
          wx:for="{{conversationSessions}}"
          wx:key="session_id"
          class="l2-card conversation-card {{selectedConversationSessionId === item.session_id ? 'conversation-card-selected' : ''}}"
          data-session-id="{{item.session_id}}"
          bindtap="openConversation"
        >
          <view class="conversation-card-head">
            <text class="l2-card-title">{{item.occurred_label}}</text>
            <text class="pill pill-neutral">{{item.turn_count}} 轮</text>
          </view>
          <text wx:if="{{item.preview}}" class="l2-card-sub">{{item.preview}}</text>
          <text class="section-link">查看对话详情 ›</text>
        </view>
      </view>
      <view wx:elif="{{conversationSessionsUnavailable}}" class="notice">最近对话暂时无法加载，请稍后重试。</view>
      <view wx:elif="{{!loading}}" class="notice">还没有可展示的对话记录。</view>
      <view wx:if="{{conversationLoading}}" class="card"><text class="loading-text">正在读取对话详情…</text></view>
      <view wx:if="{{selectedConversationSessionId && !conversationLoading}}" class="conversation-detail">
        <view wx:for="{{conversationTurns}}" wx:key="turn_id" class="conversation-turn">
          <text wx:if="{{item.owner_text}}" class="conversation-speaker">你</text>
          <text wx:if="{{item.owner_text}}" class="conversation-text">{{item.owner_text}}</text>
          <text wx:if="{{item.assistant_text}}" class="conversation-speaker assistant-speaker">Memoria</text>
          <text wx:if="{{item.assistant_text}}" class="conversation-text assistant-text">{{item.assistant_text}}</text>
          <text wx:if="{{item.assistant_text}}" class="caption">{{item.assistant_approximate === false ? '精确播放记录' : '近似播放记录'}}</text>
        </view>
        <text wx:if="{{!conversationTurns.length}}" class="caption">这段对话没有可展示的合格内容。</text>
      </view>
    </block>

    <block wx:else>
      <view class="memory-chips">
        <view class="pill {{memoryFilter === 'all' ? 'pill-teal' : 'pill-neutral'}}" data-filter="all" bindtap="setMemoryFilter">全部</view>
        <view class="pill {{memoryFilter === 'pending' ? 'pill-teal' : 'pill-neutral'}}" data-filter="pending" bindtap="setMemoryFilter">待你确认的记忆 {{pendingCount}}</view>
        <view class="pill {{memoryFilter === 'confirmed' ? 'pill-teal' : 'pill-neutral'}}" data-filter="confirmed" bindtap="setMemoryFilter">已确认的记忆</view>
      </view>

      <block wx:if="{{visibleMemories.length}}">
        <view wx:for="{{visibleMemories}}" wx:key="id" class="l2-card">
          <text class="pill {{item.pending ? 'pill-amber' : 'pill-teal'}}">{{item.pending ? '待你确认' : '你已确认'}}</text>
          <text class="l2-card-title">{{item.title}}</text>
          <text class="l2-card-sub">{{item.body}}</text>
          <view wx:if="{{item.pending}}" class="button-row">
            <button class="secondary-button btn-sm" data-claim-id="{{item.id}}" disabled="{{reviewingClaimId}}" bindtap="confirmCandidate">确认记住</button>
          </view>
        </view>
      </block>
      <view wx:else class="l2-card memory-empty">
        <glass-icon name="memory" size="176"></glass-icon>
        <text class="l2-card-title">{{memoryFilter === 'pending' ? '待确认内容已处理完' : '这里还没有内容'}}</text>
        <text class="l2-card-sub">这里还空空的，没关系。需要时再来看看，一切由你决定。</text>
        <view class="button-row">
          <button class="secondary-button btn-sm" bindtap="openArchive">查看我的记忆档案</button>
        </view>
      </view>
      <view class="l2-card list-row memory-archive-row" bindtap="openArchive">
        <view class="row-icon"><glass-icon name="memory" size="72"></glass-icon></view>
        <view class="row-copy">
          <text class="row-title">查看我的记忆档案</text>
          <text class="row-meta">已确认的偏好、来源与版本</text>
        </view>
        <text class="row-chevron">›</text>
      </view>
    </block>
  </block>
</view>
