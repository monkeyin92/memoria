<view class="page-shell">
  <text class="page-title">回顾</text>
  <text class="page-lede">留下一些事，也可以选择不留。</text>

  <view wx:if="{{!authenticated}}">
    <view class="notice">登录后查看你的专属回顾。未登录时不会读取或展示任何对话整理内容。</view>
    <button class="primary-button empty-button" bindtap="loginForReview">微信登录后查看</button>
  </view>

  <block wx:else>
    <view class="segments">
      <view class="segment {{memoryTab === 'reviews' ? 'segment-on' : ''}}" bindtap="showReviews">日常回顾</view>
      <view class="segment {{memoryTab === 'memories' ? 'segment-on' : ''}}" bindtap="showMemories">记住的事{{pendingCount ? ' · ' + pendingCount : ''}}</view>
    </view>

    <text wx:if="{{error}}" class="error-text">{{error}}</text>
    <view wx:if="{{loading}}" class="card"><text class="loading-text">正在读取回顾…</text></view>

    <block wx:elif="{{memoryTab === 'reviews'}}">
      <button class="primary-button" loading="{{summarizing}}" bindtap="summarizeSelectedDay">生成 / 更新选中日期的回顾</button>
      <view wx:if="{{!days.length}}" class="empty-block">
        <text class="empty-title">还没有可回顾的内容</text>
        <text class="empty-copy">在设备上说几句后，再回来看看。AI 整理可能有偏差，打开回顾可以查看来源。</text>
      </view>
      <view wx:for="{{days}}" wx:key="date" class="timeline-item">
        <text class="timeline-time">{{item.date}}</text>
        <view class="card {{selectedDate === item.date ? 'day-selected' : ''}}" data-date="{{item.date}}" bindtap="chooseDay">
          <text class="pill pill-neutral">AI 整理</text>
          <text class="recap-title">{{item.title}}</text>
          <text class="recap-body">{{item.overview}}</text>
          <view class="topic-tags">
            <text wx:for="{{item.highlights}}" wx:for-item="tag" wx:key="*this" class="topic-tag">{{tag}}</text>
          </view>
        </view>
      </view>
      <view class="notice">AI 整理可能有偏差。未确认的内容不会自动变成长期记忆。</view>
      <view class="fold">
        <text class="fold-summary">实际听到的回复</text>
        <block wx:if="{{heardTurns.length}}">
          <view wx:for="{{heardTurns}}" wx:key="event_id" class="diagnostic">
            <text class="recap-body">{{item.text}}</text>
            <text class="caption">{{item.approximate ? '近似播放记录' : '精确播放记录'}}</text>
          </view>
        </block>
        <text wx:else class="caption">还没有可展示的听到记录。</text>
      </view>
    </block>

    <block wx:else>
      <view class="filter-bar">
        <view class="filter-chip {{memoryFilter === 'all' ? 'filter-on' : ''}}" data-filter="all" bindtap="setMemoryFilter">全部</view>
        <view class="filter-chip {{memoryFilter === 'pending' ? 'filter-on' : ''}}" data-filter="pending" bindtap="setMemoryFilter">待你确认的记忆 {{pendingCount}}</view>
        <view class="filter-chip {{memoryFilter === 'confirmed' ? 'filter-on' : ''}}" data-filter="confirmed" bindtap="setMemoryFilter">已确认的记忆</view>
      </view>

      <block wx:if="{{visibleMemories.length}}">
        <view wx:for="{{visibleMemories}}" wx:key="id" class="card memory-card">
          <text class="pill {{item.pending ? 'pill-amber' : ''}}">{{item.pending ? '待你确认' : '你已确认'}}</text>
          <text class="recap-title">{{item.title}}</text>
          <text class="recap-body">{{item.body}}</text>
          <view wx:if="{{item.pending}}" class="button-row">
            <button class="secondary-button" data-claim-id="{{item.id}}" disabled="{{reviewingClaimId}}" bindtap="confirmCandidate">确认记住</button>
          </view>
        </view>
      </block>
      <view wx:else class="empty-block">
        <text class="empty-title">{{memoryFilter === 'pending' ? '待确认内容已处理完' : '这里还没有内容'}}</text>
        <text class="empty-copy">需要时再来看看，一切由你决定。</text>
      </view>
      <view class="list-row" bindtap="openArchive">
        <view class="row-copy">
          <text class="row-title">查看我的记忆档案</text>
          <text class="row-meta">已确认的偏好、来源与版本</text>
        </view>
        <text class="row-chevron">›</text>
      </view>
    </block>
  </block>
</view>
