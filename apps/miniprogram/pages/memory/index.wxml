<view class="page-shell tab-page" style="{{statusBarStyle}}">
  <text class="eyebrow">按天查看</text>
  <text class="page-title">对话回顾</text>
  <text class="page-lede">{{guardianMode ? '这里只有摘要，不显示原话，也没有录音。' : '想记住的事，点确认后才会留下。'}}</text>

  <view wx:if="{{!authenticated}}" class="memory-guest">
    <view class="notice">登录后打开你的专属回顾。未登录时不会读取或展示任何对话整理内容。</view>
    <button class="primary-button" bindtap="loginForReview">微信登录后打开</button>
  </view>

  <block wx:else>
    <view
      wx:if="{{safetyBanner}}"
      class="trial-banner"
      data-id="{{safetyBanner.notificationId}}"
      bindtap="openAttention"
    >
      <view class="trial-banner-icon"><image src="/assets/ui/v4/heart-rust.svg" /></view>
      <view class="trial-banner-copy">
        <text class="trial-banner-title">{{safetyBanner.message}}</text>
        <text class="trial-banner-meta">{{safetyBanner.timeLabel}}</text>
        <text wx:if="{{safetyBanner.moreLabel}}" class="trial-banner-meta">{{safetyBanner.moreLabel}}</text>
      </view>
      <image class="memory-chev" src="/assets/ui/v4/chev-rust.svg" />
    </view>

    <view wx:if="{{subscriptionPushEnabled && crisisPush.enabled}}" class="card memory-card">
      <view class="card-lead">
        <mp-icon name="bell"></mp-icon>
        <text class="l2-card-title">安全提醒</text>
      </view>
      <text class="l2-card-sub">{{crisisPush.explanation}}</text>
      <button class="secondary-button btn-sm" bindtap="enableCrisisPush">开启安全提醒</button>
    </view>

    <text wx:if="{{error}}" class="error-text">{{error}}</text>
    <view wx:if="{{loading}}" class="card memory-card"><text class="loading-text">正在读取回顾…</text></view>

    <block wx:elif="{{memoryTab === 'reviews'}}">
      <view wx:if="{{guardianError}}" class="notice notice-warn">{{guardianError}}</view>
      <view class="card memory-strip">
        <view
          wx:for="{{dateStrip}}"
          wx:key="date"
          class="memory-strip-day {{selectedDate === item.date ? 'memory-strip-on' : ''}}"
          data-date="{{item.date}}"
          bindtap="chooseDay"
        >
          <text class="memory-strip-week">{{item.weekday}}</text>
          <text class="memory-strip-num">{{item.dayNum}}</text>
        </view>
      </view>
      <view wx:if="{{!days.length}}" class="card memory-card memory-empty">
        <mp-icon name="note" size="112"></mp-icon>
        <text class="l2-card-title">还没有可回顾的内容</text>
        <text class="l2-card-sub">{{guardianMode ? '孩子还没有聊过天，或者还没有开启孩子的长期记忆。' : '这里还空空的，没关系。需要时再来看看，一切由你决定。'}}</text>
        <text class="caption">{{guardianMode ? '孩子和机器人聊几句后，再回来看看。' : '在设备上说几句后，再回来看看。'}}</text>
        <view class="button-row">
          <button class="secondary-button btn-sm" bindtap="goCompanion">看看 AI 角色</button>
        </view>
      </view>
      <view
        wx:for="{{days}}"
        wx:key="date"
        class="card memory-day"
        data-date="{{item.date}}"
        bindtap="chooseDay"
      >
        <view class="memory-day-head">
          <text class="memory-day-label">{{item.dayLabel}}</text>
          <text class="memory-day-meta">{{item.dateLabel}}</text>
        </view>
        <view class="memory-line"><view class="memory-dot"></view><text class="memory-line-text">{{item.overview}}</text></view>
        <view wx:for="{{item.highlights}}" wx:for-item="line" wx:key="*this" class="memory-line">
          <view class="memory-dot"></view><text class="memory-line-text">{{line}}</text>
        </view>
        <text wx:if="{{item.suggestion}}" class="caption">{{item.suggestion}}</text>
      </view>
      <view wx:if="{{days.length}}" class="button-row memory-actions">
        <button class="primary-button btn-sm" loading="{{summarizing}}" bindtap="summarizeSelectedDay">整理选中这一天</button>
        <button class="secondary-button btn-sm" open-type="share" data-date="{{selectedDate}}">分享这一天</button>
      </view>
      <view class="card list-row memory-claims-row" bindtap="showMemories">
        <mp-icon name="star"></mp-icon>
        <view class="row-copy">
          <text class="row-title">记住的事</text>
          <text class="row-meta">{{pendingCount ? pendingCount + ' 条待你确认' : '确认过的事，机器人才会在以后的聊天里提起'}}</text>
        </view>
        <image class="row-chev" src="/assets/ui/v4/chev-faint.svg" />
      </view>
      <text class="caption memory-note">AI 整理可能有偏差。未确认的内容不会自动变成长期记忆。</text>

      <block wx:if="{{!guardianMode}}">
        <text class="section-title">实际听到的回复</text>
        <view class="card memory-card">
          <block wx:if="{{heardTurns.length}}">
            <view wx:for="{{heardTurns}}" wx:key="event_id" class="memory-heard">
              <text class="l2-card-sub">{{item.text}}</text>
              <text class="caption">{{item.approximate ? '近似播放记录' : '精确播放记录'}}</text>
            </view>
          </block>
          <text wx:else class="caption">还没有可展示的听到记录。</text>
        </view>

        <view class="section-head">
          <text class="section-head-title">最近对话</text>
          <text class="caption">仅显示当前主体可见内容</text>
        </view>
        <view wx:if="{{conversationSessions.length}}">
          <view
            wx:for="{{conversationSessions}}"
            wx:key="session_id"
            class="card memory-card conversation-card {{selectedConversationSessionId === item.session_id ? 'conversation-card-selected' : ''}}"
            data-session-id="{{item.session_id}}"
            bindtap="openConversation"
          >
            <view class="conversation-card-head">
              <text class="l2-card-title">{{item.occurred_label}}</text>
              <text class="pill pill-neutral">{{item.turn_count}} 轮</text>
            </view>
            <text wx:if="{{item.preview}}" class="l2-card-sub">{{item.preview}}</text>
            <text class="section-link">打开对话详情</text>
          </view>
        </view>
        <view wx:elif="{{conversationSessionsUnavailable}}" class="notice">最近对话暂时无法加载，请稍后重试。</view>
        <view wx:elif="{{!loading}}" class="notice">还没有可展示的对话记录。</view>
        <view wx:if="{{conversationLoading}}" class="card memory-card"><text class="loading-text">正在读取对话详情…</text></view>
        <view wx:if="{{selectedConversationSessionId && !conversationLoading}}" class="card memory-card">
          <view wx:for="{{conversationTurns}}" wx:key="turn_id" class="conversation-turn">
            <text wx:if="{{item.owner_text}}" class="conversation-speaker">你</text>
            <text wx:if="{{item.owner_text}}" class="conversation-text">{{item.owner_text}}</text>
            <text wx:if="{{item.assistant_text}}" class="conversation-speaker assistant-speaker">Memoria</text>
            <text wx:if="{{item.assistant_text}}" class="conversation-text">{{item.assistant_text}}</text>
            <text wx:if="{{item.assistant_text}}" class="caption">{{item.assistant_approximate === false ? '精确播放记录' : '近似播放记录'}}</text>
          </view>
          <text wx:if="{{!conversationTurns.length}}" class="caption">这段对话没有可展示的合格内容。</text>
        </view>
      </block>
    </block>

    <block wx:else>
      <view class="memory-back" bindtap="showReviews">
        <image class="memory-back-icon" src="/assets/ui/v4/back-strong.svg" />
        <text>日常回顾</text>
      </view>
      <text class="section-title memory-claims-title">记住的事</text>
      <view wx:if="{{guardianMode}}" class="notice">这里是孩子和机器人聊天时可能被记住的事。只有你点了「确认记住」的，机器人才会在以后的聊天里提起；不想让它记的，点「不记这个」。</view>
      <view wx:if="{{guardianMode && guardianError}}" class="notice notice-warn">{{guardianError}}</view>
      <view class="seg memory-filter">
        <view class="seg-item {{memoryFilter === 'all' ? 'seg-item-on' : ''}}" data-filter="all" bindtap="setMemoryFilter">全部</view>
        <view class="seg-item {{memoryFilter === 'pending' ? 'seg-item-on' : ''}}" data-filter="pending" bindtap="setMemoryFilter">待你确认的记忆 {{pendingCount}}</view>
        <view class="seg-item {{memoryFilter === 'confirmed' ? 'seg-item-on' : ''}}" data-filter="confirmed" bindtap="setMemoryFilter">已确认的记忆</view>
      </view>

      <block wx:if="{{visibleMemories.length}}">
        <view wx:for="{{visibleMemories}}" wx:key="id" class="card memory-card">
          <text class="pill {{item.pending ? 'pill-draft' : 'pill-neutral'}}">{{item.pending ? '待你确认' : '你已确认'}}</text>
          <text class="l2-card-title">{{item.title}}</text>
          <text class="l2-card-sub">{{item.body}}</text>
          <view wx:if="{{item.pending}}" class="button-row">
            <button class="secondary-button btn-sm" data-claim-id="{{item.id}}" disabled="{{reviewingClaimId}}" bindtap="confirmCandidate">确认记住</button>
            <button wx:if="{{guardianMode}}" class="secondary-button btn-sm" data-claim-id="{{item.id}}" data-pending="{{true}}" disabled="{{reviewingClaimId}}" bindtap="retractMemory">不记这个</button>
          </view>
          <view wx:elif="{{guardianMode}}" class="button-row">
            <button class="secondary-button btn-sm" data-claim-id="{{item.id}}" data-pending="{{false}}" disabled="{{reviewingClaimId}}" bindtap="retractMemory">忘掉这条</button>
          </view>
        </view>
      </block>
      <view wx:else class="card memory-card memory-empty">
        <mp-icon name="note" size="112"></mp-icon>
        <text class="l2-card-title">{{memoryFilter === 'pending' ? '待确认内容已处理完' : '这里还没有内容'}}</text>
        <text class="l2-card-sub">{{guardianMode ? '孩子让机器人记住的事、聊到的学习进度，会先出现在这里等你确认。' : '这里还空空的，没关系。需要时再来看看，一切由你决定。'}}</text>
      </view>
      <view class="card list-row memory-archive-row" bindtap="openArchive">
        <mp-icon name="note"></mp-icon>
        <view class="row-copy">
          <text class="row-title">打开我的记忆档案</text>
          <text class="row-meta">已确认的偏好、来源与版本</text>
        </view>
        <image class="row-chev" src="/assets/ui/v4/chev-faint.svg" />
      </view>
    </block>
  </block>
</view>
