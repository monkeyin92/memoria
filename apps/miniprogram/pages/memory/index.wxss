/* ——— 顶部操作卡 ——— */
.summary-action {
  padding: 28rpx 32rpx 32rpx;
}

.summary-date-chip {
  display: inline-flex;
  align-items: center;
  margin-bottom: 22rpx;
  padding: 12rpx 26rpx;
  border: 1rpx solid rgba(94, 234, 255, 0.3);
  border-radius: 999rpx;
  background: rgba(34, 229, 255, 0.08);
}

.summary-date-star {
  margin-right: 10rpx;
  color: #7ceaff;
  font-size: 24rpx;
  text-shadow: 0 0 12rpx rgba(34, 229, 255, 0.7);
}

.summary-action-label {
  color: #9db4e8;
  font-size: 26rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}

.summary-button {
  margin-top: 4rpx;
}

/* ——— 时间线 ——— */
.timeline {
  margin-top: 8rpx;
}

.timeline-item {
  display: flex;
  align-items: stretch;
}

.timeline-rail {
  display: flex;
  width: 44rpx;
  flex-direction: column;
  align-items: center;
  padding-top: 52rpx;
}

.timeline-dot {
  flex: none;
  width: 16rpx;
  height: 16rpx;
  border: 4rpx solid rgba(94, 234, 255, 0.3);
  border-radius: 50%;
  background: #0b1026;
}

.timeline-dot-active {
  border-color: rgba(94, 234, 255, 0.8);
  background: linear-gradient(135deg, #22e5ff, #7b5cff);
  box-shadow: 0 0 18rpx rgba(34, 229, 255, 0.7);
}

.timeline-line {
  width: 2rpx;
  flex: 1;
  margin-top: 8rpx;
  background: linear-gradient(180deg, rgba(94, 234, 255, 0.32), rgba(94, 234, 255, 0.04));
}

.timeline-item:last-child .timeline-line {
  display: none;
}

.day-card {
  flex: 1;
  transition: transform 0.2s ease;
}

.day-selected {
  border-color: rgba(94, 234, 255, 0.55);
  background: rgba(20, 30, 66, 0.85);
  box-shadow:
    0 18rpx 52rpx rgba(0, 0, 0, 0.42),
    0 0 32rpx rgba(34, 229, 255, 0.14);
}

.day-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.day-date {
  color: #7ceaff;
  font-size: 26rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.message-count {
  padding: 6rpx 18rpx;
  border: 1rpx solid rgba(123, 92, 255, 0.35);
  border-radius: 999rpx;
  color: #cdb4ff;
  background: rgba(123, 92, 255, 0.12);
  font-size: 21rpx;
  letter-spacing: 1rpx;
}

.day-title,
.day-overview,
.day-suggestion {
  display: block;
}

.day-title {
  margin-top: 16rpx;
  color: #f2f5ff;
  font-size: 32rpx;
  font-weight: 800;
  letter-spacing: 1rpx;
}

.day-overview {
  margin-top: 12rpx;
  color: #9aa6cf;
  font-size: 27rpx;
  line-height: 1.65;
}

.highlight-list {
  margin-top: 16rpx;
}

.highlight {
  display: block;
  margin-top: 8rpx;
  color: #8fb8e8;
  font-size: 25rpx;
  line-height: 1.6;
}

.day-suggestion {
  margin-top: 18rpx;
  padding: 16rpx 22rpx;
  border: 1rpx solid rgba(255, 77, 219, 0.22);
  border-radius: 20rpx;
  color: #f0a6e0;
  background: linear-gradient(120deg, rgba(255, 77, 219, 0.1), rgba(123, 92, 255, 0.1));
  font-size: 25rpx;
  line-height: 1.6;
}
