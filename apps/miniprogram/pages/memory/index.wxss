.memory-guest .primary-button {
  margin-top: 16px;
}

.memory-card {
  margin-top: var(--mp-gap-card);
}

.memory-strip {
  display: flex;
  justify-content: space-between;
  margin-top: 24px;
  padding: 8px;
}

.memory-strip-day {
  width: 48px;
  padding: 8px 0;
  border-radius: var(--mp-radius-inset);
  color: var(--mp-ink-2);
  text-align: center;
}

.memory-strip-on {
  background: var(--mp-accent);
  color: var(--mp-on-accent);
}

.memory-strip-week {
  display: block;
  font-size: var(--mp-type-micro);
  font-weight: 500;
  opacity: 0.85;
}

.memory-strip-num {
  display: block;
  margin-top: 4px;
  font-size: var(--mp-type-lead);
  font-weight: 700;
  font-variant-numeric: tabular-nums;
}

.memory-day {
  margin-top: var(--mp-gap-card);
  padding: 16px 24px;
}

.memory-day-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 8px;
}

.memory-day-label {
  flex-shrink: 0;
  color: var(--mp-ink);
  font-size: var(--mp-type-button);
  font-weight: 700;
}

.memory-day-meta {
  min-width: 0;
  overflow: hidden;
  color: var(--mp-ink-3);
  font-size: var(--mp-type-meta);
  white-space: nowrap;
  text-overflow: ellipsis;
}

.memory-line {
  display: flex;
  align-items: flex-start;
  gap: 8px;
  margin-top: 8px;
}

.memory-dot {
  flex-shrink: 0;
  width: 4px;
  height: 4px;
  margin-top: 10px;
  border-radius: 50%;
  background: var(--mp-accent);
}

.memory-line-text {
  flex: 1;
  min-width: 0;
  color: var(--mp-ink-body);
  font-size: var(--mp-type-body);
  line-height: var(--mp-lh-body);
}

.memory-actions {
  margin-top: 24px;
}

.memory-note {
  text-align: center;
}

.memory-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.memory-empty .l2-card-title {
  margin-top: 12px;
}

.memory-empty .button-row {
  align-self: stretch;
  justify-content: center;
}

.attention-card {
  padding: 24px 24px 16px;
  text-align: center;
}

.attention-mascot {
  display: flex;
  justify-content: center;
  width: 80px;
  height: 80px;
  margin: 0 auto;
  overflow: hidden;
  border-radius: 50%;
  background: var(--mp-rust-bg);
}

.attention-mascot-img {
  width: 96px;
  margin-top: 8px;
  mix-blend-mode: multiply;
}

.attention-title {
  display: block;
  margin-top: 16px;
  color: var(--mp-ink);
  font-size: var(--mp-type-title);
  font-weight: 700;
  letter-spacing: -0.4px;
  line-height: 28px;
}

.attention-time {
  display: block;
  margin-top: 4px;
  color: var(--mp-ink-2);
  font-size: var(--mp-type-body);
  line-height: var(--mp-lh-body);
}

.attention-well {
  display: block;
  margin-top: 16px;
  padding: 16px;
  border-radius: var(--mp-radius-inset);
  background: var(--mp-rust-bg);
  color: var(--mp-rust);
  font-size: var(--mp-type-caption);
  line-height: var(--mp-lh-body);
  text-align: left;
}

.attention-card + .section-title {
  margin: 16px 0 8px;
}

.attention-tips {
  padding: 0;
}

.attention-tip {
  display: flex;
  align-items: flex-start;
  gap: 16px;
  padding: 16px;
}

.attention-tip + .attention-tip {
  box-shadow: inset 0 0.5px 0 var(--mp-line);
}

.attention-tip-num {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 24px;
  height: 24px;
  border-radius: 50%;
  background: var(--mp-fill);
  color: var(--mp-ink-2);
  font-size: var(--mp-type-caption);
  font-weight: 700;
}

.attention-tip-copy {
  flex: 1;
  min-width: 0;
}

.attention-tip-title {
  display: block;
  color: var(--mp-ink);
  font-size: var(--mp-type-body);
  font-weight: 600;
  line-height: var(--mp-lh-body);
}

.attention-tip-sub {
  display: block;
  margin-top: 4px;
  color: var(--mp-ink-2);
  font-size: var(--mp-type-caption);
  line-height: var(--mp-lh-caption);
}

.memory-heard + .memory-heard {
  margin-top: 12px;
  padding-top: 12px;
  border-top: 0.5px solid var(--mp-line);
}

.conversation-card-selected {
  box-shadow: var(--mp-shadow-selected);
}

.conversation-card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
}

.conversation-turn + .conversation-turn {
  margin-top: 12px;
  padding-top: 12px;
  border-top: 0.5px solid var(--mp-line);
}

.conversation-speaker {
  display: block;
  color: var(--mp-ink-3);
  font-size: var(--mp-type-meta);
  font-weight: 600;
}

.assistant-speaker {
  color: var(--mp-accent);
}

.conversation-text {
  display: block;
  margin-top: 4px;
  color: var(--mp-ink);
  font-size: var(--mp-type-body);
  line-height: var(--mp-lh-body);
}

.memory-filter {
  margin-top: 16px;
}

.memory-claims-row {
  margin-top: var(--mp-gap-card);
  padding: 12px var(--mp-pad-card);
}

.memory-back {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  min-height: 44px;
  margin-top: 16px;
  color: var(--mp-ink);
  font-size: var(--mp-type-body);
  font-weight: 600;
}

.memory-back-icon {
  width: 20px;
  height: 20px;
}

.memory-claims-title {
  display: block;
  margin-top: 8px;
}

.memory-archive-row {
  margin-top: var(--mp-gap-card);
  padding: 12px var(--mp-pad-card);
  border-bottom: none;
}
