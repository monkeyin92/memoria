@import "../../styles/trial-theme.wxss";

.memory-guest .primary-button {
  margin-top: 16px;
}

.memory-card {
  margin-top: var(--mp-gap-card);
}

.memory-day {
  margin-top: var(--mp-gap-card);
  padding: 16px 24px;
}

.memory-day-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 8px;
}

.memory-day-label {
  flex-shrink: 0;
  color: var(--mp-ink);
  font-size: var(--mp-type-button);
  font-weight: 700;
}

.memory-day-meta {
  min-width: 0;
  overflow: hidden;
  color: var(--mp-ink-3);
  font-size: var(--mp-type-meta);
  white-space: nowrap;
  text-overflow: ellipsis;
}

.memory-line {
  display: flex;
  align-items: flex-start;
  gap: 8px;
  margin-top: 8px;
}

.memory-dot {
  flex-shrink: 0;
  width: 4px;
  height: 4px;
  margin-top: 10px;
  border-radius: 50%;
  background: var(--mp-accent);
}

.memory-line-text {
  flex: 1;
  min-width: 0;
  color: var(--mp-ink-body);
  font-size: var(--mp-type-body);
  line-height: var(--mp-lh-body);
}

.memory-note {
  text-align: center;
}

.memory-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.memory-empty .l2-card-title {
  margin-top: 12px;
}

.memory-empty .button-row {
  align-self: stretch;
  justify-content: center;
}

.memory-chev {
  flex-shrink: 0;
  width: 18px;
  height: 18px;
}

.memory-heard + .memory-heard {
  margin-top: 12px;
  padding-top: 12px;
  border-top: 0.5px solid var(--mp-line);
}

.conversation-card-selected {
  box-shadow: var(--mp-shadow-selected);
}

.conversation-card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
}

.conversation-turn + .conversation-turn {
  margin-top: 12px;
  padding-top: 12px;
  border-top: 0.5px solid var(--mp-line);
}

.conversation-speaker {
  display: block;
  color: var(--mp-ink-3);
  font-size: var(--mp-type-meta);
  font-weight: 600;
}

.assistant-speaker {
  color: var(--mp-accent);
}

.conversation-text {
  display: block;
  margin-top: 4px;
  color: var(--mp-ink);
  font-size: var(--mp-type-body);
  line-height: var(--mp-lh-body);
}

.memory-filter {
  margin-top: 16px;
}

.memory-claims-row {
  margin-top: var(--mp-gap-card);
  padding: 12px var(--mp-pad-card);
}

.memory-back {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  min-height: 44px;
  margin-top: 16px;
  color: var(--mp-ink);
  font-size: var(--mp-type-body);
  font-weight: 600;
}

.memory-back-icon {
  width: 20px;
  height: 20px;
}

.memory-claims-title {
  display: block;
  margin-top: 8px;
}

.memory-archive-row {
  margin-top: var(--mp-gap-card);
  padding: 12px var(--mp-pad-card);
  border-bottom: none;
}
