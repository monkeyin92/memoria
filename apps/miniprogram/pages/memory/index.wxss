.memory-summarize {
  margin-top: 28rpx;
}

.memory-share {
  margin-top: 16rpx;
}

.memory-day {
  margin-top: 20rpx;
}

.memory-day-copy {
  flex: 1;
  min-width: 0;
}

.memory-day-selected {
  box-shadow: inset 0 0 0 2rpx #326e70;
}

.memory-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
}

.memory-tag {
  font-size: 22rpx;
}

.memory-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin: 28rpx 0 8rpx;
}

.memory-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.memory-empty .l2-card-title {
  margin-top: 24rpx;
  text-align: center;
}

.memory-empty .l2-card-sub {
  text-align: center;
}

.memory-empty .button-row {
  justify-content: center;
}

.memory-empty .button-row button {
  flex: none;
  min-width: 320rpx;
}

.recap-body {
  display: block;
  color: #474e54;
  color: var(--text-secondary);
  font-size: 26rpx;
  line-height: 1.8;
}

.conversation-section-head {
  margin-top: 36rpx;
}

.conversation-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.conversation-card {
  margin-top: 0;
}

.conversation-card-selected {
  box-shadow: inset 0 0 0 2rpx #326e70;
}

.conversation-card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.conversation-detail {
  margin-top: 18rpx;
  padding: 24rpx;
  border-radius: 32rpx;
  background: rgba(255, 255, 255, 0.6);
  border: 1rpx solid rgba(255, 255, 255, 0.8);
}

.conversation-turn {
  padding: 18rpx 0;
  border-bottom: 1rpx solid rgba(30, 45, 70, 0.08);
}

.conversation-turn:last-child {
  border-bottom: 0;
}

.conversation-speaker {
  display: block;
  color: #285c5e;
  color: var(--brand-teal);
  font-size: 22rpx;
  font-weight: 600;
}

.assistant-speaker {
  margin-top: 18rpx;
  color: #74572a;
}

.conversation-text {
  display: block;
  margin-top: 6rpx;
  color: #1d2b36;
  font-size: 26rpx;
  line-height: 1.7;
}

.assistant-text {
  color: #3d4d58;
}

.memory-archive-row {
  padding: 24rpx 28rpx;
}

