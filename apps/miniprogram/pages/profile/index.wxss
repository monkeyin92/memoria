.account {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-bottom: 8rpx;
}

.account-copy {
  flex: 1;
  min-width: 0;
}

.account-lede {
  margin: 4rpx 0 0;
}

.user-avatar,
.hero-initial {
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.user-avatar {
  border-radius: 50%;
}

.hero-initial {
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(160deg, #e6eef8 0%, #c9d8ea 100%);
  box-shadow: 0 12rpx 28rpx rgba(34, 52, 84, 0.14), inset 0 2rpx 0 #ffffff;
}

.hero-initial-text {
  color: #22344d;
  font-size: 40rpx;
  font-weight: 600;
}

.binding-choices {
  padding-bottom: 20rpx;
}

/* 永久注销：居中弹窗复用全局 .modal-wrap / .modal-card，只补输入框间距 */
.modal-card .field-input {
  margin-top: 24rpx;
}

.foot-link {
  display: block;
  text-align: center;
}

.enrollment-progress {
  margin-top: 16rpx;
  padding: 24rpx 26rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.55);
  border: 1rpx solid rgba(255, 255, 255, 0.8);
}

.enrollment-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
}

.enrollment-stage {
  min-width: 0;
  color: #16191c;
  color: var(--text-primary);
  font-size: 26rpx;
  font-weight: 500;
  line-height: 1.6;
}

.enrollment-percent {
  flex-shrink: 0;
  color: #285c5e;
  color: var(--brand-teal);
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1.6;
}

.enrollment-bar {
  height: 8rpx;
  margin-top: 14rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: rgba(30, 45, 70, 0.08);
}

.enrollment-bar-fill {
  height: 100%;
  border-radius: 999rpx;
  background: #326e70;
  transition: width 240ms ease;
}

.enrollment-hint {
  display: block;
  margin-top: 14rpx;
  color: #474e54;
  color: var(--text-secondary);
  font-size: 24rpx;
  line-height: 1.65;
}
