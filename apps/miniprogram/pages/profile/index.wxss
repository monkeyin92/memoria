.account {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-bottom: 8rpx;
}

.account-lede {
  margin: 4rpx 0 0;
}

.user-avatar,
.hero-initial {
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.user-avatar {
  border-radius: 50%;
}

.hero-initial {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #e8edf2;
}

.hero-initial-text {
  font-size: 40rpx;
  font-weight: 600;
}

.binding-choices {
  padding-bottom: 20rpx;
}

.modal-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 20;
  display: flex;
  align-items: flex-end;
  background: rgba(25, 47, 65, 0.35);
}

.modal-card {
  width: 100%;
  padding: 40rpx 46rpx 60rpx;
  border-radius: 36rpx 36rpx 0 0;
  background: #fff;
}

.enrollment-progress {
  margin-top: 16rpx;
  padding: 24rpx 26rpx;
  border-radius: 28rpx;
  background: #eaf0f3;
}

.enrollment-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
}

.enrollment-stage {
  min-width: 0;
  color: #192f41;
  font-size: 26rpx;
  font-weight: 500;
  line-height: 1.6;
}

.enrollment-percent {
  flex-shrink: 0;
  color: #326e70;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1.6;
}

.enrollment-bar {
  height: 8rpx;
  margin-top: 14rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: #dfe6ea;
}

.enrollment-bar-fill {
  height: 100%;
  border-radius: 999rpx;
  background: #326e70;
  transition: width 240ms ease;
}

.enrollment-hint {
  display: block;
  margin-top: 14rpx;
  color: #596a78;
  font-size: 24rpx;
  line-height: 1.65;
}
