/* ——— 资料 Hero ——— */
.profile-hero {
  position: relative;
  display: flex;
  align-items: center;
  margin-top: 24rpx;
  padding: 32rpx;
  overflow: hidden;
  border: 1rpx solid rgba(94, 234, 255, 0.22);
  border-radius: 40rpx;
  background: linear-gradient(135deg, rgba(20, 30, 66, 0.9) 0%, rgba(36, 24, 70, 0.88) 100%);
  box-shadow:
    0 20rpx 52rpx rgba(0, 0, 0, 0.42),
    0 0 40rpx rgba(34, 229, 255, 0.1);
}

.guest-profile {
  padding: 52rpx 36rpx;
  text-align: center;
}

.guest-profile-badge,
.guest-profile-title,
.guest-profile-copy {
  display: block;
}

.guest-profile-badge {
  color: #7ceaff;
  font-size: 23rpx;
  letter-spacing: 4rpx;
}

.guest-profile-title {
  margin-top: 20rpx;
  color: #f2f5ff;
  font-size: 36rpx;
  font-weight: 760;
}

.guest-profile-copy {
  margin-top: 18rpx;
  color: #8d99c4;
  font-size: 26rpx;
  line-height: 1.7;
}

.guest-profile-button {
  margin-top: 32rpx;
}

.hero-glow {
  position: absolute;
  top: -140rpx;
  right: -100rpx;
  width: 340rpx;
  height: 340rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(255, 77, 219, 0.18) 0%, rgba(255, 77, 219, 0) 68%);
}

.hero-avatar-ring {
  display: flex;
  flex: none;
  align-items: center;
  justify-content: center;
  width: 156rpx;
  height: 156rpx;
  border: 2rpx solid rgba(94, 234, 255, 0.5);
  border-radius: 50%;
  background: radial-gradient(circle at 34% 30%, rgba(34, 229, 255, 0.16), rgba(16, 23, 52, 0.9));
  box-shadow:
    0 0 32rpx rgba(34, 229, 255, 0.3),
    inset 0 0 24rpx rgba(34, 229, 255, 0.14);
}

.profile-mascot-shell {
  position: relative;
  width: 128rpx;
  height: 128rpx;
}

.hero-avatar {
  width: 100%;
  height: 100%;
}

.user-avatar {
  width: 144rpx;
  height: 144rpx;
  border-radius: 50%;
}

.profile-face {
  position: absolute;
  pointer-events: none;
}

.profile-face-eye {
  position: absolute;
  top: 24.3%;
  width: 18.33%;
  height: 41.43%;
  overflow: hidden;
  border-radius: 50%;
  background: var(--profile-face-ink);
  animation: profile-mascot-blink 5.6s ease-in-out infinite;
}

.profile-face-eye-l {
  left: 20.84%;
}

.profile-face-eye-r {
  left: 60.83%;
}

.profile-face-iris {
  position: absolute;
  left: 6.8%;
  top: 3.5%;
  width: 86.4%;
  height: 89.7%;
  border-radius: 50%;
  background: linear-gradient(180deg, var(--profile-eye-top) 0%, var(--profile-eye-top) 52%, var(--profile-eye-bottom) 100%);
}

.profile-face-shine {
  position: absolute;
  left: 22.7%;
  top: 22.4%;
  width: 22.7%;
  height: 17.2%;
  border-radius: 50%;
  background: #fffaf0;
  box-shadow: 0 12rpx 10rpx var(--profile-eye-glow);
}

.profile-face-mouth {
  position: absolute;
  left: 45%;
  top: 72.5%;
  width: 10%;
  height: 7%;
  box-sizing: border-box;
  border-bottom: 4rpx solid var(--profile-face-ink);
  border-radius: 0 0 999rpx 999rpx;
}

@keyframes profile-mascot-blink {
  0%, 44%, 48%, 100% { transform: scaleY(1); }
  46% { transform: scaleY(0.08); }
}

.hero-copy {
  flex: 1;
  margin-left: 26rpx;
}

.hero-name,
.hero-account {
  display: block;
}

.hero-name {
  color: #f2f5ff;
  font-size: 40rpx;
  font-weight: 800;
  letter-spacing: 1rpx;
}

.hero-account {
  margin-top: 12rpx;
  color: #6b7699;
  font-size: 21rpx;
  letter-spacing: 1rpx;
}

/* ——— 陪伴统计 ——— */
.stats-grid {
  display: flex;
  gap: 18rpx;
  margin-top: 24rpx;
}

.stat-cell {
  flex: 1;
  padding: 24rpx 12rpx;
  border: 1rpx solid rgba(94, 234, 255, 0.14);
  border-radius: 28rpx;
  background: rgba(16, 23, 52, 0.72);
  box-shadow: 0 12rpx 32rpx rgba(0, 0, 0, 0.3);
  text-align: center;
}

.stat-value {
  display: block;
  background: linear-gradient(120deg, #22e5ff, #a06bff);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
  font-size: 44rpx;
  font-weight: 800;
}

.stat-label {
  display: block;
  margin-top: 6rpx;
  color: #8d99c4;
  font-size: 22rpx;
  letter-spacing: 2rpx;
}

/* ——— 表单 ——— */
.field-label {
  display: block;
  margin: 20rpx 0 12rpx;
  color: #9db4e8;
  font-size: 26rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}

.field-input {
  height: 88rpx;
  box-sizing: border-box;
  padding: 0 26rpx;
  border: 1rpx solid rgba(94, 234, 255, 0.22);
  border-radius: 999rpx;
  color: #f2f5ff;
  background: rgba(255, 255, 255, 0.05);
  font-size: 29rpx;
}

.field-placeholder {
  color: #5d688f;
}

.save-button {
  margin-top: 28rpx;
}

.settings-title,
.setting-name,
.setting-desc {
  display: block;
}

.settings-title {
  color: #e6ecff;
  font-size: 31rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

/* ——— 伙伴选择 ——— */
.companion-row {
  display: flex;
  align-items: center;
  min-height: 128rpx;
  margin-top: 16rpx;
  padding: 12rpx 18rpx;
  border: 1rpx solid transparent;
  border-radius: 26rpx;
  transition: border-color 0.2s ease, background 0.2s ease;
}

.companion-selected {
  border-color: rgba(94, 234, 255, 0.55);
  background: linear-gradient(120deg, rgba(34, 229, 255, 0.1), rgba(123, 92, 255, 0.12));
  box-shadow: 0 0 28rpx rgba(34, 229, 255, 0.14);
}

.companion-mascot-shell {
  position: relative;
  flex: none;
  width: 96rpx;
  height: 96rpx;
}

.companion-image {
  width: 100%;
  height: 100%;
}

.companion-face {
  position: absolute;
  pointer-events: none;
}

.companion-face-eye {
  position: absolute;
  top: 24.3%;
  width: 18.33%;
  height: 41.43%;
  overflow: hidden;
  border-radius: 50%;
  background: var(--companion-face-ink);
  animation: companion-mascot-blink 5.6s ease-in-out infinite;
}

.companion-face-eye-l { left: 20.84%; }
.companion-face-eye-r { left: 60.83%; }

.companion-face-iris {
  position: absolute;
  left: 6.8%;
  top: 3.5%;
  width: 86.4%;
  height: 89.7%;
  border-radius: 50%;
  background: linear-gradient(180deg, var(--companion-eye-top) 0%, var(--companion-eye-top) 52%, var(--companion-eye-bottom) 100%);
}

.companion-face-shine {
  position: absolute;
  left: 22.7%;
  top: 22.4%;
  width: 22.7%;
  height: 17.2%;
  border-radius: 50%;
  background: #fffaf0;
  box-shadow: 0 8rpx 8rpx var(--companion-eye-glow);
}

.companion-face-mouth {
  position: absolute;
  left: 45%;
  top: 72.5%;
  width: 10%;
  height: 7%;
  box-sizing: border-box;
  border-bottom: 3rpx solid var(--companion-face-ink);
  border-radius: 0 0 999rpx 999rpx;
  transition: width 0.2s ease, height 0.2s ease;
}

.companion-face-happy .companion-face-mouth {
  left: 42%;
  top: 70%;
  width: 16%;
  height: 12%;
  border-bottom-width: 4rpx;
}

@keyframes companion-mascot-blink {
  0%, 44%, 48%, 100% { transform: scaleY(1); }
  46% { transform: scaleY(0.08); }
}

.companion-copy {
  flex: 1;
  margin-left: 20rpx;
}

.companion-name,
.companion-tagline {
  display: block;
}

.companion-name {
  color: #e6ecff;
  font-size: 29rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.companion-tagline,
.setting-desc {
  margin-top: 4rpx;
  color: #6b7699;
  font-size: 23rpx;
  line-height: 1.45;
}

.companion-check {
  display: flex;
  flex: none;
  align-items: center;
  justify-content: center;
  width: 40rpx;
  height: 40rpx;
  margin-right: 6rpx;
  border: 2rpx solid rgba(94, 234, 255, 0.3);
  border-radius: 50%;
  color: #fff;
  font-size: 24rpx;
}

.companion-check-on {
  border: none;
  background: linear-gradient(135deg, #19b8d8, #7b5cff);
  box-shadow: 0 0 16rpx rgba(34, 229, 255, 0.55);
}

/* ——— 偏好设置 ——— */
.setting-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
  border-bottom: 1rpx solid rgba(94, 234, 255, 0.08);
}

.setting-row:last-child {
  border-bottom: none;
}

.setting-disabled {
  opacity: 0.55;
}

.setting-name {
  color: #c4cfef;
  font-size: 28rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}

/* ——— 导航卡 ——— */
.nav-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.nav-arrow {
  display: flex;
  flex: none;
  align-items: center;
  justify-content: center;
  width: 56rpx;
  height: 56rpx;
  margin-left: 20rpx;
  border: 1rpx solid rgba(94, 234, 255, 0.3);
  border-radius: 50%;
  background: rgba(34, 229, 255, 0.08);
}

.nav-arrow-icon {
  margin-top: -6rpx;
  color: #7ceaff;
  font-size: 40rpx;
  font-weight: 300;
}

.guardian-entry {
  border-color: rgba(255, 126, 219, 0.24);
  background: linear-gradient(135deg, rgba(255, 77, 219, 0.08), rgba(34, 229, 255, 0.07));
}

.student-notice {
  border-color: rgba(255, 126, 219, 0.3);
  background: linear-gradient(135deg, rgba(123, 92, 255, 0.13), rgba(255, 77, 219, 0.08));
}

.student-notice-badge,
.student-notice-title,
.student-notice-copy {
  display: block;
}

.student-notice-badge {
  color: #f0a6e0;
  font-size: 22rpx;
  letter-spacing: 2rpx;
}

.student-notice-title {
  margin-top: 12rpx;
  color: #f2f5ff;
  font-size: 31rpx;
  font-weight: 750;
  line-height: 1.45;
}

.student-notice-copy {
  margin-top: 12rpx;
  color: #9aa6cf;
  font-size: 25rpx;
  line-height: 1.7;
}

/* ——— 账户与设备 ——— */
.account-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
  border-bottom: 1rpx solid rgba(94, 234, 255, 0.08);
}

.account-row:last-child {
  border-bottom: none;
}

.account-action {
  flex: none;
  margin-left: 20rpx;
  padding: 10rpx 28rpx;
  border: 1rpx solid rgba(94, 234, 255, 0.35);
  border-radius: 999rpx;
  color: #7ceaff;
  background: rgba(34, 229, 255, 0.08);
  font-size: 24rpx;
}

.account-action-danger {
  border-color: rgba(255, 110, 140, 0.42);
  color: #ff8ba3;
  background: rgba(255, 77, 109, 0.1);
}

/* ——— 注销入口 ——— */
.delete-entry {
  margin-top: 36rpx;
  text-align: center;
}

.delete-entry-text {
  color: #ff8ba3;
  font-size: 26rpx;
  letter-spacing: 1rpx;
}

.delete-entry-desc {
  display: block;
  margin-top: 6rpx;
  color: #5d688f;
  font-size: 21rpx;
}

/* ——— 注销弹窗 ——— */
.modal-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 99;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(4, 7, 18, 0.72);
  backdrop-filter: blur(8rpx);
}

.modal-card {
  width: 600rpx;
  box-sizing: border-box;
  padding: 40rpx 36rpx;
  border: 1rpx solid rgba(255, 110, 140, 0.3);
  border-radius: 36rpx;
  background: rgba(16, 23, 52, 0.96);
  box-shadow: 0 24rpx 64rpx rgba(0, 0, 0, 0.5);
}

.modal-title {
  display: block;
  color: #ff8ba3;
  font-size: 34rpx;
  font-weight: 800;
  letter-spacing: 1rpx;
}

.modal-desc {
  display: block;
  margin-top: 14rpx;
  color: #9aa6cf;
  font-size: 25rpx;
  line-height: 1.65;
}

.modal-input {
  margin-top: 22rpx;
}

.modal-actions {
  display: flex;
  gap: 18rpx;
  margin-top: 30rpx;
}

.modal-button {
  flex: 1;
}

.compliance-card .compliance-copy {
  display: block;
  margin-top: 14rpx;
  color: #9aa6cf;
  font-size: 25rpx;
  line-height: 1.65;
}

.delivered-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid rgba(94, 234, 255, 0.08);
}

.delivered-row:last-child {
  border-bottom: none;
}

.delivered-label {
  color: #c7d0ef;
  font-size: 26rpx;
}

.delivered-value {
  color: #7ceaff;
  font-size: 26rpx;
  font-weight: 650;
  text-align: right;
}

.section-empty {
  margin-top: 16rpx;
  color: #8d99c4;
  font-size: 25rpx;
}
