.account-card {
  display: flex;
  align-items: center;
  gap: 16px;
  margin-top: 24px;
}

.account-copy {
  flex: 1;
  min-width: 0;
}

.account-name {
  display: block;
  color: var(--mp-ink);
  font-size: var(--mp-type-title);
  font-weight: 700;
  letter-spacing: -0.3px;
  line-height: 28px;
  word-break: break-all;
}

.account-sub {
  display: block;
  margin-top: 4px;
  color: var(--mp-ink-2);
  font-size: var(--mp-type-small);
  line-height: var(--mp-lh-body);
}

.user-avatar,
.hero-initial {
  flex-shrink: 0;
  width: 64px;
  height: 64px;
}

.user-avatar {
  border-radius: 50%;
}

.hero-initial {
  display: flex;
  border-radius: 50%;
  align-items: center;
  justify-content: center;
  background: var(--mp-accent-soft);
}

.hero-initial-text {
  color: var(--mp-accent);
  font-size: var(--mp-type-headline);
  font-weight: 700;
}

.device-card {
  display: flex;
  align-items: center;
  gap: 16px;
}

.device-art {
  flex-shrink: 0;
  width: 56px;
  height: 56px;
  overflow: hidden;
  border-radius: var(--mp-radius-inset);
  background: var(--mp-accent-soft);
}

.device-art-img {
  display: block;
  width: 72px;
  margin-top: 8px;
  mix-blend-mode: multiply;
}

.device-name {
  display: block;
  color: var(--mp-ink);
  font-size: var(--mp-type-card);
  font-weight: 600;
  line-height: normal;
}

.device-pill {
  margin-top: 8px;
}

.binding-choices .list-row {
  min-height: var(--mp-tap);
}

.resync-button {
  margin-top: var(--mp-gap-card);
}

.list .row-title.row-copy {
  font-size: var(--mp-type-card);
  font-weight: 400;
}

/* WeChat buttons ship a fixed width, padding, radius, fill and bold text; the feedback row must read as a plain row. */
.profile-menu > button.list-row {
  width: calc(100% + 2 * var(--mp-pad-card));
  margin: 0 calc(-1 * var(--mp-pad-card));
  padding: 16px var(--mp-pad-card);
  border-radius: 0;
  background: transparent;
  color: var(--mp-ink);
  font-size: inherit;
  font-weight: 400;
  line-height: inherit;
  text-align: left;
}

.modal-card .field-input {
  margin-top: 12px;
}

.about-line {
  display: block;
  margin-top: 8px;
  color: var(--mp-ink-2);
  font-size: var(--mp-type-body);
  line-height: var(--mp-lh-body);
  text-align: left;
}

.about-dismiss {
  margin-top: 16px;
}

.foot-link {
  display: block;
  margin-top: 24px;
  text-align: center;
}

.profile-version {
  display: block;
  margin-top: 24px;
  color: var(--mp-ink-3);
  font-size: var(--mp-type-meta);
  line-height: 16px;
  text-align: center;
}

.privacy-note + .profile-version {
  margin-top: 8px;
}
