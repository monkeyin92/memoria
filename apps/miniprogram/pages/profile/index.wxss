.account-card {
  display: flex;
  align-items: center;
  gap: 32rpx;
  margin-top: 48rpx;
}

.account-copy {
  flex: 1;
  min-width: 0;
}

.account-name {
  display: block;
  color: var(--mp-ink);
  font-size: var(--mp-type-title);
  font-weight: 700;
  letter-spacing: -0.6rpx;
  line-height: 56rpx;
  word-break: break-all;
}

.account-sub {
  display: block;
  margin-top: 8rpx;
  color: var(--mp-ink-2);
  font-size: var(--mp-type-caption);
  line-height: var(--mp-lh-caption);
}

.user-avatar,
.hero-initial {
  flex-shrink: 0;
  width: 128rpx;
  height: 128rpx;
}

.user-avatar {
  border-radius: 50%;
}

.hero-initial {
  display: flex;
  border-radius: 50%;
  align-items: center;
  justify-content: center;
  background: var(--mp-accent-soft);
}

.hero-initial-text {
  color: var(--mp-accent);
  font-size: var(--mp-type-headline);
  font-weight: 700;
}

.device-card {
  display: flex;
  align-items: center;
  gap: 32rpx;
}

.device-art {
  display: flex;
  justify-content: center;
  flex-shrink: 0;
  width: 112rpx;
  height: 112rpx;
  overflow: hidden;
  border-radius: var(--mp-radius-inset);
  background: var(--mp-accent-soft);
}

.device-fig {
  flex-shrink: 0;
  margin-top: 16rpx;
}

.device-name {
  display: block;
  color: var(--mp-ink);
  font-size: var(--mp-type-body);
  font-weight: 600;
  line-height: var(--mp-lh-body);
}

.device-pill {
  margin-top: 16rpx;
}

.binding-choices .list-row {
  min-height: var(--mp-tap);
}

.resync-button {
  margin-top: var(--mp-gap-card);
}

.list .row-title.row-copy {
  font-size: var(--mp-type-card);
  font-weight: 500;
}

.profile-caption {
  margin: 24rpx 8rpx 0;
}

.modal-card .field-input {
  margin-top: 24rpx;
}

.foot-link {
  display: block;
  margin-top: 48rpx;
  text-align: center;
}
