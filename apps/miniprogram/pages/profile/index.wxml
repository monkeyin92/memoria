<view class="page-shell">
  <view wx:if="{{!authenticated}}">
    <text class="page-title">我的</text>
    <text class="page-lede">设备与记录，登录后跟随账号。</text>
    <view class="notice">登录后即可管理你的资料。未登录时不会读取资料、统计或回顾。</view>
    <button class="primary-button empty-button" bindtap="loginFromProfile">微信登录</button>
    <view class="list" style="margin-top: 32rpx;">
      <view class="list-row" bindtap="openPrivacy">
        <view class="row-copy">
          <text class="row-title">隐私与数据</text>
          <text class="row-meta">先了解，再决定</text>
        </view>
        <text class="row-chevron">›</text>
      </view>
    </view>
  </view>

  <block wx:else>
    <view class="account">
      <image wx:if="{{profile.avatar_url}}" class="user-avatar" src="{{profile.avatar_url}}" mode="aspectFill" />
      <view wx:else class="hero-initial" aria-hidden="true">
        <text class="hero-initial-text">{{profileInitial}}</text>
      </view>
      <view class="account-copy">
        <text class="page-title">{{profile.display_name || '新朋友'}}</text>
        <text class="page-lede account-lede">微信已登录</text>
      </view>
    </view>

    <view class="profile-character" bindtap="openCompanion">
      <image class="character-photo" src="{{companionImage}}" mode="aspectFit" />
      <view class="row-copy">
        <text class="row-title">{{personaHeadline}}</text>
        <text class="row-meta">人格与声音。下次唤醒才会换成对应声音</text>
      </view>
      <text class="row-chevron">›</text>
    </view>

    <view class="list">
      <view class="list-row" bindtap="openDevice">
        <view class="row-copy">
          <text class="row-title">我的设备</text>
          <text class="row-meta">{{deviceBindingDetail}}</text>
        </view>
        <text class="row-chevron">›</text>
      </view>
      <view wx:if="{{deviceBindingChoices.length}}" class="binding-choices">
        <view
          wx:for="{{deviceBindingChoices}}"
          wx:key="bindingId"
          class="choice-card"
          data-binding-id="{{item.bindingId}}"
          bindtap="chooseDeviceBinding"
        >
          <view class="row-copy">
            <text class="row-title">{{item.label}}</text>
            <text class="row-meta">{{item.modeLabel}}</text>
          </view>
        </view>
      </view>
      <button
        wx:if="{{deviceBindingState === 'error' || deviceBindingState === 'cached'}}"
        class="secondary-button"
        loading="{{deviceBindingSyncing}}"
        disabled="{{deviceBindingSyncing}}"
        bindtap="retryDeviceBindingSync"
      >重新同步设备</button>
      <view wx:if="{{guardianEntryAllowed}}" class="list-row" bindtap="openGuardianSummary">
        <view class="row-copy">
            <text class="row-title">家庭与监护</text>
            <text class="row-meta">成长小结与监护授权</text>
        </view>
        <text class="row-chevron">›</text>
      </view>
      <view wx:if="{{digitalSelfEntryAllowed}}" class="list-row" bindtap="openDigitalSelf">
        <view class="row-copy">
          <text class="row-title">我的记忆档案</text>
          <text class="row-meta">只保留你确认的事</text>
        </view>
        <text class="row-chevron">›</text>
      </view>
    </view>

    <text class="group-label">偏好与隐私</text>
    <view class="list">
      <view class="setting-row">
        <view>
          <text class="setting-name">自动整理日常回顾</text>
          <text class="setting-desc">开启后生成待查看的草稿，不自动保存为记忆</text>
        </view>
        <switch checked="{{profile.auto_summary}}" data-key="auto_summary" bindchange="onSwitch" color="#326e70" />
      </view>
      <view class="setting-row">
        <view>
          <text class="setting-name">过滤明显旁人</text>
          <text class="setting-desc">不让明确非主人的声音进入主人私有路径</text>
        </view>
        <switch checked="{{profile.reject_non_owner_voice}}" data-key="reject_non_owner_voice" bindchange="onSwitch" color="#326e70" />
      </view>
      <view wx:if="{{rawVoiceEntryAllowed}}" class="list-row" bindtap="openPrivacy">
        <view class="row-copy">
          <text class="row-title">隐私与数据</text>
          <text class="row-meta">授权、声音样本、导出与删除</text>
        </view>
        <text class="row-chevron">›</text>
      </view>
      <view wx:if="{{authenticated}}" class="list-row" data-state="{{speakerEnrollmentState}}" bindtap="startSpeakerEnrollment">
        <view class="row-copy">
          <text class="row-title">主人声纹</text>
          <text class="row-meta">{{speakerEnrollmentHint}}</text>
        </view>
        <text class="row-chevron">›</text>
      </view>
    </view>

    <view wx:if="{{customPersonaActive}}" class="card">
      <text class="setting-name">自定义人格与声音</text>
      <text class="setting-desc">对话只在机器人上进行。自定义人格用你写的名字说话，并在声音就绪后用你的声音。</text>
      <text class="field-label">人格名字</text>
      <input class="field-input" value="{{customPersonaName}}" maxlength="16" placeholder="例如：小黑" placeholder-class="field-placeholder" bindinput="onCustomPersonaName" />
      <text class="field-label">人格描述</text>
      <textarea class="field-textarea" value="{{customPersonaText}}" maxlength="420" placeholder="用几句话写出它怎么说话、怎么陪你。" placeholder-class="field-placeholder" bindinput="onCustomPersonaText" auto-height />
      <button class="secondary-button empty-button" loading="{{saving}}" bindtap="saveCustomPersona">保存自定义人格</button>
      <text class="setting-desc">{{voiceCloneStatusLabel}}</text>
      <view class="button-row">
        <button class="secondary-button" loading="{{voiceSampleBusy}}" disabled="{{voiceSampleBusy || recording}}" bindtap="uploadVoiceSample">上传音频</button>
        <button class="secondary-button" loading="{{voiceSampleBusy}}" disabled="{{voiceSampleBusy}}" bindtap="toggleVoiceRecord">{{recording ? '结束录音' : '对着麦克风录'}}</button>
      </view>
      <text wx:if="{{recording}}" class="caption">正在录音 {{recordSeconds}} 秒，请说满 10 秒后再点结束。</text>
    </view>

    <text class="group-label">账号</text>
    <view class="list">
      <view class="list-row" bindtap="copyAccountId">
        <view class="row-copy">
          <text class="row-title">账号编号</text>
          <text class="row-meta">邀请家人时可提供给对方。{{accountId}}</text>
        </view>
      </view>
      <view class="list-row" bindtap="logout">
        <view class="row-copy">
          <text class="row-title">退出当前设备</text>
        </view>
      </view>
      <view class="list-row" bindtap="logoutAll">
        <view class="row-copy">
          <text class="row-title">退出所有设备</text>
        </view>
      </view>
    </view>

    <view wx:if="{{isMinor}}" class="notice">每周会给监护人一份成长小结，不含对话原文。</view>
    <view wx:if="{{profileUnavailableReason}}" class="notice notice-warn">{{profileUnavailableReason}}</view>

    <text class="foot-link" bindtap="openDeleteModal">注销账号</text>
    <text class="privacy-note">{{complianceCopy.positioning}} {{complianceCopy.aiDisclosure}} {{complianceCopy.trainingDefaultOff}}</text>

    <view wx:if="{{showDelete}}" class="modal-mask" bindtap="closeDeleteModal">
      <view class="modal-card" catchtap="noop">
        <text class="page-title">注销账号</text>
        <text class="page-lede">注销将永久删除账号及全部数据，且不可恢复。请完整输入「{{deleteConfirmText}}」确认。</text>
        <input class="field-input" value="{{deleteConfirmation}}" placeholder="{{deleteConfirmText}}" placeholder-class="field-placeholder" bindinput="onDeleteConfirmation" />
        <text wx:if="{{deleteError}}" class="error-text">{{deleteError}}</text>
        <view class="button-row">
          <button class="secondary-button" bindtap="closeDeleteModal">取消</button>
          <button class="danger-button" loading="{{deleting}}" bindtap="confirmDelete">永久注销</button>
        </view>
      </view>
    </view>
  </block>
</view>
