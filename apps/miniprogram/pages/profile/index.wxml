<view class="page-bg"><image class="page-bg-img" src="/assets/bg/night-stars.png" mode="widthFix" /></view>

<view class="page-shell">
  <text class="eyebrow">你的陪伴空间</text>

  <view class="profile-hero">
    <view class="hero-glow"></view>
    <view class="hero-avatar-ring">
      <image wx:if="{{profile.companion_id === 'starlight'}}" class="hero-avatar" src="/assets/companions/miniprogram/starlight.png" mode="aspectFit" />
      <image wx:if="{{profile.companion_id === 'taoxi'}}" class="hero-avatar" src="/assets/companions/miniprogram/taoxi.png" mode="aspectFit" />
      <image wx:if="{{profile.companion_id === 'mianmian'}}" class="hero-avatar" src="/assets/companions/miniprogram/mianmian.png" mode="aspectFit" />
      <image wx:if="{{profile.companion_id === 'axu'}}" class="hero-avatar" src="/assets/companions/miniprogram/axu.png" mode="aspectFit" />
      <image wx:if="{{profile.companion_id === 'xuanmo'}}" class="hero-avatar" src="/assets/companions/miniprogram/xuanmo.png" mode="aspectFit" />
    </view>
    <view class="hero-copy">
      <text class="hero-name">{{profile.display_name || '新朋友'}}</text>
      <text class="hero-bio">{{profile.bio || '慢慢说，我会认真听。'}}</text>
      <text class="hero-account">{{identity.account_type === 'anonymous' ? '匿名体验身份 · 仅在当前运行期有效' : '账号由服务端安全保护'}}</text>
    </view>
  </view>

  <view class="stats-grid">
    <view class="stat-cell">
      <text class="stat-value">{{stats.totalDays}}</text>
      <text class="stat-label">聊过的天</text>
    </view>
    <view class="stat-cell">
      <text class="stat-value">{{stats.moments}}</text>
      <text class="stat-label">记住的片刻</text>
    </view>
    <view class="stat-cell">
      <text class="stat-value">{{stats.streak}}</text>
      <text class="stat-label">连续陪伴</text>
    </view>
  </view>

  <view class="card">
    <text class="settings-title">个人信息</text>
    <text class="field-label">称呼</text>
    <input class="field-input" value="{{profile.display_name}}" maxlength="64" bindinput="onNameInput" />
    <text class="field-label">想让伙伴怎样陪你</text>
    <textarea class="bio-input" value="{{profile.bio}}" maxlength="280" bindinput="onBioInput" />
    <button class="primary-button save-button" loading="{{saving}}" bindtap="saveProfile">保存资料</button>
    <text wx:if="{{error}}" class="error-text">{{error}}</text>
  </view>

  <view class="card">
    <text class="settings-title">陪伴方式</text>
    <view wx:for="{{companions}}" wx:key="id" class="companion-row {{profile.companion_id === item.id ? 'companion-selected' : ''}}" data-id="{{item.id}}" bindtap="chooseCompanion">
      <image wx:if="{{item.id === 'starlight'}}" class="companion-image" src="/assets/companions/miniprogram/starlight.png" mode="aspectFit" />
      <image wx:if="{{item.id === 'taoxi'}}" class="companion-image" src="/assets/companions/miniprogram/taoxi.png" mode="aspectFit" />
      <image wx:if="{{item.id === 'mianmian'}}" class="companion-image" src="/assets/companions/miniprogram/mianmian.png" mode="aspectFit" />
      <image wx:if="{{item.id === 'axu'}}" class="companion-image" src="/assets/companions/miniprogram/axu.png" mode="aspectFit" />
      <image wx:if="{{item.id === 'xuanmo'}}" class="companion-image" src="/assets/companions/miniprogram/xuanmo.png" mode="aspectFit" />
      <view class="companion-copy">
        <text class="companion-name">{{item.name}}</text>
        <text class="companion-tagline">{{item.tagline}}</text>
      </view>
      <view class="companion-check {{profile.companion_id === item.id ? 'companion-check-on' : ''}}">
        <text wx:if="{{profile.companion_id === item.id}}">✓</text>
      </view>
    </view>
  </view>

  <view class="card">
    <text class="settings-title">陪伴偏好</text>
    <view class="setting-row">
      <view><text class="setting-name">过滤明显旁人（实验）</text><text class="setting-desc">不让明确非主人的声音进入主人私有路径</text></view>
      <switch checked="{{profile.reject_non_owner_voice}}" data-key="reject_non_owner_voice" bindchange="onSwitch" color="#22e5ff" />
    </view>
    <view class="setting-row">
      <view><text class="setting-name">自动生成每日回顾</text><text class="setting-desc">每次聊天结束后静默整理</text></view>
      <switch checked="{{profile.auto_summary}}" data-key="auto_summary" bindchange="onSwitch" color="#22e5ff" />
    </view>
    <view class="setting-row">
      <view><text class="setting-name">语音回应</text><text class="setting-desc">让伙伴用声音陪你</text></view>
      <switch checked="{{profile.voice_reply}}" data-key="voice_reply" bindchange="onSwitch" color="#22e5ff" />
    </view>
    <view class="setting-row setting-disabled">
      <view><text class="setting-name">温柔提醒</text><text class="setting-desc">即将开放 · 在合适的时候问候你</text></view>
      <switch checked="{{profile.gentle_reminders}}" data-key="gentle_reminders" bindchange="onSwitch" color="#22e5ff" disabled />
    </view>
  </view>

  <view class="card nav-card" bindtap="openDigitalSelf">
    <view><text class="settings-title">数字分身成长</text><text class="setting-desc">查看服务端的成长维度、Persona 与版本状态</text></view>
    <view class="nav-arrow"><text class="nav-arrow-icon">›</text></view>
  </view>
  <view class="card nav-card" bindtap="openPrivacy">
    <view><text class="settings-title">隐私与原始语音授权</text><text class="setting-desc">查看或撤回可选的原始音频归档授权</text></view>
    <view class="nav-arrow"><text class="nav-arrow-icon">›</text></view>
  </view>

  <view class="card">
    <text class="settings-title">账户与设备</text>
    <view class="account-row" bindtap="logout">
      <view><text class="setting-name">退出当前设备</text><text class="setting-desc">其他已登录设备保持在线</text></view>
      <text class="account-action">退出</text>
    </view>
    <view class="account-row" bindtap="logoutAll">
      <view><text class="setting-name">退出所有设备</text><text class="setting-desc">所有设备都需要重新登录</text></view>
      <text class="account-action account-action-danger">全部退出</text>
    </view>
  </view>

  <view class="delete-entry" bindtap="openDeleteModal">
    <text class="delete-entry-text">注销账号</text>
    <text class="delete-entry-desc">永久删除账号及全部数据</text>
  </view>

  <view wx:if="{{showDelete}}" class="modal-mask" bindtap="closeDeleteModal">
    <view class="modal-card" catchtap="noop">
      <text class="modal-title">注销账号</text>
      <text class="modal-desc">注销将永久删除账号及全部数据，且不可恢复。请输入密码并完整输入「{{deleteConfirmText}}」确认。</text>
      <input class="field-input modal-input" password value="{{deletePassword}}" placeholder="账号密码" placeholder-class="field-placeholder" bindinput="onDeletePassword" />
      <input class="field-input modal-input" value="{{deleteConfirmation}}" placeholder="{{deleteConfirmText}}" placeholder-class="field-placeholder" bindinput="onDeleteConfirmation" />
      <text wx:if="{{deleteError}}" class="error-text">{{deleteError}}</text>
      <view class="modal-actions">
        <button class="secondary-button modal-button" bindtap="closeDeleteModal">取消</button>
        <button class="danger-button modal-button" loading="{{deleting}}" bindtap="confirmDelete">永久注销</button>
      </view>
    </view>
  </view>
</view>
