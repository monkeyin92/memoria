<view class="page-shell tab-page" style="{{statusBarStyle}}">
  <view wx:if="{{!authenticated}}">
    <text class="page-title">我的</text>
    <text class="page-lede">设备与记录，登录后跟随账号。</text>
    <view class="notice">登录后即可管理你的资料。未登录时不会读取资料、统计或回顾。</view>
    <button class="primary-button empty-button" bindtap="loginFromProfile">微信登录</button>
    <view class="list" style="margin-top: 32rpx;">
      <view class="list-row" bindtap="openPrivacy">
        <mp-icon name="shield" tone="ink"></mp-icon>
        <view class="row-copy">
          <text class="row-title">授权与隐私说明</text>
          <text class="row-meta">先了解，再决定</text>
        </view>
        <image class="row-chev" src="/assets/ui/v4/chev-faint.svg" aria-hidden="true" />
      </view>
    </view>
  </view>

  <block wx:else>
    <text class="page-title">我的</text>

    <view class="card card-xl account-card">
      <image wx:if="{{profile.avatar_url}}" class="user-avatar" src="{{profile.avatar_url}}" mode="aspectFill" />
      <view wx:else class="hero-initial" aria-hidden="true">
        <text class="hero-initial-text">{{profileInitial}}</text>
      </view>
      <view class="account-copy">
        <text class="account-name">{{profile.display_name || '新朋友'}}</text>
        <text class="account-sub">{{deviceBindingStateLabel}} · {{deviceBindingCountLabel}}</text>
      </view>
    </view>

    <view class="card device-card" bindtap="openDevice">
      <view class="device-art"><view class="device-fig"><face-badge role="{{profile.companion_id}}" size="md" plain="{{true}}"></face-badge></view></view>
      <view class="row-copy">
        <text class="device-name">{{deviceBindingLabel || '我的设备'}}</text>
        <view class="device-pill pill {{deviceBindingState === 'ready' || deviceBindingState === 'cached' ? 'pill-online' : 'pill-neutral'}}">{{deviceBindingStateLabel}}</view>
        <text wx:if="{{deviceBindingState !== 'ready'}}" class="row-meta">{{deviceBindingDetail}}</text>
      </view>
      <image class="row-chev" src="/assets/ui/v4/chev-faint.svg" aria-hidden="true" />
    </view>
    <view wx:if="{{deviceBindingChoices.length}}" class="list binding-choices">
      <view
        wx:for="{{deviceBindingChoices}}"
        wx:key="bindingId"
        class="list-row"
        data-binding-id="{{item.bindingId}}"
        bindtap="chooseDeviceBinding"
      >
        <view class="row-copy">
          <text class="row-title">{{item.label}}</text>
          <text class="row-meta">{{item.modeLabel}}</text>
        </view>
        <image class="row-chev" src="/assets/ui/v4/chev-faint.svg" aria-hidden="true" />
      </view>
    </view>
    <button
      wx:if="{{deviceBindingState === 'error' || deviceBindingState === 'cached'}}"
      class="secondary-button resync-button"
      loading="{{deviceBindingSyncing}}"
      disabled="{{deviceBindingSyncing}}"
      bindtap="retryDeviceBindingSync"
    >重新同步设备</button>

    <view class="list">
      <view class="list-row" bindtap="openDevice">
        <mp-icon name="dev" tone="ink"></mp-icon>
        <text class="row-title row-copy">设备管理</text>
        <image class="row-chev" src="/assets/ui/v4/chev-faint.svg" aria-hidden="true" />
      </view>
      <view class="list-row" bindtap="openCompanion">
        <mp-icon name="star" tone="ink"></mp-icon>
        <view class="row-copy">
          <text class="row-title">{{personaHeadline}}</text>
          <text class="row-meta">下次唤醒才会换成对应声音</text>
        </view>
        <image class="row-chev" src="/assets/ui/v4/chev-faint.svg" aria-hidden="true" />
      </view>
      <view wx:if="{{guardianEntryAllowed}}" class="list-row" bindtap="openGuardianSummary">
        <mp-icon name="user" tone="ink"></mp-icon>
        <view class="row-copy">
          <text class="row-title">监护与成长小结</text>
          <text class="row-meta">成长小结与监护授权</text>
        </view>
        <image class="row-chev" src="/assets/ui/v4/chev-faint.svg" aria-hidden="true" />
      </view>
      <view wx:if="{{digitalSelfEntryAllowed}}" class="list-row" bindtap="openDigitalSelf">
        <mp-icon name="note" tone="ink"></mp-icon>
        <view class="row-copy">
          <text class="row-title">我的记忆档案</text>
          <text class="row-meta">只保留你确认的事</text>
        </view>
        <image class="row-chev" src="/assets/ui/v4/chev-faint.svg" aria-hidden="true" />
      </view>
      <view wx:if="{{rawVoiceEntryAllowed}}" class="list-row" bindtap="openPrivacy">
        <mp-icon name="shield" tone="ink"></mp-icon>
        <view class="row-copy">
          <text class="row-title">授权与隐私说明</text>
          <text class="row-meta">授权、导出与删除</text>
        </view>
        <image class="row-chev" src="/assets/ui/v4/chev-faint.svg" aria-hidden="true" />
      </view>
      <view class="list-row" bindtap="openCustomPersona">
        <mp-icon name="wave" tone="ink"></mp-icon>
        <view class="row-copy">
          <text class="row-title">自定义人格</text>
          <text class="row-meta">{{customPersonaLabel || '还没有分配到自定义人格'}}</text>
        </view>
        <image class="row-chev" src="/assets/ui/v4/chev-faint.svg" aria-hidden="true" />
      </view>
    </view>
    <text class="caption profile-caption">对话只在机器人上进行。自定义人格用你写的名字说话，可创建、删除或分配给使用人。</text>

    <text class="group-label">偏好</text>
    <view class="list">
      <view class="setting-row">
        <view class="row-copy">
          <text class="setting-name">自动整理日常回顾</text>
          <text class="setting-desc">开启后生成待查看的草稿，不自动保存为记忆</text>
        </view>
        <switch checked="{{profile.auto_summary}}" data-key="auto_summary" bindchange="onSwitch" color="#4A52C9" />
      </view>
    </view>

    <text class="group-label">账号</text>
    <view class="list">
      <view class="list-row" bindtap="copyAccountId">
        <view class="row-copy">
          <text class="row-title">账号编号</text>
          <text class="row-meta">邀请监护人时可提供给对方。{{accountId}}</text>
        </view>
      </view>
      <view class="list-row" bindtap="logout">
        <text class="row-title row-copy">退出当前设备</text>
      </view>
      <view class="list-row" bindtap="logoutAll">
        <text class="row-title row-copy">退出所有设备</text>
      </view>
    </view>

    <view wx:if="{{isMinor}}" class="notice">每周会给监护人一份成长小结，不含对话原文。</view>
    <view wx:if="{{profileUnavailableReason}}" class="notice notice-warn">{{profileUnavailableReason}}</view>

    <text class="foot-link danger-link" bindtap="openDeleteModal">永久注销</text>
    <text class="privacy-note">{{complianceCopy.positioning}} {{complianceCopy.aiDisclosure}} {{complianceCopy.trainingDefaultOff}}</text>

    <!-- 居中弹窗二次确认：完整输入确认文本才可注销 -->
    <view wx:if="{{showDelete}}" class="modal-wrap" bindtap="closeDeleteModal">
      <view class="modal-card" catchtap="noop">
        <text class="modal-title">注销账号</text>
        <text class="modal-desc">注销将永久删除账号及全部数据，且不可恢复。请完整输入「{{deleteConfirmText}}」确认。</text>
        <input class="field-input" value="{{deleteConfirmation}}" placeholder="{{deleteConfirmText}}" placeholder-class="field-placeholder" bindinput="onDeleteConfirmation" />
        <text wx:if="{{deleteError}}" class="error-text">{{deleteError}}</text>
        <view class="button-row">
          <button class="secondary-button" bindtap="closeDeleteModal">取消</button>
          <button class="danger-button" loading="{{deleting}}" disabled="{{deleteConfirmation !== deleteConfirmText}}" bindtap="confirmDelete">永久注销</button>
        </view>
      </view>
    </view>
  </block>
</view>
