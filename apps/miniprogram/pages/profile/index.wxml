<view class="page-bg"><image class="page-bg-img" src="/assets/bg/night-stars.png" mode="widthFix" /></view>

<view class="page-shell">
  <text class="eyebrow">你的陪伴空间</text>

  <view wx:if="{{!authenticated}}" class="card guest-profile">
    <text class="guest-profile-badge">游客浏览模式</text>
    <text class="guest-profile-title">先看看，再决定什么时候开始</text>
    <text class="guest-profile-copy">未登录时不会读取你的资料、统计或回顾。若账号尚未授权手机号，下一步会进入「授权手机号并登录」。</text>
    <button class="primary-button guest-profile-button" bindtap="loginFromProfile">微信登录</button>
  </view>

  <block wx:else>
  <view class="profile-hero">
    <view class="hero-glow"></view>
    <view class="hero-avatar-ring">
      <image
        wx:if="{{profile.avatar_url}}"
        class="user-avatar"
        src="{{profile.avatar_url}}"
        mode="aspectFill"
        aria-label="微信头像"
      />
      <view wx:else class="hero-initial" aria-hidden="true">
        <text class="hero-initial-text">{{profileInitial}}</text>
      </view>
    </view>
    <view class="hero-copy">
      <text class="hero-name">{{profile.display_name || '新朋友'}}</text>
      <text class="hero-account">微信账号已安全登录</text>
    </view>
  </view>

  <view class="stats-grid">
    <view class="stat-cell">
      <text class="stat-value">{{stats.totalDays}}</text>
      <text class="stat-label">聊过的天</text>
    </view>
    <view class="stat-cell">
      <text class="stat-value">{{stats.moments}}</text>
      <text class="stat-label">记住的片刻</text>
    </view>
    <view class="stat-cell">
      <text class="stat-value">{{stats.streak}}</text>
      <text class="stat-label">连续陪伴</text>
    </view>
  </view>

  <view class="card compliance-card">
    <text class="settings-title">合规说明</text>
    <text class="compliance-copy">{{complianceCopy.positioning}}</text>
    <text class="compliance-copy">{{complianceCopy.aiDisclosure}}</text>
    <text class="compliance-copy">{{complianceCopy.trainingDefaultOff}}</text>
    <text wx:if="{{isMinor}}" class="compliance-copy">{{complianceCopy.minorRestrictions}}</text>
  </view>

  <view class="card">
    <text class="settings-title">已交货能力</text>
    <text class="setting-desc">只展示服务端已确认的控制面与身份信号，不含未验收的硬件指标。</text>
    <view wx:if="{{deliveredCapabilitiesLoading}}" class="section-empty">正在加载…</view>
    <view wx:elif="{{!deliveredCapabilities.length}}" class="section-empty">暂时无法读取能力仪表。</view>
    <view wx:for="{{deliveredCapabilities}}" wx:key="label" class="delivered-row">
      <text class="delivered-label">{{item.label}}</text>
      <text class="delivered-value">{{item.value}}</text>
    </view>
  </view>

  <view class="card" aria-role="radiogroup" aria-label="人格与声音">
    <text class="settings-title">人格与声音</text>
    <text class="setting-desc">对话只在机器人上进行。目录人格用对应的设计声音；自定义人格用你写的名字说话，并在声音就绪后用你的声音。换人格后，下次唤醒才会换成对应声音。</text>
    <view
      wx:for="{{companions}}"
      wx:key="id"
      class="persona-row {{!customPersonaActive && profile.companion_id === item.id ? 'persona-selected' : ''}}"
      data-id="{{item.id}}"
      bindtap="chooseCompanion"
      aria-role="radio"
      aria-checked="{{!customPersonaActive && profile.companion_id === item.id}}"
      aria-label="{{item.name}}，声音 {{item.voiceName}}"
    >
      <view class="persona-copy">
        <text class="persona-name">{{item.name}}</text>
        <text class="persona-tagline">{{item.tagline}}</text>
        <text class="persona-voice">声音 · {{item.voiceName}}</text>
      </view>
      <view class="persona-check {{!customPersonaActive && profile.companion_id === item.id ? 'persona-check-on' : ''}}" aria-hidden="true">
        <text wx:if="{{!customPersonaActive && profile.companion_id === item.id}}">✓</text>
      </view>
    </view>

    <view
      class="persona-row {{customPersonaActive ? 'persona-selected' : ''}}"
      bindtap="chooseCustomPersona"
      aria-role="radio"
      aria-checked="{{customPersonaActive}}"
      aria-label="自定义人格与声音"
    >
      <view class="persona-copy">
        <text class="persona-name">自定义</text>
        <text class="persona-tagline">自己写性格，再用上传或录音作为声音</text>
        <text class="persona-voice">声音 · 你提供的样本</text>
      </view>
      <view class="persona-check {{customPersonaActive ? 'persona-check-on' : ''}}" aria-hidden="true">
        <text wx:if="{{customPersonaActive}}">✓</text>
      </view>
    </view>

    <view wx:if="{{customPersonaActive}}" class="custom-persona-panel">
      <text class="field-label">人格名字</text>
      <input
        class="field-input"
        value="{{customPersonaName}}"
        maxlength="16"
        placeholder="例如：小黑"
        placeholder-class="field-placeholder"
        bindinput="onCustomPersonaName"
      />
      <text class="field-label">人格描述</text>
      <textarea
        class="field-textarea"
        value="{{customPersonaText}}"
        maxlength="420"
        placeholder="用几句话写出它怎么说话、怎么陪你。保存后会写入资料，下一次在设备上对话生效。"
        placeholder-class="field-placeholder"
        bindinput="onCustomPersonaText"
        auto-height
      />
      <button class="secondary-button custom-save" loading="{{saving}}" bindtap="saveCustomPersona">保存自定义人格</button>
      <text class="setting-desc">录或上传 10–60 秒清楚的人声。生成大约一分钟，结果就显示在上面。</text>
      <text class="persona-voice">{{voiceCloneStatusLabel}}</text>
      <view class="button-row voice-sample-row">
        <button class="secondary-button" loading="{{voiceSampleBusy}}" disabled="{{voiceSampleBusy || recording}}" bindtap="uploadVoiceSample">上传音频</button>
        <button class="secondary-button" loading="{{voiceSampleBusy}}" disabled="{{voiceSampleBusy}}" bindtap="toggleVoiceRecord">{{recording ? '结束录音' : '对着麦克风录'}}</button>
      </view>
      <text wx:if="{{recording}}" class="recording-hint">正在录音 {{recordSeconds}} 秒，请说满 10 秒后再点结束。</text>
      <text wx:if="{{!voiceCloneAllowed}}" class="setting-desc">当前绑定未开启声音复刻时，提交样本可能被拒绝。</text>
    </view>
  </view>

  <view class="card">
    <text class="settings-title">陪伴偏好</text>
    <view class="setting-row">
      <view><text class="setting-name">过滤明显旁人（实验）</text><text class="setting-desc">不让明确非主人的声音进入主人私有路径</text></view>
      <switch checked="{{profile.reject_non_owner_voice}}" data-key="reject_non_owner_voice" bindchange="onSwitch" color="#22e5ff" />
    </view>
    <view class="setting-row">
      <view><text class="setting-name">自动生成每日回顾</text><text class="setting-desc">每次聊天结束后静默整理</text></view>
      <switch checked="{{profile.auto_summary}}" data-key="auto_summary" bindchange="onSwitch" color="#22e5ff" />
    </view>
    <view class="setting-row setting-disabled">
      <view><text class="setting-name">温柔提醒</text><text class="setting-desc">即将开放 · 在合适的时候问候你</text></view>
      <switch checked="{{profile.gentle_reminders}}" data-key="gentle_reminders" bindchange="onSwitch" color="#22e5ff" disabled />
    </view>
  </view>

  <view wx:if="{{isMinor}}" class="card student-notice">
    <text class="student-notice-badge">成长小结知情说明</text>
    <text class="student-notice-title">每周会给爸爸妈妈一份成长小结</text>
    <text class="student-notice-copy">只分享一周的情绪趋势、学习时长和话题分布，你和伙伴聊过的具体内容不会出现在小结里。</text>
  </view>

  <view wx:if="{{guardianEntryAllowed}}" class="card nav-card guardian-entry" bindtap="openGuardianSummary">
    <view><text class="settings-title">成长小结与监护授权</text><text class="setting-desc">查看已授权孩子的每周聚合小结与监护关系</text></view>
    <view class="nav-arrow"><text class="nav-arrow-icon">›</text></view>
  </view>
  <view wx:if="{{authenticated}}" class="card">
    <text class="settings-title">主人声纹</text>
    <text wx:if="{{speakerEnrollmentState === 'active'}}" class="setting-desc">主人声纹已可用，设备用它确认是不是你在说话。模板由服务端保管，不用于声音复刻。</text>
    <text wx:elif="{{speakerEnrollmentState === 'pending'}}" class="setting-desc">上一版声纹还没生效。请唤醒设备，按提示再说几句话。</text>
    <text wx:elif="{{speakerEnrollmentState === 'requested'}}" class="setting-desc">已记录授权。唤醒设备，按提示说几句话即可。手机不录音。</text>
    <text wx:elif="{{speakerEnrollmentState === 'required'}}" class="setting-desc">绑定完成后唤醒设备，按提示说几句话完成主人声纹。手机不采集声纹。</text>
    <text wx:else class="setting-desc">当前还不能登记主人声纹：{{speakerEnrollmentBlockReason}}</text>
    <view wx:if="{{speakerEnrollmentState === 'required' || speakerEnrollmentState === 'requested' || speakerEnrollmentState === 'active'}}" class="account-row" bindtap="startSpeakerEnrollment">
      <view><text class="setting-name">{{speakerEnrollmentState === 'active' ? '重新录制主人声纹' : '在设备上开始初始化'}}</text><text class="setting-desc">需要已绑定且在线的设备</text></view>
      <text wx:if="{{speakerEnrollmentState === 'active'}}" class="account-action">重新录制</text>
      <text wx:elif="{{speakerEnrollmentState === 'requested'}}" class="account-action">再试一次</text>
      <text wx:else class="account-action">开始</text>
    </view>
    <text wx:if="{{speakerEnrollmentState === 'required' || speakerEnrollmentState === 'requested' || speakerEnrollmentState === 'active'}}" class="form-note">真正录音发生在设备端。管理员可随时重新录制，完成后回到本页刷新。</text>
  </view>
  <view wx:if="{{digitalSelfEntryAllowed}}" class="card nav-card" bindtap="openDigitalSelf">
    <view><text class="settings-title">数字分身成长</text><text class="setting-desc">查看服务端的成长维度、Persona 与版本状态</text></view>
    <view class="nav-arrow"><text class="nav-arrow-icon">›</text></view>
  </view>
  <view class="card nav-card" bindtap="openDevice">
    <view><text class="settings-title">设备与家庭成员</text><text class="setting-desc">查看设备绑定、确认当前使用者，敏感能力由服务端按当前主体授权</text></view>
    <view class="nav-arrow"><text class="nav-arrow-icon">›</text></view>
  </view>
  <view wx:if="{{rawVoiceEntryAllowed}}" class="card nav-card" bindtap="openPrivacy">
    <view><text class="settings-title">隐私与原始语音授权</text><text class="setting-desc">查看或撤回可选的原始音频归档授权</text></view>
    <view class="nav-arrow"><text class="nav-arrow-icon">›</text></view>
  </view>

  <view wx:if="{{profileUnavailableReason}}" class="card capability-unavailable-card">
    <text class="capability-unavailable-title">敏感能力入口已关闭</text>
    <text class="setting-desc">{{profileUnavailableReason}}</text>
    <text class="setting-desc">能力只由服务端按当前主体授权，不会按本地年龄开放。</text>
  </view>

  <view class="card">
    <text class="settings-title">账户与设备</text>
    <view class="account-row" bindtap="logout">
      <view><text class="setting-name">退出当前设备</text><text class="setting-desc">其他已登录设备保持在线</text></view>
      <text class="account-action">退出</text>
    </view>
    <view class="account-row" bindtap="logoutAll">
      <view><text class="setting-name">退出所有设备</text><text class="setting-desc">所有设备都需要重新登录</text></view>
      <text class="account-action account-action-danger">全部退出</text>
    </view>
  </view>

  <view class="delete-entry" bindtap="openDeleteModal">
    <text class="delete-entry-text">注销账号</text>
    <text class="delete-entry-desc">永久删除账号及全部数据</text>
  </view>

  <view wx:if="{{showDelete}}" class="modal-mask" bindtap="closeDeleteModal">
    <view class="modal-card" catchtap="noop">
      <text class="modal-title">注销账号</text>
      <text class="modal-desc">注销将永久删除账号及全部数据，且不可恢复。提交时会重新校验当前微信身份，请完整输入「{{deleteConfirmText}}」确认。</text>
      <input class="field-input modal-input" value="{{deleteConfirmation}}" placeholder="{{deleteConfirmText}}" placeholder-class="field-placeholder" bindinput="onDeleteConfirmation" />
      <text wx:if="{{deleteError}}" class="error-text">{{deleteError}}</text>
      <view class="modal-actions">
        <button class="secondary-button modal-button" bindtap="closeDeleteModal">取消</button>
        <button class="danger-button modal-button" loading="{{deleting}}" bindtap="confirmDelete">永久注销</button>
      </view>
    </view>
  </view>
  </block>
</view>
