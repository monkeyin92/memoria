.role-new {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  height: 48px;
  margin-top: var(--mp-gap-card);
  border-radius: var(--mp-radius-inset);
  background: var(--mp-surface);
  box-shadow: var(--mp-shadow-card);
  color: var(--mp-accent);
  font-size: var(--mp-type-card);
  font-weight: 600;
}

.role-new-icon {
  width: 18px;
  height: 18px;
}

.role-hint {
  margin-top: 8px;
  line-height: 16px;
  text-align: center;
}

.companion-voice {
  margin-top: 0;
  padding-top: 4px;
  padding-bottom: 4px;
}

.companion-voice .setting-row {
  gap: 16px;
}
