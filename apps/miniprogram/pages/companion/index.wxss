.role-new {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  height: var(--mp-tap);
  margin-top: var(--mp-gap-card);
  border-radius: var(--mp-radius-inset);
  background: var(--mp-surface);
  box-shadow: var(--mp-shadow-card);
  color: var(--mp-accent);
  font-size: var(--mp-type-body);
  font-weight: 600;
}

.role-new-icon {
  width: 40rpx;
  height: 40rpx;
}

.role-hint {
  margin-top: 32rpx;
  text-align: center;
}

.companion-voice {
  margin-top: 0;
  padding-top: 8rpx;
  padding-bottom: 8rpx;
}

.companion-voice .setting-row {
  gap: 32rpx;
}
