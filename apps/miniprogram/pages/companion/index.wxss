.role-new {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  height: var(--mp-tap);
  margin-top: var(--mp-gap-card);
  border-radius: var(--mp-radius-inset);
  background: var(--mp-surface);
  box-shadow: var(--mp-shadow-card);
  color: var(--mp-accent);
  font-size: var(--mp-type-body);
  font-weight: 600;
}

.role-new-icon {
  width: 20px;
  height: 20px;
}

.role-hint {
  margin-top: 16px;
  text-align: center;
}

.companion-voice {
  margin-top: 0;
  padding-top: 4px;
  padding-bottom: 4px;
}

.companion-voice .setting-row {
  gap: 16px;
}
