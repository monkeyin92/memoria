.default-voice-stage { display: flex; align-items: center; justify-content: center; margin-top: 24px; padding: 24px 20px; border-radius: 24px; background: var(--mp-screen); }
.default-voice-wave { display: flex; align-items: center; gap: 8px; height: 40px; }
.default-voice-wave view { width: 5px; height: 12px; border-radius: 4px; background: var(--mp-cyan); }
.default-voice-wave view:nth-child(2), .default-voice-wave view:nth-child(6) { height: 24px; }
.default-voice-wave view:nth-child(3), .default-voice-wave view:nth-child(5) { height: 32px; }
.default-voice-wave view:nth-child(4) { height: 40px; }
.default-voice-title { display: block; margin-top: 28px; font-size: var(--mp-type-heading); line-height: 1.5; font-weight: 650; }
