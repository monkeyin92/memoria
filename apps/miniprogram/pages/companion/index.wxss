.role-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--mp-gap-card);
  margin-top: 48rpx;
}

.role-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  box-sizing: border-box;
  min-width: 0;
  padding: 16rpx 16rpx 32rpx;
  border-radius: var(--mp-radius-card);
  background: var(--mp-surface);
  box-shadow: var(--mp-shadow-card);
  text-align: center;
  transition: box-shadow var(--mp-dur);
}

.role-card-on {
  box-shadow: var(--mp-shadow-selected);
}

.role-art {
  display: flex;
  justify-content: center;
  width: 100%;
  height: 192rpx;
  overflow: hidden;
  border-radius: var(--mp-radius-inset);
  background: var(--mp-fill);
}

.role-card-on .role-art {
  background: var(--mp-accent-soft);
}

.role-fig {
  margin-top: 16rpx;
}

.role-name {
  display: block;
  margin-top: 16rpx;
  color: var(--mp-ink);
  font-size: var(--mp-type-body);
  font-weight: 600;
  line-height: var(--mp-lh-body);
}

.role-tagline {
  display: block;
  margin-top: 8rpx;
  padding: 0 8rpx;
  color: var(--mp-ink-2);
  font-size: var(--mp-type-meta);
  line-height: 32rpx;
}

.role-chip {
  margin-top: 16rpx;
}

.role-new {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  height: var(--mp-tap);
  margin-top: var(--mp-gap-card);
  border-radius: var(--mp-radius-inset);
  background: var(--mp-surface);
  box-shadow: var(--mp-shadow-card);
  color: var(--mp-accent);
  font-size: var(--mp-type-body);
  font-weight: 600;
}

.role-new-icon {
  width: 40rpx;
  height: 40rpx;
}

.role-hint {
  margin-top: 32rpx;
  text-align: center;
}

.companion-voice {
  margin-top: 0;
  padding-top: 8rpx;
  padding-bottom: 8rpx;
}

.companion-voice .setting-row {
  gap: 32rpx;
}

.role-play {
  flex-shrink: 0;
  min-height: 64rpx;
}
