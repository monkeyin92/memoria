<view class="page-shell tab-page" style="{{statusBarStyle}}">
  <text class="eyebrow">声音与表达</text>
  <text class="page-title">声音</text>
  <text class="page-lede">选择一种音色与说话方式。点选即可保存，下次对话生效。</text>
  <text wx:if="{{saving}}" class="caption role-hint">正在保存…</text>

  <view class="voice-list">
    <view
      wx:for="{{cards}}"
      wx:key="id"
      class="voice-option {{profile.companion_id === item.id ? 'voice-option-on' : ''}}"
      aria-disabled="{{saving}}"
      data-id="{{item.id}}"
      bindtap="chooseCompanion"
    >
      <view class="voice-bars" aria-hidden="true">
        <view class="voice-bar"></view>
        <view class="voice-bar"></view>
        <view class="voice-bar"></view>
        <view class="voice-bar"></view>
        <view class="voice-bar"></view>
      </view>
      <view class="voice-copy">
        <text class="voice-name">{{item.tone}}<text class="voice-catalog-name"> {{item.name}}</text></text>
        <text class="voice-tagline">{{item.tagline}}</text>
      </view>
      <text wx:if="{{profile.companion_id === item.id}}" class="voice-current">已选</text>
      <view
        class="pill pill-neutral voice-chip"
        data-id="{{item.id}}"
        catchtap="togglePreview"
      >{{previewingId === item.id ? '停止' : '试听'}}</view>
    </view>
  </view>

  <view class="role-new" bindtap="openCustomPersona">
    <image class="role-new-icon" src="/assets/ui/v4/plus-accent.svg" aria-hidden="true"></image>
    <text>自定义表达</text>
  </view>
  <text class="caption role-hint">试听只播放示例，不会切换设置。</text>
  <text class="privacy-note">声音由 AI 生成。表达风格不改变权限与记忆规则。</text>
</view>
