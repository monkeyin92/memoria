<view class="page-shell companion-shell">
  <text class="page-title">伙伴</text>
  <text class="page-lede">当前伙伴 · {{currentName}}在陪你</text>

  <scroll-view class="role-flow" scroll-x="true" enable-flex="true">
    <view
      wx:for="{{companions}}"
      wx:key="id"
      class="role-card {{!customPersonaActive && profile.companion_id === item.id ? 'role-card-selected' : ''}}"
      data-role="{{item.id}}"
    >
      <view wx:if="{{!customPersonaActive && profile.companion_id === item.id}}" class="pill pill-teal companion-current">当前伙伴</view>
      <view class="companion-face">
        <face-badge role="{{item.id}}" size="lg" breathe="{{!customPersonaActive && profile.companion_id === item.id}}"></face-badge>
      </view>
      <text class="role-card-name">{{item.name}}</text>
      <text class="role-card-tagline">{{item.tagline}} · {{item.voiceName}}</text>
      <text class="companion-desc">{{item.description}}</text>
      <text class="companion-tone">{{item.tone}}</text>
      <view class="button-row companion-actions">
        <button wx:if="{{!customPersonaActive && profile.companion_id === item.id}}" class="secondary-button btn-sm" disabled="true">✓ 已选择</button>
        <button wx:else class="primary-button btn-sm" data-id="{{item.id}}" bindtap="chooseCompanion">选TA陪伴</button>
      </view>
    </view>
  </scroll-view>
  <text class="caption">左右滑动，认识每一位伙伴</text>

  <view class="section-head">
    <text class="section-head-title">声音设置</text>
  </view>
  <view class="l2-card companion-voice">
    <view class="setting-row" bindtap="chooseCatalogVoice">
      <view class="row-icon">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none"><path d="M11 5L6 9H2v6h4l5 4V5z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/><path d="M15.5 8.5a5 5 0 0 1 0 7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
      </view>
      <view class="row-copy">
        <text class="row-title">角色默认声音</text>
        <text class="row-meta">{{currentTone}}</text>
      </view>
      <view class="pill {{!customPersonaActive ? 'pill-teal' : 'pill-neutral'}}">{{!customPersonaActive ? '使用中' : '可选'}}</view>
    </view>
    <view class="setting-row" bindtap="chooseCustomPersona">
      <view class="row-icon">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none"><rect x="9" y="2" width="6" height="12" rx="3" stroke="currentColor" stroke-width="1.8"/><path d="M5 10a7 7 0 0 0 14 0M12 17v4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
      </view>
      <view class="row-copy">
        <text class="row-title">我的自定义声音</text>
        <text class="row-meta">需要单独同意与可用声音样本，在「我的」里录制或上传</text>
      </view>
      <view class="pill {{customPersonaActive ? 'pill-teal' : 'pill-neutral'}}">{{customPersonaActive ? '使用中' : '未开始'}}</view>
    </view>
  </view>

  <text class="caption">角色只影响表达风格，不改变你的资料权限。换角色后，下次唤醒才会换成对应声音。</text>
  <button class="primary-button empty-button" loading="{{saving}}" bindtap="saveCurrent">使用{{currentName}}的默认声音</button>
  <text class="privacy-note">声音数据加密传输与存储于云端，可随时更换或撤回。</text>
</view>
