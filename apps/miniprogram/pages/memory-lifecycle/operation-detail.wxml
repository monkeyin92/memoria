<!-- 操作详情页 -->
<view class="page-shell operation-detail-page">
  <!-- 内部草稿标识 -->
  <view class="draft-banner">
    <text class="draft-label">{{draftLabel}}</text>
  </view>

  <block wx:if="{{operation}}">
    <view class="page-content">
      <!-- 操作摘要 -->
      <view class="card summary-card">
        <text class="summary-action">{{operation.actionLabel}}</text>
        <view class="summary-status">
          <text class="status-badge" style="background-color: {{operation.status === 'completed' ? '#e7f5ea' : '#fffaf0'}}; color: {{operation.status === 'completed' ? '#07c160' : '#ff9c00'}}">
            {{operation.status === 'completed' ? '已完成' : '处理中'}}
          </text>
        </view>
        <text class="summary-message">{{operation.message}}</text>
      </view>

      <!-- 时间线 -->
      <view class="card timeline-card">
        <text class="card-title">处理阶段</text>
        <view class="timeline">
          <!-- 受理阶段 -->
          <view class="timeline-item completed">
            <view class="timeline-dot"></view>
            <view class="timeline-content">
              <text class="timeline-label">请求受理</text>
              <text class="timeline-time">{{operation.acceptedAt | formatTime}}</text>
            </view>
          </view>

          <!-- 停止访问阶段 -->
          <view
            wx:if="{{operation.accessStoppedAt}}"
            class="timeline-item {{operation.accessStoppedAt ? 'completed' : 'pending'}}"
          >
            <view class="timeline-dot"></view>
            <view class="timeline-content">
              <text class="timeline-label">停止访问</text>
              <text class="timeline-time">{{operation.accessStoppedAt | formatTime}}</text>
            </view>
          </view>

          <!-- 删除处理阶段 -->
          <view class="timeline-item {{operation.completedAt ? 'completed' : 'pending'}}">
            <view class="timeline-dot"></view>
            <view class="timeline-content">
              <text class="timeline-label">删除处理</text>
              <text class="timeline-time" wx:if="{{operation.completedAt}}">{{operation.completedAt | formatTime}}</text>
              <text class="timeline-time" wx:else>处理中…</text>
            </view>
          </view>

          <!-- 完成阶段 -->
          <view class="timeline-item {{operation.status === 'completed' ? 'completed' : 'pending'}}">
            <view class="timeline-dot"></view>
            <view class="timeline-content">
              <text class="timeline-label">整体完成</text>
              <text class="timeline-time" wx:if="{{operation.status === 'completed'}}">已完成</text>
              <text class="timeline-time" wx:else>待完成</text>
            </view>
          </view>
        </view>
      </view>

      <!-- 绑定状态 -->
      <view wx:if="{{operation.bindingStatus}}" class="card binding-card">
        <text class="card-title">设备绑定</text>
        <view class="status-item">
          <text class="label">状态：</text>
          <text class="value">{{operation.bindingStatus.status === 'revoked' ? '已解绑' : '待处理'}}</text>
        </view>
        <view wx:if="{{operation.bindingStatus.revokedAt}}" class="status-item">
          <text class="label">解绑时间：</text>
          <text class="value">{{operation.bindingStatus.revokedAt | formatTime}}</text>
        </view>
      </view>

      <!-- 记忆访问权限 -->
      <view wx:if="{{operation.memoryAccessStatus}}" class="card access-card">
        <text class="card-title">记忆访问权限</text>
        <view class="status-item">
          <text class="label">状态：</text>
          <text class="value">{{operation.memoryAccessStatus.status === 'stopped' ? '已停止' : '停止中'}}</text>
        </view>
        <view wx:for="{{operation.memoryAccessStatus.scopeStops}}" wx:key="scopeId" class="scope-item">
          <text class="scope-label">{{item.scopeId}}</text>
          <text class="scope-status">{{item.accessStatus}}</text>
        </view>
      </view>

      <!-- 数据删除 -->
      <view wx:if="{{operation.domains && operation.domains.length > 0}}" class="card domains-card">
        <text class="card-title">数据删除进度</text>
        <view wx:for="{{operation.domains}}" wx:key="domain" class="domain-item">
          <view class="domain-header">
            <text class="domain-name">{{item.domain}}</text>
            <text class="domain-status" style="color: {{item.status === 'purged' ? '#07c160' : item.status === 'pending' ? '#ff9c00' : '#999'}}">
              {{item.status === 'purged' ? '已删除' : item.status === 'pending' ? '删除中' : '待处理'}}
            </text>
          </view>
          <text class="domain-message">{{item.message}}</text>
        </view>
      </view>

      <!-- 保管状态 -->
      <view wx:if="{{operation.custodyStatus}}" class="card custody-card">
        <text class="card-title">保管状态</text>
        <view class="status-item">
          <text class="label">本次摘要：</text>
          <text class="value">{{operation.custodyStatus.status}}</text>
        </view>
        <view wx:for="{{operation.custodyStatus.grants}}" wx:key="grantId" class="grant-item">
          <view class="grant-header">
            <text class="grant-id">{{item.grantId}}</text>
            <text class="grant-status">{{item.status}}</text>
          </view>
          <view class="grant-dates">
            <text class="date-label">生效：</text>
            <text class="date-value">{{item.effectiveAt | formatTime}}</text>
          </view>
          <view class="grant-dates">
            <text class="date-label">到期：</text>
            <text class="date-value">{{item.expiresAt | formatTime}}</text>
          </view>
        </view>
      </view>

      <!-- 对话状态 -->
      <view wx:if="{{operation.chatTransitionStatus}}" class="card chat-card">
        <text class="card-title">对话状态</text>
        <view class="status-item">
          <text class="label">当前：</text>
          <text class="value chat-value">{{operation.chatTransitionStatus}}</text>
        </view>
      </view>

      <!-- 两层清除状态 -->
      <view wx:if="{{operation.childLayersPurged !== undefined}}" class="card layers-card">
        <text class="card-title">两层清除状态</text>
        <view class="status-item">
          <text class="label">近期摘要和长期记录：</text>
          <text class="value">{{operation.childLayersPurged === 'completed' ? '已清除' : operation.childLayersPurged === 'pending' ? '清除中' : '未清除'}}</text>
        </view>
        <view class="status-item">
          <text class="label">完整删除：</text>
          <text class="value">{{operation.subjectDeletion === 'completed' ? '已删除' : operation.subjectDeletion === 'pending' ? '删除中' : '未执行'}}</text>
        </view>
      </view>

      <!-- 操作按钮 -->
      <view class="card action-buttons">
        <button
          wx:if="{{operation.status === 'in_progress'}}"
          type="primary"
          bindtap="retryOperation"
        >
          重新检查进度
        </button>
        <button type="default" bindtap="goBack">
          返回
        </button>
      </view>
    </view>

    <text class="page-notice">【模拟状态】本页数据不代表真实处理结果。</text>
  </block>

  <block wx:else>
    <view class="empty-state">
      <text class="empty-title">未找到操作</text>
      <button type="default" bindtap="goBack">返回</button>
    </view>
  </block>
</view>

<wxs module="filters">
  function formatTime(dateStr) {
    if (!dateStr) return "-";
    var date = getDate(dateStr);
    var month = date.getMonth() + 1;
    var day = date.getDate();
    var hour = date.getHours();
    var min = date.getMinutes();
    return (
      month +
      "月" +
      day +
      "日 " +
      (hour < 10 ? "0" + hour : hour) +
      ":" +
      (min < 10 ? "0" + min : min)
    );
  }
  module.exports = {
    formatTime: formatTime,
  };
</wxs>
