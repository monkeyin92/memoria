/* 操作详情页 - 最小样式 */

.operation-detail-page {
  background-color: var(--mp-bg);
}

.draft-banner {
  background-color: var(--mp-sun-bg);
  padding: 12px 16px;
  border-bottom: 1px solid var(--mp-line);
}

.draft-label {
  display: block;
  font-size: var(--mp-type-meta);
  color: var(--mp-ink);
  text-align: center;
}

.page-content {
  padding: 16px;
}

.card {
  background-color: var(--mp-surface);
  border-radius: var(--mp-radius-card);
  padding: 16px;
  margin-bottom: 12px;
  box-shadow: var(--mp-shadow-card);
}

.card-title {
  display: block;
  font-size: var(--mp-type-card);
  font-weight: 600;
  color: var(--mp-ink);
  margin-bottom: 12px;
}

.summary-action {
  display: block;
  font-size: var(--mp-type-headline);
  font-weight: 700;
  color: var(--mp-ink);
  margin-bottom: 8px;
}

.status-badge {
  display: inline-block;
  font-size: var(--mp-type-meta);
  font-weight: 600;
  padding: 4px 8px;
  border-radius: 4px;
  background-color: var(--mp-sage-bg);
  color: var(--mp-sage);
}

.summary-message {
  display: block;
  font-size: var(--mp-type-body);
  color: var(--mp-ink-2);
  line-height: 1.6;
}

.timeline-item {
  position: relative;
  display: flex;
  gap: 12px;
  margin-bottom: 16px;
}

.timeline-dot {
  position: absolute;
  left: -20px;
  top: 4px;
  width: 12px;
  height: 12px;
  border-radius: 50%;
  background-color: var(--mp-line);
}

.timeline-item.completed .timeline-dot {
  background-color: var(--mp-sage);
}

.timeline-label {
  display: block;
  font-size: var(--mp-type-small);
  font-weight: 500;
  color: var(--mp-ink);
}

.timeline-time {
  display: block;
  font-size: var(--mp-type-meta);
  color: var(--mp-ink-3);
}

.status-item {
  display: flex;
  justify-content: space-between;
  padding: 8px 0;
  border-bottom: 1px solid var(--mp-line);
  font-size: var(--mp-type-small);
}

.label {
  color: var(--mp-ink-2);
  font-weight: 500;
}

.value {
  color: var(--mp-ink);
  text-align: right;
}

.domain-item {
  margin-top: 8px;
  padding: 8px;
  background-color: var(--mp-fill);
  border-radius: var(--mp-radius-icon);
  font-size: var(--mp-type-small);
}

.action-buttons {
  display: flex;
  flex-direction: column;
  gap: 8px;
  margin-top: 16px;
}

.action-buttons button {
  width: 100%;
}

.page-notice {
  display: block;
  text-align: center;
  font-size: var(--mp-type-meta);
  color: var(--mp-ink-3);
  padding: 12px 16px;
}
