/* F01 记忆生命周期管理 - 最小样式 */

.memory-lifecycle-page {
  background-color: var(--mp-bg);
}

.draft-banner {
  background-color: var(--mp-sun-bg);
  padding: 12px 16px;
  border-bottom: 1px solid var(--mp-line);
}

.draft-label {
  display: block;
  font-size: var(--mp-type-meta);
  color: var(--mp-ink);
  text-align: center;
}

.page-content {
  padding: 16px;
}

.card {
  background-color: var(--mp-surface);
  border-radius: var(--mp-radius-card);
  padding: 16px;
  margin-bottom: 12px;
  box-shadow: var(--mp-shadow-card);
}

.card-title {
  display: block;
  font-size: var(--mp-type-card);
  font-weight: 600;
  color: var(--mp-ink);
  margin-bottom: 12px;
}

.card-text {
  display: block;
  font-size: var(--mp-type-body);
  color: var(--mp-ink-2);
  line-height: 1.6;
}

.card-notice {
  display: block;
  font-size: var(--mp-type-meta);
  color: var(--mp-ink-3);
  margin-top: 8px;
}

.info-card,
.action-instruction,
.operation-progress,
.new-custody-card,
.status-card,
.chat-status-card {
  border-left: 4px solid var(--mp-accent);
}

.grant-item {
  border: 1px solid var(--mp-line);
  border-radius: var(--mp-radius-icon);
  padding: 12px;
  margin-bottom: 12px;
}

.grant-status {
  display: inline-block;
  font-size: var(--mp-type-meta);
  font-weight: 600;
  padding: 4px 8px;
  border-radius: 4px;
}

.grant-status.active {
  background-color: var(--mp-sage-bg);
  color: var(--mp-sage);
}

.history-item {
  border-top: 1px solid var(--mp-line);
  padding: 12px 0;
  display: flex;
  justify-content: space-between;
}

.history-action {
  display: block;
  font-size: var(--mp-type-body);
  font-weight: 500;
  color: var(--mp-ink);
}

.history-time {
  display: block;
  font-size: var(--mp-type-meta);
  color: var(--mp-ink-3);
}
