/* Parent v3 chrome. Tokens live on page in app.wxss (--mp-*). */

.trial-page {
  --trial-bg: var(--mp-bg);
  --trial-apricot: var(--mp-accent-soft);
  --trial-mint: var(--mp-accent);
  --trial-ink: var(--mp-ink);
  --trial-muted: var(--mp-ink-2);
  --trial-card: var(--mp-surface);
  --trial-radius: var(--mp-radius-card);
  --trial-accent: var(--mp-accent);
  --trial-shadow: var(--mp-shadow-card);
  min-height: 100vh;
  box-sizing: border-box;
  padding: 24rpx var(--mp-pad-page) var(--mp-tab-clearance);
  background: var(--mp-bg);
  color: var(--mp-ink);
}

.trial-title {
  display: block;
  margin: 0;
  color: var(--mp-ink);
  font-size: var(--mp-type-display);
  font-weight: 800;
  letter-spacing: -1.2rpx;
  line-height: var(--mp-lh-display);
}

.trial-caption {
  display: block;
  margin: 8rpx 0 0;
  color: var(--mp-ink-2);
  font-size: var(--mp-type-caption);
  line-height: var(--mp-lh-caption);
}

.trial-card {
  background: var(--mp-surface);
  border-radius: var(--mp-radius-card);
  border: none;
  box-shadow: var(--mp-shadow-card);
}

.trial-card-soft {
  background: var(--mp-accent-soft);
  border-radius: var(--mp-radius-card);
  box-shadow: none;
}

.trial-primary {
  margin: 0;
  padding: 0 40rpx;
  height: 112rpx;
  border-radius: 32rpx;
  background: var(--mp-ink) !important;
  color: #ffffff !important;
  font-size: var(--mp-type-button);
  font-weight: 600;
  line-height: 112rpx;
}

.trial-primary[disabled] {
  opacity: 0.55;
}

.trial-secondary {
  margin: 0;
  padding: 0 40rpx;
  height: 112rpx;
  border-radius: 32rpx;
  background: var(--mp-surface) !important;
  color: var(--mp-ink) !important;
  box-shadow: var(--mp-shadow-card);
  font-size: var(--mp-type-button);
  font-weight: 600;
  line-height: 112rpx;
}

.trial-danger {
  margin: 0;
  padding: 0 40rpx;
  height: 112rpx;
  border-radius: 32rpx;
  background: var(--mp-surface) !important;
  color: var(--mp-rust) !important;
  border: 2rpx solid var(--mp-line);
  font-size: var(--mp-type-button);
  font-weight: 600;
  line-height: 112rpx;
}

.trial-status-pill {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  padding: 0;
  border-radius: 0;
  background: transparent;
  color: var(--mp-ink-2);
  font-size: var(--mp-type-caption);
  font-weight: 500;
}

.trial-status-pill.is-off {
  color: var(--mp-ink-3);
}

.trial-status-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--mp-ink-3);
  box-shadow: none;
}

.trial-status-pill:not(.is-off) {
  color: var(--mp-sage);
}

.trial-status-pill:not(.is-off) .trial-status-dot {
  background: var(--mp-sage);
  box-shadow: 0 0 0 6rpx var(--mp-sage-bg);
}

.trial-banner {
  display: flex;
  align-items: center;
  gap: 32rpx;
  margin-bottom: var(--mp-gap-card);
  padding: 32rpx;
  border-radius: var(--mp-radius-card);
  background: var(--mp-rust-bg);
  border: none;
  color: var(--mp-rust);
}

.trial-banner-dot {
  flex-shrink: 0;
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: var(--mp-rust);
  box-shadow: none;
}

.trial-banner-copy {
  flex: 1;
  min-width: 0;
}

.trial-banner-title {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  line-height: var(--mp-lh-body);
  color: var(--mp-rust);
}

.trial-banner-meta {
  display: block;
  margin-top: 8rpx;
  color: #8a5848;
  font-size: var(--mp-type-meta);
  line-height: 1.4;
}

.trial-banner-chevron {
  color: var(--mp-rust);
  font-size: 36rpx;
  font-weight: 400;
}

.trial-inset {
  margin-top: 28rpx;
  overflow: hidden;
  background: var(--mp-surface);
  border-radius: var(--mp-radius-card);
  border: none;
  box-shadow: var(--mp-shadow-card);
}

.trial-inset-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  min-height: var(--mp-tap);
  padding: 24rpx 32rpx;
}

.trial-inset-row + .trial-inset-row {
  border-top: 1rpx solid var(--mp-line);
}

.trial-inset-label {
  color: var(--mp-ink);
  font-size: 30rpx;
  font-weight: 500;
}

.trial-inset-value {
  color: var(--mp-ink-2);
  font-size: 28rpx;
}

.trial-inset-caption {
  display: block;
  padding: 0 32rpx 28rpx;
  color: var(--mp-ink-2);
  font-size: var(--mp-type-caption);
  line-height: 1.45;
}

.trial-inset-caption.is-action {
  color: var(--mp-accent);
  text-decoration: underline;
  text-underline-offset: 4rpx;
}

.trial-link {
  color: var(--mp-accent);
  font-size: var(--mp-type-caption);
  font-weight: 500;
}

.mp-mascot-tile {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 120rpx;
  height: 120rpx;
  border-radius: var(--mp-radius-inset);
  background: var(--mp-fill);
  overflow: hidden;
}

.mp-privacy-well {
  margin-top: 24rpx;
  padding: 28rpx 32rpx;
  border-radius: var(--mp-radius-inset);
  background: var(--mp-bg);
  color: var(--mp-ink-2);
  font-size: var(--mp-type-caption);
  line-height: var(--mp-lh-caption);
}

.mp-sheet-mask {
  position: fixed;
  inset: 0;
  z-index: 100;
  background: var(--mp-scrim);
}

.mp-sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 101;
  max-height: min(86vh, 1200rpx);
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
  padding: 16rpx 40rpx calc(40rpx + env(safe-area-inset-bottom));
  border-radius: var(--mp-radius-sheet) var(--mp-radius-sheet) 0 0;
  background: var(--mp-surface);
  box-shadow: var(--mp-shadow-card);
}

.mp-sheet-grab {
  width: 72rpx;
  height: 8rpx;
  margin: 8rpx auto 28rpx;
  border-radius: 999rpx;
  background: var(--mp-fill);
}

.mp-sheet-title {
  display: block;
  margin-bottom: 24rpx;
  color: var(--mp-ink);
  font-size: var(--mp-type-title);
  font-weight: 600;
  line-height: 1.3;
}

.mp-sheet-quote {
  margin-bottom: 20rpx;
  padding: 28rpx 32rpx;
  border-radius: var(--mp-radius-inset);
  background: var(--mp-bg);
  color: var(--mp-ink);
  font-size: var(--mp-type-body);
  line-height: var(--mp-lh-body);
}

.mp-sheet-actions {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}
