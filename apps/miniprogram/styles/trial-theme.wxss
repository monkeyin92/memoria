/* Trial parent UI. Calm card layout (style reference only; no third-party assets).
   Palette is fixed by product. Shapes are CSS only. */
.trial-page {
  --trial-bg: #faf7f2;
  --trial-apricot: #f5ebdd;
  --trial-mint: #3cb8a0;
  --trial-ink: #1f2a2e;
  --trial-muted: #8a8580;
  --trial-card: #ffffff;
  --trial-radius: 40rpx;
  --trial-shadow: 0 12rpx 40rpx rgba(60, 48, 36, 0.08);
  min-height: 100vh;
  box-sizing: border-box;
  padding: 24rpx 32rpx 96rpx;
  background: var(--trial-bg);
  color: var(--trial-ink);
}

.trial-title {
  display: block;
  margin: 0;
  color: var(--trial-ink);
  font-size: 52rpx;
  font-weight: 700;
  letter-spacing: -0.5rpx;
  line-height: 1.25;
}

.trial-caption {
  display: block;
  margin: 8rpx 0 0;
  color: var(--trial-muted);
  font-size: 24rpx;
  line-height: 1.6;
}

.trial-card {
  background: var(--trial-card);
  border-radius: var(--trial-radius);
  box-shadow: var(--trial-shadow);
}

.trial-card-soft {
  background: var(--trial-apricot);
  border-radius: var(--trial-radius);
  box-shadow: none;
}

.trial-primary {
  margin: 0;
  padding: 0 40rpx;
  border-radius: 999rpx;
  background: var(--trial-mint) !important;
  color: #ffffff !important;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 96rpx;
}

.trial-primary[disabled] {
  opacity: 0.55;
}

.trial-status-pill {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  background: rgba(60, 184, 160, 0.14);
  color: #2a8f7c;
  font-size: 22rpx;
  font-weight: 600;
}

.trial-status-pill.is-off {
  background: rgba(138, 133, 128, 0.16);
  color: var(--trial-muted);
}

.trial-status-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: currentColor;
}

.trial-banner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 24rpx;
  padding: 28rpx 32rpx;
  border-radius: var(--trial-radius);
  background: var(--trial-apricot);
  color: var(--trial-ink);
  font-size: 28rpx;
  font-weight: 600;
}

.trial-banner-chevron {
  color: var(--trial-muted);
  font-size: 36rpx;
  font-weight: 400;
}

.trial-inset {
  margin-top: 28rpx;
  overflow: hidden;
  background: var(--trial-card);
  border-radius: var(--trial-radius);
  box-shadow: var(--trial-shadow);
}

.trial-inset-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  min-height: 112rpx;
  padding: 24rpx 32rpx;
}

.trial-inset-row + .trial-inset-row {
  border-top: 1rpx solid rgba(60, 48, 36, 0.06);
}

.trial-inset-label {
  color: var(--trial-ink);
  font-size: 30rpx;
  font-weight: 500;
}

.trial-inset-value {
  color: var(--trial-muted);
  font-size: 28rpx;
}
