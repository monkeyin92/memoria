/* Parent v4 chrome shared by home, device, bind and child-memory. Tokens live on page in app.wxss (--mp-*). */

.trial-page {
  --trial-bg: var(--mp-bg);
  --trial-apricot: var(--mp-accent-soft);
  --trial-mint: var(--mp-accent);
  --trial-ink: var(--mp-ink);
  --trial-muted: var(--mp-ink-2);
  --trial-card: var(--mp-surface);
  --trial-radius: var(--mp-radius-card);
  --trial-accent: var(--mp-accent);
  --trial-shadow: var(--mp-shadow-card);
  min-height: 100vh;
  box-sizing: border-box;
  padding: 24rpx var(--mp-pad-page) var(--mp-page-foot);
  background: var(--mp-bg);
  color: var(--mp-ink);
}

.trial-page.tab-page {
  padding-bottom: var(--mp-tab-clearance);
}

.trial-title {
  display: block;
  margin: 8rpx 0 0;
  color: var(--mp-ink);
  font-size: var(--mp-type-display);
  font-weight: 800;
  letter-spacing: -1.2rpx;
  line-height: var(--mp-lh-display);
}

.trial-caption {
  display: block;
  margin: 8rpx 0 0;
  color: var(--mp-ink-2);
  font-size: var(--mp-type-caption);
  line-height: var(--mp-lh-caption);
}

.trial-card {
  box-sizing: border-box;
  background: var(--mp-surface);
  border-radius: var(--mp-radius-card);
  border: none;
  box-shadow: var(--mp-shadow-card);
}

.trial-card-xl {
  border-radius: var(--mp-radius-card-xl);
}

.trial-primary,
.trial-secondary,
.trial-danger {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  width: 100%;
  margin: 0;
  padding: 0 40rpx;
  min-height: var(--mp-tap);
  border-radius: var(--mp-radius-inset);
  font-size: var(--mp-type-button);
  font-weight: 600;
  line-height: 1.4;
}

.trial-primary {
  background: var(--mp-ink) !important;
  color: var(--mp-on-accent) !important;
}

.trial-primary[disabled] {
  opacity: 0.55;
}

.trial-secondary {
  background: var(--mp-surface) !important;
  color: var(--mp-ink) !important;
  box-shadow: var(--mp-shadow-card);
}

.trial-danger {
  background: var(--mp-surface) !important;
  color: var(--mp-rust) !important;
  border: 2rpx solid var(--mp-line);
}

.trial-status-pill {
  display: inline-flex;
  align-items: center;
  gap: 12rpx;
  min-height: 48rpx;
  padding: 0 24rpx;
  border-radius: var(--mp-radius-pill);
  background: var(--mp-sage-bg);
  color: var(--mp-sage);
  font-size: var(--mp-type-meta);
  font-weight: 600;
  white-space: nowrap;
}

.trial-status-pill.is-off {
  background: var(--mp-fill);
  color: var(--mp-ink-2);
}

.trial-status-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: currentColor;
}

.trial-banner {
  display: flex;
  align-items: center;
  gap: 32rpx;
  margin-top: 48rpx;
  padding: var(--mp-pad-card);
  border-radius: var(--mp-radius-card);
  background: var(--mp-rust-bg);
  border: none;
  color: var(--mp-rust);
}

.trial-banner-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: var(--mp-icon);
  height: var(--mp-icon);
  border-radius: var(--mp-radius-icon);
  background: var(--mp-rust-tile);
}

.trial-banner-icon image {
  width: 48rpx;
  height: 48rpx;
}

.trial-banner-copy {
  flex: 1;
  min-width: 0;
}

.trial-banner-title {
  display: block;
  color: var(--mp-rust);
  font-size: var(--mp-type-card);
  font-weight: 600;
  line-height: var(--mp-lh-card);
}

.trial-banner-meta {
  display: block;
  margin-top: 8rpx;
  color: var(--mp-rust-ink);
  font-size: var(--mp-type-meta);
  line-height: 1.4;
}

.trial-banner-chevron {
  flex-shrink: 0;
  color: var(--mp-rust);
  font-size: var(--mp-type-title);
  font-weight: 400;
}

.trial-inset {
  margin-top: var(--mp-gap-card);
  overflow: hidden;
  background: var(--mp-surface);
  border-radius: var(--mp-radius-card);
  border: none;
  box-shadow: var(--mp-shadow-card);
}

.trial-inset-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  min-height: var(--mp-tap);
  padding: 24rpx 32rpx;
}

.trial-inset-row + .trial-inset-row {
  border-top: 1rpx solid var(--mp-line);
}

.trial-inset-label {
  flex-shrink: 0;
  color: var(--mp-ink);
  font-size: var(--mp-type-body);
  font-weight: 500;
}

.trial-inset-value {
  min-width: 0;
  color: var(--mp-ink-2);
  font-size: var(--mp-type-body);
  text-align: right;
  word-break: break-all;
}

.trial-inset-caption {
  display: block;
  padding: 0 32rpx 28rpx;
  color: var(--mp-ink-2);
  font-size: var(--mp-type-caption);
  line-height: var(--mp-lh-caption);
}

.trial-inset-caption.is-action {
  color: var(--mp-accent);
  text-decoration: underline;
  text-underline-offset: 4rpx;
}

.trial-link {
  color: var(--mp-accent);
  font-size: var(--mp-type-caption);
  font-weight: 600;
}

.mp-mascot-tile {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 112rpx;
  height: 112rpx;
  border-radius: var(--mp-radius-inset);
  background: var(--mp-accent-soft);
  overflow: hidden;
}

.mp-icon-tile {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: var(--mp-icon);
  height: var(--mp-icon);
  border-radius: var(--mp-radius-icon);
  background: var(--mp-accent-soft);
}

.mp-icon-tile image {
  width: 48rpx;
  height: 48rpx;
}

.mp-privacy-well {
  margin-top: 24rpx;
  padding: 28rpx 32rpx;
  border-radius: var(--mp-radius-inset);
  background: var(--mp-bg);
  color: var(--mp-ink-2);
  font-size: var(--mp-type-caption);
  line-height: var(--mp-lh-caption);
}

.mp-sheet-quote {
  margin-bottom: 24rpx;
  padding: 28rpx 32rpx;
  border-radius: var(--mp-radius-inset);
  background: var(--mp-bg);
  color: var(--mp-ink);
  font-size: var(--mp-type-body);
  line-height: var(--mp-lh-body);
}

.mp-sheet-actions {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}
