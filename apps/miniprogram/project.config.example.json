{
  "description": "Memoria 微信小程序。导入前复制为 project.config.json，替换 appid，并配置合法域名。",
  "packOptions": {
    "ignore": [
      {
        "value": "tests",
        "type": "folder"
      },
      {
        "value": "design-preview",
        "type": "folder"
      }
    ],
    "include": [
      {
        "value": "assets/bg/night-stars.png",
        "type": "file"
      }
    ]
  },
  "setting": {
    "urlCheck": true,
    "es6": true,
    "enhance": true,
    "postcss": true,
    "minified": true,
    "compileWorklet": false,
    "uglifyFileName": false,
    "uploadWithSourceMap": true,
    "packNpmManually": false,
    "packNpmRelationList": [],
    "minifyWXSS": true,
    "minifyWXML": true,
    "localPlugins": false,
    "disableUseStrict": false,
    "useCompilerPlugins": false,
    "condition": false,
    "ignoreUploadUnusedFiles": true,
    "swc": false,
    "disableSWC": true,
    "babelSetting": {
      "ignore": [],
      "disablePlugins": [],
      "outputPath": ""
    }
  },
  "compileType": "miniprogram",
  "libVersion": "3.7.10",
  "appid": "touristappid",
  "projectname": "memoria-miniprogram",
  "simulatorPluginLibVersion": {},
  "editorSetting": {}
}
