diff --git a/main/audio/engines/afe_audio_engine.cc b/main/audio/engines/afe_audio_engine.cc
--- a/main/audio/engines/afe_audio_engine.cc
+++ b/main/audio/engines/afe_audio_engine.cc
@@ -137,8 +137,17 @@ bool AfeAudioEngine::Initialize(AudioCodec* codec, srmodel_list_t* models) {
     afe_config->aec_nlp_level = AEC_NLP_LEVEL_VERYAGGR;
     afe_config->ns_init = false;
     afe_config->vad_init = kUseAfeForVoiceProcessing;
+#if defined(CONFIG_BOARD_TYPE_MEMORIA_ATK_DNESP32S3_V1) && \
+    CONFIG_BOARD_TYPE_MEMORIA_ATK_DNESP32S3_V1
+    // ES8388 on the Memoria simplex board has no playback reference. Use a
+    // moderately aggressive detector and the same 300 ms silence floor as
+    // the Agent instead of allowing speaker tail/noise to latch VAD forever.
+    afe_config->vad_mode = VAD_MODE_2;
+    afe_config->vad_min_noise_ms = 300;
+#else
     afe_config->vad_mode = VAD_MODE_0;
     afe_config->vad_min_noise_ms = 100;
+#endif
     if (vad_model_name != nullptr) {
         afe_config->vad_model_name = vad_model_name;
     }
