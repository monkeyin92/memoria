diff --git a/main/audio/engines/afe_audio_engine.cc b/main/audio/engines/afe_audio_engine.cc
--- a/main/audio/engines/afe_audio_engine.cc
+++ b/main/audio/engines/afe_audio_engine.cc
@@ -137,8 +137,19 @@ bool AfeAudioEngine::Initialize(AudioCodec* codec, srmodel_list_t* models) {
     afe_config->aec_nlp_level = AEC_NLP_LEVEL_VERYAGGR;
     afe_config->ns_init = false;
     afe_config->vad_init = kUseAfeForVoiceProcessing;
+#if defined(CONFIG_BOARD_TYPE_MEMORIA_ESP_VOCAT) && \
+    CONFIG_BOARD_TYPE_MEMORIA_ESP_VOCAT
+    // ES8388 on the Memoria simplex board has no playback reference. ESP-SR
+    // defines larger VAD modes as having a higher speech-trigger probability,
+    // so keep the strictest mode to reject steady room/playback noise. Retain
+    // a 900 ms quiet tail for natural pauses in short Chinese utterances.
+    // The protocol layer still supplies the independent 20 s hard fence.
+    afe_config->vad_mode = VAD_MODE_0;
+    afe_config->vad_min_noise_ms = 900;
+#else
     afe_config->vad_mode = VAD_MODE_0;
     afe_config->vad_min_noise_ms = 100;
+#endif
     if (vad_model_name != nullptr) {
         afe_config->vad_model_name = vad_model_name;
     }
