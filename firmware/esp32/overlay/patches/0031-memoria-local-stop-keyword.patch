+bool AfeAudioEngine::EnableStopKeywordDetection() {
+    // Stop keywords are MultiNet commands; WakeNet has no command graph. The
+    // detector shares the AFE (AEC/NS) output that also feeds the uplink.
+    if (wake_detector_ != WakeDetector::kMultiNet || custom_wake_word_ == nullptr) {
+        return false;
     }
+    custom_wake_word_->SetStopOnly(true);
+    custom_wake_word_->Start();
+    xEventGroupSetBits(event_group_, kWakeWordEnabled);
     UpdateActiveState();
+    return true;
 }
 
+bool AfeAudioEngine::IsStopKeywordDetectionEnabled() const {
+    return wake_detector_ == WakeDetector::kMultiNet && custom_wake_word_ != nullptr &&
+        IsWakeWordDetectionEnabled() && custom_wake_word_->IsStopOnly();
+}
