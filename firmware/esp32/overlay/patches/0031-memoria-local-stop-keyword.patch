+
+void CustomWakeWord::HandleStopCommand(const Command& command, float score) {
+    const int64_t now_ms = esp_timer_get_time() / 1000;
+    const memoria::LocalStopVerdict verdict =
+        stop_gate_.Evaluate(command.text.c_str(), score, stop_only_.load(), now_ms);
+    const memoria::LocalStopPhrase* phrase = memoria::FindLocalStopPhrase(command.text.c_str());
+    ESP_LOGI(TAG, "Local stop keyword %s: id=%s prob=%.3f min=%.2f",
+             memoria::LocalStopVerdictName(verdict), command.text.c_str(),
+             static_cast<double>(score),
+             static_cast<double>(phrase != nullptr ? phrase->min_score : 0.0f));
+    if (verdict == memoria::LocalStopVerdict::kAccept && stop_keyword_detected_callback_) {
+        stop_keyword_detected_callback_(command.text, score);
+    }
+}
