+bool AudioService::EnableStopKeywordDetection() {
+    if (!InitializeAudioEngine() || !audio_engine_->HasWakeWord()) {
+        xEventGroupClearBits(event_group_, AS_EVENT_WAKE_WORD_RUNNING);
+        return false;
+    }
+    // Unlike EnableWakeWordDetection, keep the input resampler state: in
+    // realtime playback the same capture stream is still being uplinked.
+    if (!audio_engine_->EnableStopKeywordDetection()) {
+        audio_engine_->EnableWakeWordDetection(false);
         xEventGroupClearBits(event_group_, AS_EVENT_WAKE_WORD_RUNNING);
+        return false;
     }
+    xEventGroupSetBits(event_group_, AS_EVENT_WAKE_WORD_RUNNING);
+    return true;
 }
 
+bool AudioService::IsStopKeywordDetectionEnabled() const {
+    return audio_engine_initialized_ && audio_engine_->IsStopKeywordDetectionEnabled();
+}
