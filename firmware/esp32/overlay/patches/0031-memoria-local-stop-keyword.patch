+#if CONFIG_BOARD_TYPE_MEMORIA_ESP_VOCAT
+void Application::ConfigureStopKeywordForSpeaking() {
+    // Wake words stay ignored during playback. With the signed "keyword"
+    // barge-in source the MultiNet detector keeps running in stop-only mode
+    // on the AEC/NS output so the owner can stop playback by voice; each hit
+    // re-checks that a generation is really playing (LocalStopKeywordArmed).
+    auto* memoria_protocol = static_cast<memoria::MemoriaProtocol*>(protocol_.get());
+    if (memoria_protocol != nullptr && memoria_protocol->KeywordBargeInAllowed() &&
+        audio_service_.EnableStopKeywordDetection()) {
+        ESP_LOGI(TAG, "Local stop keyword armed for playback");
+        return;
     }
+    audio_service_.EnableWakeWordDetection(false);
 }
 
+void Application::HandleLocalStopKeyword(const std::string& phrase_id, float score) {
+    auto* memoria_protocol = static_cast<memoria::MemoriaProtocol*>(protocol_.get());
+    const DeviceState state = GetDeviceState();
+    if (state != kDeviceStateSpeaking || memoria_protocol == nullptr) {
+        ESP_LOGI(TAG, "Local stop keyword %s ignored outside playback (state: %d)",
+                 phrase_id.c_str(), static_cast<int>(state));
+        return;
+    }
+    memoria::MemoriaProtocol::LocalStopKeywordHit hit;
+    hit.keyword_id = phrase_id;
+    hit.score = score;
+    hit.near_end_rms = audio_service_.LastUplinkRms();
+    hit.voice_detected = audio_service_.IsVoiceDetected();
+    // The same L0 hard stop as BOOT (AbortSpeaking): close the protocol gate,
+    // flush the audio pipeline, then report keyword.detected with the fence.
+    if (!memoria_protocol->NotifyLocalKeywordStop(hit)) {
+        ESP_LOGI(TAG, "Local stop keyword %s ignored: no playing generation it may stop",
+                 phrase_id.c_str());
+        return;
+    }
+    ESP_LOGI(TAG, "Local stop keyword %s (prob=%.3f) stopped playback", phrase_id.c_str(),
+             static_cast<double>(score));
+    aborted_ = true;
+}
+#endif
