+void Application::HandleMediaTransportClosedEvent() {
+    auto* memoria_protocol = static_cast<memoria::MemoriaProtocol*>(protocol_.get());
+    const uint32_t closed_transport_attempt = media_closed_transport_attempt_.load();
+    if (memoria_protocol != nullptr &&
+        memoria_protocol->TransportAttemptId() != closed_transport_attempt) {
+        // This close event belongs to an older WSS. Its transport cleanup ran,
+        // but it has no authority over the newer epoch's UI or microphone.
+        return;
+    }
+
+    auto display = Board::GetInstance().GetDisplay();
+    display->SetChatMessage("system", "");
+    const DeviceState state = GetDeviceState();
+    if (!media_recovery_pending_ && memoria_protocol != nullptr &&
+        memoria_protocol->CanResumeSession() &&
+        (state == kDeviceStateIdle || state == kDeviceStateConnecting ||
+         state == kDeviceStateListening || state == kDeviceStateSpeaking)) {
+        // A close notification and SetError can wake the same EventGroup
+        // snapshot. Preserve the semantic state here, before the error branch,
+        // so listening never becomes an idle recovery target.
+        media_recovery_previous_state_ = state;
+        media_recovery_pending_ = true;
+        media_reconnect_attempt_ = 0;
+        media_reconnect_due_us_ =
+            esp_timer_get_time() + kMediaReconnectCallbackGraceUs;
+        SetDeviceState(kDeviceStateRecovering);
+    }
+    if (media_recovery_pending_) {
+        if (GetDeviceState() != kDeviceStateRecovering) {
+            SetDeviceState(kDeviceStateRecovering);
+        }
+        // Reopening here could destroy WebSocket callback storage while the
+        // receive task is returning. A later clock tick crosses the grace.
+        return;
+    }
+    SetDeviceState(kDeviceStateIdle);
+}
