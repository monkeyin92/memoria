+bool LcdDisplay::ShowQrCode(const std::string& payload, const char* caption) {
+    if (!setup_ui_called_ || payload.empty() || !Lock(1000)) {
+        return false;
+    }
+    if (qr_overlay_ != nullptr) {
+        lv_obj_del(qr_overlay_);
+        qr_overlay_ = nullptr;
+        qr_code_ = nullptr;
+        qr_caption_ = nullptr;
+    }
+    qr_overlay_ = lv_obj_create(lv_screen_active());
+    if (qr_overlay_ == nullptr) {
+        Unlock();
+        return false;
+    }
+    lv_obj_set_size(qr_overlay_, LV_HOR_RES, LV_VER_RES);
+    lv_obj_set_style_radius(qr_overlay_, 0, 0);
+    lv_obj_set_style_bg_opa(qr_overlay_, LV_OPA_COVER, 0);
+    lv_obj_set_style_bg_color(qr_overlay_, lv_color_white(), 0);
+    lv_obj_set_style_border_width(qr_overlay_, 0, 0);
+    lv_obj_set_style_pad_all(qr_overlay_, 0, 0);
+    qr_code_ = lv_qrcode_create(qr_overlay_);
+    if (qr_code_ == nullptr) {
+        lv_obj_del(qr_overlay_);
+        qr_overlay_ = nullptr;
+        Unlock();
+        return false;
+    }
+    lv_qrcode_set_size(qr_code_, 190);
+    lv_qrcode_set_dark_color(qr_code_, lv_color_black());
+    lv_qrcode_set_light_color(qr_code_, lv_color_white());
+    lv_qrcode_set_quiet_zone(qr_code_, true);
+    if (lv_qrcode_update(qr_code_, payload.data(), payload.size()) != LV_RESULT_OK) {
+        lv_obj_del(qr_overlay_);
+        qr_overlay_ = nullptr;
+        qr_code_ = nullptr;
+        Unlock();
+        return false;
+    }
+    lv_obj_center(qr_code_);
+    lv_obj_set_y(qr_code_, -17);
+    qr_caption_ = lv_label_create(qr_overlay_);
+    if (qr_caption_ == nullptr) {
+        lv_obj_del(qr_overlay_);
+        qr_overlay_ = nullptr;
+        qr_code_ = nullptr;
+        Unlock();
+        return false;
+    }
+    lv_label_set_text(qr_caption_, caption == nullptr ? "微信扫码绑定" : caption);
+    lv_obj_set_style_text_color(qr_caption_, lv_color_black(), 0);
+    lv_obj_align(qr_caption_, LV_ALIGN_BOTTOM_MID, 0, -4);
+    Unlock();
+    return true;
+}
+
+void LcdDisplay::ClearQrCode() {
+    if (!Lock(1000)) {
+        return;
+    }
+    if (qr_overlay_ != nullptr) {
+        lv_obj_del(qr_overlay_);
+        qr_overlay_ = nullptr;
+        qr_code_ = nullptr;
+        qr_caption_ = nullptr;
+    }
+    Unlock();
+}
 
