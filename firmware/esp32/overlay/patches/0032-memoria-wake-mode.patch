+
+void Application::ArmIdleWakeWord() {
+#if CONFIG_BOARD_TYPE_MEMORIA_ESP_VOCAT
+    // The phone's wake mode: with the screen as the only way in, the wake word
+    // stays off while idle.
+    audio_service_.EnableWakeWordDetection(
+        memoria::WakeModeRegistry::GetInstance().keyword_enabled());
+#else
+    audio_service_.EnableWakeWordDetection(true);
+#endif
+}
+
+void Application::RefreshWakeMode() {
+    // Called from the display-profile poll task when the phone changed the mode.
+    Schedule([this]() {
+        if (GetDeviceState() == kDeviceStateIdle) {
+            ArmIdleWakeWord();
+        }
+    });
 }
 
