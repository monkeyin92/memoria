 void AudioService::SetDecodeSampleRate(int sample_rate, int frame_duration) {
+    /* Opus decodes any stream at any of its rates, so decode straight to the codec
+     * rate and skip esp_ae_rate_cvt. Version 1.3 keeps samples from the last sound
+     * and writes them past out_sample_num when the next frame is shorter: the 16 kHz
+     * local cues smashed the heap on tap wake (#290). */
+    const int codec_rate = codec_->output_sample_rate();
+    if (codec_rate == 8000 || codec_rate == 12000 || codec_rate == 16000 || codec_rate == 24000 ||
+        codec_rate == 48000) {
+        sample_rate = codec_rate;
+    }
     if (decoder_sample_rate_ == sample_rate && decoder_duration_ms_ == frame_duration) {
         return;
     }
