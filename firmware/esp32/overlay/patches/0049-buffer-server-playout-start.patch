+
+bool AudioService::WaitForServerPlayoutPrefillLocked(std::unique_lock<std::mutex>& lock) {
+    const uint32_t generation = audio_playback_queue_.front()->generation_id;
+    const uint32_t epoch = playback_generation_;
+    if (generation == 0 || server_playout_prefill_epoch_ == epoch) {
+        return true;
+    }
+    const auto deadline = std::chrono::steady_clock::now() + std::chrono::milliseconds(320);
+    const size_t frame_samples = static_cast<size_t>(codec_->output_sample_rate()) / 50;
+    audio_queue_cv_.wait_until(lock, deadline, [this, generation, epoch, frame_samples]() {
+        if (service_stopped_.load() || playback_generation_ != epoch) {
+            return true;
+        }
+        const auto pcm_frames = std::count_if(audio_playback_queue_.begin(), audio_playback_queue_.end(),
+            [generation, frame_samples](const auto& task) {
+                return task->generation_id == generation && task->pcm.size() == frame_samples;
+            });
+        const auto opus_frames = std::count_if(audio_decode_queue_.begin(), audio_decode_queue_.end(),
+            [generation](const auto& packet) {
+                return packet->generation_id == generation && packet->frame_duration == 20;
+            });
+        return pcm_frames + opus_frames >= 16;
+    });
+    if (service_stopped_.load() || playback_generation_ != epoch || audio_playback_queue_.empty()) {
+        return false;
+    }
+    server_playout_prefill_epoch_ = epoch;
+    return true;
 }
 
