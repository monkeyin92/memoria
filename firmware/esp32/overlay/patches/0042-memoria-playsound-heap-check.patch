+#if CONFIG_HEAP_POISONING_COMPREHENSIVE
+static memoria::CanaryUsWindow g_canary_us;
+static portMUX_TYPE g_canary_us_mux = portMUX_INITIALIZER_UNLOCKED;
+
+static void NoteCanaryUs(uint32_t us) {
+    portENTER_CRITICAL(&g_canary_us_mux);
+    g_canary_us.Note(us);
+    portEXIT_CRITICAL(&g_canary_us_mux);
+}
+
+static void PsramHeapCheckTask(void* arg) {
+    (void)arg;
+    for (;;) {
+        vTaskDelay(pdMS_TO_TICKS(30000));
+        int64_t started = esp_timer_get_time();
+        bool ok = heap_caps_check_integrity(MALLOC_CAP_SPIRAM, true);
+        int64_t scan_us = esp_timer_get_time() - started;
+        if (scan_us < 0) {
+            scan_us = 0;
+        }
+        uint32_t n = 0;
+        uint32_t min_us = 0;
+        uint32_t max_us = 0;
+        uint32_t avg_us = 0;
+        portENTER_CRITICAL(&g_canary_us_mux);
+        g_canary_us.Take(n, min_us, max_us, avg_us);
+        portEXIT_CRITICAL(&g_canary_us_mux);
+        ESP_LOGI(TAG,
+                 "poison canary n=%" PRIu32 " min_us=%" PRIu32 " max_us=%" PRIu32
+                 " avg_us=%" PRIu32 " psram_scan_us=%" PRId64,
+                 n, min_us, max_us, avg_us, scan_us);
+        if (!ok) {
+            ESP_LOGE(TAG, "PSRAM heap integrity failed");
+        }
+    }
+}
+#endif
