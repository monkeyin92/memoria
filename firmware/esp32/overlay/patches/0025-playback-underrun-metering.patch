+/* Memoria playback supply metering (observation only; the boundary, the
+ * attribution rules and the honesty scope live in
+ * memoria_playback_supply_meter.h).  Every log line is emitted after the audio
+ * queue lock is released: a UART write inside the lock would delay the queue
+ * producer and consumer this meter observes. */
+#define MEMORIA_PLAYBACK_SUPPLY_LOG_MS 40
+
+static int64_t MemoriaSupplyNowMs() {
+    return esp_timer_get_time() / 1000;
+}
+
+static void MemoriaLogSupplySummary(const memoria::SupplyEpisodeSummary& summary) {
+    if (!summary.valid) {
+        return;
+    }
+    /* The WSS receive callback has a 4 KiB task stack. Keep this scratch
+     * buffer off that stack, without sharing mutable storage across tasks. */
+    std::unique_ptr<char[]> buffer(new (std::nothrow) char[memoria::kSupplySummaryLogCapacity]);
+    if (!buffer) {
+        ESP_LOGW(TAG, "media playback supply summary dropped: allocation failed");
+        return;
+    }
+    if (memoria::FormatSupplySummaryLog(
+            buffer.get(), memoria::kSupplySummaryLogCapacity, summary) > 0) {
+        ESP_LOGI(TAG, "%s", buffer.get());
+    } else {
+        ESP_LOGW(TAG, "media playback supply summary dropped: buffer too small");
+    }
+}
+
+static void MemoriaLogSupplyWait(const memoria::SupplyWaitRecord& record) {
+    if (!record.valid || record.wait_ms < MEMORIA_PLAYBACK_SUPPLY_LOG_MS) {
+        return;
+    }
+    char buffer[memoria::kSupplyWaitLogCapacity];
+    if (memoria::FormatSupplyWaitLog(buffer, sizeof(buffer), record) > 0) {
+        ESP_LOGW(TAG, "%s", buffer);
+    }
+}
