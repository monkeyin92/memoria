+/* Memoria playback metering (diagnostic only; no behaviour change).
+ * A downlink answer is produced at ~1.0x realtime, so the playout queue is
+ * never deep and any jitter starves it.  The delivery ledger records
+ * "playback completed" while the listener hears stuttering, so count the
+ * starvation episodes: the codec task is the only producer of
+ * audio_playback_queue_, and the consumer waits for frames here.  Duration is
+ * the observed I2S write granularity, so anything clearly longer than one
+ * frame is a gap the DAC had nothing to play. */
+#define MEMORIA_STARVE_LOG_MS 40
+static uint32_t memoria_meter_generation = 0;
+static uint32_t memoria_meter_stream_generation = 0;
+static bool memoria_meter_streaming = false;
