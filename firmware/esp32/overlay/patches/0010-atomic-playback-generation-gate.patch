-        audio_queue_cv_.notify_all();
+bool AudioService::ResetDecoderLocked(uint32_t accepted_server_generation) {
+    ++playback_generation_;
+    accepted_server_generation_ = accepted_server_generation;
+    std::unique_lock<std::mutex> decoder_lock(decoder_mutex_);
+    if (opus_decoder_ != nullptr) {
+        esp_opus_dec_reset(opus_decoder_);
     }
+    decoder_lock.unlock();
+    timestamp_queue_.clear();
+    audio_decode_queue_.clear();
+    audio_playback_queue_.clear();
+    audio_testing_queue_.clear();
+    const bool notify_drained = MarkPlaybackDrainedLocked();
+    audio_queue_cv_.notify_all();
+    return notify_drained;
+}
+
+void AudioService::ResetDecoder() {
+    bool notify_drained = false;
+    {
+        std::lock_guard<std::mutex> lock(audio_queue_mutex_);
+        notify_drained = ResetDecoderLocked(accepted_server_generation_);
+    }
+    if (notify_drained && callbacks_.on_playback_drained) {
+        callbacks_.on_playback_drained();
+    }
+}
+
+void AudioService::ResetDecoderForServerGeneration(uint32_t generation_id) {
+    bool notify_drained = false;
+    {
+        std::lock_guard<std::mutex> lock(audio_queue_mutex_);
+        notify_drained = ResetDecoderLocked(generation_id);
+    }
     if (notify_drained && callbacks_.on_playback_drained) {
         callbacks_.on_playback_drained();
     }
 }
