+#if CONFIG_BOARD_TYPE_MEMORIA_ESP_VOCAT
+void Application::CancelMediaRecovery(bool terminal_close) {
+    media_recovery_pending_ = false;
+    media_reconnect_attempt_ = 0;
+    media_reconnect_due_us_ = 0;
+    if (terminal_close && protocol_ != nullptr) {
+        protocol_->CloseAudioChannel(true);
+    }
+    if (GetDeviceState() == kDeviceStateRecovering) {
+        SetDeviceState(kDeviceStateIdle);
+    }
+}
+
+void Application::ContinueMediaRecovery() {
+    if (!media_recovery_pending_ || !media_network_connected_.load() ||
+        GetDeviceState() != kDeviceStateRecovering || protocol_ == nullptr ||
+        esp_timer_get_time() < media_reconnect_due_us_) {
+        return;
+    }
+    auto* memoria_protocol = static_cast<memoria::MemoriaProtocol*>(protocol_.get());
+    if (memoria_protocol == nullptr || !memoria_protocol->CanResumeSession()) {
+        CancelMediaRecovery(false);
+        return;
+    }
+
+    ++media_reconnect_attempt_;
+    ESP_LOGI(TAG, "Resuming device media Session, attempt=%u/%u",
+             static_cast<unsigned int>(media_reconnect_attempt_),
+             static_cast<unsigned int>(kMediaReconnectMaxAttempts));
+    if (protocol_->OpenAudioChannel()) {
+        media_recovery_pending_ = false;
+        media_reconnect_attempt_ = 0;
+        media_reconnect_due_us_ = 0;
+        if (memoria_protocol->HasActivePlaybackGeneration()) {
+            SetDeviceState(kDeviceStateSpeaking);
+        } else if (media_recovery_previous_state_ == kDeviceStateListening ||
+                   (media_recovery_previous_state_ == kDeviceStateSpeaking &&
+                    listening_mode_ != kListeningModeManualStop)) {
+            // Symmetric with the normal tts-stop path: if playback completed
+            // while this auto/realtime client was disconnected, resume the
+            // microphone instead of stranding the conversation in idle.
+            SetListeningMode(listening_mode_);
+        } else {
+            SetDeviceState(kDeviceStateIdle);
+        }
+        return;
+    }
+
+    if (media_reconnect_attempt_ >= kMediaReconnectMaxAttempts ||
+        !memoria_protocol->CanResumeSession()) {
+        ESP_LOGW(TAG, "Device media recovery exhausted or denied");
+        CancelMediaRecovery(true);
+        return;
+    }
+    // Bounded exponential backoff: 1, 2, 4, 8 seconds between attempts.
+    const uint32_t delay_s = 1U << (media_reconnect_attempt_ - 1U);
+    media_reconnect_due_us_ = esp_timer_get_time() + static_cast<int64_t>(delay_s) * 1000000;
+}
+#endif
