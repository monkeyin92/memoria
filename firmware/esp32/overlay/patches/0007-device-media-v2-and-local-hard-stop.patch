 void Application::AbortSpeaking(AbortReason reason) {
     ESP_LOGI(TAG, "Abort speaking");
     aborted_ = true;
+#if CONFIG_BOARD_TYPE_MEMORIA_ATK_DNESP32S3_V1
+    // L0 physical hard stop: flush the local playback pipeline synchronously
+    // so nothing more is heard, then report the stop with the pre-flush fence
+    // and local flush sample end. The server closes the generation gate;
+    // late frames of the old generation are dropped and counted by the
+    // protocol and must never resume playback.
+    audio_service_.ResetDecoder();
+    auto* memoria_protocol = static_cast<memoria::MemoriaProtocol*>(protocol_.get());
+    if (memoria_protocol != nullptr) {
+        memoria_protocol->NotifyLocalFlush();
+    }
+#else
     if (protocol_) {
         protocol_->SendAbortSpeaking(reason);
     }
+#endif
 }
 
