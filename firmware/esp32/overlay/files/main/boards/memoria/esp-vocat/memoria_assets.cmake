function(memoria_strip_offline_audio assets_var)
    set(source "${${assets_var}}")
    set(stage "${CMAKE_BINARY_DIR}/memoria-assets-no-offline-audio")
    if(NOT IS_DIRECTORY "${source}")
        message(FATAL_ERROR "memoria_strip_offline_audio: not a directory: ${source}")
    endif()
    file(REMOVE_RECURSE "${stage}")
    file(COPY "${source}/" DESTINATION "${stage}" REGEX "\\.[Oo][Gg][Gg]$" EXCLUDE)
    set(${assets_var} "${stage}" PARENT_SCOPE)
endfunction()

if(CMAKE_SCRIPT_MODE_FILE STREQUAL CMAKE_CURRENT_LIST_FILE)
    set(MEMORIA_ASSETS "${MEMORIA_ASSETS_SOURCE}")
    memoria_strip_offline_audio(MEMORIA_ASSETS)
    message("${MEMORIA_ASSETS}")
endif()
