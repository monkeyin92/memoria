# Runtime
# This development sample defaults to optional LiveKit Cloud. Current production
# self-hosted settings are documented in infra/memoria.env.production.example.
ENVIRONMENT=development
DEPLOYMENT_PROFILE=livekit_cloud
LOG_LEVEL=INFO
LLM_PROVIDER=qwen
PUBLIC_BASE_URL=http://localhost:8000
ALLOWED_ORIGINS=http://localhost:5173

# LiveKit
LIVEKIT_URL=wss://YOUR_PROJECT.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_AGENT_NAME=duplex-zh-agent
LIVEKIT_TURN_DETECTOR_VERSION=v1
LIVEKIT_ADAPTIVE_INTERRUPTION=true
# 自建本地 LiveKit 可改为：
# LIVEKIT_URL=ws://localhost:7880
# LIVEKIT_API_KEY=devkey
# LIVEKIT_API_SECRET=devsecret
# DEPLOYMENT_PROFILE=cn_self_hosted
# LIVEKIT_TURN_DETECTOR_VERSION=v1-mini
# LIVEKIT_ADAPTIVE_INTERRUPTION=false

# Alibaba Model Studio / DashScope
DASHSCOPE_API_KEY=
# Optional: override only when the model page provides a different workspace host prefix.
# DASHSCOPE_WORKSPACE_ID=llm-qp8mf178biax7m6c
QWEN_OMNI_VOICE=Liora Mira
# QWEN_OMNI_VOICE_CLONE_ID=
QWEN_OMNI_PERSONA_LABEL=Memoria 人设声
QWEN_OMNI_SDP_TIMEOUT_S=10
DASHSCOPE_REGION=cn-beijing
DASHSCOPE_WS_URL=wss://dashscope.aliyuncs.com/api-ws/v1/inference
DASHSCOPE_COMPATIBLE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_FAST_MODEL=qwen-turbo
QWEN_DEEP_MODEL=qwen-plus
DASHSCOPE_SUMMARY_MODEL=qwen-plus
DASHSCOPE_SUMMARY_TIMEOUT_S=30
QWEN_EMOTION_ENABLED=true

# Listener backchannels ("嗯/我在听") while the user is speaking.
# Default: main_track (session.say, no second room track). background needs AEC.
LISTENER_CUES_ENABLED=true
LISTENER_CUE_PLAYBACK=main_track
LISTENER_CUE_AEC_VALIDATED=false
LISTENER_CUE_PAUSE_MS=250
LISTENER_CUE_MIN_SPEECH_MS=1800
LISTENER_CUE_COOLDOWN_MS=5000
LISTENER_CUE_MAX_PER_TURN=2
LISTENER_CUE_VOLUME=0.65
COSYVOICE_PARALINGUISTIC_TAGS=true

# FunASR
FUNASR_MODEL=fun-asr-realtime
FUNASR_SAMPLE_RATE=16000
FUNASR_LANGUAGE=zh
FUNASR_CHUNK_MS=80
FUNASR_MAX_SENTENCE_SILENCE_MS=400
FUNASR_SEMANTIC_PUNCTUATION=false
FUNASR_HEARTBEAT=true
FUNASR_RECONNECT_AUDIO_MS=1500
FUNASR_CONNECT_TIMEOUT_S=5
FUNASR_RESULT_TIMEOUT_S=8

# DeepSeek
# Optional override. Set LLM_PROVIDER=deepseek and provide the key to enable it.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_FAST_MODEL=deepseek-v4-flash
DEEPSEEK_DEEP_MODEL=deepseek-v4-pro
DEEPSEEK_FAST_FIRST_TOKEN_TIMEOUT_S=3.0
DEEPSEEK_FAST_TOTAL_TIMEOUT_S=12.0
DEEPSEEK_FAST_MAX_TOKENS=240
DEEPSEEK_FAST_TEMPERATURE=0.45
DEEPSEEK_DEEP_TOTAL_TIMEOUT_S=90

# CosyVoice
COSYVOICE_MODEL=cosyvoice-v3-flash
COSYVOICE_VOICE=longanyang
COSYVOICE_SAMPLE_RATE=24000
COSYVOICE_FORMAT=pcm
COSYVOICE_LANGUAGE=zh
# Inject [laughter]/[breath] into first TTS segment when true. Keep false for
# longanyang PlainText unless the deployed CosyVoice model is verified for tags.
COSYVOICE_PARALINGUISTIC_TAGS=false

# Qwen Omni semantic_vad sweep knobs (Flash default; Plus may override).
QWEN_OMNI_VAD_THRESHOLD=0.5
QWEN_OMNI_PREFIX_PADDING_MS=500
QWEN_OMNI_SILENCE_DURATION_MS=800
# Optional Plus-only overrides for A/B sweeps (comment out to share Flash values):
# QWEN_OMNI_PLUS_VAD_THRESHOLD=0.5
# QWEN_OMNI_PLUS_SILENCE_DURATION_MS=700

# Session target-speaker enrollment (reject nearby talkers during barge-in/turns).
SPEAKER_VERIFY_ENABLED=true
SPEAKER_ENROLL_SPEECH_MS=3500
SPEAKER_ENROLL_TIMEOUT_MS=15000
SPEAKER_ACCEPT_THRESHOLD=0.62
SPEAKER_MIN_VERIFY_SPEECH_MS=450
COSYVOICE_RATE=1.0
COSYVOICE_PITCH=1.0
COSYVOICE_VOLUME=50
COSYVOICE_WORD_TIMESTAMPS=true
COSYVOICE_POOL_SIZE=4
COSYVOICE_CONNECT_TIMEOUT_S=5
COSYVOICE_FIRST_AUDIO_TIMEOUT_S=1.5
COSYVOICE_TOTAL_TIMEOUT_S=20

# Turn handling
VAD_MIN_SPEECH_DURATION_S=0.05
VAD_MIN_SILENCE_DURATION_S=0.30
VAD_PREFIX_PADDING_DURATION_S=0.30
ENDPOINTING_MODE=dynamic
ENDPOINTING_MIN_DELAY_S=1.50
ENDPOINTING_MAX_DELAY_S=2.20
ENDPOINTING_ALPHA=0.85
INTERRUPTION_MIN_DURATION_S=0.45
FALSE_INTERRUPTION_TIMEOUT_S=1.70
BACKCHANNEL_BOUNDARY_START_S=0.50
BACKCHANNEL_BOUNDARY_END_S=1.80
PREEMPTIVE_GENERATION=false
PREEMPTIVE_TTS=false

# Persistence and observability
DATABASE_URL=postgresql+asyncpg://voice:voice@localhost:5432/voice
REDIS_URL=redis://localhost:6379/0
OTEL_EXPORTER_OTLP_ENDPOINT=
PROMETHEUS_PORT=9090
SENTRY_DSN=

# Security
MEMORIA_AUTH_SECRET=
READINESS_GATE_TTL_S=86400
SESSION_TOKEN_TTL_S=300
JWT_ISSUER=voice-agent
AUDIO_RETENTION_ENABLED=false
AUDIO_RETENTION_DAYS=0
PII_REDACTION_ENABLED=true

# Offline / mock mode (local tests without provider keys)
OFFLINE_MOCK=false
FUNASR_MOCK_WS_URL=
COSYVOICE_MOCK_WS_URL=
DEEPSEEK_MOCK_BASE_URL=
