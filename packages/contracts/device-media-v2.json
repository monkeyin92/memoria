{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://memoria.local/contracts/device-media-v2.json",
  "title": "Memoria hardware device media protocol v2",
  "description": "Device WSS control frames and MemoriaAudioFrameV1 golden bytes. Version 1 remains a shared compatibility fixture for the legacy livekit_compat gateway; the direct hardware edge accepts only version 2.",
  "oneOf": [
    {
      "$ref": "#/$defs/device_hello_v1"
    },
    {
      "$ref": "#/$defs/device_hello_v2"
    },
    {
      "$ref": "#/$defs/session_accepted_v2"
    },
    {
      "$ref": "#/$defs/vad_start_v2"
    },
    {
      "$ref": "#/$defs/vad_end_v2"
    },
    {
      "$ref": "#/$defs/keyword_detected_v2"
    },
    {
      "$ref": "#/$defs/button_stop_v2"
    },
    {
      "$ref": "#/$defs/playback_receipt_v2"
    },
    {
      "$ref": "#/$defs/device_state_event_v2"
    },
    {
      "$ref": "#/$defs/session_close_v2"
    },
    {
      "$ref": "#/$defs/generation_control_v2"
    },
    {
      "$ref": "#/$defs/playback_control_v2"
    },
    {
      "$ref": "#/$defs/runtime_profile_invalidated_v2"
    },
    {
      "$ref": "#/$defs/runtime_profile_applied_v2"
    },
    {
      "$ref": "#/$defs/session_error_v2"
    }
  ],
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "uint32": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "positive_uint32": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4294967295
    },
    "uint64": {
      "type": "integer",
      "minimum": 0
    },
    "unit_interval": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "audio_mode": {
      "enum": [
        "half_duplex_safe",
        "interrupt_assist",
        "full_duplex_verified"
      ]
    },
    "device_settings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "settings_version",
        "volume_limit",
        "screen_brightness",
        "night_mode",
        "do_not_disturb",
        "learning_mode",
        "audio_mode",
        "wake_mode",
        "allowed_barge_in"
      ],
      "properties": {
        "settings_version": {
          "$ref": "#/$defs/uint32"
        },
        "volume_limit": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "screen_brightness": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "night_mode": {
          "type": "boolean"
        },
        "do_not_disturb": {
          "type": "boolean"
        },
        "learning_mode": {
          "enum": [
            "off",
            "tutor_english",
            "tutor_homework"
          ]
        },
        "audio_mode": {
          "$ref": "#/$defs/audio_mode"
        },
        "wake_mode": {
          "enum": [
            "button",
            "keyword",
            "button_or_keyword"
          ]
        },
        "allowed_barge_in": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "enum": [
              "none",
              "button",
              "keyword",
              "voice"
            ]
          }
        }
      }
    },
    "generation_fence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "turn_id",
        "generation_id",
        "tool_epoch",
        "session_epoch"
      ],
      "properties": {
        "turn_id": {
          "$ref": "#/$defs/positive_uint32"
        },
        "generation_id": {
          "$ref": "#/$defs/positive_uint32"
        },
        "tool_epoch": {
          "$ref": "#/$defs/uint32"
        },
        "session_epoch": {
          "$ref": "#/$defs/positive_uint32"
        }
      }
    },
    "legacy_capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "display",
        "microphone",
        "speaker",
        "device_aec",
        "physical_button"
      ],
      "properties": {
        "display": {
          "type": "boolean"
        },
        "microphone": {
          "type": "boolean"
        },
        "speaker": {
          "type": "boolean"
        },
        "device_aec": {
          "type": "boolean"
        },
        "physical_button": {
          "type": "boolean"
        }
      }
    },
    "legacy_audio": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "uplink_codec",
        "uplink_sample_rate",
        "downlink_sample_rate",
        "channels",
        "frame_ms"
      ],
      "properties": {
        "uplink_codec": {
          "const": "opus"
        },
        "uplink_sample_rate": {
          "const": 16000
        },
        "downlink_sample_rate": {
          "const": 24000
        },
        "channels": {
          "const": 1
        },
        "frame_ms": {
          "const": 20
        }
      }
    },
    "device_hello_v1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "version",
        "device_id",
        "firmware_version",
        "board_profile",
        "stream_epoch",
        "audio",
        "capabilities"
      ],
      "properties": {
        "type": {
          "const": "device.hello"
        },
        "version": {
          "const": 1
        },
        "device_id": {
          "$ref": "#/$defs/identifier"
        },
        "firmware_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "board_profile": {
          "$ref": "#/$defs/identifier"
        },
        "stream_epoch": {
          "$ref": "#/$defs/positive_uint32"
        },
        "audio": {
          "$ref": "#/$defs/legacy_audio"
        },
        "capabilities": {
          "$ref": "#/$defs/legacy_capabilities"
        }
      }
    },
    "device_audio_v2": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "uplink_codec",
        "uplink_sample_rate",
        "downlink_sample_rates",
        "channels",
        "frame_ms"
      ],
      "properties": {
        "uplink_codec": {
          "const": "opus"
        },
        "uplink_sample_rate": {
          "const": 16000
        },
        "downlink_sample_rates": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true,
          "contains": {
            "const": 16000
          },
          "items": {
            "enum": [
              16000,
              24000
            ]
          }
        },
        "channels": {
          "const": 1
        },
        "frame_ms": {
          "const": 20
        }
      }
    },
    "device_capabilities_v2": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "display",
        "microphone",
        "speaker",
        "simultaneous_capture_playback",
        "aec_mode",
        "aec_reference",
        "aec_reference_verified",
        "local_vad",
        "local_stop_keyword",
        "physical_stop_button",
        "playback_watermark",
        "local_duck",
        "barge_in_level"
      ],
      "properties": {
        "display": {
          "type": "boolean"
        },
        "microphone": {
          "type": "boolean"
        },
        "speaker": {
          "type": "boolean"
        },
        "simultaneous_capture_playback": {
          "type": "boolean"
        },
        "aec_mode": {
          "enum": [
            "none",
            "fd_low_cost",
            "fd_high_quality"
          ]
        },
        "aec_reference": {
          "enum": [
            "none",
            "software_post_gain_pre_i2s",
            "hardware_loopback"
          ]
        },
        "aec_reference_verified": {
          "type": "boolean"
        },
        "local_vad": {
          "type": "boolean"
        },
        "local_stop_keyword": {
          "type": "boolean"
        },
        "physical_stop_button": {
          "type": "boolean"
        },
        "playback_watermark": {
          "enum": [
            "none",
            "approximate",
            "exact"
          ]
        },
        "local_duck": {
          "type": "boolean"
        },
        "barge_in_level": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        }
      }
    },
    "device_hello_v2": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "version",
        "device_id",
        "firmware_version",
        "board_profile",
        "stream_epoch",
        "audio",
        "capabilities"
      ],
      "properties": {
        "type": {
          "const": "device.hello"
        },
        "version": {
          "const": 2
        },
        "device_id": {
          "$ref": "#/$defs/identifier"
        },
        "firmware_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "board_profile": {
          "$ref": "#/$defs/identifier"
        },
        "stream_epoch": {
          "$ref": "#/$defs/positive_uint32"
        },
        "audio": {
          "$ref": "#/$defs/device_audio_v2"
        },
        "capabilities": {
          "$ref": "#/$defs/device_capabilities_v2"
        }
      }
    },
    "acoustic_attestation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "verified",
        "board_profile",
        "profile_version"
      ],
      "properties": {
        "verified": {
          "const": true
        },
        "board_profile": {
          "$ref": "#/$defs/identifier"
        },
        "profile_version": {
          "$ref": "#/$defs/positive_uint32"
        }
      }
    },
    "session_accepted_v2": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "version",
        "session_id",
        "stream_epoch",
        "interaction_authority",
        "audio_mode",
        "downlink_sample_rate",
        "runtime_profile_version",
        "device_settings",
        "current_fence",
        "current_generation_active",
        "acoustic_attestation"
      ],
      "properties": {
        "type": {
          "const": "session.accepted"
        },
        "version": {
          "const": 2
        },
        "session_id": {
          "$ref": "#/$defs/identifier"
        },
        "stream_epoch": {
          "$ref": "#/$defs/positive_uint32"
        },
        "interaction_authority": {
          "const": "python_authoritative"
        },
        "audio_mode": {
          "$ref": "#/$defs/audio_mode"
        },
        "downlink_sample_rate": {
          "enum": [
            16000,
            24000
          ]
        },
        "runtime_profile_version": {
          "$ref": "#/$defs/positive_uint32"
        },
        "device_settings": {
          "$ref": "#/$defs/device_settings"
        },
        "current_fence": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/generation_fence"
            }
          ]
        },
        "current_generation_active": {
          "type": "boolean"
        },
        "acoustic_attestation": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/acoustic_attestation"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "current_generation_active": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "current_fence": {
                "$ref": "#/$defs/generation_fence"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "audio_mode": {
                "const": "full_duplex_verified"
              }
            }
          },
          "then": {
            "properties": {
              "acoustic_attestation": {
                "$ref": "#/$defs/acoustic_attestation"
              }
            }
          }
        }
      ]
    },
    "device_event_base": {
      "type": "object",
      "required": [
        "version",
        "stream_epoch",
        "control_sequence",
        "device_monotonic_ms"
      ],
      "properties": {
        "version": {
          "const": 2
        },
        "stream_epoch": {
          "$ref": "#/$defs/positive_uint32"
        },
        "control_sequence": {
          "$ref": "#/$defs/uint32"
        },
        "device_monotonic_ms": {
          "$ref": "#/$defs/uint64"
        }
      }
    },
    "vad_start_v2": {
      "allOf": [
        {
          "$ref": "#/$defs/device_event_base"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "version",
            "stream_epoch",
            "control_sequence",
            "device_monotonic_ms",
            "sample_position",
            "probability",
            "near_end_rms"
          ],
          "properties": {
            "type": {
              "const": "vad.start"
            },
            "version": {
              "const": 2
            },
            "stream_epoch": {
              "$ref": "#/$defs/positive_uint32"
            },
            "control_sequence": {
              "$ref": "#/$defs/uint32"
            },
            "device_monotonic_ms": {
              "$ref": "#/$defs/uint64"
            },
            "sample_position": {
              "$ref": "#/$defs/uint64"
            },
            "probability": {
              "$ref": "#/$defs/unit_interval"
            },
            "near_end_rms": {
              "type": "number",
              "minimum": 0
            }
          }
        }
      ]
    },
    "vad_end_v2": {
      "allOf": [
        {
          "$ref": "#/$defs/device_event_base"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "version",
            "stream_epoch",
            "control_sequence",
            "device_monotonic_ms",
            "sample_position",
            "voiced_end_sample",
            "probability",
            "near_end_rms"
          ],
          "properties": {
            "type": {
              "const": "vad.end"
            },
            "version": {
              "const": 2
            },
            "stream_epoch": {
              "$ref": "#/$defs/positive_uint32"
            },
            "control_sequence": {
              "$ref": "#/$defs/uint32"
            },
            "device_monotonic_ms": {
              "$ref": "#/$defs/uint64"
            },
            "sample_position": {
              "$ref": "#/$defs/uint64"
            },
            "voiced_end_sample": {
              "$ref": "#/$defs/uint64"
            },
            "probability": {
              "$ref": "#/$defs/unit_interval"
            },
            "near_end_rms": {
              "type": "number",
              "minimum": 0
            }
          }
        }
      ]
    },
    "interruption_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "detected_sample",
        "source",
        "aec_mode",
        "aec_verified",
        "vad_probability",
        "near_end_rms",
        "far_end_rms",
        "speaker_class",
        "duration_ms"
      ],
      "properties": {
        "detected_sample": {
          "$ref": "#/$defs/uint64"
        },
        "source": {
          "enum": [
            "button",
            "local_kws",
            "local_vad",
            "cloud_asr"
          ]
        },
        "aec_mode": {
          "enum": [
            "none",
            "fd_low_cost",
            "fd_high_quality"
          ]
        },
        "aec_verified": {
          "type": "boolean"
        },
        "vad_probability": {
          "$ref": "#/$defs/unit_interval"
        },
        "near_end_rms": {
          "type": "number",
          "minimum": 0
        },
        "far_end_rms": {
          "type": "number",
          "minimum": 0
        },
        "residual_echo_score": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/unit_interval"
            }
          ]
        },
        "speaker_class": {
          "enum": [
            "owner",
            "guest",
            "ambiguous",
            "unknown"
          ]
        },
        "asr_prefix": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "maxLength": 64
            }
          ]
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 60000
        }
      }
    },
    "keyword_detected_v2": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "version",
        "stream_epoch",
        "control_sequence",
        "device_monotonic_ms",
        "keyword_id",
        "confidence",
        "hard_stop",
        "evidence",
        "expected_fence"
      ],
      "properties": {
        "type": {
          "const": "keyword.detected"
        },
        "version": {
          "const": 2
        },
        "stream_epoch": {
          "$ref": "#/$defs/positive_uint32"
        },
        "control_sequence": {
          "$ref": "#/$defs/uint32"
        },
        "device_monotonic_ms": {
          "$ref": "#/$defs/uint64"
        },
        "keyword_id": {
          "$ref": "#/$defs/identifier"
        },
        "confidence": {
          "$ref": "#/$defs/unit_interval"
        },
        "hard_stop": {
          "type": "boolean"
        },
        "evidence": {
          "$ref": "#/$defs/interruption_evidence"
        },
        "expected_fence": {
          "$ref": "#/$defs/generation_fence"
        }
      }
    },
    "button_stop_v2": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "version",
        "stream_epoch",
        "control_sequence",
        "device_monotonic_ms",
        "expected_fence",
        "local_flush_sample_end"
      ],
      "properties": {
        "type": {
          "const": "button.stop"
        },
        "version": {
          "const": 2
        },
        "stream_epoch": {
          "$ref": "#/$defs/positive_uint32"
        },
        "control_sequence": {
          "$ref": "#/$defs/uint32"
        },
        "device_monotonic_ms": {
          "$ref": "#/$defs/uint64"
        },
        "expected_fence": {
          "$ref": "#/$defs/generation_fence"
        },
        "local_flush_sample_end": {
          "$ref": "#/$defs/uint64"
        }
      }
    },
    "playback_receipt_v2": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "version",
        "stream_epoch",
        "control_sequence",
        "device_monotonic_ms",
        "fence",
        "received_sequence",
        "rendered_sample_end",
        "approximate"
      ],
      "properties": {
        "type": {
          "enum": [
            "playback.started",
            "playback.progress",
            "playback.ended",
            "playback.error"
          ]
        },
        "version": {
          "const": 2
        },
        "stream_epoch": {
          "$ref": "#/$defs/positive_uint32"
        },
        "control_sequence": {
          "$ref": "#/$defs/uint32"
        },
        "device_monotonic_ms": {
          "$ref": "#/$defs/uint64"
        },
        "fence": {
          "$ref": "#/$defs/generation_fence"
        },
        "received_sequence": {
          "$ref": "#/$defs/uint32"
        },
        "rendered_sample_end": {
          "$ref": "#/$defs/uint64"
        },
        "approximate": {
          "type": "boolean"
        }
      }
    },
    "device_state_event_v2": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "version",
        "stream_epoch",
        "control_sequence",
        "device_monotonic_ms",
        "value"
      ],
      "properties": {
        "type": {
          "enum": [
            "device.mute_changed",
            "device.network_changed",
            "device.telemetry"
          ]
        },
        "version": {
          "const": 2
        },
        "stream_epoch": {
          "$ref": "#/$defs/positive_uint32"
        },
        "control_sequence": {
          "$ref": "#/$defs/uint32"
        },
        "device_monotonic_ms": {
          "$ref": "#/$defs/uint64"
        },
        "value": {
          "type": "object",
          "maxProperties": 32,
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "integer",
              "boolean",
              "null"
            ],
            "maxLength": 1024
          }
        }
      }
    },
    "session_close_v2": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "version",
        "stream_epoch",
        "control_sequence",
        "device_monotonic_ms",
        "value"
      ],
      "properties": {
        "type": {
          "const": "session.close"
        },
        "version": {
          "const": 2
        },
        "stream_epoch": {
          "$ref": "#/$defs/positive_uint32"
        },
        "control_sequence": {
          "$ref": "#/$defs/uint32"
        },
        "device_monotonic_ms": {
          "$ref": "#/$defs/uint64"
        },
        "value": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "reason"
          ],
          "properties": {
            "reason": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          }
        }
      }
    },
    "server_event_base": {
      "type": "object",
      "required": [
        "version",
        "session_id",
        "stream_epoch",
        "control_sequence",
        "server_monotonic_ms"
      ],
      "properties": {
        "version": {
          "const": 2
        },
        "session_id": {
          "$ref": "#/$defs/identifier"
        },
        "stream_epoch": {
          "$ref": "#/$defs/positive_uint32"
        },
        "control_sequence": {
          "$ref": "#/$defs/uint32"
        },
        "server_monotonic_ms": {
          "$ref": "#/$defs/uint64"
        }
      }
    },
    "generation_control_v2": {
      "allOf": [
        {
          "$ref": "#/$defs/server_event_base"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
