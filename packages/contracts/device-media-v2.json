  "binary_audio": {
    "name": "MemoriaAudioFrameV1",
    "version": 1,
    "byte_order": "network",
    "header_size": 30,
    "websocket_fragmentation_allowed": false,
    "fields": [
      {
        "name": "version",
        "type": "uint8"
      },
      {
        "name": "direction",
        "type": "uint8",
        "values": {
          "uplink": 1,
          "downlink": 2
        }
      },
      {
        "name": "flags",
        "type": "uint16",
        "description": "bit 0 (0x0001) = discontinuity: downlink-only, set by the edge at socket-write time on the first frame after a same-generation forward gap caused by queue drops; uplink frames must carry flags 0; any other bit is forged"
      },
      {
        "name": "stream_epoch",
        "type": "uint32"
      },
      {
        "name": "sequence",
        "type": "uint32"
      },
      {
        "name": "sample_start",
        "type": "uint64"
      },
      {
        "name": "frame_samples",
        "type": "uint32"
      },
      {
        "name": "generation_id",
        "type": "uint32"
      },
      {
        "name": "payload_size",
        "type": "uint16"
      }
    ],
    "generation_semantics": {
      "none": 0,
      "first": 1,
      "mapping_allowed_on_direct_path": false,
      "downlink_clock": {
        "reset_on": [
          "generation.started",
          "playback.flush"
        ],
        "reset_to": 0,
        "gap_policy": "same-generation forward gaps caused by queue drops MUST be marked with the discontinuity flag (0x0001) at socket-write time; the device accepts a flagged gap only when the sequence delta and the sample delta are consistent multiples of frame_samples, and rejects backward, forged or unflagged gaps"
      }
    },
    "audio": {
      "codec": "opus",
      "channels": 1,
      "frame_ms": 20,
      "uplink_sample_rate": 16000,
      "uplink_frame_samples": 320,
      "downlink_sample_rates": [
        16000,
        24000
      ],
      "downlink_frame_samples": {
        "16000": 320,
        "24000": 480
      }
    },
    "golden_frames": [
      {
        "name": "uplink-v1",
        "stream_epoch": 18,
        "sequence": 7,
        "sample_start": 2240,
        "frame_samples": 320,
        "generation_id": 0,
        "payload_hex": "010203",
        "frame_hex": "01010000000000120000000700000000000008c000000140000000000003010203"
      },
      {
        "name": "downlink-24k-v1",
        "stream_epoch": 18,
        "sequence": 3,
        "sample_start": 1440,
        "frame_samples": 480,
        "generation_id": 1,
        "payload_hex": "0405",
        "frame_hex": "01020000000000120000000300000000000005a0000001e00000000100020405"
      },
      {
        "name": "downlink-16k-negotiated",
        "stream_epoch": 18,
        "sequence": 3,
        "sample_start": 960,
        "frame_samples": 320,
        "generation_id": 1,
        "payload_hex": "0405",
        "frame_hex": "01020000000000120000000300000000000003c0000001400000000100020405"
      }
    ],
    "flags": {
      "discontinuity": 1,
      "description": "Downlink-only bit 0 (0x0001). The edge sets it at socket-write time on the first frame after a same-generation forward gap caused by queue drops. Uplink frames must carry flags 0; any other downlink bit is forged and must be rejected.",
      "uplink_allowed": false
    }
  },
  "priority_lanes": {
    "description": "Server-to-device write lanes. P0 always preempts P1, P1 preempts P2 audio, P2 preempts P3. Device-to-server control events travel in the opposite direction on the same socket, ordered by their own device-lifetime monotonic control_sequence; their intended urgency is expressed in uplink_priority_lanes.",
    "p0": [
      "playback.flush",
      "generation.cancelled",
      "session.close"
    ],
    "p1": [
      "generation.started",
      "generation.pause",
      "generation.resume",
      "vad.start",
      "vad.end",
      "keyword.detected",
      "button.stop",
      "playback.started",
      "playback.progress",
      "playback.ended",
      "playback.error",
      "runtime_profile.applied"
    ],
    "p2": [
      "assistant.audio.frame",
      "generation.completed"
    ],
    "p3": [
      "screen.subtitle",
      "screen.expression",
      "device.telemetry"
    ]
  },
  "uplink_priority_lanes": {
    "description": "Device-to-server ordering intent. The device serializes every control event on one device-lifetime monotonic control_sequence and the edge enforces strict advancement per connection; urgency within that sequence is advisory.",
    "p0": [
      "device.mute_changed",
      "session.close"
    ],
    "p1": [
      "vad.start",
      "vad.end",
      "keyword.detected",
      "button.stop",
      "playback.started",
      "playback.progress",
      "playback.ended",
      "playback.error",
      "runtime_profile.applied"
    ],
    "p2": [
      "audio.frame"
    ],
    "p3": [
      "device.network_changed",
      "device.telemetry"
    ]
  },
  "ordered_barriers": {
    "generation.completed": "MUST be queued after all assistant.audio.frame messages for the same generation and MUST be dropped if that generation becomes stale before write"
  }
}
