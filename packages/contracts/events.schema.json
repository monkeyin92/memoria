{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://voice-agent.local/schemas/events.schema.json",
  "title": "VoiceAgentUIEvents",
  "oneOf": [
    {
      "type": "object",
      "required": ["type", "session_id", "provisional_id", "stream_epoch", "provisional_turn_id", "projection_revision", "capture_start_sample", "capture_end_sample", "text", "speaker", "floor_state", "speaker_evidence", "persist_as_turn", "history_eligible"],
      "properties": {
        "type": { "const": "turn.provisional.started" },
        "session_id": { "type": "string", "minLength": 1 },
        "provisional_id": { "type": "string", "minLength": 1, "maxLength": 256 },
        "stream_epoch": { "type": "integer", "minimum": 1 },
        "provisional_turn_id": { "type": "integer", "minimum": 1 },
        "projection_revision": { "type": "integer", "minimum": 1 },
        "capture_start_sample": { "type": "integer", "minimum": 0 },
        "capture_end_sample": { "type": "integer", "minimum": 1 },
        "text": { "type": "string", "maxLength": 5000 },
        "speaker": { "const": "user" },
        "floor_state": { "enum": ["user_holds_floor", "assistant_holds_floor", "overlap", "uncertain", "silence"] },
        "speaker_evidence": {
          "type": "object",
          "required": ["speaker_class", "reason_code", "authority_verified"],
          "properties": {
            "speaker_class": { "enum": ["owner", "guest", "uncertain"] },
            "reason_code": { "type": "string", "minLength": 1, "maxLength": 128 },
            "authority_verified": { "type": "boolean" }
          },
          "additionalProperties": false
        },
        "persist_as_turn": { "const": false },
        "history_eligible": { "const": false },
        "reason": { "type": "string", "maxLength": 128 }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": ["type", "session_id", "provisional_id", "stream_epoch", "provisional_turn_id", "projection_revision", "capture_start_sample", "capture_end_sample", "text", "speaker", "floor_state", "speaker_evidence", "persist_as_turn", "history_eligible"],
      "properties": {
        "type": { "const": "turn.provisional.patch" },
        "session_id": { "type": "string", "minLength": 1 },
        "provisional_id": { "type": "string", "minLength": 1, "maxLength": 256 },
        "stream_epoch": { "type": "integer", "minimum": 1 },
        "provisional_turn_id": { "type": "integer", "minimum": 1 },
        "projection_revision": { "type": "integer", "minimum": 1 },
        "capture_start_sample": { "type": "integer", "minimum": 0 },
        "capture_end_sample": { "type": "integer", "minimum": 1 },
        "text": { "type": "string", "maxLength": 5000 },
        "speaker": { "const": "user" },
        "floor_state": { "enum": ["user_holds_floor", "assistant_holds_floor", "overlap", "uncertain", "silence"] },
        "speaker_evidence": {
          "type": "object",
          "required": ["speaker_class", "reason_code", "authority_verified"],
          "properties": {
            "speaker_class": { "enum": ["owner", "guest", "uncertain"] },
            "reason_code": { "type": "string", "minLength": 1, "maxLength": 128 },
            "authority_verified": { "type": "boolean" }
          },
          "additionalProperties": false
        },
        "persist_as_turn": { "const": false },
        "history_eligible": { "const": false },
        "reason": { "type": "string", "maxLength": 128 }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": ["type", "session_id", "provisional_id", "stream_epoch", "provisional_turn_id", "projection_revision", "capture_start_sample", "capture_end_sample", "text", "speaker", "floor_state", "speaker_evidence", "persist_as_turn", "history_eligible", "reason"],
      "properties": {
        "type": { "const": "turn.provisional.discarded" },
        "session_id": { "type": "string", "minLength": 1 },
        "provisional_id": { "type": "string", "minLength": 1, "maxLength": 256 },
        "stream_epoch": { "type": "integer", "minimum": 1 },
        "provisional_turn_id": { "type": "integer", "minimum": 1 },
        "projection_revision": { "type": "integer", "minimum": 1 },
        "capture_start_sample": { "type": "integer", "minimum": 0 },
        "capture_end_sample": { "type": "integer", "minimum": 1 },
        "text": { "type": "string", "maxLength": 5000 },
        "speaker": { "const": "user" },
        "floor_state": { "const": "silence" },
        "speaker_evidence": {
          "type": "object",
          "required": ["speaker_class", "reason_code", "authority_verified"],
          "properties": {
            "speaker_class": { "enum": ["owner", "guest", "uncertain"] },
            "reason_code": { "type": "string", "minLength": 1, "maxLength": 128 },
            "authority_verified": { "type": "boolean" }
          },
          "additionalProperties": false
        },
        "persist_as_turn": { "const": false },
        "history_eligible": { "const": false },
        "reason": { "type": "string", "minLength": 1, "maxLength": 128 }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": ["type", "session_id", "provisional_id", "stream_epoch", "projection_revision", "turn_revision", "capture_start_sample", "capture_end_sample", "text", "speaker", "final", "speaker_evidence", "persist_as_turn", "history_eligible", "context_version", "turn_id", "generation_id", "tool_epoch"],
      "properties": {
        "type": { "const": "turn.committed" },
        "session_id": { "type": "string", "minLength": 1 },
        "provisional_id": { "type": "string", "minLength": 1, "maxLength": 256 },
        "stream_epoch": { "type": "integer", "minimum": 1 },
        "projection_revision": { "type": "integer", "minimum": 1 },
        "turn_revision": { "type": "integer", "minimum": 1 },
        "capture_start_sample": { "type": "integer", "minimum": 0 },
        "capture_end_sample": { "type": "integer", "minimum": 1 },
        "text": { "type": "string", "minLength": 1, "maxLength": 5000 },
        "speaker": { "const": "user" },
        "final": { "const": true },
        "speaker_evidence": {
          "type": "object",
          "required": ["speaker_class", "reason_code", "authority_verified"],
          "properties": {
            "speaker_class": { "enum": ["owner", "guest", "uncertain"] },
            "reason_code": { "type": "string", "minLength": 1, "maxLength": 128 },
            "authority_verified": { "type": "boolean" }
          },
          "additionalProperties": false
        },
        "persist_as_turn": { "const": true },
        "history_eligible": { "type": "boolean" },
        "context_version": { "type": "integer", "minimum": 0 },
        "turn_id": { "type": "integer", "minimum": 1 },
        "generation_id": { "type": "integer", "minimum": 1 },
        "tool_epoch": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": ["type", "session_id", "state", "phase", "turn_id", "generation_id", "tool_epoch", "at"],
      "properties": {
        "type": { "const": "assistant_state" },
        "session_id": { "type": "string", "minLength": 1 },
        "state": { "type": "string" },
        "phase": { "type": "string" },
        "turn_id": { "type": "integer" },
        "generation_id": { "type": "integer" },
        "tool_epoch": { "type": "integer", "minimum": 0 },
        "at": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": ["type", "session_id", "speaker", "text", "final", "turn_id", "generation_id", "turn_revision", "history_eligible"],
      "properties": {
        "type": { "const": "transcript_delta" },
        "session_id": { "type": "string", "minLength": 1 },
        "speaker": { "enum": ["user", "assistant"] },
        "text": { "type": "string" },
        "final": { "type": "boolean" },
        "heard": { "type": "boolean" },
        "history_eligible": { "type": "boolean" },
        "turn_id": { "type": "integer" },
        "generation_id": { "type": "integer" },
        "turn_revision": { "type": "integer", "minimum": 1 },
        "tool_epoch": { "type": "integer", "minimum": 0 },
        "preview_provenance": {
          "type": ["object", "null"],
          "required": [
            "digital_self_version_id",
            "manifest_sha256",
            "turn_id",
            "generation_id",
            "tool_epoch",
            "epistemic_status",
            "disclosures",
            "source_refs"
          ],
          "properties": {
            "digital_self_version_id": { "type": "string", "maxLength": 128 },
            "manifest_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "turn_id": { "type": "integer", "minimum": 0 },
            "generation_id": { "type": "integer", "minimum": 0 },
            "tool_epoch": { "type": "integer", "minimum": 0 },
            "epistemic_status": {
              "enum": ["fact", "inference", "unknown", "not_applicable"]
            },
            "disclosures": {
              "type": "array",
              "maxItems": 4,
              "items": { "type": "string", "maxLength": 64 }
            },
            "source_refs": {
              "type": "array",
              "maxItems": 12,
              "items": {
                "type": "object",
                "required": ["kind", "item_id", "source_event_ids"],
                "properties": {
                  "kind": { "type": "string", "maxLength": 64 },
                  "item_id": { "type": "string", "maxLength": 128 },
                  "source_event_ids": {
                    "type": "array",
                    "maxItems": 8,
                    "items": { "type": "string", "maxLength": 128 }
                  }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": ["type", "session_id", "capture_allowed", "policy_epoch", "reason", "turn_id", "generation_id", "at"],
      "properties": {
        "type": { "const": "input_policy" },
        "session_id": { "type": "string", "minLength": 1 },
        "capture_allowed": { "type": "boolean" },
        "policy_epoch": { "type": "integer", "minimum": 1 },
        "reason": { "type": "string", "minLength": 1, "maxLength": 80 },
        "turn_id": { "type": "integer", "minimum": 0 },
        "generation_id": { "type": "integer", "minimum": 0 },
        "at": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": ["type", "source", "session_id", "name", "status", "turn_id", "generation_id", "at"],
      "properties": {
        "type": { "const": "audio_trace" },
        "source": { "enum": ["agent", "client"] },
        "session_id": { "type": "string" },
        "name": { "type": "string" },
        "status": { "type": "string" },
        "detail": { "type": "object" },
        "turn_id": { "type": "integer" },
        "generation_id": { "type": "integer" },
        "tool_epoch": { "type": "integer", "minimum": 0 },
        "at": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": ["type", "session_id", "action", "gain", "turn_id", "generation_id", "at"],
      "properties": {
        "type": { "const": "assistant_audio" },
        "session_id": { "type": "string" },
        "action": { "enum": ["duck", "restore"] },
        "gain": { "type": "number", "minimum": 0, "maximum": 1 },
        "turn_id": { "type": "integer" },
        "generation_id": { "type": "integer" },
        "tool_epoch": { "type": "integer", "minimum": 0 },
        "at": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": ["type", "session_id", "label", "provider_label", "provider_confidence", "evidence", "persist", "turn_id", "generation_id", "expires_after_ms", "at"],
      "properties": {
        "type": { "const": "emotion_observation" },
        "session_id": { "type": "string" },
        "label": { "type": "string" },
        "provider_label": { "type": "string" },
        "provider_confidence": { "type": ["number", "null"] },
        "evidence": { "type": "array", "items": { "type": "string" } },
        "persist": { "const": false },
        "turn_id": { "type": "integer" },
        "generation_id": { "type": "integer" },
        "tool_epoch": { "type": "integer", "minimum": 0 },
        "expires_after_ms": { "type": "integer", "exclusiveMinimum": 0 },
        "at": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": ["type", "session_id", "expression", "turn_id", "generation_id", "tool_epoch", "at"],
      "properties": {
        "type": { "const": "assistant_expression" },
        "session_id": { "type": "string", "minLength": 1 },
        "expression": { "enum": ["neutral", "happy", "curious", "caring"] },
        "turn_id": { "type": "integer", "minimum": 0 },
        "generation_id": { "type": "integer", "minimum": 0 },
        "tool_epoch": { "type": "integer", "minimum": 0 },
        "at": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": ["type", "session_id", "state", "speech_ms", "target_ms", "elapsed_ms", "at"],
      "properties": {
        "type": { "const": "speaker_enroll_progress" },
        "session_id": { "type": "string" },
        "state": { "type": "string" },
        "speech_ms": { "type": "integer", "minimum": 0 },
        "target_ms": { "type": "integer", "minimum": 1 },
        "elapsed_ms": { "type": "integer", "minimum": 0 },
        "at": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": ["type", "session_id", "accepted", "reason", "score", "speech_ms", "state", "at"],
      "properties": {
        "type": { "const": "speaker_enroll_result" },
        "session_id": { "type": "string" },
        "accepted": { "type": "boolean" },
        "reason": { "type": "string" },
        "score": { "type": "number", "minimum": 0, "maximum": 1 },
        "speech_ms": { "type": "integer", "minimum": 0 },
        "state": { "type": "string" },
        "at": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": ["type", "session_id", "context", "reason", "score", "utt", "roll", "speech_ms", "at"],
      "properties": {
        "type": { "const": "speaker_reject" },
        "session_id": { "type": "string" },
        "context": { "type": "string" },
        "reason": { "type": "string" },
        "score": { "type": "number", "minimum": -1, "maximum": 1 },
        "utt": { "type": "number", "minimum": -1, "maximum": 1 },
        "roll": { "type": "number", "minimum": -1, "maximum": 1 },
        "speech_ms": { "type": "integer", "minimum": 0 },
        "at": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": ["type", "session_id", "cue_id", "cue_epoch", "user_turn_id", "state", "phase", "at"],
      "properties": {
        "type": { "const": "listener_cue" },
        "session_id": { "type": "string" },
        "cue_id": { "type": "string" },
        "cue_epoch": { "type": "integer", "minimum": 0 },
        "user_turn_id": { "type": "integer", "minimum": 0 },
        "state": { "type": "string" },
        "phase": { "type": "string" },
        "at": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    }
  ]
}
