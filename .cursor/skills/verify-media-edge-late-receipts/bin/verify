#!/usr/bin/env python3
"""Model-check Media Edge late-playback-receipt guarantees with TLA+/TLC.

Reads services/media_edge/formal/LateReceipts.tla and its configs, runs TLC on
current guarantees and mutation evidence, and confirms the repaired F1 property.
See the skill's SKILL.md for the code mapping, coverage record, and interpretation
guide.

Usage:
    bin/verify              # property check + mutation evidence + fixed F1
    bin/verify --check      # property check only
    bin/verify --mutants    # property check + mutation evidence
    bin/verify --finding    # property check + fixed F1 confirmation

Exit codes: 0 all runs matched their expectation, 1 a check failed, 2 setup
problem (no JDK 11+, download/hash failure, missing spec).
"""

from __future__ import annotations

import hashlib
import os
import re
import shutil
import subprocess
import sys
import tempfile
import urllib.request
from pathlib import Path

TLA_VERSION = "1.7.4"
TLA_URL = (
    "https://github.com/tlaplus/tlaplus/releases/download/"
    f"v{TLA_VERSION}/tla2tools.jar"
)
TLA_SHA256 = "936a262061c914694dfd669a543be24573c45d5aa0ff20a8b96b23d01e050e88"

SKILL_DIR = Path(__file__).resolve().parents[1]
REPO_ROOT = SKILL_DIR.parents[2]
SPEC_DIR = REPO_ROOT / "services" / "media_edge" / "formal"
SPEC_PATH = SPEC_DIR / "LateReceipts.tla"
PRIMARY_CFG_PATH = SPEC_DIR / "LateReceipts.cfg"

# TLC explores 27759 distinct states for the current spec at MaxReceipts = 3.
# A different count means the spec changed; re-derive the model and update this
# number in the same change, so a silently weakened model cannot pass.
EXPECTED_BASE_DISTINCT = 27759
REQUIRED_ACTIONS = (
    "Enqueue",
    "Begin",
    "TerminalCheck",
    "PrecheckCheck",
    "CoreAdvance",
    "EdgeApplyCore",
    "DeviceStopEdgeFirst",
    "SendDownlink",
    "DropRefused",
    "CloseRefused",
    "DropTerminalReplaced",
    "DropPrecheck",
    "OpenWindow",
    "Forward",
    "DropAfterForwardError",
    "CloseAfterForwardError",
)

