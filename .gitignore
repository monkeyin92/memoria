# The audio-acceptance tool keeps a recorded-turns log and regenerates its own fixtures
!scripts/auto_audio/fixtures/**
scripts/auto_audio/selfcheck/

# CosyVoice design previews (binary); registry JSON is committed for deploy
infra/voices/previews/

# Gate caches redirected into the tree when the home cache is unwritable
.tmp-gate/
# Local scratch/cache directory used when the home cache is not writable
.tmp/

# Device-test run receipts and raw audit tarballs stay local (not source)
devicetest/run-*/
devicetest/r02-*/
devicetest/precheck-*/
devicetest/safety-*/
devicetest/targeted-*/
devicetest/flash-backups/
