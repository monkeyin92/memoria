# Local mascot cutout backups (opaque masters)

# Local agent tooling state (not a repository document)
.commandcode/

# Docker volumes
postgres-data/
redis-data/
data/

# Audio dumps (privacy)
*.wav
!services/agent/tests/fixtures/audio/**
!tests/e2e/fixtures/**
# Committed safety prompts and acceptance receipts stay visible; new files in
# these directories must show as untracked rather than vanish silently.
!infra/voices/fixed_safety/
!infra/voices/fixed_safety/*.wav
!docs/acceptance/run-20260924-defect-a-retest-live/
!docs/acceptance/run-20260924-defect-a-retest-live/*.log
!docs/acceptance/run-20261015-aigc-labels/archive/
